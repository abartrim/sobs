# Per-Dockerfile ignore (BuildKit uses <dockerfile>.dockerignore over the default .dockerignore).
# The parity build NEEDS migration/ (tools, manifest, committed upstream fixtures) + app.py + go/ +
# templates/ + static/ — unlike the default .dockerignore, which strips migration/ for Dockerfile.go.
__pycache__/
*.pyc
.env
.venv/
venv/
*.egg-info/
dist/
build/
.libchdb/
.git/
.claude/
node_modules/
tests/
*.tar.gz
# Generated/large dirs the harness regenerates itself. NOTE: keep migration/golden/ — most goldens
# are regenerated, but stream routes (e.g. get__tail) ship a COMMITTED golden that capture skips, so
# excluding golden/ would drop it -> MISSING_GOLDEN.
migration/fixtures/data/
migration/fixtures/_run/
