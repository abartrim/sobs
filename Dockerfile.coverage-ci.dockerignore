# Per-Dockerfile ignore. Coverage needs migration/ (tools + manifest + committed upstream fixtures)
# + app.py + templates/ + static/. It does NOT byte-diff, so committed goldens are not needed.
__pycache__/
*.pyc
.env
.venv/
venv/
*.egg-info/
dist/
build/
.libchdb/
.git/
.claude/
node_modules/
tests/
go/
*.tar.gz
migration/golden/
migration/fixtures/data/
migration/fixtures/_run/
