# Parity harness image — mirrors the CI "Go Parity" job environment so the golden-corpus
# byte-diff can run locally (and in Docker, per request). It bundles BOTH sides the harness
# drives: the Python 3.14 oracle (with chdb 4.1.9 from requirements.txt) and the Go 1.23
# toolchain that builds + boots the ported server.
#
# The repo is mounted at runtime (so the live worktree code is what gets tested); the pinned
# native libchdb (chdb-core v26.5.0) for the Go side is provided via CHDB_LIB_PATH pointing at
# the mounted .libchdb/ — exactly like CI fetches it into $GITHUB_WORKSPACE/.libchdb.
FROM python:3.14-slim

ARG GO_VERSION=1.23.4
# Default to arm64 so a native build on Apple Silicon avoids qemu; override for x86_64.
ARG GOARCH=arm64

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates git build-essential \
    && rm -rf /var/lib/apt/lists/*

# Go toolchain (matches go/go.mod's `go 1.23`).
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${GOARCH}.tar.gz" -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm /tmp/go.tgz
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"

# Python deps: the app's runtime requirements (incl. chdb 4.1.9, the Python-side oracle engine)
# plus pyyaml (a harness-only dep used by capture_routes.py to read routes.yaml). Copied first so
# this heavy layer is cached independently of the mounted source.
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt pyyaml

WORKDIR /work
CMD ["bash"]
