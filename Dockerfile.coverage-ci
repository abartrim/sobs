# syntax=docker/dockerfile:1
# CI oracle-coverage image: measures which app.py lines the differential corpus exercises, runs the
# structural checks + the coverage floor gate IN-container (fresh process), all as cached layers.
# Ubuntu 26.04 ships Python 3.14 (app.py requires it). No Go/libchdb — coverage uses the chdb wheel.
# Parallel + big container memory (dind) is why this is a Docker build, not a native runner step:
# coverage instrumentation makes each embedded chdb heavier, so the 4Gi runner can't fan out.
FROM ubuntu:26.04 AS coverage
ENV DEBIAN_FRONTEND=noninteractive

# --- layer: OS packages incl. Python 3.14 ---
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates git build-essential \
        python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Parallel capture, brute-forced with resources (migration-only + temporary). cap=0: chdb's
# per-instance memory cap is cgroup-aware and trips under parallelism, so auto-size from container mem.
ARG PARITY_WORKERS=12
ENV SOBS_PARITY_WORKERS=${PARITY_WORKERS} \
    SOBS_CHDB_MAX_SERVER_MB=0

WORKDIR /src
# --- layer: Python deps incl. chdb 4.1.9 wheel + coverage (busts only on requirements.txt) ---
COPY requirements.txt ./
RUN python3 -m pip install --no-cache-dir --break-system-packages -r requirements.txt pyyaml coverage

# --- layer: full repo + structural checks + parallel coverage capture + floor gate ---
COPY . .
RUN python3 migration/tools/structural_checks.py
RUN python3 migration/tools/coverage_capture.py
RUN python3 migration/tools/coverage_gate.py
