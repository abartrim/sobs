{"checklist":[{"id":"sdk","label":"Install & initialise the SDK"},{"id":"collector","label":"Run the OpenTelemetry Collector"},{"id":"verify","label":"Verify data in SOBS"}],"deployment":"docker","env":"dev","language":"python","ok":true,"steps":[{"commands":["pip install opentelemetry-sdk opentelemetry-exporter-otlp opentelemetry-instrumentation"],"description":"Add the core SDK and OTLP exporter to your project.","id":"sdk_install","language":"bash","title":"Install OpenTelemetry Python SDK"},{"commands":["from opentelemetry import trace","from opentelemetry.sdk.trace import TracerProvider","from opentelemetry.sdk.trace.export import BatchSpanProcessor","from opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter","","provider = TracerProvider()","provider.add_span_processor(","    BatchSpanProcessor(OTLPSpanExporter(endpoint=\"http://localhost:4317\", insecure=True))",")","trace.set_tracer_provider(provider)"],"description":"Bootstrap tracing and metrics at startup.","id":"sdk_init","language":"python","title":"Initialise SDK in your application"},{"commands":["# otel-collector-config.yaml","receivers:","  otlp:","    protocols:","      grpc:","        endpoint: 0.0.0.0:4317","      http:","        endpoint: 0.0.0.0:4318","exporters:","  otlphttp:","    endpoint: http://localhost:44317","service:","  pipelines:","    traces:","      receivers: [otlp]","      exporters: [otlphttp]","    metrics:","      receivers: [otlp]","      exporters: [otlphttp]","    logs:","      receivers: [otlp]","      exporters: [otlphttp]"],"description":"Start the contrib collector with a minimal config wired to SOBS.","id":"collector_run","language":"yaml","title":"Run the OpenTelemetry Collector (Docker)"},{"commands":["docker run -d --name otel-collector \\","  -p 4317:4317 -p 4318:4318 \\","  -v $(pwd)/otel-collector-config.yaml:/etc/otelcol-contrib/config.yaml \\","  otel/opentelemetry-collector-contrib:latest"],"description":"Mount the config and expose OTLP ports.","id":"collector_docker_run","language":"bash","title":"Start the collector container"},{"commands":["# Open your browser and navigate to http://localhost:44317/","# The Summary card should show span, log, and metric counts within ~30 s."],"description":"Check the Summary page for incoming telemetry.","id":"sobs_verify","language":"bash","title":"Verify data arrives in SOBS"}],"version":"1"}
