<script>
(function () {
  'use strict';

  var CHART_DATA = [{"chart_spec": {"data": {"attr_fp": "", "limit": 1000, "metric_name": "", "service": "", "signal_name": "trace_volume", "signal_source": "traces", "source_view": "v_derived_signals_anomaly", "window_hours": 6}, "named_queries": [], "sql": {"mode": "raw", "override_sql": "SELECT time, value FROM v_derived_signals_anomaly WHERE service = \u0027web\u0027 ORDER BY time"}, "template_id": "derived_signal_overlay", "visual": {"legend_show": true, "role_map": {}, "smooth_line": true, "value_color": "", "zoom_end_pct": 100, "zoom_inside": true, "zoom_slider": false, "zoom_start_pct": 0}}, "chart_type": "derived_signal_overlay", "id": "d0000000-0000-4000-8000-00000000c001", "options_json": "{\"chart_spec\": {\"template_id\": \"derived_signal_overlay\", \"sql\": {\"mode\": \"raw\", \"override_sql\": \"SELECT time, value FROM v_derived_signals_anomaly WHERE service = \u0027web\u0027 ORDER BY time\"}, \"data\": {\"source_view\": \"v_derived_signals_anomaly\", \"service\": \"\", \"signal_source\": \"traces\", \"signal_name\": \"trace_volume\", \"metric_name\": \"\", \"attr_fp\": \"\", \"window_hours\": 6, \"limit\": 1000}, \"visual\": {\"zoom_inside\": true, \"zoom_slider\": false, \"zoom_start_pct\": 0, \"zoom_end_pct\": 100, \"legend_show\": true, \"smooth_line\": true, \"value_color\": \"\", \"role_map\": {}}, \"named_queries\": []}}", "position": 0, "query": "SELECT time, value FROM v_derived_signals_anomaly WHERE service = \u0027web\u0027 ORDER BY time", "title": "Trace volume overlay"}, {"chart_spec": {"data": {"attr_fp": "", "limit": 1000, "metric_name": "", "service": "", "signal_name": "trace_volume", "signal_source": "traces", "source_view": "v_derived_signals_anomaly", "window_hours": 6}, "named_queries": [], "sql": {"mode": "raw", "override_sql": "SELECT time, value, p95, p99 FROM otel_traces ORDER BY time"}, "template_id": "time_series_percentiles", "visual": {"legend_show": true, "role_map": {}, "smooth_line": true, "value_color": "", "zoom_end_pct": 100, "zoom_inside": true, "zoom_slider": false, "zoom_start_pct": 0}}, "chart_type": "time_series_percentiles", "id": "d0000000-0000-4000-8000-00000000c002", "options_json": "{\"chart_spec\": {\"template_id\": \"time_series_percentiles\", \"sql\": {\"mode\": \"raw\", \"override_sql\": \"SELECT time, value, p95, p99 FROM otel_traces ORDER BY time\"}, \"data\": {\"source_view\": \"v_derived_signals_anomaly\", \"service\": \"\", \"signal_source\": \"traces\", \"signal_name\": \"trace_volume\", \"metric_name\": \"\", \"attr_fp\": \"\", \"window_hours\": 6, \"limit\": 1000}, \"visual\": {\"zoom_inside\": true, \"zoom_slider\": false, \"zoom_start_pct\": 0, \"zoom_end_pct\": 100, \"legend_show\": true, \"smooth_line\": true, \"value_color\": \"\", \"role_map\": {}}, \"named_queries\": []}}", "position": 1, "query": "SELECT time, value, p95, p99 FROM otel_traces ORDER BY time", "title": "Latency percentiles"}];
  var TEMPLATES = [{"default_spec": {"data": {"attr_fp": "", "limit": 1000, "metric_name": "", "service": "", "signal_name": "trace_volume", "signal_source": "traces", "source_view": "v_derived_signals_anomaly", "window_hours": 6}, "sql": {"mode": "builder", "override_sql": ""}, "template_id": "anomaly_overlay", "visual": {"legend_show": true, "role_map": {}, "smooth_line": true, "value_color": "", "zoom_end_pct": 100, "zoom_inside": true, "zoom_slider": false, "zoom_start_pct": 0}}, "description": "Metric with baseline band and per-point anomaly state markers (normal/warning/outlier)", "drilldown": {"bucket_seconds": 60, "label": "Open anomaly details", "target": "metrics", "time_axis": "x"}, "icon": "bi-activity", "id": "anomaly_overlay", "name": "Anomaly Overlay", "query_shape": "Columns: time, value, baseline_mean, baseline_lower, baseline_upper, anomaly_state", "sample_sql": "SELECT\n  time,\n  value,\n  baseline_mean,\n  baseline_lower,\n  baseline_upper,\n  anomaly_state\nFROM v_otel_metrics_anomaly\nWHERE ServiceName = \u0027my-service\u0027\n  AND MetricName = \u0027my.metric\u0027\n  AND time \u003e= now() - INTERVAL 6 HOUR\nORDER BY time"}, {"default_spec": {"data": {"attr_fp": "", "limit": 1000, "metric_name": "", "service": "", "signal_name": "trace_volume", "signal_source": "traces", "source_view": "v_derived_signals_anomaly", "window_hours": 6}, "sql": {"mode": "builder", "override_sql": ""}, "template_id": "box_plot", "visual": {"legend_show": true, "role_map": {}, "smooth_line": true, "value_color": "", "zoom_end_pct": 100, "zoom_inside": true, "zoom_slider": false, "zoom_start_pct": 0}}, "description": "Show distribution, quartiles, and outliers", "drilldown": {"label": "Open traces view", "target": "traces"}, "icon": "bi-boxes", "id": "box_plot", "name": "Distribution Box Plot", "query_shape": "Columns: dimension, min, q1, median, q3, max", "sample_sql": "SELECT\n  HTTPMethod AS dimension,\n  min(Duration) AS min,\n  quantile(0.25)(Duration) AS q1,\n  quantile(0.5)(Duration) AS median,\n  quantile(0.75)(Duration) AS q3,\n  max(Duration) AS max\nFROM otel_traces\nGROUP BY HTTPMethod\nORDER BY median DESC"}, {"default_spec": {"data": {"attr_fp": "", "limit": 1000, "metric_name": "", "service": "", "signal_name": "trace_volume", "signal_source": "traces", "source_view": "v_derived_signals_anomaly", "window_hours": 6}, "sql": {"mode": "raw", "override_sql": "SELECT toDateTime(\u00272024-01-01 00:00:00\u0027) AS time, 1 AS value"}, "template_id": "custom_echarts", "visual": {"custom_mapping_json": "{\"points\": {\"from\": \"rows\"}}", "custom_option_json": "{\"tooltip\": {\"trigger\": \"axis\"}, \"xAxis\": {\"type\": \"time\"}, \"yAxis\": {\"type\": \"value\"}, \"series\": [{\"name\": \"Value\", \"type\": \"line\", \"data\": \"{{points}}\", \"showSymbol\": false, \"smooth\": true}]}", "legend_show": true, "role_map": {}, "smooth_line": true, "value_color": "", "zoom_end_pct": 100, "zoom_inside": true, "zoom_slider": false, "zoom_start_pct": 0}}, "description": "Bring your own SQL, mapping JSON, and raw ECharts option JSON.", "drilldown": null, "icon": "bi-code-slash", "id": "custom_echarts", "name": "Custom ECharts", "query_shape": "Any SELECT result set", "sample_sql": "SELECT toDateTime(\u00272024-01-01 00:00:00\u0027) AS time, 1 AS value"}, {"default_spec": {"data": {"attr_fp": "", "limit": 1000, "metric_name": "", "service": "", "signal_name": "trace_volume", "signal_source": "traces", "source_view": "v_derived_signals_anomaly", "window_hours": 6}, "sql": {"mode": "builder", "override_sql": ""}, "template_id": "derived_signal_overlay", "visual": {"legend_show": true, "role_map": {}, "smooth_line": true, "value_color": "", "zoom_end_pct": 100, "zoom_inside": true, "zoom_slider": false, "zoom_start_pct": 0}}, "description": "At-a-glance signal health view with recent focus, anomaly windows, and status summary", "drilldown": {"bucket_seconds": 60, "label": "Open signal details", "target": "metrics", "time_axis": "x"}, "icon": "bi-soundwave", "id": "derived_signal_overlay", "name": "Derived Signal Overlay", "query_shape": "Columns: time, service, source, signal, attr_fp, value, sample_count, baseline_mean, baseline_lower, baseline_upper, anomaly_state, anomaly_score", "sample_sql": "SELECT\n  time,\n  ServiceName AS service,\n  SignalSource AS source,\n  SignalName AS signal,\n  AttrFingerprint AS attr_fp,\n  value,\n  SampleCount AS sample_count,\n  baseline_mean,\n  baseline_lower,\n  baseline_upper,\n  anomaly_state,\n  anomaly_score\nFROM v_derived_signals_anomaly\nWHERE ServiceName = \u0027trace-svc-0\u0027\n  AND SignalSource = \u0027traces\u0027\n  AND SignalName = \u0027latency_p95_ms\u0027\n  AND time \u003e= now() - INTERVAL 6 HOUR\nORDER BY time"}, {"default_spec": {"data": {"attr_fp": "", "limit": 1000, "metric_name": "", "service": "", "signal_name": "trace_volume", "signal_source": "traces", "source_view": "v_derived_signals_anomaly", "window_hours": 6}, "sql": {"mode": "builder", "override_sql": ""}, "template_id": "dual_axis_anomaly", "visual": {"legend_show": true, "role_map": {}, "smooth_line": true, "value_color": "", "zoom_end_pct": 100, "zoom_inside": true, "zoom_slider": false, "zoom_start_pct": 0}}, "description": "Compare metric vs anomaly detection signal on dual axes", "drilldown": {"bucket_seconds": 60, "extra": {"analyze": "1", "stats": "1"}, "label": "Open source logs", "target": "logs", "time_axis": "x"}, "icon": "bi-graph-up-arrow", "id": "dual_axis_anomaly", "name": "Metric + Anomaly Score", "query_shape": "Columns: time, metric, anomaly_score", "sample_sql": "SELECT\n  time,\n  value AS metric,\n  anomaly_score\nFROM v_otel_metrics_anomaly\nWHERE ServiceName = \u0027my-service\u0027\n  AND MetricName = \u0027my.metric\u0027\n  AND time \u003e= now() - INTERVAL 1 HOUR\nORDER BY time"}, {"default_spec": {"data": {"attr_fp": "", "limit": 1000, "metric_name": "", "service": "", "signal_name": "trace_volume", "signal_source": "traces", "source_view": "v_derived_signals_anomaly", "window_hours": 6}, "sql": {"mode": "builder", "override_sql": ""}, "template_id": "gauge_kpi", "visual": {"legend_show": true, "role_map": {}, "smooth_line": true, "value_color": "", "zoom_end_pct": 100, "zoom_inside": true, "zoom_slider": false, "zoom_start_pct": 0}}, "description": "Single-value gauge for KPI monitoring (SLA %, uptime %)", "drilldown": {"label": "Open source traces", "target": "traces"}, "icon": "bi-speedometer", "id": "gauge_kpi", "name": "KPI Gauge", "query_shape": "Columns: single numeric value", "sample_sql": "SELECT\n  round(100.0 * countIf(StatusCode = \u0027STATUS_CODE_OK\u0027) / count(), 2) AS value\nFROM otel_traces\nWHERE Timestamp \u003e now() - interval 1 hour"}, {"default_spec": {"data": {"attr_fp": "", "limit": 1000, "metric_name": "", "service": "", "signal_name": "trace_volume", "signal_source": "traces", "source_view": "v_derived_signals_anomaly", "window_hours": 6}, "sql": {"mode": "builder", "override_sql": ""}, "template_id": "heatmap", "visual": {"legend_show": true, "role_map": {}, "smooth_line": true, "value_color": "", "zoom_end_pct": 100, "zoom_inside": true, "zoom_slider": false, "zoom_start_pct": 0}}, "description": "2D heatmap for correlating errors across dimensions", "drilldown": {"bucket_seconds": 300, "label": "Open source traces", "service_axis": "x", "target": "traces", "time_axis": "y"}, "icon": "bi-fire", "id": "heatmap", "name": "Heatmap", "query_shape": "Columns: x category, y time bucket, numeric value", "sample_sql": "SELECT\n  ServiceName AS x_category,\n  toStartOfFiveMinutes(Timestamp) AS y_category,\n  round(100.0 * countIf(StatusCode = \u0027STATUS_CODE_ERROR\u0027) / count(), 2) AS value\nFROM otel_traces\nGROUP BY ServiceName, y_category\nORDER BY ServiceName, y_category"}, {"default_spec": {"data": {"attr_fp": "", "limit": 1000, "metric_name": "", "service": "", "signal_name": "trace_volume", "signal_source": "traces", "source_view": "v_derived_signals_anomaly", "window_hours": 6}, "sql": {"mode": "builder", "override_sql": ""}, "template_id": "time_series_percentiles", "visual": {"legend_show": true, "role_map": {}, "smooth_line": true, "value_color": "", "zoom_end_pct": 100, "zoom_inside": true, "zoom_slider": false, "zoom_start_pct": 0}}, "description": "Show metric with percentile bands for anomaly detection", "drilldown": {"bucket_seconds": 60, "label": "Open source traces", "target": "traces", "time_axis": "x"}, "icon": "bi-graph-up", "id": "time_series_percentiles", "name": "Time Series with Normal Range", "query_shape": "Columns: time, value, p95, p99", "sample_sql": "SELECT\n  toStartOfMinute(Timestamp) AS time,\n  avg(Duration) AS value,\n  quantile(0.95)(Duration) AS p95,\n  quantile(0.99)(Duration) AS p99\nFROM otel_traces\nGROUP BY time\nORDER BY time"}];
  var queryRenderUrl = "/api/dashboards/render";
  var specCompileUrl = "/api/dashboards/spec/compile";
  var specDryRunUrl = "/api/dashboards/spec/dry-run";
  var specValidateUrl = "/api/dashboards/spec/validate";
  var specRenderUrl = "/api/dashboards/spec/render";
  var specOptionsUrl = "/api/dashboards/spec/options";
  var aiAskUrl = "/api/dashboards/spec/ai-build";
  var importChartUrl = "/api/dashboards/d0000000-0000-4000-8000-00000000d001/charts/import";
  var templatesMap = {};
  TEMPLATES.forEach(function (t) { templatesMap[t.id] = t; });
  var sourceUrls = {
    logs: "/logs",
    metrics: "/metrics/anomaly",
    traces: "/traces",
    errors: "/errors"
  };

  function extractWhereLiteral(query, fieldName) {
    if (!query || !fieldName) return '';
    var re = new RegExp(fieldName + "\\s*=\\s*'([^']+)'", 'i');
    var m = String(query).match(re);
    return m && m[1] ? m[1] : '';
  }

  function axisData(option, axisName) {
    var axis = option[axisName];
    if (!axis) return [];
    if (Array.isArray(axis)) {
      return axis[0] && Array.isArray(axis[0].data) ? axis[0].data : [];
    }
    return Array.isArray(axis.data) ? axis.data : [];
  }

  function buildDrilldownUrl(drilldown, chartInstance, params) {
    if (!drilldown || !sourceUrls[drilldown.target]) return null;

    var url = new URL(sourceUrls[drilldown.target], window.location.origin);
    var option = chartInstance.getOption();
    var pointDrilldown = params && params.data && params.data.drilldown ? params.data.drilldown : null;

    if (pointDrilldown) {
      Object.keys(pointDrilldown).forEach(function (key) {
        if (pointDrilldown[key] !== undefined && pointDrilldown[key] !== null && pointDrilldown[key] !== '') {
          url.searchParams.set(key, String(pointDrilldown[key]));
        }
      });
    }

    function categoryValue(axisName, index) {
      var data = axisData(option, axisName);
      return data && data[index] !== undefined ? data[index] : '';
    }

    if (drilldown.time_axis && !url.searchParams.get('from_ts') && params) {
      var fromValue = '';
      if (params.componentSubType === 'heatmap' && Array.isArray(params.value)) {
        fromValue = drilldown.time_axis === 'x' ? categoryValue('xAxis', params.value[0]) : categoryValue('yAxis', params.value[1]);
      } else {
        fromValue = params.name || '';
      }
      if (fromValue) {
        url.searchParams.set('from_ts', String(fromValue));
        if (drilldown.bucket_seconds) {
          url.searchParams.set('window_s', String(drilldown.bucket_seconds));
        }
      }
    }

    if (!url.searchParams.get('service') && drilldown.service_axis && params && params.componentSubType === 'heatmap' && Array.isArray(params.value)) {
      var serviceValue = drilldown.service_axis === 'x' ? categoryValue('xAxis', params.value[0]) : categoryValue('yAxis', params.value[1]);
      if (serviceValue) {
        url.searchParams.set('service', String(serviceValue));
      }
    }

    if (drilldown.extra) {
      Object.keys(drilldown.extra).forEach(function (key) {
        url.searchParams.set(key, String(drilldown.extra[key]));
      });
    }

    return url.toString();
  }

  function buildTemplateExample(t) {
    if (!t) return '';
    var parts = [];
    if (t.query_shape) {
      parts.push('Expected query shape: ' + t.query_shape);
    }
    if (t.drilldown) {
      parts.push('Drilldown: ' + (t.drilldown.label || 'open source data') + '.');
    }
    return parts.join(' ');
  }

  function pointNumericValue(p) {
    if (!p) return null;
    var v = p.value;
    if (Array.isArray(v)) {
      return v.length > 1 ? v[1] : v[0];
    }
    if (p.data && Array.isArray(p.data.value)) {
      return p.data.value.length > 1 ? p.data.value[1] : p.data.value[0];
    }
    return v;
  }

  /* ── Anomaly badge helper ── */
  var _ANOMALY_STATE_COLOR = {
    outlier: '#dc3545',
    warning: '#ffc107',
    normal:  '#28a745',
  };
  var _ANOMALY_BADGE = {
    outlier: { cls: 'bg-danger',  label: '⚠ Outlier' },
    warning: { cls: 'bg-warning text-dark', label: '⚡ Warning' },
    normal:  { cls: 'bg-success', label: '✓ Normal' },
  };

  function updateAnomalyBadge(chartId, states) {
    var badge = document.getElementById('anomaly-badge-' + chartId);
    if (!badge || !states || !states.length) return;
    var worst = 'normal';
    for (var i = 0; i < states.length; i++) {
      var s = states[i];
      if (s === 'outlier') { worst = 'outlier'; break; }
      if (s === 'warning') worst = 'warning';
    }
    var info = _ANOMALY_BADGE[worst] || _ANOMALY_BADGE['normal'];
    badge.className = 'badge ' + info.cls;
    badge.textContent = info.label;
    badge.title = 'Latest anomaly state: ' + worst + ' (' + states.filter(function (s) { return s !== 'normal'; }).length + ' flagged points)';
    badge.classList.remove('d-none');
  }

  function extractAnomalyStates(option) {
    // For anomaly_overlay: the value series carries per-point itemStyle color info.
    // Look for an anomaly_state list stored in option._anomalyStates (injected below).
    return option._anomalyStates || null;
  }

  /* ── Render existing charts ── */
  function renderChart(chartCfg) {
    var el = document.getElementById('chart-' + chartCfg.id);
    var hintEl = document.getElementById('chart-hint-' + chartCfg.id);
    var sourceBtn = document.getElementById('chart-source-btn-' + chartCfg.id);
    if (!el) return;
    var ec = echarts.init(el, (window.SOBS && SOBS.echartsTheme) ? SOBS.echartsTheme() : null);
    ec.showLoading({ text: 'Loading…', color: (window.SOBS && SOBS.cssVar) ? SOBS.cssVar('--bs-primary') : '#0d6efd', textColor: (window.SOBS && SOBS.cssVar) ? SOBS.cssVar('--bs-secondary-color') : '#adb5bd', maskColor: 'rgba(128,128,128,0.2)' });

    // Use ChartSpec render endpoint as the single chart model.
    fetch(specRenderUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ spec: chartCfg.chart_spec })
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        ec.hideLoading();
        if (data.error) {
          ec.setOption({ title: { text: 'Error: ' + data.error, left: 'center', top: 'center', textStyle: { color: '#dc3545', fontSize: 12 } } });
          if (hintEl) { hintEl.textContent = ''; }
          return;
        }

        var option = data.option;
        if (data.query) {
          chartCfg.query = data.query;
        }

        // Anomaly overlay: annotate per-point items with tooltip showing why-flagged detail
        if ((chartCfg.chart_type === 'anomaly_overlay' || chartCfg.chart_type === 'derived_signal_overlay') && option && option.series) {
          var valueSeries = null;
          for (var si = 0; si < option.series.length; si++) {
            if (option.series[si].name === 'Value') { valueSeries = option.series[si]; break; }
          }
          if (valueSeries && Array.isArray(valueSeries.data)) {
            var anomalyStates = [];
            valueSeries.data = valueSeries.data.map(function (pt) {
              var dd = pt && pt.drilldown ? pt.drilldown : null;
              var state = (chartCfg.chart_type === 'derived_signal_overlay'
                ? ((dd && dd._effective_state) || (dd && dd._anomaly_state) || 'normal')
                : ((dd && dd._anomaly_state) || 'normal'));
              anomalyStates.push(state);
              return pt;
            });
            // Store states for badge computation; also expose via tooltip
            option._anomalyStates = anomalyStates;
            option.tooltip = option.tooltip || {};
            option.tooltip.formatter = function (params) {
              var lines = [params[0] && params[0].axisValueLabel || ''];
              params.forEach(function (p) {
                var extra = '';
                if (p.seriesName === 'Value' && p.data && p.data.drilldown) {
                  var dd = p.data.drilldown;
                  var st = (chartCfg.chart_type === 'derived_signal_overlay'
                    ? (dd._effective_state || dd._anomaly_state || 'normal')
                    : (dd._anomaly_state || 'normal'));
                  var score = dd._anomaly_score != null ? dd._anomaly_score.toFixed(2) : '—';
                  var stColor = _ANOMALY_STATE_COLOR[st] || '#adb5bd';
                  extra = ' <span style="color:' + stColor + '">● ' + st + ' (z=' + score + ')</span>';
                  if (chartCfg.chart_type === 'derived_signal_overlay') {
                    var statState = dd._anomaly_state || 'normal';
                    var ruleState = dd._rule_state || 'normal';
                    var ruleName = dd._rule_name || '';
                    var ruleReason = dd._rule_reason || '';
                    extra += '<br/><span class="text-secondary">stat=' + statState + ', rule=' + ruleState + '</span>';
                    if (ruleName) {
                      extra += '<br/><span class="text-warning">' + ruleName + '</span>';
                    }
                    if (ruleReason) {
                      extra += '<br/><span class="text-secondary">' + ruleReason + '</span>';
                    }
                  }
                }
                var pv = pointNumericValue(p);
                lines.push('<b>' + p.seriesName + '</b>: ' + (pv != null ? pv : '—') + extra);
              });
              return lines.join('<br/>');
            };
            updateAnomalyBadge(chartCfg.id, anomalyStates);
          }
        }

        ec.setOption(option);

        var template = templatesMap[chartCfg.chart_type];
        var drilldown = template && template.drilldown ? template.drilldown : (option && option._customDrilldown ? option._customDrilldown : null);
        if (drilldown) {
          var dd = Object.assign({}, drilldown);
          dd.extra = Object.assign({}, dd.extra || {});
          // Populate service/metric defaults so anomaly details can query the view directly.
          var queryService = extractWhereLiteral(chartCfg.query, 'ServiceName');
          var queryMetric = extractWhereLiteral(chartCfg.query, 'MetricName');
          var querySource = extractWhereLiteral(chartCfg.query, 'SignalSource');
          var querySignal = extractWhereLiteral(chartCfg.query, 'SignalName');
          var queryAttrFp = extractWhereLiteral(chartCfg.query, 'AttrFingerprint');
          if (queryService && !dd.extra.service) dd.extra.service = queryService;
          if (queryMetric && !dd.extra.metric) dd.extra.metric = queryMetric;
          if (querySource && !dd.extra.source) dd.extra.source = querySource;
          if (querySignal && !dd.extra.signal) dd.extra.signal = querySignal;
          if (queryAttrFp && !dd.extra.attr_fp) dd.extra.attr_fp = queryAttrFp;

          var baseSourceUrl = buildDrilldownUrl(dd, ec);
          el.style.cursor = 'pointer';
          if (hintEl) {
            hintEl.textContent = 'Click chart data to ' + (dd.label || 'open source data') + '.';
          }
          if (sourceBtn && baseSourceUrl) {
            sourceBtn.href = baseSourceUrl;
            sourceBtn.classList.remove('d-none');
            sourceBtn.title = dd.label || 'Open source data';
          }
          ec.on('click', function (params) {
            var targetUrl = buildDrilldownUrl(dd, ec, params);
            if (targetUrl && sourceBtn) {
              sourceBtn.href = targetUrl;
              sourceBtn.classList.remove('d-none');
            }
            if (targetUrl) {
              window.location.assign(targetUrl);
            }
          });
        } else {
          el.style.cursor = 'default';
          if (hintEl) {
            hintEl.textContent = '';
          }
          if (sourceBtn) {
            sourceBtn.classList.add('d-none');
            sourceBtn.removeAttribute('href');
          }
        }
      })
      .catch(function (err) {
        ec.hideLoading();
        ec.setOption({ title: { text: 'Network error', left: 'center', top: 'center', textStyle: { color: '#dc3545' } } });
      });

    window.addEventListener('resize', function () { ec.resize(); });
  }

  CHART_DATA.forEach(renderChart);

  /* ── Auto-refresh interval ── */
  var _refreshTimer = null;
  var _countdownTimer = null;
  var _countdownRemaining = 0;
  var refreshIntervalSelect = document.getElementById('refreshIntervalSelect');
  var refreshIntervalSelectMobile = document.getElementById('refreshIntervalSelectMobile');
  var dashboardRefreshModal = document.getElementById('dashboardRefreshModal');
  var refreshCountdown = document.getElementById('refreshCountdown');

  function refreshAllCharts() {
    CHART_DATA.forEach(function (cfg) {
      var el = document.getElementById('chart-' + cfg.id);
      if (el) {
        var existing = echarts.getInstanceByDom(el);
        if (existing) existing.dispose();
      }
    });
    CHART_DATA.forEach(renderChart);
  }

  function _tickCountdown() {
    _countdownRemaining -= 1;
    if (_countdownRemaining <= 0) {
      _countdownRemaining = parseInt(refreshIntervalSelect.value, 10);
    }
    if (refreshCountdown) {
      var s = _countdownRemaining;
      refreshCountdown.textContent = s >= 60 ? Math.ceil(s / 60) + 'm' : s + 's';
    }
  }

  function applyRefreshInterval() {
    if (_refreshTimer) { clearInterval(_refreshTimer); _refreshTimer = null; }
    if (_countdownTimer) { clearInterval(_countdownTimer); _countdownTimer = null; }
    var sec = parseInt(refreshIntervalSelect.value, 10);
    if (refreshCountdown) {
      if (sec > 0) {
        _countdownRemaining = sec;
        refreshCountdown.textContent = sec >= 60 ? Math.ceil(sec / 60) + 'm' : sec + 's';
        refreshCountdown.style.display = '';
      } else {
        refreshCountdown.style.display = 'none';
        refreshCountdown.textContent = '';
      }
    }
    if (sec > 0) {
      _countdownTimer = setInterval(_tickCountdown, 1000);
      _refreshTimer = setInterval(function () {
        _countdownRemaining = sec;
        if (refreshCountdown) refreshCountdown.textContent = sec >= 60 ? Math.ceil(sec / 60) + 'm' : sec + 's';
        refreshAllCharts();
      }, sec * 1000);
    }
  }

  if (refreshIntervalSelect) {
    var _storageKey = 'sobs_dash_refresh_d0000000-0000-4000-8000-00000000d001';
    refreshIntervalSelect.addEventListener('change', function () {
      localStorage.setItem(_storageKey, refreshIntervalSelect.value);
      if (refreshIntervalSelectMobile) {
        refreshIntervalSelectMobile.value = refreshIntervalSelect.value;
      }
      applyRefreshInterval();
    });

    if (refreshIntervalSelectMobile) {
      refreshIntervalSelectMobile.value = refreshIntervalSelect.value;
      refreshIntervalSelectMobile.addEventListener('change', function () {
        if (refreshIntervalSelect.value !== refreshIntervalSelectMobile.value) {
          refreshIntervalSelect.value = refreshIntervalSelectMobile.value;
          refreshIntervalSelect.dispatchEvent(new Event('change'));
        }
      });
    }

    if (dashboardRefreshModal) {
      dashboardRefreshModal.addEventListener('show.bs.modal', function () {
        if (refreshIntervalSelectMobile) {
          refreshIntervalSelectMobile.value = refreshIntervalSelect.value;
        }
      });
    }

    var _savedInterval = localStorage.getItem(_storageKey);
    if (_savedInterval && _savedInterval !== '0') {
      refreshIntervalSelect.value = _savedInterval;
      if (refreshIntervalSelectMobile) {
        refreshIntervalSelectMobile.value = _savedInterval;
      }
      applyRefreshInterval();
    }
  }

  /* ── Template selector: update description ── */
  var templateSelect = document.getElementById('templateSelect');
  var templateDesc = document.getElementById('templateDesc');
  var columnHint = document.getElementById('columnHint');
  var addChartModal = document.getElementById('addChartModal');
  var addChartForm = document.getElementById('chartEditorForm');
  var chartEditorModalTitle = document.getElementById('chartEditorModalTitle');
  var chartEditorSubmitBtn = document.getElementById('chartEditorSubmitBtn');
  var chartTitleInput = document.getElementById('chartTitleInput');
  var chartSqlCopyBtn = document.getElementById('chartSqlCopyBtn');
  var chartSqlModal = document.getElementById('chartSqlModal');
  var chartSqlModalTitle = document.getElementById('chartSqlModalTitle');
  var chartSqlModalMeta = document.getElementById('chartSqlModalMeta');
  var chartSqlModalBody = document.getElementById('chartSqlModalBody');
  var defaultChartFormAction = addChartForm ? addChartForm.getAttribute('action') : '';
  var queryInput = document.getElementById('queryInput');
  var chartSpecJson = document.getElementById('chartSpecJson');
  var sqlModeSelect = document.getElementById('sqlModeSelect');
  var sourceViewInput = document.getElementById('sourceViewInput');
  var builderFieldsWrap = document.getElementById('builderFieldsWrap');
  var rawSqlModeHint = document.getElementById('rawSqlModeHint');
  var serviceInput = document.getElementById('serviceInput');
  var serviceOptionsList = document.getElementById('serviceOptionsList');
  var signalSourceInput = document.getElementById('signalSourceInput');
  var signalNameInput = document.getElementById('signalNameInput');
  var signalOptionsList = document.getElementById('signalOptionsList');
  var metricNameInput = document.getElementById('metricNameInput');
  var metricOptionsList = document.getElementById('metricOptionsList');
  var attrFpInput = document.getElementById('attrFpInput');
  var windowHoursInput = document.getElementById('windowHoursInput');
  var limitInput = document.getElementById('limitInput');
  var compileSpecBtn = document.getElementById('compileSpecBtn');
  var dryRunSpecBtn = document.getElementById('dryRunSpecBtn');
  var compiledSql = document.getElementById('compiledSql');
  var specValidationMsg = document.getElementById('specValidationMsg');
  var dryRunMeta = document.getElementById('dryRunMeta');
  var dryRunTableWrap = document.getElementById('dryRunTableWrap');
  var dryRunTable = document.getElementById('dryRunTable');
  var roleMapEditorWrap = document.getElementById('roleMapEditorWrap');
  var roleMapEditor = document.getElementById('roleMapEditor');
  var roleMapHelp = document.getElementById('roleMapHelp');
  var customEchartsFields = document.getElementById('customEchartsFields');
  var customMappingJsonInput = document.getElementById('customMappingJsonInput');
  var customOptionJsonInput = document.getElementById('customOptionJsonInput');
  var customDrilldownPresetBtn = document.getElementById('customDrilldownPresetBtn');
  var standardVisualControls = document.getElementById('standardVisualControls');
  var derivedSignalBuilderFields = document.getElementById('derivedSignalBuilderFields');
  var metricBuilderFields = document.getElementById('metricBuilderFields');
  var legendShowInput = document.getElementById('legendShowInput');
  var smoothLineInput = document.getElementById('smoothLineInput');
  var zoomInsideInput = document.getElementById('zoomInsideInput');
  var zoomSliderInput = document.getElementById('zoomSliderInput');
  var zoomStartInput = document.getElementById('zoomStartInput');
  var zoomEndInput = document.getElementById('zoomEndInput');
  var valueColorInput = document.getElementById('valueColorInput');
  var lastDryRunColumns = [];
  var lastDryRunColumnTypes = [];
  var roleMapState = {};
  var suppressRoleMapReset = false;
  // Named queries state: array of {name, sql, purpose}
  var namedQueriesState = [];
  // AI builder elements
  var aiBuilderQuestion = document.getElementById('aiBuilderQuestion');
  var aiBuilderChartType = document.getElementById('aiBuilderChartType');
  var aiBuilderInstruction = document.getElementById('aiBuilderInstruction');
  var aiBuilderBuildBtn = document.getElementById('aiBuilderBuildBtn');
  var aiBuilderSpinner = document.getElementById('aiBuilderSpinner');
  var aiBuilderStatus = document.getElementById('aiBuilderStatus');
  // Named queries elements
  var namedQueriesSection = document.getElementById('namedQueriesSection');
  var namedQueriesList = document.getElementById('namedQueriesList');
  var addNamedQueryBtn = document.getElementById('addNamedQueryBtn');
  // Import chart elements
  var importChartFileInput = document.getElementById('importChartFileInput');
  var importChartTitleInput = document.getElementById('importChartTitleInput');
  var importChartSubmitBtn = document.getElementById('importChartSubmitBtn');
  var importChartStatus = document.getElementById('importChartStatus');
  var importChartModal = document.getElementById('importChartModal');

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatSql(sql) {
    var raw = String(sql || '').replace(/\r\n/g, '\n').trim();
    if (!raw) return '';
    var normalized = raw.replace(/\s+/g, ' ');
    var clauseKeywords = [
      'SELECT', 'FROM', 'WHERE', 'GROUP BY', 'HAVING', 'ORDER BY', 'LIMIT', 'OFFSET',
      'WITH', 'UNION ALL', 'UNION', 'INNER JOIN', 'LEFT JOIN', 'RIGHT JOIN', 'FULL JOIN',
      'CROSS JOIN', 'JOIN'
    ];
    clauseKeywords.forEach(function (keyword) {
      var pattern = new RegExp('\\s+' + keyword.replace(/ /g, '\\s+') + '\\b', 'gi');
      normalized = normalized.replace(pattern, '\n' + keyword);
    });
    normalized = normalized
      .replace(/\b(AND|OR)\b/gi, '\n  $1')
      .replace(/,\s*(?![^()]*\))/g, ',\n  ')
      .replace(/\n{2,}/g, '\n')
      .trim();
    return normalized;
  }

  /* ── Named Queries UI ── */

  function readNamedQueryInputs() {
    var result = [];
    if (!namedQueriesList) return result;
    namedQueriesList.querySelectorAll('.named-query-entry').forEach(function (entry) {
      var nameEl = entry.querySelector('.nq-name');
      var sqlEl = entry.querySelector('.nq-sql');
      var purposeEl = entry.querySelector('.nq-purpose');
      var name = nameEl ? nameEl.value.trim().toLowerCase() : '';
      var sql = sqlEl ? sqlEl.value.trim() : '';
      var purpose = purposeEl ? purposeEl.value.trim() : '';
      if (name && sql) {
        result.push({ name: name, sql: sql, purpose: purpose });
      }
    });
    namedQueriesState = result;
    return result;
  }

  function renderNamedQueriesEditor(queries) {
    if (!namedQueriesList) return;
    namedQueriesList.innerHTML = '';
    (queries || []).forEach(function (nq, idx) {
      namedQueriesList.appendChild(createNamedQueryRow(nq, idx));
    });
  }

  function createNamedQueryRow(nq, idx) {
    var div = document.createElement('div');
    div.className = 'named-query-entry border rounded p-2 position-relative';
    div.style.background = 'var(--bs-tertiary-bg)';
    var label = 'Query #' + (idx + 1);
    div.innerHTML = ''
      + '<div class="d-flex align-items-center gap-2 mb-1">'
      + '  <input type="text" class="form-control form-control-sm font-monospace nq-name" style="max-width:140px;" placeholder="name (snake_case)" value="' + escapeHtml(nq ? nq.name : '') + '">'
      + '  <input type="text" class="form-control form-control-sm nq-purpose" placeholder="purpose (optional)" value="' + escapeHtml(nq ? nq.purpose : '') + '">'
      + '  <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 nq-remove-btn ms-auto" title="Remove named query"><i class="bi bi-x"></i></button>'
      + '</div>'
      + '<textarea class="form-control form-control-sm font-monospace nq-sql" rows="3" placeholder="SELECT ..."></textarea>';
    var sqlEl = div.querySelector('.nq-sql');
    if (sqlEl && nq && nq.sql) sqlEl.value = nq.sql;
    var removeBtn = div.querySelector('.nq-remove-btn');
    if (removeBtn) {
      removeBtn.addEventListener('click', function () {
        div.remove();
        readNamedQueryInputs();
      });
    }
    return div;
  }

  /* ── AI Chart Builder ── */

  function runAiBuild() {
    var question = aiBuilderQuestion ? aiBuilderQuestion.value.trim() : '';
    if (!question) {
      if (aiBuilderStatus) { aiBuilderStatus.textContent = 'Please enter a chart description.'; aiBuilderStatus.className = 'small text-danger'; }
      return;
    }
    if (aiBuilderSpinner) aiBuilderSpinner.classList.remove('d-none');
    if (aiBuilderBuildBtn) aiBuilderBuildBtn.disabled = true;
    if (aiBuilderStatus) { aiBuilderStatus.textContent = 'Generating chart…'; aiBuilderStatus.className = 'small text-secondary'; }

    var payload = {
      question: question,
      preferred_chart_type: aiBuilderChartType ? aiBuilderChartType.value : '',
      chart_instruction: aiBuilderInstruction ? aiBuilderInstruction.value.trim() : '',
      thinking_level: 'off'
    };

    fetch(aiAskUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
      .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
      .then(function (res) {
        if (aiBuilderSpinner) aiBuilderSpinner.classList.add('d-none');
        if (aiBuilderBuildBtn) aiBuilderBuildBtn.disabled = false;
        if (!res.ok || !res.body.ok) {
          var errMsg = (res.body && res.body.error) ? res.body.error : 'AI build failed';
          if (aiBuilderStatus) { aiBuilderStatus.textContent = 'Error: ' + errMsg; aiBuilderStatus.className = 'small text-danger'; }
          return;
        }
        var body = res.body;
        // Populate editor from AI result
        var spec = body.spec || {};
        var visual = spec.visual || {};
        // Set title if empty
        if (chartTitleInput && !chartTitleInput.value.trim()) {
          // Use question as default title (truncated)
          chartTitleInput.value = question.length > 60 ? question.slice(0, 57) + '…' : question;
        }
        // Switch to custom_echarts + raw SQL mode
        if (templateSelect) templateSelect.value = 'custom_echarts';
        if (sqlModeSelect) sqlModeSelect.value = 'raw';
        if (queryInput && body.sql) queryInput.value = body.sql;
        if (customOptionJsonInput && visual.custom_option_json) {
          var opt = visual.custom_option_json;
          try {
            var parsed = typeof opt === 'string' ? JSON.parse(opt) : opt;
            customOptionJsonInput.value = JSON.stringify(parsed, null, 2);
          } catch (_) {
            customOptionJsonInput.value = typeof opt === 'string' ? opt : JSON.stringify(opt, null, 2);
          }
        }
        if (customMappingJsonInput) customMappingJsonInput.value = visual.custom_mapping_json || '{}';
        // Restore named queries
        var nqs = Array.isArray(body.named_queries) ? body.named_queries : [];
        namedQueriesState = nqs;
        renderNamedQueriesEditor(nqs);
        // Update visibility and info
        suppressRoleMapReset = true;
        updateTemplateInfo();
        suppressRoleMapReset = false;
        refreshBuilderVisibility();
        var statusMsg = body.chart_error
          ? 'SQL generated. A fallback eCharts option was populated; review and adjust before adding the chart.'
          : 'Chart generated! SQL and eCharts option have been populated. Review and adjust, then add the chart.';
        var statusClass = body.chart_error ? 'small text-warning' : 'small text-success';
        var namedResults = Array.isArray(body.named_query_results) ? body.named_query_results : [];
        var failedNamed = namedResults.filter(function (item) { return item && item.error; });
        if (body.chart_error) statusMsg += ' (Note: ' + body.chart_error + ')';
        if (failedNamed.length) {
          statusMsg += ' (' + failedNamed.length + ' named quer' + (failedNamed.length === 1 ? 'y' : 'ies') + ' failed validation/execution and were excluded from the generated spec.)';
          statusClass = 'small text-warning';
        }
        if (aiBuilderStatus) { aiBuilderStatus.textContent = statusMsg; aiBuilderStatus.className = statusClass; }
      })
      .catch(function (err) {
        if (aiBuilderSpinner) aiBuilderSpinner.classList.add('d-none');
        if (aiBuilderBuildBtn) aiBuilderBuildBtn.disabled = false;
        if (aiBuilderStatus) { aiBuilderStatus.textContent = 'Network error: ' + err; aiBuilderStatus.className = 'small text-danger'; }
      });
  }

  /* ── Chart Import ── */

  function runChartImport() {
    if (!importChartFileInput || !importChartFileInput.files || !importChartFileInput.files.length) {
      if (importChartStatus) { importChartStatus.textContent = 'Please select a JSON file.'; importChartStatus.className = 'small text-danger'; }
      return;
    }
    var file = importChartFileInput.files[0];
    var reader = new FileReader();
    reader.onload = function (evt) {
      var text = evt.target.result;
      var payload;
      try {
        payload = JSON.parse(text);
      } catch (_) {
        if (importChartStatus) { importChartStatus.textContent = 'Invalid JSON file.'; importChartStatus.className = 'small text-danger'; }
        return;
      }
      // Override title if user specified one
      var titleOverride = importChartTitleInput ? importChartTitleInput.value.trim() : '';
      if (titleOverride) payload.title = titleOverride;

      if (importChartSubmitBtn) importChartSubmitBtn.disabled = true;
      if (importChartStatus) { importChartStatus.textContent = 'Importing…'; importChartStatus.className = 'small text-secondary'; }

      fetch(importChartUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
        .then(function (res) {
          if (importChartSubmitBtn) importChartSubmitBtn.disabled = false;
          if (!res.ok || !res.body.ok) {
            var errMsg = (res.body && res.body.error) ? res.body.error : 'Import failed';
            if (importChartStatus) { importChartStatus.textContent = 'Error: ' + errMsg; importChartStatus.className = 'small text-danger'; }
            return;
          }
          // Redirect to dashboard to see the new chart
          window.location.href = res.body.dashboard_url || window.location.href;
        })
        .catch(function (err) {
          if (importChartSubmitBtn) importChartSubmitBtn.disabled = false;
          if (importChartStatus) { importChartStatus.textContent = 'Network error: ' + err; importChartStatus.className = 'small text-danger'; }
        });
    };
    reader.readAsText(file);
  }

  function readRoleMapInputs() {
    var next = {};
    if (!roleMapEditor) return next;
    var selects = roleMapEditor.querySelectorAll('select[data-role]');
    selects.forEach(function (sel) {
      var role = sel.getAttribute('data-role') || '';
      var mapped = sel.value || '';
      if (role && mapped) next[role] = mapped;
    });
    roleMapState = next;
    return next;
  }

  function pickDefaultRoleColumn(role, roleIndex, columns) {
    if (roleMapState && roleMapState[role]) {
      return roleMapState[role];
    }
    if (!columns || !columns.length) {
      return '';
    }
    for (var i = 0; i < columns.length; i++) {
      if (String(columns[i]).toLowerCase() === String(role).toLowerCase()) {
        return columns[i];
      }
    }
    if (typeof roleIndex === 'number' && roleIndex >= 0 && roleIndex < columns.length) {
      return columns[roleIndex];
    }
    return '';
  }

  function renderRoleMapEditor(columns, columnTypes) {
    if (!roleMapEditorWrap || !roleMapEditor) return;
    var t = templatesMap[templateSelect && templateSelect.value ? templateSelect.value : ''];
    if (t && t.id === 'custom_echarts') {
      roleMapEditorWrap.style.display = 'none';
      roleMapEditor.innerHTML = '';
      if (roleMapHelp) roleMapHelp.textContent = '';
      return;
    }
    var roleDefs = t && t.column_roles ? t.column_roles : null;
    var colList = Array.isArray(columns) ? columns : [];
    var typeList = Array.isArray(columnTypes) ? columnTypes : [];

    if (!roleDefs || !Object.keys(roleDefs).length || !colList.length) {
      roleMapEditorWrap.style.display = 'none';
      roleMapEditor.innerHTML = '';
      if (roleMapHelp) roleMapHelp.textContent = '';
      return;
    }

    var html = '';
    Object.keys(roleDefs).forEach(function (role) {
      var expectedIdx = Number(roleDefs[role]);
      var selected = pickDefaultRoleColumn(role, expectedIdx, colList);
      var optionsHtml = '<option value="">(unmapped)</option>' + colList.map(function (colName, idx) {
        var selectedAttr = selected === colName ? ' selected' : '';
        var typeLabel = typeList[idx] ? ' [' + String(typeList[idx]) + ']' : '';
        return '<option value="' + escapeHtml(colName) + '"' + selectedAttr + '>' + escapeHtml(colName + typeLabel) + '</option>';
      }).join('');
      html += '<div class="row g-2 align-items-center">'
        + '<div class="col-4 small text-secondary">' + escapeHtml(role) + '</div>'
        + '<div class="col-8"><select class="form-select form-select-sm" data-role="' + escapeHtml(role) + '">' + optionsHtml + '</select></div>'
        + '</div>';
    });
    roleMapEditor.innerHTML = html;
    roleMapEditorWrap.style.display = '';
    if (roleMapHelp) roleMapHelp.textContent = 'Map each template role to a query column before save.';
    roleMapEditor.querySelectorAll('select[data-role]').forEach(function (sel) {
      sel.addEventListener('change', function () {
        readRoleMapInputs();
      });
    });
    readRoleMapInputs();
  }

  function setSpecMessage(text, isError) {
    if (!specValidationMsg) return;
    specValidationMsg.textContent = text || '';
    specValidationMsg.className = isError ? 'small text-danger' : 'small text-secondary';
  }

  function scrollModalSectionIntoView(el) {
    if (!el) return;
    var modalBody = el.closest('.modal-body');
    if (!modalBody) return;
    var bodyRect = modalBody.getBoundingClientRect();
    var targetRect = el.getBoundingClientRect();
    var currentTop = modalBody.scrollTop;
    var pad = 12;

    if (targetRect.top < bodyRect.top) {
      modalBody.scrollTo({ top: Math.max(0, currentTop + (targetRect.top - bodyRect.top) - pad), behavior: 'smooth' });
      return;
    }

    if (targetRect.bottom > bodyRect.bottom) {
      modalBody.scrollTo({ top: currentTop + (targetRect.bottom - bodyRect.bottom) + pad, behavior: 'smooth' });
    }
  }

  function insertCustomDrilldownPreset() {
    if (!customMappingJsonInput) return;
    var current = customMappingJsonInput.value ? customMappingJsonInput.value.trim() : '';
    var mapping = {};
    if (current) {
      try {
        var parsed = JSON.parse(current);
        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
          mapping = parsed;
        }
      } catch (err) {
        setSpecMessage('Fix Custom Mapping JSON before inserting preset.', true);
        return;
      }
    }

    if (!mapping._drilldown || typeof mapping._drilldown !== 'object') {
      mapping._drilldown = {
        target: 'traces',
        label: 'Open source traces',
        extra: {
          service: '',
          from_ts: ''
        }
      };
    }

    customMappingJsonInput.value = JSON.stringify(mapping, null, 2);
    setSpecMessage('Inserted _drilldown preset into Custom Mapping JSON.', false);
  }

  function setDatalistOptions(listEl, values) {
    if (!listEl) return;
    var vals = Array.isArray(values) ? values : [];
    listEl.innerHTML = vals.map(function (v) {
      return '<option value="' + escapeHtml(String(v)) + '"></option>';
    }).join('');
  }

  function refreshDistinctBuilderOptions() {
    if (!sourceViewInput) return Promise.resolve();
    var params = new URLSearchParams({ source_view: sourceViewInput.value || 'v_derived_signals_anomaly' });
    if (signalSourceInput && signalSourceInput.value) {
      params.set('signal_source', signalSourceInput.value);
    }
    return fetch(specOptionsUrl + '?' + params.toString())
      .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
      .then(function (res) {
        if (!res.ok) return;
        setDatalistOptions(serviceOptionsList, res.body.services || []);
        setDatalistOptions(signalOptionsList, res.body.signals || []);
        setDatalistOptions(metricOptionsList, res.body.metrics || []);
      })
      .catch(function () {
        // Ignore autocomplete failures; free text remains available.
      });
  }

  function resetEditorForm(mode) {
    if (chartEditorModalTitle) chartEditorModalTitle.textContent = mode === 'clone' ? 'Clone Chart' : (mode === 'edit' ? 'Edit Chart' : 'Add Chart');
    if (chartEditorSubmitBtn) chartEditorSubmitBtn.textContent = mode === 'clone' ? 'Clone Chart' : (mode === 'edit' ? 'Save Changes' : 'Add Chart');
    if (addChartForm && defaultChartFormAction) addChartForm.setAttribute('action', defaultChartFormAction);
    if (chartTitleInput) chartTitleInput.value = '';
    if (templateSelect) templateSelect.value = 'time_series_percentiles';
    if (sqlModeSelect) sqlModeSelect.value = 'builder';
    if (sourceViewInput) sourceViewInput.value = 'v_derived_signals_anomaly';
    if (serviceInput) serviceInput.value = '';
    if (signalSourceInput) signalSourceInput.value = 'traces';
    if (signalNameInput) signalNameInput.value = 'trace_volume';
    if (metricNameInput) metricNameInput.value = '';
    if (attrFpInput) attrFpInput.value = '';
    if (windowHoursInput) windowHoursInput.value = '6';
    if (limitInput) limitInput.value = '1000';
    if (queryInput) queryInput.value = '';
    if (legendShowInput) legendShowInput.checked = true;
    if (smoothLineInput) smoothLineInput.checked = true;
    if (zoomInsideInput) zoomInsideInput.checked = true;
    if (zoomSliderInput) zoomSliderInput.checked = false;
    if (zoomStartInput) zoomStartInput.value = '0';
    if (zoomEndInput) zoomEndInput.value = '100';
    if (valueColorInput) valueColorInput.value = '';
    if (customMappingJsonInput) customMappingJsonInput.value = '{"points":{"from":"rows"}}';
    if (customOptionJsonInput) {
      customOptionJsonInput.value = JSON.stringify({
        tooltip: { trigger: 'axis' },
        xAxis: { type: 'time' },
        yAxis: { type: 'value' },
        series: [{ name: 'Value', type: 'line', data: '\\u007B\\u007Bpoints\\u007D\\u007D', showSymbol: false, smooth: true }]
      }, null, 2);
    }
    roleMapState = {};
    if (chartSpecJson) chartSpecJson.value = '';
    if (compiledSql) compiledSql.textContent = '';
    if (dryRunMeta) dryRunMeta.textContent = '';
    renderDryRunTable([], [], []);
    setSpecMessage('', false);
    namedQueriesState = [];
    renderNamedQueriesEditor([]);
    suppressRoleMapReset = true;
    updateTemplateInfo();
    suppressRoleMapReset = false;
    refreshBuilderVisibility();
    refreshDistinctBuilderOptions();
  }

  function applySpecToEditor(title, spec, formAction, mode) {
    var nextSpec = spec || {};
    var sql = nextSpec.sql || {};
    var data = nextSpec.data || {};
    var visual = nextSpec.visual || {};

    if (addChartForm && formAction) {
      addChartForm.setAttribute('action', formAction);
    }
    if (chartEditorModalTitle) chartEditorModalTitle.textContent = mode === 'clone' ? 'Clone Chart' : 'Edit Chart';
    if (chartEditorSubmitBtn) chartEditorSubmitBtn.textContent = mode === 'clone' ? 'Clone Chart' : 'Save Changes';
    if (chartTitleInput) chartTitleInput.value = title || '';
    if (templateSelect && nextSpec.template_id) templateSelect.value = nextSpec.template_id;
    if (sqlModeSelect && sql.mode) sqlModeSelect.value = String(sql.mode);
    if (queryInput) queryInput.value = sql.override_sql ? String(sql.override_sql) : '';
    if (sourceViewInput && data.source_view) sourceViewInput.value = String(data.source_view);
    if (serviceInput) serviceInput.value = data.service ? String(data.service) : '';
    if (signalSourceInput) signalSourceInput.value = data.signal_source ? String(data.signal_source) : 'traces';
    if (signalNameInput) signalNameInput.value = data.signal_name ? String(data.signal_name) : '';
    if (metricNameInput) metricNameInput.value = data.metric_name ? String(data.metric_name) : '';
    if (attrFpInput) attrFpInput.value = data.attr_fp ? String(data.attr_fp) : '';
    if (windowHoursInput) windowHoursInput.value = data.window_hours != null ? String(data.window_hours) : '6';
    if (limitInput) limitInput.value = data.limit != null ? String(data.limit) : '1000';

    if (legendShowInput) legendShowInput.checked = visual.legend_show !== false;
    if (smoothLineInput) smoothLineInput.checked = visual.smooth_line !== false;
    if (zoomInsideInput) zoomInsideInput.checked = visual.zoom_inside !== false;
    if (zoomSliderInput) zoomSliderInput.checked = visual.zoom_slider === true;
    if (zoomStartInput) zoomStartInput.value = visual.zoom_start_pct != null ? String(visual.zoom_start_pct) : '0';
    if (zoomEndInput) zoomEndInput.value = visual.zoom_end_pct != null ? String(visual.zoom_end_pct) : '100';
    if (valueColorInput) valueColorInput.value = visual.value_color ? String(visual.value_color) : '';
    if (customMappingJsonInput) {
      customMappingJsonInput.value = visual.custom_mapping_json
        ? String(visual.custom_mapping_json)
        : '{"points":{"from":"rows"}}';
    }
    if (customOptionJsonInput) {
      customOptionJsonInput.value = visual.custom_option_json
        ? String(visual.custom_option_json)
        : '';
    }
    roleMapState = (visual.role_map && typeof visual.role_map === 'object') ? visual.role_map : {};

    // Restore named queries
    var incomingNQ = Array.isArray(nextSpec.named_queries) ? nextSpec.named_queries : [];
    namedQueriesState = incomingNQ.map(function (nq) {
      return { name: String(nq.name || ''), sql: String(nq.sql || ''), purpose: String(nq.purpose || '') };
    });
    renderNamedQueriesEditor(namedQueriesState);

    if (chartSpecJson) chartSpecJson.value = JSON.stringify(nextSpec);
    if (compiledSql) compiledSql.textContent = '';
    if (dryRunMeta) dryRunMeta.textContent = '';
    renderDryRunTable([], [], []);
    setSpecMessage('', false);
    suppressRoleMapReset = true;
    updateTemplateInfo();
    suppressRoleMapReset = false;
    refreshBuilderVisibility();
    refreshDistinctBuilderOptions();
  }

  function currentChartSpec() {
    return {
      template_id: templateSelect && templateSelect.value ? templateSelect.value : 'time_series_percentiles',
      sql: {
        mode: sqlModeSelect && sqlModeSelect.value ? sqlModeSelect.value : 'builder',
        override_sql: queryInput && queryInput.value ? queryInput.value : ''
      },
      data: {
        source_view: sourceViewInput && sourceViewInput.value ? sourceViewInput.value : 'v_derived_signals_anomaly',
        service: serviceInput && serviceInput.value ? serviceInput.value.trim() : '',
        signal_source: signalSourceInput && signalSourceInput.value ? signalSourceInput.value.trim() : '',
        signal_name: signalNameInput && signalNameInput.value ? signalNameInput.value.trim() : '',
        metric_name: metricNameInput && metricNameInput.value ? metricNameInput.value.trim() : '',
        attr_fp: attrFpInput && attrFpInput.value ? attrFpInput.value.trim() : '',
        window_hours: windowHoursInput && windowHoursInput.value ? Number(windowHoursInput.value) : 6,
        limit: limitInput && limitInput.value ? Number(limitInput.value) : 1000
      },
      visual: {
        zoom_inside: true,
        zoom_slider: false,
        custom_mapping_json: customMappingJsonInput && customMappingJsonInput.value ? customMappingJsonInput.value : '',
        custom_option_json: customOptionJsonInput && customOptionJsonInput.value ? customOptionJsonInput.value : ''
      }
    };
  }

  function applyVisualSettings(spec) {
    if (!spec.visual) spec.visual = {};
    spec.visual.legend_show = !!(legendShowInput && legendShowInput.checked);
    spec.visual.smooth_line = !!(smoothLineInput && smoothLineInput.checked);
    spec.visual.zoom_inside = !!(zoomInsideInput && zoomInsideInput.checked);
    spec.visual.zoom_slider = !!(zoomSliderInput && zoomSliderInput.checked);
    spec.visual.zoom_start_pct = zoomStartInput && zoomStartInput.value ? Number(zoomStartInput.value) : 0;
    spec.visual.zoom_end_pct = zoomEndInput && zoomEndInput.value ? Number(zoomEndInput.value) : 100;
    spec.visual.value_color = valueColorInput && valueColorInput.value ? valueColorInput.value.trim() : '';
    spec.visual.role_map = readRoleMapInputs();
    spec.visual.custom_mapping_json = customMappingJsonInput && customMappingJsonInput.value
      ? customMappingJsonInput.value
      : '';
    spec.visual.custom_option_json = customOptionJsonInput && customOptionJsonInput.value
      ? customOptionJsonInput.value
      : '';
    spec.named_queries = readNamedQueryInputs();
    return spec;
  }

  function renderDryRunTable(columns, columnTypes, rows) {
    if (!dryRunTable || !dryRunTableWrap) return;
    if (!columns || !columns.length) {
      dryRunTableWrap.style.display = 'none';
      dryRunTable.innerHTML = '';
      return;
    }
    var head = '<thead><tr>' + columns.map(function (c, idx) {
      var t = columnTypes && columnTypes[idx] ? String(columnTypes[idx]) : 'unknown';
      return '<th>' + escapeHtml(c) + '<div class="small text-secondary">' + escapeHtml(t) + '</div></th>';
    }).join('') + '</tr></thead>';
    var sampleRows = (rows || []).slice(0, 8);
    var body = '<tbody>' + sampleRows.map(function (r) {
      return '<tr>' + columns.map(function (c, idx) {
          var v = r && r[idx] !== undefined && r[idx] !== null ? String(r[idx]) : '—';
          return '<td class="small font-monospace" data-label="' + escapeHtml(c) + '">' + escapeHtml(v) + '</td>';
      }).join('') + '</tr>';
    }).join('') + '</tbody>';
    dryRunTable.innerHTML = head + body;
    dryRunTableWrap.style.display = '';
  }

  function runDryRun() {
    var spec = applyVisualSettings(currentChartSpec());
    if (dryRunMeta) dryRunMeta.textContent = 'Running dry-run…';
    return fetch(specDryRunUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ spec: spec })
    })
      .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
      .then(function (res) {
        if (!res.ok) {
          throw new Error(res.body && res.body.error ? res.body.error : 'Dry-run failed');
        }
        if (queryInput && res.body.query) queryInput.value = res.body.query;
        if (chartSpecJson) chartSpecJson.value = JSON.stringify(res.body.spec || spec);
        lastDryRunColumns = Array.isArray(res.body.columns) ? res.body.columns : [];
        lastDryRunColumnTypes = Array.isArray(res.body.column_types) ? res.body.column_types : [];
        if (res.body.spec && res.body.spec.visual && res.body.spec.visual.role_map) {
          roleMapState = res.body.spec.visual.role_map;
        }
        renderRoleMapEditor(lastDryRunColumns, lastDryRunColumnTypes);
        if (dryRunMeta) {
          dryRunMeta.textContent = 'Columns: ' + (res.body.columns || []).length + ' · Rows: ' + (res.body.rows || []).length;
        }
        renderDryRunTable(res.body.columns || [], res.body.column_types || [], res.body.rows || []);
        if (dryRunTableWrap && dryRunTableWrap.style.display !== 'none') {
          scrollModalSectionIntoView(dryRunTableWrap);
        }
        return res.body;
      })
      .catch(function (err) {
        if (dryRunMeta) dryRunMeta.textContent = String(err.message || err);
        renderDryRunTable([], [], []);
        throw err;
      });
  }

  function refreshBuilderVisibility() {
    var selectedTemplate = templateSelect && templateSelect.value ? templateSelect.value : '';
    var isCustomEcharts = selectedTemplate === 'custom_echarts';
    if (selectedTemplate === 'custom_echarts' && sqlModeSelect) {
      sqlModeSelect.value = 'raw';
    }

    var useBuilder = !sqlModeSelect || sqlModeSelect.value !== 'raw';
    if (builderFieldsWrap) builderFieldsWrap.classList.toggle('d-none', !useBuilder);
    if (rawSqlModeHint) rawSqlModeHint.classList.toggle('d-none', useBuilder);
    if (sourceViewInput) sourceViewInput.disabled = !useBuilder;
    if (serviceInput) serviceInput.disabled = !useBuilder;
    if (attrFpInput) attrFpInput.disabled = !useBuilder;
    if (windowHoursInput) windowHoursInput.disabled = !useBuilder;
    if (limitInput) limitInput.disabled = !useBuilder;

    var source = sourceViewInput ? sourceViewInput.value : 'v_derived_signals_anomaly';
    var isMetricSource = source === 'v_otel_metrics_anomaly'
      || source === 'otel_metrics_gauge'
      || source === 'otel_metrics_sum'
      || source === 'otel_metrics_histogram';
    var showDerivedFields = useBuilder && !isMetricSource;
    if (derivedSignalBuilderFields) derivedSignalBuilderFields.classList.toggle('d-none', !showDerivedFields);
    if (metricBuilderFields) metricBuilderFields.classList.toggle('d-none', !useBuilder || !isMetricSource);
    if (customEchartsFields) customEchartsFields.classList.toggle('d-none', !isCustomEcharts);
    if (standardVisualControls) standardVisualControls.classList.toggle('d-none', isCustomEcharts);
    if (roleMapEditorWrap) roleMapEditorWrap.style.display = isCustomEcharts ? 'none' : roleMapEditorWrap.style.display;
    if (queryInput) queryInput.rows = useBuilder ? 5 : 11;
    // Named queries section is only visible for custom_echarts
    if (namedQueriesSection) namedQueriesSection.style.display = isCustomEcharts ? '' : 'none';
  }

  function compileSpec() {
    var spec = applyVisualSettings(currentChartSpec());
    if (compiledSql) compiledSql.textContent = 'Compiling…';
    setSpecMessage('Compiling chart spec…', false);
    return fetch(specCompileUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ spec: spec })
    })
      .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
      .then(function (res) {
        if (!res.ok) {
          throw new Error(res.body && res.body.error ? res.body.error : 'Compile failed');
        }
        var returnedSpec = res.body.spec || spec;
        returnedSpec = applyVisualSettings(returnedSpec);
        if (returnedSpec.visual && returnedSpec.visual.role_map) {
          roleMapState = returnedSpec.visual.role_map;
        }
        renderRoleMapEditor(lastDryRunColumns, lastDryRunColumnTypes);
        if (queryInput) queryInput.value = res.body.query || '';
        if (compiledSql) compiledSql.textContent = res.body.query || '';
        if (chartSpecJson) chartSpecJson.value = JSON.stringify(returnedSpec);
        setSpecMessage('Compiled successfully.', false);
        return Object.assign({}, res.body, { spec: returnedSpec });
      })
      .catch(function (err) {
        if (compiledSql) compiledSql.textContent = '';
        setSpecMessage(err.message || String(err), true);
        throw err;
      });
  }

  function validateSpec() {
    var spec = applyVisualSettings(currentChartSpec());
    return fetch(specValidateUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ spec: spec })
    })
      .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
      .then(function (res) {
        if (!res.ok || !res.body.valid) {
          throw new Error((res.body && res.body.error) || 'Spec validation failed');
        }
        setSpecMessage('Valid mapping: ' + res.body.columns.length + ' columns, ' + res.body.row_count + ' rows.', false);
        return res.body;
      });
  }

  function updateTemplateInfo() {
    var t = templatesMap[templateSelect.value];
    if (!t) {
      templateDesc.textContent = '';
      columnHint.textContent = '';
      return;
    }

    templateDesc.textContent = t.description || '';
    columnHint.textContent = buildTemplateExample(t);
    if (customEchartsFields) {
      customEchartsFields.classList.toggle('d-none', t.id !== 'custom_echarts');
    }
    if (!suppressRoleMapReset) roleMapState = {};
    renderRoleMapEditor(lastDryRunColumns, lastDryRunColumnTypes);
    if (t.id === 'custom_echarts' && sqlModeSelect) {
      sqlModeSelect.value = 'raw';
    }
    if (sqlModeSelect && sqlModeSelect.value === 'raw' && queryInput && !queryInput.value.trim()) {
      queryInput.value = t.sample_sql || '';
    }
    refreshBuilderVisibility();
  }

  function openChartSqlModal(chartId) {
    var chartCfg = CHART_DATA.find(function (c) { return c.id === chartId; });
    if (!chartCfg) return;
    if (chartSqlModalTitle) {
      chartSqlModalTitle.textContent = (chartCfg.title || 'Chart') + ' SQL';
    }
    if (chartSqlModalMeta) {
      chartSqlModalMeta.textContent = (chartCfg.chart_type || 'chart') + ' chart';
    }
    if (chartSqlModalBody) {
      chartSqlModalBody.textContent = formatSql(chartCfg.query || '');
    }
    if (chartSqlModal) {
      bootstrap.Modal.getOrCreateInstance(chartSqlModal).show();
    }
  }

  function copyChartSqlToClipboard() {
    if (!chartSqlModalBody) return Promise.resolve();
    var text = chartSqlModalBody.textContent || '';
    if (!text.trim()) return Promise.resolve();
    if (navigator.clipboard && navigator.clipboard.writeText) {
      return navigator.clipboard.writeText(text);
    }
    var temp = document.createElement('textarea');
    temp.value = text;
    temp.setAttribute('readonly', 'readonly');
    temp.style.position = 'absolute';
    temp.style.left = '-9999px';
    document.body.appendChild(temp);
    temp.select();
    document.execCommand('copy');
    document.body.removeChild(temp);
    return Promise.resolve();
  }

  updateTemplateInfo();
  templateSelect.addEventListener('change', updateTemplateInfo);
  if (sqlModeSelect) sqlModeSelect.addEventListener('change', refreshBuilderVisibility);
  if (sourceViewInput) {
    sourceViewInput.addEventListener('change', function () {
      refreshBuilderVisibility();
      refreshDistinctBuilderOptions();
    });
  }
  if (signalSourceInput) {
    signalSourceInput.addEventListener('change', function () {
      refreshDistinctBuilderOptions();
    });
  }
  if (compileSpecBtn) compileSpecBtn.addEventListener('click', function () { compileSpec(); });
  if (dryRunSpecBtn) dryRunSpecBtn.addEventListener('click', function () { runDryRun(); });
  if (customDrilldownPresetBtn) {
    customDrilldownPresetBtn.addEventListener('click', function () {
      insertCustomDrilldownPreset();
    });
  }
  refreshBuilderVisibility();
  refreshDistinctBuilderOptions();

  document.querySelectorAll('.js-add-chart-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      resetEditorForm('add');
    });
  });

  document.querySelectorAll('.js-view-chart-sql').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var chartId = btn.getAttribute('data-chart-id');
      if (!chartId) return;
      openChartSqlModal(chartId);
    });
  });

  if (chartSqlCopyBtn) {
    chartSqlCopyBtn.addEventListener('click', function () {
      var iconEl = chartSqlCopyBtn.querySelector('i');
      var originalClass = iconEl ? iconEl.className : '';
      copyChartSqlToClipboard()
        .then(function () {
          if (iconEl) iconEl.className = 'bi bi-check2';
          window.setTimeout(function () {
            if (iconEl) iconEl.className = originalClass;
          }, 1200);
        })
        .catch(function () {
          if (iconEl) iconEl.className = 'bi bi-exclamation-triangle';
          window.setTimeout(function () {
            if (iconEl) iconEl.className = originalClass;
          }, 1600);
        });
    });
  }

  document.querySelectorAll('.js-edit-chart').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var chartId = btn.getAttribute('data-chart-id');
      var formAction = btn.getAttribute('data-edit-url') || '';
      var chartCfg = CHART_DATA.find(function (c) { return c.id === chartId; });
      if (!chartCfg) return;
      applySpecToEditor(chartCfg.title || '', chartCfg.chart_spec || {}, formAction, 'edit');
      bootstrap.Modal.getOrCreateInstance(addChartModal).show();
    });
  });

  document.querySelectorAll('.js-clone-chart').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var chartId = btn.getAttribute('data-chart-id');
      var formAction = btn.getAttribute('data-clone-url') || '';
      var chartCfg = CHART_DATA.find(function (c) { return c.id === chartId; });
      if (!chartCfg) return;
      applySpecToEditor((chartCfg.title || 'Chart') + ' (copy)', chartCfg.chart_spec || {}, formAction, 'clone');
      bootstrap.Modal.getOrCreateInstance(addChartModal).show();
    });
  });

  /* ── Preview in modal ── */
  var previewBtn = document.getElementById('previewBtn');
  var previewChartInst = null;
  if (previewBtn) {
    previewBtn.addEventListener('click', function () {
      var modal = document.getElementById('addChartModal');
      var area = document.getElementById('queryPreviewArea');
      var msg = document.getElementById('queryPreviewMsg');

      area.style.display = 'block';
      msg.textContent = 'Rendering…';
      scrollModalSectionIntoView(area);
      if (previewChartInst) { previewChartInst.dispose(); previewChartInst = null; }

      fetch(specRenderUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ spec: applyVisualSettings(currentChartSpec()) })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.error) {
            msg.textContent = 'Error: ' + data.error;
            return;
          }
          msg.textContent = 'Preview ready';
          var el = document.getElementById('queryPreviewChart');
          previewChartInst = echarts.init(el, (window.SOBS && SOBS.echartsTheme) ? SOBS.echartsTheme() : null);
          previewChartInst.setOption(data.option);
          scrollModalSectionIntoView(area);
          if (queryInput && data.query) queryInput.value = data.query;
          var previewSpec = applyVisualSettings(data.spec || currentChartSpec());
          if (chartSpecJson) chartSpecJson.value = JSON.stringify(previewSpec);
          validateSpec();
          runDryRun();
        })
        .catch(function (err) {
          msg.textContent = 'Network error: ' + err;
        });
    });
  }

  if (addChartForm) {
    addChartForm.addEventListener('submit', function (ev) {
      ev.preventDefault();
      compileSpec()
        .then(function () { return validateSpec(); })
        .then(function () { addChartForm.submit(); })
        .catch(function () {
          // Validation message already set by helpers.
        });
    });
  }

  // AI builder event
  if (aiBuilderBuildBtn) {
    aiBuilderBuildBtn.addEventListener('click', function () { runAiBuild(); });
  }

  // Named queries – add row
  if (addNamedQueryBtn) {
    addNamedQueryBtn.addEventListener('click', function () {
      var entries = namedQueriesList ? namedQueriesList.querySelectorAll('.named-query-entry') : [];
      var newRow = createNamedQueryRow(null, entries.length);
      if (namedQueriesList) namedQueriesList.appendChild(newRow);
    });
  }

  // Import chart events
  if (importChartSubmitBtn) {
    importChartSubmitBtn.addEventListener('click', function () { runChartImport(); });
  }

  // Reset import modal state on open
  if (importChartModal) {
    importChartModal.addEventListener('show.bs.modal', function () {
      if (importChartFileInput) importChartFileInput.value = '';
      if (importChartTitleInput) importChartTitleInput.value = '';
      if (importChartStatus) { importChartStatus.textContent = ''; importChartStatus.className = 'small'; }
      if (importChartSubmitBtn) importChartSubmitBtn.disabled = false;
    });
  }
})();
</script>

<script>
(function () {
  /* ===== Theme management ===== */
  var THEME_KEY = 'sobs-theme';
  var VALID_THEMES = { light: true, dark: true, system: true };

  function normalizeTheme(value) {
    return VALID_THEMES[value] ? value : 'system';
  }

  function getStoredTheme() {
    return normalizeTheme(localStorage.getItem(THEME_KEY));
  }

  function applyTheme(stored) {
    stored = normalizeTheme(stored);
    var effective = stored === 'system'
      ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      : stored;
    document.documentElement.setAttribute('data-bs-theme', effective);
  }

  function updateThemeUI(stored) {
    document.querySelectorAll('[data-sobs-theme]').forEach(function (btn) {
      var active = btn.getAttribute('data-sobs-theme') === stored;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    ['sbCompactThemeIcon', 'sbCompactThemeIconNav'].forEach(function (iconId) {
      var compactIcon = document.getElementById(iconId);
      if (compactIcon) {
        compactIcon.className = stored === 'light'
          ? 'bi bi-sun'
          : (stored === 'dark' ? 'bi bi-moon-stars' : 'bi bi-circle-half');
      }
    });
  }

  var currentTheme = getStoredTheme();
  localStorage.setItem(THEME_KEY, currentTheme);
  updateThemeUI(currentTheme);

  document.querySelectorAll('[data-sobs-theme]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var t = this.getAttribute('data-sobs-theme');
      localStorage.setItem(THEME_KEY, t);
      applyTheme(t);
      updateThemeUI(t);
    });
  });

  // Follow OS preference changes when in system mode
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
    if (getStoredTheme() === 'system') {
      applyTheme('system');
    }
  });

  // Expose a small helper for chart code: returns 'dark' or null matching current BS theme
  window.SOBS = window.SOBS || {};
  window.SOBS.echartsTheme = function () {
    return document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'dark' : null;
  };
  window.SOBS.cssVar = function (name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  };
  // Copy text (or a Promise resolving to text) to the clipboard.
  // When a Promise is supplied, ClipboardItem is used so the user-activation
  // token is captured at call-time rather than after the async resolution,
  // which matters for browsers that enforce user-activation on clipboard writes.
  window.SOBS.copyToClipboard = async function (textOrPromise) {
    if (typeof textOrPromise !== 'string' &&
        typeof ClipboardItem !== 'undefined' &&
        navigator.clipboard && navigator.clipboard.write) {
      var blobPromise = Promise.resolve(textOrPromise).then(function (t) {
        return new Blob([t], { type: 'text/plain' });
      });
      await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blobPromise })]);
    } else {
      var text = typeof textOrPromise === 'string' ? textOrPromise : await textOrPromise;
      await navigator.clipboard.writeText(text);
    }
  };
}());

/* ===== Sidebar ===== */
(function () {
  var rootEl = document.documentElement;
  var sidebar = document.getElementById('sbSidebar');
  var toggleBtn = document.getElementById('sbToggleBtn');
  var toggleIcon = document.getElementById('sbToggleIcon');
  var hamburgerBtn = document.getElementById('sbHamburgerBtn');
  var backdrop = document.getElementById('sbBackdrop');
  var mq = window.matchMedia('(max-width: 575.98px)');
  var lastFocusedElement = null;

  function isHamburgerMode() { return mq.matches; }

  // Restore saved state (compact or full) on medium+ screens
  var saved = localStorage.getItem('sobs-sidebar-state') || 'full';
  var shouldCompact = saved === 'compact' && !isHamburgerMode();
  sidebar.classList.toggle('sidebar-compact', shouldCompact);
  toggleIcon.className = shouldCompact ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
  rootEl.classList.toggle('sb-state-compact', shouldCompact);
  rootEl.classList.remove('sb-state-pending');

  // Toggle button: switch between full (State 1) and compact (State 2)
  toggleBtn.addEventListener('click', function () {
    var isCompact = sidebar.classList.toggle('sidebar-compact');
    toggleIcon.className = isCompact ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
    localStorage.setItem('sobs-sidebar-state', isCompact ? 'compact' : 'full');
    rootEl.classList.toggle('sb-state-compact', isCompact);
  });

  // Hamburger button: open sidebar as overlay (State 3)
  hamburgerBtn.addEventListener('click', function () {
    lastFocusedElement = document.activeElement;
    sidebar.classList.add('sb-open');
    backdrop.classList.add('show');
    document.body.style.overflow = 'hidden';
    hamburgerBtn.setAttribute('aria-expanded', 'true');
    var firstFocusable = sidebar.querySelector('a.nav-link, button.nav-link, button, a');
    if (firstFocusable) {
      firstFocusable.focus();
    }
  });

  function closeSidebar() {
    sidebar.classList.remove('sb-open');
    backdrop.classList.remove('show');
    document.body.style.overflow = '';
    hamburgerBtn.setAttribute('aria-expanded', 'false');
    if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
      lastFocusedElement.focus();
      lastFocusedElement = null;
    } else {
      hamburgerBtn.focus();
    }
  }

  // Close on backdrop click
  backdrop.addEventListener('click', closeSidebar);

  // Close on nav-link click in hamburger mode (navigate away)
  sidebar.querySelectorAll('a.nav-link, button.nav-link').forEach(function (link) {
    link.addEventListener('click', function () {
      if (isHamburgerMode()) closeSidebar();
    });
  });

  // Escape closes overlay menu in hamburger mode
  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && isHamburgerMode() && sidebar.classList.contains('sb-open')) {
      closeSidebar();
    }
  });

  // Handle transition between hamburger and normal modes on resize
  mq.addEventListener('change', function (e) {
    if (!e.matches) {
      // Back to normal/desktop mode
      closeSidebar();
      var restoredState = localStorage.getItem('sobs-sidebar-state') || 'full';
      if (restoredState === 'compact') {
        sidebar.classList.add('sidebar-compact');
        toggleIcon.className = 'bi bi-chevron-right';
        rootEl.classList.add('sb-state-compact');
      } else {
        sidebar.classList.remove('sidebar-compact');
        toggleIcon.className = 'bi bi-chevron-left';
        rootEl.classList.remove('sb-state-compact');
      }
    } else {
      // In hamburger mode we don't force compact desktop rules.
      rootEl.classList.remove('sb-state-compact');
    }
  });
}());
</script>

<!-- ===== AI Assistant Widget ===== -->
<style>
  :root {
    --sobs-ai-btn-bg: rgba(13, 110, 253, 0.12);
    --sobs-ai-btn-hover-bg: rgba(13, 110, 253, 0.18);
    --sobs-ai-btn-border: rgba(13, 110, 253, 0.2);
    --sobs-ai-btn-color: #0d6efd;
    --sobs-ai-btn-shadow: 0 4px 12px rgba(0, 0, 0, 0.18);
  }
  [data-bs-theme='dark'] {
    --sobs-ai-btn-bg: rgba(110, 168, 254, 0.18);
    --sobs-ai-btn-hover-bg: rgba(110, 168, 254, 0.26);
    --sobs-ai-btn-border: rgba(110, 168, 254, 0.28);
    --sobs-ai-btn-color: #9ec5fe;
    --sobs-ai-btn-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
  }
  #sobsAiBtn {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 1080;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--sobs-ai-btn-border);
    background: var(--sobs-ai-btn-bg);
    color: var(--sobs-ai-btn-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: var(--sobs-ai-btn-shadow);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background 0.15s, border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  #sobsAiBtn:hover {
    background: var(--sobs-ai-btn-hover-bg);
    border-color: var(--sobs-ai-btn-color);
    transform: scale(1.08);
  }
  #sobsAiPanel {
    position: fixed;
    bottom: 4.5rem;
    right: 1.5rem;
    z-index: 1075;
    width: min(420px, calc(100vw - 2rem));
    min-height: 320px;
    min-width: 320px;
    max-height: 70vh;
    max-width: calc(100vw - 1rem);
    display: none;
    flex-direction: column;
    background: var(--bs-body-bg);
    border: 1px solid var(--bs-border-color);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,.4);
    resize: both;
    overflow: hidden;
    transition: width 0.2s ease, height 0.2s ease, max-height 0.2s ease, right 0.2s ease, bottom 0.2s ease;
  }
  #sobsAiPanel.behind-modal {
    z-index: 1040;
  }
  #sobsAiBtn.behind-modal {
    z-index: 1040;
    opacity: .7;
  }
  #sobsAiPanel.open { display: flex; }
  #sobsAiPanel.expanded {
    max-height: none;
  }
  #sobsAiPanelHeader {
    padding: .6rem 1rem;
    background: var(--bs-tertiary-bg);
    border-bottom: 1px solid var(--bs-border-color);
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-shrink: 0;
    cursor: move;
    user-select: none;
    overflow: hidden;
  }
  #sobsAiPanelHeader > .fw-semibold {
    min-width: 0;
  }
  #sobsAiPanel.dragging {
    transition: none;
  }
  #sobsAiToggleHistory {
    border: 0;
    background: transparent;
    color: var(--bs-secondary-color);
    padding: .15rem .28rem;
    opacity: .72;
  }
  #sobsAiToggleHistory:hover {
    opacity: 1;
    color: var(--bs-body-color);
    background: color-mix(in srgb, var(--bs-secondary-bg) 72%, transparent);
  }
  #sobsAiPanel:not(.history-collapsed) #sobsAiToggleHistory {
    color: var(--bs-primary);
    opacity: .92;
  }
  #sobsAiActiveChat {
    display: none;
    align-items: center;
    gap: .25rem;
    max-width: 180px;
    min-width: 0;
    flex-shrink: 1;
    font-size: .64rem;
    color: var(--bs-secondary-color);
    border: 1px solid var(--bs-border-color);
    border-radius: 999px;
    padding: .08rem .4rem;
    background: color-mix(in srgb, var(--bs-tertiary-bg) 65%, transparent);
  }
  #sobsAiActiveChat.visible {
    display: inline-flex;
  }
  #sobsAiActiveChatLabel {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 132px;
  }
  #sobsAiThinkingWrap {
    display: none;
    align-items: center;
    gap: .35rem;
    font-size: .72rem;
    color: var(--bs-secondary-color);
    flex-shrink: 0;
  }
  #sobsAiThinkingWrap.active {
    display: inline-flex;
  }
  #sobsAiPanel.header-tight .sobs-ai-thinking-text {
    display: none;
  }
  #sobsAiPanel.header-tight #sobsAiActiveChat {
    max-width: 120px;
  }
  #sobsAiPanel.header-very-tight #sobsAiActiveChat {
    display: none;
  }
  #sobsAiThinkingLevel {
    width: 84px;
    padding: .12rem .3rem;
    font-size: .72rem;
  }
  #sobsAiMessages {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: .75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    font-size: .85rem;
  }
  #sobsAiBody {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
  }
  #sobsAiHistoryPanel {
    width: 210px;
    min-width: 160px;
    border-right: 1px solid var(--bs-border-color);
    background: color-mix(in srgb, var(--bs-secondary-bg) 52%, transparent);
    display: flex;
    flex-direction: column;
    transition: width .18s ease;
  }
  #sobsAiPanel.history-collapsed #sobsAiHistoryPanel {
    width: 0;
    min-width: 0;
    border-right: 0;
    overflow: hidden;
  }
  #sobsAiHistoryHeader {
    padding: .5rem .55rem;
    border-bottom: 1px solid var(--bs-border-color);
    color: var(--bs-secondary-color);
    font-size: .7rem;
    font-weight: 600;
  }
  #sobsAiHistoryList {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: .3rem;
    display: flex;
    flex-direction: column;
    gap: .28rem;
  }
  #sobsAiHistorySentinel {
    height: 1px;
    flex-shrink: 0;
  }
  #sobsAiHistorySearch {
    flex-shrink: 0;
    padding: .3rem .35rem;
    border-top: 1px solid var(--bs-border-color);
  }
  #sobsAiHistorySearchInput {
    width: 100%;
    font-size: .7rem;
    padding: .22rem .4rem;
    border: 1px solid var(--bs-border-color);
    border-radius: 5px;
    background: var(--bs-body-bg);
    color: var(--bs-body-color);
    outline: none;
  }
  #sobsAiHistorySearchInput:focus {
    border-color: color-mix(in srgb, var(--bs-primary) 55%, var(--bs-border-color));
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--bs-primary) 15%, transparent);
  }
  .sobs-ai-history-loading {
    text-align: center;
    font-size: .68rem;
    color: var(--bs-secondary-color);
    padding: .3rem 0;
  }
  .sobs-ai-history-item {
    border: 1px solid var(--bs-border-color);
    border-radius: 8px;
    background: var(--bs-body-bg);
    padding: .35rem .4rem;
    cursor: pointer;
  }
  .sobs-ai-history-item.active {
    border-color: color-mix(in srgb, var(--bs-primary) 65%, var(--bs-border-color));
    background: color-mix(in srgb, var(--bs-primary-bg-subtle) 58%, var(--bs-body-bg));
  }
  .sobs-ai-history-title {
    font-size: .72rem;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sobs-ai-history-meta {
    margin-top: .16rem;
    font-size: .62rem;
    color: var(--bs-secondary-color);
  }
  #sobsAiConversation {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1 1 auto;
  }
  .sobs-ai-msg {
    padding: .45rem .75rem;
    border-radius: 10px;
    max-width: 90%;
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.5;
  }
  .sobs-ai-msg.user {
    background: var(--bs-primary);
    color: #fff;
    align-self: flex-end;
    border-bottom-right-radius: 3px;
  }
  .sobs-ai-msg.assistant {
    background: var(--bs-secondary-bg);
    color: var(--bs-body-color);
    align-self: flex-start;
    border-bottom-left-radius: 3px;
    white-space: normal;
  }
  .sobs-ai-msg-time {
    font-size: .6rem;
    line-height: 1;
    opacity: .7;
    white-space: nowrap;
  }
  .sobs-ai-msg-meta {
    margin-top: .28rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .45rem;
    flex-wrap: wrap;
  }
  .sobs-ai-msg-actions {
    display: inline-flex;
    align-items: center;
    gap: .15rem;
    flex-wrap: wrap;
  }
  .sobs-ai-msg-action {
    --bs-btn-padding-y: .08rem;
    --bs-btn-padding-x: .28rem;
    --bs-btn-font-size: .68rem;
    display: inline-flex;
    align-items: center;
    gap: .2rem;
    color: var(--bs-secondary-color);
    text-decoration: none;
  }
  .sobs-ai-msg-action:hover,
  .sobs-ai-msg-action:focus {
    color: var(--bs-body-color);
  }
  .sobs-ai-msg-action[disabled] {
    opacity: .72;
    pointer-events: none;
  }
  .sobs-ai-msg.assistant p { margin: 0 0 .45rem 0; }
  .sobs-ai-msg.assistant p:last-child { margin-bottom: 0; }
  .sobs-ai-msg.assistant ul,
  .sobs-ai-msg.assistant ol {
    margin: 0 0 .45rem 1.15rem;
    padding-left: .6rem;
  }
  .sobs-ai-msg.assistant li { margin: .15rem 0; }
  .sobs-ai-msg.assistant pre {
    margin: .35rem 0;
    padding: .45rem .55rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--bs-body-color) 8%, transparent);
    overflow-x: auto;
  }
  .sobs-ai-msg.assistant code {
    font-size: .82em;
    border-radius: 4px;
    padding: .05rem .3rem;
    background: color-mix(in srgb, var(--bs-body-color) 10%, transparent);
  }
  .sobs-ai-msg.assistant pre code {
    padding: 0;
    background: transparent;
  }
  .sobs-ai-msg.assistant a {
    color: var(--bs-link-color);
    text-decoration: underline;
    word-break: break-all;
  }
  .sobs-markdown-block {
    display: block;
  }
  .sobs-markdown-tail {
    display: block;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--bs-body-color);
    line-height: 1.5;
  }
  .sobs-ai-msg.assistant .ai-md-table-wrap {
    width: 100%;
    overflow-x: auto;
    margin: .35rem 0;
  }
  .sobs-ai-msg.assistant table {
    width: 100%;
    border-collapse: collapse;
    font-size: .82rem;
  }
  .sobs-ai-msg.assistant th,
  .sobs-ai-msg.assistant td {
    border: 1px solid var(--bs-border-color);
    padding: .35rem .45rem;
    text-align: left;
    vertical-align: top;
  }
  .sobs-ai-msg.assistant th {
    background: var(--bs-tertiary-bg);
    font-weight: 600;
  }
  .sobs-ai-msg.assistant tr:nth-child(even) td {
    background: color-mix(in srgb, var(--bs-body-color) 3%, transparent);
  }
  .sobs-ai-msg.error-msg { background: #dc354522; color: #dc3545; }
  .sobs-ai-msg.info-msg { background: #0d6efd22; color: #0d6efd; }
  .sobs-ai-tool-card {
    align-self: flex-start;
    max-width: 90%;
    border: 1px solid var(--bs-border-color);
    background: var(--bs-tertiary-bg);
    border-radius: 10px;
    padding: .5rem .6rem;
    display: flex;
    flex-direction: column;
    gap: .35rem;
    font-size: .78rem;
  }
  .sobs-ai-tool-title {
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: .35rem;
  }
  .sobs-ai-tool-code {
    font-family: var(--bs-font-monospace);
    font-size: .74rem;
    background: color-mix(in srgb, var(--bs-body-color) 7%, transparent);
    border-radius: 6px;
    padding: .35rem .45rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .sobs-ai-tool-actions {
    display: flex;
    gap: .4rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .sobs-ai-tool-status {
    color: var(--bs-secondary-color);
    font-size: .72rem;
  }
  .sobs-ai-tool-card.historical {
    background: color-mix(in srgb, var(--bs-tertiary-bg) 78%, transparent);
  }
  .sobs-ai-thinking-trace {
    margin-top: .35rem;
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    font-size: .72rem;
    color: var(--bs-secondary-color);
    text-decoration: none;
    opacity: .9;
  }
  .sobs-ai-thinking-trace:hover {
    color: var(--bs-info-text-emphasis, var(--bs-info));
    opacity: 1;
  }
  .sobs-ai-msg.thinking-msg {
    background: color-mix(in srgb, var(--bs-secondary-bg) 78%, transparent);
    color: var(--bs-secondary-color);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 92px;
    padding: .5rem .7rem;
  }
  .sobs-ai-thinking-wrap {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    align-self: flex-start;
    gap: .25rem;
    max-width: 90%;
  }
  .sobs-ai-thinking {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sobs-ai-thinking-dots {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    min-height: 14px;
  }
  .sobs-ai-thinking-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: .35;
    animation: sobsAiThinkingPulse 1.1s ease-in-out infinite;
  }
  .sobs-ai-thinking-dot:nth-child(2) { animation-delay: .16s; }
  .sobs-ai-thinking-dot:nth-child(3) { animation-delay: .32s; }
  .sobs-ai-thinking-label {
    font-size: .64rem;
    line-height: 1;
    letter-spacing: .04em;
    color: var(--bs-secondary-color);
  }
  @keyframes sobsAiThinkingPulse {
    0%, 80%, 100% {
      transform: translateY(0) scale(.85);
      opacity: .3;
    }
    40% {
      transform: translateY(-1px) scale(1);
      opacity: .85;
    }
  }
  #sobsAiInputRow {
    display: flex;
    gap: .4rem;
    padding: .6rem;
    border-top: 1px solid var(--bs-border-color);
    flex-shrink: 0;
  }
  #sobsAiStatus {
    display: none;
    font-size: .7rem;
    color: var(--bs-secondary-color);
    padding: .25rem .6rem;
    border-top: 1px solid var(--bs-border-color);
    gap: .75rem;
    flex-wrap: wrap;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
  }
  #sobsAiStatus.visible { display: flex; }
  #sobsAiStatus .stat-group { display: flex; gap: .3rem; align-items: center; }
  #sobsAiStatus .stat-label { font-weight: 600; opacity: .75; }
  #sobsAiStatus .stat-sep { opacity: .35; }
  #sobsAiInput {
    flex: 1;
    font-size: .85rem;
    resize: none;
    border-radius: 8px;
    padding: .4rem .6rem;
    border: 1px solid var(--bs-border-color);
    background: var(--bs-body-bg);
    color: var(--bs-body-color);
    min-height: 38px;
    max-height: 120px;
  }
  #sobsAiSendBtn {
    flex-shrink: 0;
    height: 38px;
    padding: 0 .75rem;
    font-size: .85rem;
  }
  @media (max-width: 768px) {
    #sobsAiPanel {
      right: 1rem;
      bottom: 4.25rem;
      width: calc(100vw - 2rem);
    }
    #sobsAiPanel.expanded {
      right: .5rem;
      bottom: .5rem;
      width: calc(100vw - 1rem);
      height: calc(100vh - 1rem);
      max-height: calc(100vh - 1rem);
    }
    #sobsAiHistoryPanel {
      width: 150px;
      min-width: 130px;
    }
  }
</style>

<button id="sobsAiBtn" title="AI Assistant (beta)" aria-label="Open AI assistant (beta)">
  <i class="bi bi-robot fs-5"></i>
</button>

<div id="sobsAiPanel" class="history-collapsed" role="dialog" aria-label="AI Assistant (beta)" aria-modal="false">
  <div id="sobsAiPanelHeader">
    <i class="bi bi-robot text-primary"></i>
    <span class="fw-semibold small flex-grow-1">AI Assistant (beta)</span>
    <span id="sobsAiActiveChat" aria-label="Active chat">
      <i class="bi bi-pin-angle"></i>
      <span id="sobsAiActiveChatLabel"></span>
    </span>
    <button type="button" id="sobsAiToggleHistory" aria-label="Toggle chat history" title="Toggle history">
      <i class="bi bi-layout-sidebar"></i>
    </button>
    <div id="sobsAiThinkingWrap" aria-label="Thinking level">
      <span class="sobs-ai-thinking-text">Thinking</span>
      <select id="sobsAiThinkingLevel" class="form-select form-select-sm" title="Model thinking level">
        <option value="off">Off</option>
        <option value="low">Low</option>
        <option value="medium">Medium</option>
        <option value="high">High</option>
      </select>
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="sobsAiNewChat" aria-label="New chat" title="New chat">
      <i class="bi bi-plus-lg"></i>
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="sobsAiExpand" aria-label="Expand AI helper" aria-expanded="false" title="Expand">
      <i class="bi bi-arrows-angle-expand"></i>
    </button>
    <button type="button" class="btn-close btn-close-sm" id="sobsAiClose" aria-label="Close"></button>
  </div>
  <div id="sobsAiBody">
    <aside id="sobsAiHistoryPanel" aria-label="Chat history">
      <div id="sobsAiHistoryHeader">Chats</div>
      <div id="sobsAiHistoryList">
        <div id="sobsAiHistorySentinel"></div>
      </div>
      <div id="sobsAiHistorySearch">
        <input type="search" id="sobsAiHistorySearchInput" placeholder="Filter chats…" autocomplete="off" aria-label="Filter chat history">
      </div>
    </aside>
    <div id="sobsAiConversation">
      <div id="sobsAiMessages" aria-live="polite" aria-relevant="additions"></div>
      <div id="sobsAiStatus" role="status" aria-label="Token usage"></div>
      <div id="sobsAiInputRow">
        <textarea id="sobsAiInput" rows="1" placeholder="Ask a question about this page…" aria-label="Your question"></textarea>
        <button id="sobsAiSendBtn" class="btn btn-primary btn-sm" type="button">
          <i class="bi bi-send"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/markdown-it@14.1.0/dist/markdown-it.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js"></script>
<script>
(function () {
  var btn = document.getElementById('sobsAiBtn');
  var panel = document.getElementById('sobsAiPanel');
  var closeBtn = document.getElementById('sobsAiClose');
  var expandBtn = document.getElementById('sobsAiExpand');
  var newChatBtn = document.getElementById('sobsAiNewChat');
  var toggleHistoryBtn = document.getElementById('sobsAiToggleHistory');
  var historyListEl = document.getElementById('sobsAiHistoryList');
  var activeChatEl = document.getElementById('sobsAiActiveChat');
  var activeChatLabelEl = document.getElementById('sobsAiActiveChatLabel');
  var messagesEl = document.getElementById('sobsAiMessages');
  var statusEl = document.getElementById('sobsAiStatus');
  var inputEl = document.getElementById('sobsAiInput');
  var sendBtn = document.getElementById('sobsAiSendBtn');
  var thinkingWrapEl = document.getElementById('sobsAiThinkingWrap');
  var thinkingLevelEl = document.getElementById('sobsAiThinkingLevel');
  var currentAbortController = null;
  var currentChatId = '';
  var supportsThinking = false;
  var historyLoaded = false;
  var chatStateKey = 'sobs-ai-chat-state-v1';
  var headerResizeObserver = null;
  var mdRenderer = (window.markdownit && window.DOMPurify)
    ? window.markdownit({
      html: false,
      linkify: true,
      breaks: true,
      typographer: true
    })
    : null;

  if (mdRenderer) {
    mdRenderer.renderer.rules.table_open = function () {
      return '<div class="ai-md-table-wrap"><table>';
    };
    mdRenderer.renderer.rules.table_close = function () {
      return '</table></div>';
    };
  }

  function formatRelativeTime(ts) {
    if (!ts) return '';
    var d = new Date(String(ts).replace(' ', 'T') + 'Z');
    if (isNaN(d.getTime())) {
      d = new Date(ts);
    }
    if (isNaN(d.getTime())) return '';
    var diffSec = Math.max(1, Math.floor((Date.now() - d.getTime()) / 1000));
    if (diffSec < 60) return diffSec + 's ago';
    var diffMin = Math.floor(diffSec / 60);
    if (diffMin < 60) return diffMin + 'm ago';
    var diffHr = Math.floor(diffMin / 60);
    if (diffHr < 24) return diffHr + 'h ago';
    var diffDay = Math.floor(diffHr / 24);
    if (diffDay < 365) return diffDay + 'd ago';
    return Math.floor(diffDay / 365) + 'y ago';
  }

  function setActiveChatLabel(label) {
    var text = String(label || '').trim();
    if (!activeChatEl || !activeChatLabelEl) return;
    if (!text) {
      activeChatLabelEl.textContent = '';
      activeChatEl.classList.remove('visible');
      return;
    }
    activeChatLabelEl.textContent = text;
    activeChatEl.classList.add('visible');
  }

  function syncPanelHeaderDensity() {
    if (!panel) return;
    var width = panel.offsetWidth || panel.getBoundingClientRect().width || 0;
    panel.classList.toggle('header-tight', width > 0 && width < 560);
    panel.classList.toggle('header-very-tight', width > 0 && width < 470);
  }

  if (window.ResizeObserver && panel) {
    headerResizeObserver = new window.ResizeObserver(function () {
      syncPanelHeaderDensity();
    });
    headerResizeObserver.observe(panel);
  }

  function snapshotPanelGeometryForRestore() {
    var rect = panel.getBoundingClientRect();
    var computed = window.getComputedStyle(panel);
    panel.dataset.sobsPrevWidth = Math.max(320, Math.round(rect.width)) + 'px';
    panel.dataset.sobsPrevHeight = Math.max(280, Math.round(rect.height)) + 'px';

    if (panel.style.left && panel.style.top) {
      panel.dataset.sobsPrevMode = 'floating';
      panel.dataset.sobsPrevLeft = Math.round(rect.left) + 'px';
      panel.dataset.sobsPrevTop = Math.round(rect.top) + 'px';
      panel.dataset.sobsPrevRight = 'auto';
      panel.dataset.sobsPrevBottom = 'auto';
    } else {
      panel.dataset.sobsPrevMode = 'anchored';
      panel.dataset.sobsPrevLeft = '';
      panel.dataset.sobsPrevTop = '';
      panel.dataset.sobsPrevRight = panel.style.right || computed.right || '';
      panel.dataset.sobsPrevBottom = panel.style.bottom || computed.bottom || '';
    }
  }

  function setExpandedState(expanded) {
    var wasExpanded = panel.classList.contains('expanded');
    if (expanded === wasExpanded) {
      return;
    }

    panel.classList.toggle('expanded', expanded);

    if (expanded) {
      snapshotPanelGeometryForRestore();
      applyExpandedBounds();
    } else {
      panel.style.width = panel.dataset.sobsPrevWidth || '';
      panel.style.height = panel.dataset.sobsPrevHeight || '';
      var mode = String(panel.dataset.sobsPrevMode || 'anchored');
      if (mode === 'floating') {
        panel.style.left = panel.dataset.sobsPrevLeft || '';
        panel.style.top = panel.dataset.sobsPrevTop || '';
        panel.style.right = 'auto';
        panel.style.bottom = 'auto';
      } else {
        panel.style.left = '';
        panel.style.top = '';
        panel.style.right = panel.dataset.sobsPrevRight || '';
        panel.style.bottom = panel.dataset.sobsPrevBottom || '';
      }
      clampPanelSize(true);
      if (mode === 'floating' && panel.style.left && panel.style.top) {
        clampPanelPosition(true);
      }
    }
    if (!expandBtn) {
      return;
    }
    expandBtn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    expandBtn.setAttribute('aria-label', expanded ? 'Collapse AI helper' : 'Expand AI helper');
    expandBtn.setAttribute('title', expanded ? 'Collapse' : 'Expand');
    var icon = expandBtn.querySelector('i');
    if (icon) {
      icon.className = expanded ? 'bi bi-arrows-angle-contract' : 'bi bi-arrows-angle-expand';
    }
    if (expanded) {
      applyExpandedBounds();
    }
  }

  function toggleExpanded() {
    setExpandedState(!panel.classList.contains('expanded'));
  }

  function toggleHistory() {
    panel.classList.toggle('history-collapsed');
    syncPanelHeaderDensity();
  }

  function togglePanel() {
    panel.classList.toggle('open');
    if (panel.classList.contains('open')) {
      if (panel.style.left && panel.style.top) {
        clampPanelPosition();
      }
      syncPanelHeaderDensity();
      inputEl.focus();
      if (!messagesEl.hasChildNodes()) {
        addMsg('assistant', 'Hi! I\'m your SOBS observability assistant. I can help you understand logs, traces, metrics, errors, and more on this page. What would you like to know?', null);
      }
      if (!historyLoaded) {
        loadChatHistory();
      }
      syncActiveChatLabelFromHistory();
    }
  }

  // ===== Paged history state =====
  var historySearchEl = document.getElementById('sobsAiHistorySearchInput');
  var historySentinelEl = document.getElementById('sobsAiHistorySentinel');
  var historyState = { offset: 0, q: '', loading: false, hasMore: true };
  var historyIntersectionObserver = null;
  var historySearchTimer = null;

  function _historyPageSize() {
    // Estimate how many items fit in the visible list height.
    // Each item is ~54px (2-line title+meta + padding + gap).
    var listH = historyListEl ? historyListEl.clientHeight : 0;
    var itemH = 54;
    // Try to measure an existing item for accuracy.
    var existing = historyListEl && historyListEl.querySelector('.sobs-ai-history-item');
    if (existing && existing.offsetHeight > 0) {
      itemH = existing.offsetHeight + 4; // +4 for gap
    }
    var visible = listH > 0 ? Math.floor(listH / itemH) : 10;
    // Fetch 1.5x what's visible so the list fills without an immediate second request, min 5 max 100.
    return Math.max(5, Math.min(Math.ceil(visible * 1.5), 100));
  }

  function _buildHistoryItem(chat) {
    var item = document.createElement('button');
    item.type = 'button';
    item.dataset.chatId = String(chat.chat_id || '');
    item.className = 'sobs-ai-history-item' + (String(chat.chat_id || '') === currentChatId ? ' active' : '');
    var title = document.createElement('div');
    title.className = 'sobs-ai-history-title';
    title.textContent = String(chat.label || 'Chat');
    var meta = document.createElement('div');
    meta.className = 'sobs-ai-history-meta';
    meta.textContent = formatRelativeTime(chat.last_ts) + ' • ' + String(chat.turn_count || 0) + ' turns';
    item.appendChild(title);
    item.appendChild(meta);
    item.addEventListener('click', function () {
      loadChatConversation(String(chat.chat_id || ''));
    });
    return item;
  }

  function _appendHistoryItems(chats) {
    if (!historyListEl || !historySentinelEl) return;
    (chats || []).forEach(function (chat) {
      // insert before sentinel so new items appear above it
      historyListEl.insertBefore(_buildHistoryItem(chat), historySentinelEl);
      // accumulate into cache for label sync
      if (!historyListEl._cachedChats) historyListEl._cachedChats = [];
      historyListEl._cachedChats.push(chat);
    });
  }

  function refreshHistoryActiveState() {
    if (!historyListEl) return;
    historyListEl.querySelectorAll('.sobs-ai-history-item').forEach(function (el) {
      el.classList.toggle('active', el.dataset.chatId === currentChatId);
    });
  }

  async function _fetchHistoryPage() {
    if (historyState.loading || !historyState.hasMore) return;
    historyState.loading = true;
    // show a loading indicator inside sentinel
    var loadingEl = document.createElement('div');
    loadingEl.className = 'sobs-ai-history-loading';
    loadingEl.textContent = '…';
    if (historySentinelEl) historySentinelEl.appendChild(loadingEl);
    try {
      var url = new URL('/api/ai/helper/chats', window.location.origin);
      url.searchParams.set('page', window.location.pathname || '/');
      url.searchParams.set('offset', String(historyState.offset));
      url.searchParams.set('limit', String(_historyPageSize()));
      if (historyState.q) url.searchParams.set('q', historyState.q);
      var resp = await fetch(url.toString());
      var data = await resp.json();
      if (!resp.ok || !data.ok) return;
      historyLoaded = true;
      _appendHistoryItems(data.chats || []);
      historyState.offset += (data.chats || []).length;
      historyState.hasMore = !!data.has_more;
      syncActiveChatLabelFromHistory();
    } catch (_err) {
      // ignore
    } finally {
      if (loadingEl.parentNode) loadingEl.parentNode.removeChild(loadingEl);
      historyState.loading = false;
    }
  }

  function _resetAndLoadHistory() {
    if (!historyListEl || !historySentinelEl) return;
    // remove all history items (keep sentinel)
    Array.from(historyListEl.querySelectorAll('.sobs-ai-history-item')).forEach(function (el) {
      el.parentNode.removeChild(el);
    });
    historyListEl._cachedChats = [];
    historyState.offset = 0;
    historyState.hasMore = true;
    historyState.loading = false;
    _fetchHistoryPage();
  }

  function loadChatHistory() {
    _resetAndLoadHistory();
  }

  // IntersectionObserver: load next page when sentinel scrolls into view
  if (window.IntersectionObserver && historySentinelEl && historyListEl) {
    historyIntersectionObserver = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting && historyState.hasMore && !historyState.loading) {
        _fetchHistoryPage();
      }
    }, { root: historyListEl, threshold: 0.1 });
    historyIntersectionObserver.observe(historySentinelEl);
  }

  // Debounced search
  if (historySearchEl) {
    historySearchEl.addEventListener('input', function () {
      clearTimeout(historySearchTimer);
      historySearchTimer = setTimeout(function () {
        historyState.q = (historySearchEl.value || '').trim().toLowerCase();
        _resetAndLoadHistory();
      }, 300);
    });
  }

  function syncActiveChatLabelFromHistory() {
    var chats = (historyListEl && historyListEl._cachedChats) || [];
    var found = null;
    for (var i = 0; i < chats.length; i += 1) {
      if (String(chats[i].chat_id || '') === currentChatId) {
        found = chats[i];
        break;
      }
    }
    if (found) {
      setActiveChatLabel(String(found.label || 'Chat'));
    } else if (currentChatId) {
      setActiveChatLabel('Chat');
    } else {
      setActiveChatLabel('');
    }
  }

  async function loadChatConversation(chatId) {
    if (!chatId) return;
    try {
      var url = new URL('/api/ai/helper/chats' + '/' + encodeURIComponent(chatId), window.location.origin);
      var resp = await fetch(url.toString());
      var data = await resp.json();
      if (!resp.ok || !data.ok) return;
      while (messagesEl.firstChild) { messagesEl.removeChild(messagesEl.firstChild); }
      (data.messages || []).forEach(function (msg) {
        if (String(msg.kind || 'message') === 'tool') {
          addToolCard(msg, {historical: true});
          return;
        }
        addMsg(String(msg.role || 'assistant'), String(msg.text || ''), String(msg.ts || ''), {
          turnId: String(msg.turn_id || ''),
          chatId: String(data.chat_id || chatId),
          retryQuestion: String(msg.question || ''),
          copyText: String(msg.role || '') === 'assistant' ? String(msg.text || '') : ''
        });
      });
      currentChatId = String(data.chat_id || chatId);
      refreshHistoryActiveState();
      syncActiveChatLabelFromHistory();
      messagesEl.scrollTop = messagesEl.scrollHeight;
      syncPanelHeaderDensity();
      inputEl.focus();
    } catch (_err) {
      // ignore load failures
    }
  }

  async function loadCapabilities() {
    try {
      var capUrl = new URL('/api/ai/helper/capabilities', window.location.origin);
      capUrl.searchParams.set('page', window.location.pathname || '/logs');
      var r = await fetch(capUrl.toString());
      var data = await r.json();
      if (!data || !data.ok) {
        return;
      }
      supportsThinking = !!data.supports_thinking;
      if (thinkingWrapEl) {
        thinkingWrapEl.classList.toggle('active', supportsThinking);
      }
      if (supportsThinking && thinkingLevelEl) {
        thinkingLevelEl.value = String(data.default_thinking_level || 'off');
      }
    } catch (_err) {
      if (thinkingWrapEl) {
        thinkingWrapEl.classList.remove('active');
      }
    }
  }

  function saveChatState() {
    try {
      var hasCustomPosition = !!(panel.style.left && panel.style.top);
      var hasCustomSize = !!(panel.style.width || panel.style.height);
      var state = {
        path: window.location.pathname,
        query: window.location.search,
        isOpen: panel.classList.contains('open'),
        isExpanded: panel.classList.contains('expanded'),
        messagesHtml: stripAssistantMeta(messagesEl.innerHTML),
        statusHtml: statusEl ? statusEl.innerHTML : '',
        statusVisible: statusEl ? statusEl.classList.contains('visible') : false,
        isHistoryCollapsed: panel.classList.contains('history-collapsed'),
        chatId: currentChatId,
        thinkingLevel: thinkingLevelEl ? thinkingLevelEl.value : 'off',
        hasCustomPosition: hasCustomPosition,
        panelLeft: hasCustomPosition ? panel.style.left : '',
        panelTop: hasCustomPosition ? panel.style.top : '',
        hasCustomSize: hasCustomSize,
        panelWidth: hasCustomSize ? panel.style.width : '',
        panelHeight: hasCustomSize ? panel.style.height : '',
        savedAt: Date.now()
      };
      window.sessionStorage.setItem(chatStateKey, JSON.stringify(state));
    } catch (_err) {
      // Ignore storage errors in constrained browser modes.
    }
  }

  function setAiLayerBehindModal(behind) {
    panel.classList.toggle('behind-modal', !!behind);
    btn.classList.toggle('behind-modal', !!behind);
  }

  function syncAiLayerWithModals() {
    setAiLayerBehindModal(!!document.querySelector('.modal.show'));
  }

  function shouldPersistAiState() {
    return panel.classList.contains('open');
  }

  function saveAiStateForNavigation() {
    if (!shouldPersistAiState()) {
      return;
    }
    saveChatState();
  }

  function restoreChatState() {
    try {
      var raw = window.sessionStorage.getItem(chatStateKey);
      if (!raw) return;
      var state = JSON.parse(raw);
      window.sessionStorage.removeItem(chatStateKey);
      if (!state || !state.messagesHtml) return;
      if (Date.now() - Number(state.savedAt || 0) > 5 * 60 * 1000) return;

      messagesEl.innerHTML = stripAssistantMeta(String(state.messagesHtml || ''));
      if (statusEl) {
        statusEl.innerHTML = String(state.statusHtml || '');
        statusEl.classList.toggle('visible', !!state.statusVisible && !!state.statusHtml);
      }
      panel.classList.toggle('open', !!state.isOpen);
      setExpandedState(!!state.isExpanded);
      panel.classList.toggle('history-collapsed', !!state.isHistoryCollapsed);
      if (state.hasCustomSize) {
        if (state.panelWidth) {
          panel.style.width = String(state.panelWidth);
        }
        if (state.panelHeight) {
          panel.style.height = String(state.panelHeight);
        }
        clampPanelSize();
      }
      if (state.hasCustomPosition && state.panelLeft && state.panelTop) {
        panel.style.left = String(state.panelLeft);
        panel.style.top = String(state.panelTop);
        panel.style.right = 'auto';
        panel.style.bottom = 'auto';
        clampPanelPosition();
      }
      currentChatId = String(state.chatId || '');
      syncActiveChatLabelFromHistory();
      if (thinkingLevelEl && state.thinkingLevel) {
        thinkingLevelEl.value = String(state.thinkingLevel);
      }
      messagesEl.scrollTop = messagesEl.scrollHeight;
      syncPanelHeaderDensity();
    } catch (_err) {
      // Ignore malformed state.
    }
  }

  function clearChat() {
    if (currentAbortController) {
      currentAbortController.abort();
      currentAbortController = null;
    }
    while (messagesEl.firstChild) { messagesEl.removeChild(messagesEl.firstChild); }
    if (statusEl) { statusEl.textContent = ''; statusEl.classList.remove('visible'); }
    currentChatId = '';
    setActiveChatLabel('');
    inputEl.value = '';
    inputEl.style.height = '';
    addMsg('assistant', 'Hi! I\'m your SOBS observability assistant. I can help you understand logs, traces, metrics, errors, and more on this page. What would you like to know?', null);
    loadChatHistory();
    inputEl.focus();
  }

  function clamp(value, min, max) {
    return Math.min(Math.max(value, min), max);
  }

  function clampPanelSize(preferInlineSize) {
    if (panel.classList.contains('expanded')) {
      applyExpandedBounds();
      return;
    }
    var minW = 320;
    var minH = 280;
    var maxW = Math.max(minW, window.innerWidth - 8);
    var maxH = Math.max(minH, window.innerHeight - 8);

    var width = panel.offsetWidth;
    var height = panel.offsetHeight;
    if (preferInlineSize) {
      var inlineW = Number.parseFloat(panel.style.width || '');
      var inlineH = Number.parseFloat(panel.style.height || '');
      if (!Number.isNaN(inlineW) && inlineW > 0) {
        width = inlineW;
      }
      if (!Number.isNaN(inlineH) && inlineH > 0) {
        height = inlineH;
      }
    }

    var nextW = clamp(width, minW, maxW);
    var nextH = clamp(height, minH, maxH);
    panel.style.width = nextW + 'px';
    panel.style.height = nextH + 'px';
    syncPanelHeaderDensity();
  }

  function applyExpandedBounds() {
    var margin = 10;
    var left = margin;
    var top = margin;
    var rightEdge = window.innerWidth - margin;
    var bottomEdge = window.innerHeight - margin;
    var sidebar = document.getElementById('sbSidebar');

    if (sidebar) {
      var sbRect = sidebar.getBoundingClientRect();
      var sidebarVisible = sbRect.width > 1 && sbRect.right > 0 && sbRect.left < window.innerWidth;
      if (sidebarVisible) {
        left = Math.max(left, Math.floor(sbRect.right + margin));
      }
    }

    var width = Math.max(320, rightEdge - left);
    var height = Math.max(280, bottomEdge - top);

    panel.style.left = left + 'px';
    panel.style.top = top + 'px';
    panel.style.right = 'auto';
    panel.style.bottom = 'auto';
    panel.style.width = width + 'px';
    panel.style.height = height + 'px';
    syncPanelHeaderDensity();
  }

  function clampPanelPosition(preferInlineSize) {
    if (!(panel.style.left && panel.style.top)) {
      return;
    }
    var rect = panel.getBoundingClientRect();
    var width = rect.width;
    var height = rect.height;
    if (preferInlineSize) {
      var inlineW = Number.parseFloat(panel.style.width || '');
      var inlineH = Number.parseFloat(panel.style.height || '');
      if (!Number.isNaN(inlineW) && inlineW > 0) {
        width = inlineW;
      }
      if (!Number.isNaN(inlineH) && inlineH > 0) {
        height = inlineH;
      }
    }
    var margin = 8;
    var maxLeft = Math.max(margin, window.innerWidth - width - margin);
    var maxTop = Math.max(margin, window.innerHeight - height - margin);
    var currentLeft = Number.parseFloat(panel.style.left) || margin;
    var currentTop = Number.parseFloat(panel.style.top) || margin;
    panel.style.left = clamp(currentLeft, margin, maxLeft) + 'px';
    panel.style.top = clamp(currentTop, margin, maxTop) + 'px';
    panel.style.right = 'auto';
    panel.style.bottom = 'auto';
    syncPanelHeaderDensity();
  }

  function initPanelDrag() {
    var header = document.getElementById('sobsAiPanelHeader');
    if (!header) {
      return;
    }
    var dragState = {
      active: false,
      pointerId: null,
      offsetX: 0,
      offsetY: 0,
    };

    function endDrag() {
      dragState.active = false;
      dragState.pointerId = null;
      panel.classList.remove('dragging');
    }

    header.addEventListener('pointerdown', function (event) {
      if (!panel.classList.contains('open')) {
        return;
      }
      if (event.button !== 0) {
        return;
      }
      var target = event.target;
      if (target && target.closest('button,select,input,textarea,a,label')) {
        return;
      }
      var rect = panel.getBoundingClientRect();
      dragState.active = true;
      dragState.pointerId = event.pointerId;
      dragState.offsetX = event.clientX - rect.left;
      dragState.offsetY = event.clientY - rect.top;
      panel.classList.add('dragging');
      if (typeof header.setPointerCapture === 'function') {
        header.setPointerCapture(event.pointerId);
      }
      event.preventDefault();
    });

    header.addEventListener('pointermove', function (event) {
      if (!dragState.active || event.pointerId !== dragState.pointerId) {
        return;
      }
      var rect = panel.getBoundingClientRect();
      var margin = 8;
      var maxLeft = Math.max(margin, window.innerWidth - rect.width - margin);
      var maxTop = Math.max(margin, window.innerHeight - rect.height - margin);
      var left = clamp(event.clientX - dragState.offsetX, margin, maxLeft);
      var top = clamp(event.clientY - dragState.offsetY, margin, maxTop);
      panel.style.left = left + 'px';
      panel.style.top = top + 'px';
      panel.style.right = 'auto';
      panel.style.bottom = 'auto';
    });

    header.addEventListener('pointerup', function (event) {
      if (dragState.active && event.pointerId === dragState.pointerId) {
        endDrag();
      }
    });

    header.addEventListener('pointercancel', endDrag);
  }

  function applyClientAction(clientAction, statusElRef) {
    if (!clientAction || !clientAction.type) {
      if (statusElRef) {
        statusElRef.textContent = 'No executable action returned';
      }
      return;
    }

    if (clientAction.type === 'navigate') {
      var navTarget = String(clientAction.target_page || window.location.pathname || '/logs');
      var navQuery = clientAction.query && typeof clientAction.query === 'object' ? clientAction.query : {};
      var navUrl = new URL(navTarget, window.location.origin);
      Object.keys(navQuery).forEach(function (key) {
        var value = String(navQuery[key] == null ? '' : navQuery[key]).trim();
        if (value) {
          navUrl.searchParams.set(String(key), value);
        } else {
          navUrl.searchParams.delete(String(key));
        }
      });
      if (statusElRef) {
        statusElRef.textContent = 'Navigating to ' + navTarget + '...';
      }
      saveChatState();
      window.location.href = navUrl.toString();
      return;
    }

    if (clientAction.type === 'open_modal') {
      var modalTarget = String(clientAction.target_page || window.location.pathname || '');
      if (modalTarget && modalTarget !== window.location.pathname) {
        if (statusElRef) {
          statusElRef.textContent = 'Navigating to ' + modalTarget + '...';
        }
        saveChatState();
        window.location.href = new URL(modalTarget, window.location.origin).toString();
        return;
      }
      var modalId = String(clientAction.modal_id || clientAction.modalId || '').replace(/^#/, '');
      var modalEl = modalId ? document.getElementById(modalId) : null;
      if (!modalEl || !window.bootstrap || !window.bootstrap.Modal) {
        if (statusElRef) {
          statusElRef.textContent = 'Modal not found: ' + (modalId || 'unknown');
        }
        return;
      }
      var modal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
      setAiLayerBehindModal(true);
      modal.show();
      if (statusElRef) {
        statusElRef.textContent = 'Opened modal';
      }
      return;
    }

    if (clientAction.type === 'invoke_click') {
      var clickTarget = String(clientAction.target_page || window.location.pathname || '');
      if (clickTarget && clickTarget !== window.location.pathname) {
        if (statusElRef) {
          statusElRef.textContent = 'Navigating to ' + clickTarget + '...';
        }
        saveChatState();
        window.location.href = new URL(clickTarget, window.location.origin).toString();
        return;
      }
      var selector = String(clientAction.selector || '').trim();
      var elementId = String(clientAction.element_id || '').trim();
      var clickEl = null;
      if (selector) {
        clickEl = document.querySelector(selector);
      }
      if (!clickEl && elementId) {
        clickEl = document.getElementById(elementId);
      }
      if (!clickEl || typeof clickEl.click !== 'function') {
        if (statusElRef) {
          statusElRef.textContent = 'Clickable element not found';
        }
        return;
      }
      clickEl.click();
      if (statusElRef) {
        statusElRef.textContent = 'Action clicked';
      }
      return;
    }

    if (clientAction.type === 'submit_form') {
      var submitTarget = String(clientAction.target_page || window.location.pathname || '');
      if (submitTarget && submitTarget !== window.location.pathname) {
        if (statusElRef) {
          statusElRef.textContent = 'Navigating to ' + submitTarget + '...';
        }
        saveChatState();
        window.location.href = new URL(submitTarget, window.location.origin).toString();
        return;
      }
      var actionId = String(clientAction.action_id || '');
      var actionButton = actionId ? document.querySelector('[data-ai-action-id="' + actionId.replace(/"/g, '\\"') + '"]') : null;
      var formSelector = String(clientAction.form_selector || '').trim();
      var formId = String(clientAction.form_id || '').trim();
      var form = null;
      if (actionButton) {
        form = actionButton.closest('form');
      }
      if (!form && formSelector) {
        form = document.querySelector(formSelector);
      }
      if (!form && formId) {
        form = document.getElementById(formId);
      }
      if (!form && actionButton) {
        var actionModal = actionButton.closest('.modal');
        form = actionModal ? actionModal.querySelector('form') : null;
      }
      if (!form) {
        var openModal = document.querySelector('.modal.show');
        form = openModal ? openModal.querySelector('form') : null;
      }
      if (!form && actionId.indexOf('dashboard.chart.create') !== -1) {
        form = document.getElementById('chartEditorForm');
      }
      if (!form) {
        if (statusElRef) {
          statusElRef.textContent = 'Form not found for submit action';
        }
        return;
      }
      var fields = clientAction.fields && typeof clientAction.fields === 'object' ? clientAction.fields : {};
      Object.keys(fields).forEach(function (name) {
        var value = String(fields[name] == null ? '' : fields[name]);
        var field = form.querySelector('[name="' + String(name).replace(/"/g, '\\"') + '"]');
        if (!field) {
          return;
        }
        field.value = value;
        field.dispatchEvent(new Event('input', {bubbles: true}));
        field.dispatchEvent(new Event('change', {bubbles: true}));
      });
      if (statusElRef) {
        statusElRef.textContent = 'Submitting form...';
      }
      saveChatState();
      if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
      } else {
        form.submit();
      }
      return;
    }

    if (clientAction.type === 'apply_sql_filter') {
      var sqlWhere = String(clientAction.sql_where || '').trim();
      if (!sqlWhere) {
        var altSql = [
          clientAction.sql,
          clientAction.where,
          clientAction.filter,
          clientAction.expression,
          clientAction.query
        ];
        for (var si = 0; si < altSql.length; si += 1) {
          var candidate = altSql[si];
          if (typeof candidate === 'string' && candidate.trim()) {
            sqlWhere = candidate.trim();
            break;
          }
          if (candidate && typeof candidate === 'object') {
            var nested = String(candidate.sql_where || candidate.sql || candidate.where || '').trim();
            if (nested) {
              sqlWhere = nested;
              break;
            }
          }
        }
      }
      var targetPage = String(clientAction.target_page || window.location.pathname || '/logs');
      if (!sqlWhere) {
        if (statusElRef) {
          statusElRef.textContent = 'Skipped: empty SQL filter';
        }
        return;
      }

      if (targetPage === window.location.pathname) {
        var sqlInput = document.getElementById('sql-filter-input') || document.querySelector('input[name="sql"]');
        if (!sqlInput) {
          if (statusElRef) {
            statusElRef.textContent = 'No SQL filter input found on this page';
          }
          return;
        }
        sqlInput.value = sqlWhere;
        sqlInput.dispatchEvent(new Event('input', {bubbles: true}));
        sqlInput.dispatchEvent(new Event('change', {bubbles: true}));
        if (clientAction.submit) {
          var filterForm = sqlInput.form || document.querySelector('form[method="get"]');
          if (filterForm) {
            if (statusElRef) {
              statusElRef.textContent = 'Applying filter...';
            }
            saveChatState();
            if (typeof filterForm.requestSubmit === 'function') {
              filterForm.requestSubmit();
            } else {
              filterForm.submit();
            }
            return;
          }
        }
        if (statusElRef) {
          statusElRef.textContent = 'Filter updated in SQL input';
        }
        return;
      }

      var next = new URL(targetPage, window.location.origin);
      next.searchParams.set('sql', sqlWhere);
      if (statusElRef) {
        statusElRef.textContent = 'Navigating to ' + targetPage + ' with filter...';
      }
      saveChatState();
      window.location.href = next.toString();
      return;
    }

    if (clientAction.type === 'start_live_mode') {
      var liveTarget = String(clientAction.target_page || '/logs');
      if (liveTarget === window.location.pathname) {
        var liveBtn = document.querySelector('[data-ai-action-id="logs.live_mode.start"]');
        if (liveBtn && typeof liveBtn.click === 'function') {
          if (statusElRef) {
            statusElRef.textContent = 'Starting live mode...';
          }
          liveBtn.click();
          return;
        }
      }
      var liveUrl = new URL(liveTarget, window.location.origin);
      liveUrl.searchParams.set('live', '1');
      if (statusElRef) {
        statusElRef.textContent = 'Navigating to live mode...';
      }
      saveChatState();
      window.location.href = liveUrl.toString();
      return;
    }

    if (clientAction.type === 'apply_form_filters') {
      var filterTarget = String(clientAction.target_page || '');
      var filters = clientAction.filters && typeof clientAction.filters === 'object' ? clientAction.filters : {};
      var submit = !!clientAction.submit;

      if (!filterTarget) {
        if (statusElRef) {
          statusElRef.textContent = 'Missing target page for filter action';
        }
        return;
      }

      if (filterTarget === window.location.pathname) {
        var actionId = String(clientAction.action_id || '');
        var actionButton = actionId ? document.querySelector('[data-ai-action-id="' + actionId.replace(/"/g, '\\"') + '"]') : null;
        var filterForm = actionButton ? actionButton.closest('form') : document.querySelector('form[method="get"]');
        var appliedCount = 0;
        Object.keys(filters).forEach(function (name) {
          var value = String(filters[name] == null ? '' : filters[name]);
          var selector = '[name="' + String(name).replace(/"/g, '\\"') + '"]';
          var field = filterForm ? filterForm.querySelector(selector) : null;
          if (!field) {
            field = document.querySelector(selector);
          }
          if (!field) {
            return;
          }
          field.value = value;
          field.dispatchEvent(new Event('input', {bubbles: true}));
          field.dispatchEvent(new Event('change', {bubbles: true}));
          appliedCount += 1;
        });

        if (appliedCount === 0) {
          if (statusElRef) {
            statusElRef.textContent = 'No matching filter inputs found on this page';
          }
          return;
        }

        if (submit && filterForm) {
          if (statusElRef) {
            statusElRef.textContent = 'Applying filters...';
          }
          saveChatState();
          if (typeof filterForm.requestSubmit === 'function') {
            filterForm.requestSubmit();
          } else {
            filterForm.submit();
          }
          return;
        }

        if (statusElRef) {
          statusElRef.textContent = 'Updated filter inputs';
        }
        return;
      }

      var filterUrl = new URL(filterTarget, window.location.origin);
      Object.keys(filters).forEach(function (name) {
        var value = String(filters[name] == null ? '' : filters[name]).trim();
        if (value) {
          filterUrl.searchParams.set(String(name), value);
        } else {
          filterUrl.searchParams.delete(String(name));
        }
      });
      if (statusElRef) {
        statusElRef.textContent = 'Navigating to ' + filterTarget + ' with filters...';
      }
      saveChatState();
      window.location.href = filterUrl.toString();
      return;
    }

    if (statusElRef) {
      statusElRef.textContent = 'Unsupported action type: ' + String(clientAction.type);
    }
  }

  async function executeToolAction(tool, statusElRef, confirmed) {
    if (!tool || !tool.action_token) {
      if (statusElRef) {
        statusElRef.textContent = 'Action token unavailable';
      }
      return;
    }
    if (statusElRef) {
      statusElRef.textContent = 'Authorizing action...';
    }

    try {
      var execResp = await fetch('/api/ai/helper/actions/execute', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          action_token: String(tool.action_token || ''),
          confirm: !!confirmed
        })
      });
      var execData = await execResp.json();
      if (!execResp.ok || !execData.ok) {
        if (statusElRef) {
          statusElRef.textContent = String(execData.error || 'Action execution failed');
        }
        return;
      }
      applyClientAction(execData.client_action || null, statusElRef);
    } catch (err) {
      if (statusElRef) {
        statusElRef.textContent = 'Action execution failed: ' + String(err);
      }
    }
  }

  function addToolCard(tool, options) {
    var opts = options || {};
    var card = document.createElement('div');
    card.className = 'sobs-ai-tool-card' + (opts.historical ? ' historical' : '');
    card.dataset.toolPayload = encodeDatasetJson(tool);

    var title = document.createElement('div');
    title.className = 'sobs-ai-tool-title';
    title.innerHTML = '<i class="bi bi-sliders"></i><span>AI Action</span>';
    card.appendChild(title);

    var summary = document.createElement('div');
    summary.textContent = String(tool.summary || 'Proposed action');
    card.appendChild(summary);

    if (tool.action && tool.action.type === 'apply_sql_filter') {
      var code = document.createElement('div');
      code.className = 'sobs-ai-tool-code';
      code.textContent = String(tool.action.sql_where || '');
      card.appendChild(code);
    }

    var status = document.createElement('div');
    status.className = 'sobs-ai-tool-status';
    status.textContent = String(tool.status_label || (tool.unsupported
      ? 'Not available in this page action manifest'
      : (tool.requires_confirmation ? 'Awaiting confirmation' : 'Queued')));

    var actions = document.createElement('div');
    actions.className = 'sobs-ai-tool-actions';

    if (!opts.historical && !tool.unsupported && tool.requires_confirmation) {
      var confirmBtn = document.createElement('button');
      confirmBtn.className = 'btn btn-sm btn-primary';
      confirmBtn.type = 'button';
      confirmBtn.textContent = 'Confirm';
      confirmBtn.setAttribute('data-sobs-ai-tool-action', 'confirm');

      var cancelBtn = document.createElement('button');
      cancelBtn.className = 'btn btn-sm btn-outline-secondary';
      cancelBtn.type = 'button';
      cancelBtn.textContent = 'Dismiss';
      cancelBtn.setAttribute('data-sobs-ai-tool-action', 'dismiss');

      actions.appendChild(confirmBtn);
      actions.appendChild(cancelBtn);
    }

    actions.appendChild(status);
    card.appendChild(actions);
    messagesEl.appendChild(card);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return {card: card, status: status};
  }

  btn.addEventListener('click', togglePanel);
  closeBtn.addEventListener('click', function () { panel.classList.remove('open'); });
  if (newChatBtn) {
    newChatBtn.addEventListener('click', clearChat);
  }
  if (toggleHistoryBtn) {
    toggleHistoryBtn.addEventListener('click', toggleHistory);
  }
  if (expandBtn) {
    expandBtn.addEventListener('click', toggleExpanded);
  }
  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!(target instanceof Element)) {
      return;
    }
    var link = target.closest('a[href]');
    if (!link) {
      return;
    }
    if (link.hasAttribute('download')) {
      return;
    }
    var rel = String(link.getAttribute('rel') || '').toLowerCase();
    if (rel.indexOf('external') !== -1) {
      return;
    }
    var href = String(link.getAttribute('href') || '').trim();
    if (!href || href.charAt(0) === '#') {
      return;
    }
    if (href.toLowerCase().indexOf('javascript:') === 0) {
      return;
    }
    var targetAttr = String(link.getAttribute('target') || '').trim().toLowerCase();
    if (targetAttr && targetAttr !== '_self') {
      return;
    }
    saveAiStateForNavigation();
  }, true);
  document.addEventListener('submit', function (_event) {
    saveAiStateForNavigation();
  }, true);
  window.addEventListener('pagehide', function () {
    saveAiStateForNavigation();
  });
  document.addEventListener('show.bs.modal', function (_evt) {
    setAiLayerBehindModal(true);
  });
  document.addEventListener('hidden.bs.modal', function (_evt) {
    syncAiLayerWithModals();
  });
  messagesEl.addEventListener('click', async function (event) {
    var target = event.target;
    if (!(target instanceof Element)) {
      return;
    }

    var msgButton = target.closest('[data-sobs-ai-msg-action]');
    if (msgButton) {
      var msgEl = msgButton.closest('.sobs-ai-msg');
      if (!msgEl) {
        return;
      }
      var msgAction = String(msgButton.getAttribute('data-sobs-ai-msg-action') || '');
      if (msgAction === 'retry') {
        await sendQuestionText(String(msgEl.dataset.retryQuestion || ''));
      } else if (msgAction === 'copy') {
        var copyText = String(msgEl.dataset.copyText || '').trim();
        if (!copyText) {
          return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(copyText);
          flashMessageActionButton(msgButton, 'Copied');
        } else {
          window.prompt('Copy response:', copyText);
        }
      } else if (msgAction === 'feedback') {
        await submitAssistantFeedback(msgEl, msgButton);
      }
      return;
    }

    var toolButton = target.closest('[data-sobs-ai-tool-action]');
    if (!toolButton) {
      return;
    }
    var card = toolButton.closest('.sobs-ai-tool-card');
    if (!card) {
      return;
    }
    var toolPayload = decodeDatasetJson(card.dataset.toolPayload || '');
    var statusNode = card.querySelector('.sobs-ai-tool-status');
    if (!toolPayload) {
      if (statusNode) {
        statusNode.textContent = 'Action details unavailable';
      }
      return;
    }
    var toolAction = String(toolButton.getAttribute('data-sobs-ai-tool-action') || '');
    if (toolAction === 'dismiss') {
      removeNode(card);
      return;
    }
    if (toolAction === 'confirm') {
      executeToolAction(toolPayload, statusNode, true);
    }
  });
  initPanelDrag();
  window.addEventListener('resize', function () {
    clampPanelSize();
    clampPanelPosition();
    syncPanelHeaderDensity();
  });
  restoreChatState();
  loadCapabilities();
  loadChatHistory();
  syncPanelHeaderDensity();

  function addMsg(role, text, ts, options) {
    var el = document.createElement('div');
    el.className = 'sobs-ai-msg ' + role;
    if (role === 'assistant') {
      el.innerHTML = renderAssistantMarkdown(text);
    } else {
      el.textContent = text;
    }
    syncMessageMeta(el, ts, Object.assign({
      role: role,
      copyText: role === 'assistant' ? stripAssistantMeta(text) : ''
    }, options || {}));
    messagesEl.appendChild(el);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return el;
  }

  function addThinkingMsg() {
    var wrap = document.createElement('div');
    wrap.className = 'sobs-ai-thinking-wrap';
    wrap.setAttribute('aria-label', 'Assistant is thinking');
    wrap.innerHTML = ''
      + '<div class="sobs-ai-msg assistant thinking-msg" aria-hidden="true">'
      + '<div class="sobs-ai-thinking">'
      + '<div class="sobs-ai-thinking-dots">'
      + '<span class="sobs-ai-thinking-dot"></span>'
      + '<span class="sobs-ai-thinking-dot"></span>'
      + '<span class="sobs-ai-thinking-dot"></span>'
      + '</div>'
      + '</div>'
      + '</div>'
      + '<div class="sobs-ai-thinking-label">Thinking</div>';
    messagesEl.appendChild(wrap);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return wrap;
  }

  function sanitizeAssistantHtml(html) {
    if (!window.DOMPurify) {
      return '';
    }
    return window.DOMPurify.sanitize(html, {
      ALLOWED_URI_REGEXP: /^(?:(?:https?):|[^a-z]|[a-z+.-]+(?:[^a-z+.-:]|$))/i,
      FORBID_TAGS: [
        'style',
        'script',
        'iframe',
        'object',
        'embed',
        'form',
        'input',
        'button',
        'select',
        'textarea',
        'label'
      ]
    });
  }

  function hardenRenderedLinks(container) {
    var links = container.querySelectorAll('a[href]');
    links.forEach(function (link) {
      var href = (link.getAttribute('href') || '').trim();
      if (!/^https?:\/\//i.test(href)) {
        link.removeAttribute('href');
        return;
      }
      link.setAttribute('target', '_blank');
      link.setAttribute('rel', 'noopener noreferrer');
    });
  }

  function renderAssistantMarkdown(text) {
    var source = stripAssistantMeta(String(text || ''));
    if (!mdRenderer || !window.DOMPurify) {
      var fallback = document.createElement('div');
      fallback.textContent = source;
      return fallback.innerHTML;
    }
    var rawHtml = mdRenderer.render(source);
    var sanitized = sanitizeAssistantHtml(rawHtml);
    var probe = document.createElement('div');
    probe.innerHTML = sanitized;
    hardenRenderedLinks(probe);
    return probe.innerHTML;
  }

  function addThinkingTraceLink(msgEl, donePayload) {
    if (!msgEl || !donePayload) return;
    var modelStats = donePayload.model_stats || {};
    var thinkingTokens = Number(modelStats.thinking_tokens || 0);
    var logsUrl = String(donePayload.turn_logs_url || '');
    if (!(thinkingTokens > 0) || !logsUrl) {
      return;
    }
    var existing = msgEl.querySelector('.sobs-ai-thinking-trace');
    if (existing) {
      return;
    }
    var link = document.createElement('a');
    link.className = 'sobs-ai-thinking-trace';
    link.href = logsUrl;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.title = 'View model thinking telemetry for this turn';
    link.innerHTML = '<i class="bi bi-lightbulb"></i><span>Thinking trace</span>';
    msgEl.appendChild(link);
  }

  function appendMsgTimestamp(msgEl, ts) {
    if (!msgEl || !ts) return;
    syncMessageMeta(msgEl, ts, {
      role: getMessageRole(msgEl),
      turnId: msgEl.dataset.turnId,
      chatId: msgEl.dataset.chatId,
      retryQuestion: msgEl.dataset.retryQuestion,
      copyText: msgEl.dataset.copyText,
      feedbackSaved: msgEl.dataset.feedbackSaved === '1'
    });
  }

  function tps(stats) {
    if (!stats || !stats.elapsed_ms || stats.elapsed_ms <= 0) return '—';
    var t = (stats.completion_tokens / (stats.elapsed_ms / 1000)).toFixed(1);
    return t + ' t/s';
  }

  function updateStatus(guardStats, modelStats) {
    if (!statusEl) return;
    var parts = [];
    if (guardStats && (guardStats.prompt_tokens || guardStats.completion_tokens || guardStats.elapsed_ms)) {
      parts.push(
        '<span class="stat-group">'
        + '<span class="stat-label">Guard</span>'
        + '<span title="tokens in">' + (guardStats.prompt_tokens || 0) + '↑</span>'
        + '<span title="tokens out">' + (guardStats.completion_tokens || 0) + '↓</span>'
        + '<span title="tokens per second">' + tps(guardStats) + '</span>'
        + '</span>'
      );
    }
    if (modelStats && (modelStats.prompt_tokens || modelStats.completion_tokens || modelStats.elapsed_ms)) {
      if (parts.length) parts.push('<span class="stat-sep">·</span>');
      parts.push(
        '<span class="stat-group">'
        + '<span class="stat-label">Model</span>'
        + '<span title="tokens in">' + (modelStats.prompt_tokens || 0) + '↑</span>'
        + '<span title="tokens out">' + (modelStats.completion_tokens || 0) + '↓</span>'
        + '<span title="tokens per second">' + tps(modelStats) + '</span>'
        + '</span>'
      );
    }
    if (parts.length) {
      statusEl.innerHTML = parts.join('');
      statusEl.classList.add('visible');
    }
  }

  function gatherContext() {
    var ctx = {};
    var params = new URLSearchParams(window.location.search);
    params.forEach(function(v, k) { if (v) ctx[k] = v; });
    return ctx;
  }

  function removeNode(node) {
    if (node && node.parentNode) {
      node.parentNode.removeChild(node);
    }
  }

  function getMessageRole(msgEl) {
    if (!msgEl || !msgEl.classList) {
      return 'assistant';
    }
    if (msgEl.classList.contains('user')) {
      return 'user';
    }
    if (msgEl.classList.contains('assistant')) {
      return 'assistant';
    }
    return 'assistant';
  }

  function buildMessageActionButton(label, iconClass, actionName) {
    var button = document.createElement('button');
    button.type = 'button';
    button.className = 'btn btn-sm btn-link sobs-ai-msg-action';
    button.setAttribute('data-sobs-ai-msg-action', actionName);
    button.setAttribute('aria-label', label);
    button.setAttribute('title', label);
    button.innerHTML = '<i class="' + iconClass + '"></i><span>' + label + '</span>';
    return button;
  }

  function setMessageActionButtonLabel(button, label) {
    if (!button) return;
    var labelEl = button.querySelector('span');
    if (labelEl) {
      labelEl.textContent = label;
    }
  }

  function flashMessageActionButton(button, label) {
    if (!button) return;
    var original = button.dataset.originalLabel;
    if (!original) {
      var labelEl = button.querySelector('span');
      original = labelEl ? labelEl.textContent : '';
      button.dataset.originalLabel = original;
    }
    setMessageActionButtonLabel(button, label);
    window.setTimeout(function () {
      setMessageActionButtonLabel(button, button.dataset.originalLabel || original || '');
    }, 1200);
  }

  function syncMessageMeta(msgEl, ts, options) {
    if (!msgEl) return;
    var opts = options || {};
    var role = String(opts.role || getMessageRole(msgEl));
    if (opts.turnId !== undefined) {
      msgEl.dataset.turnId = String(opts.turnId || '');
    }
    if (opts.chatId !== undefined) {
      msgEl.dataset.chatId = String(opts.chatId || '');
    }
    if (opts.retryQuestion !== undefined) {
      msgEl.dataset.retryQuestion = String(opts.retryQuestion || '');
    }
    if (opts.copyText !== undefined) {
      msgEl.dataset.copyText = String(opts.copyText || '');
    }
    if (opts.feedbackSaved) {
      msgEl.dataset.feedbackSaved = '1';
    }

    var metaEl = msgEl.querySelector('.sobs-ai-msg-meta');
    if (!metaEl) {
      metaEl = document.createElement('div');
      metaEl.className = 'sobs-ai-msg-meta';
      msgEl.appendChild(metaEl);
    }
    metaEl.innerHTML = '';

    if (role === 'assistant') {
      var actionsEl = document.createElement('div');
      actionsEl.className = 'sobs-ai-msg-actions';
      if (msgEl.dataset.retryQuestion) {
        actionsEl.appendChild(buildMessageActionButton('Retry', 'bi bi-arrow-clockwise', 'retry'));
      }
      if (msgEl.dataset.copyText || String(msgEl.textContent || '').trim()) {
        actionsEl.appendChild(buildMessageActionButton('Copy', 'bi bi-clipboard', 'copy'));
      }
      if (msgEl.dataset.turnId) {
        var feedbackBtn = buildMessageActionButton('Feedback', 'bi bi-chat-left-text', 'feedback');
        if (msgEl.dataset.feedbackSaved === '1') {
          feedbackBtn.disabled = true;
          setMessageActionButtonLabel(feedbackBtn, 'Saved');
        }
        actionsEl.appendChild(feedbackBtn);
      }
      if (actionsEl.childNodes.length) {
        metaEl.appendChild(actionsEl);
      }
    }

    var rel = formatRelativeTime(ts);
    if (rel) {
      var timeEl = document.createElement('span');
      timeEl.className = 'sobs-ai-msg-time';
      timeEl.textContent = rel;
      metaEl.appendChild(timeEl);
    }
  }

  function encodeDatasetJson(value) {
    try {
      return encodeURIComponent(JSON.stringify(value || {}));
    } catch (_err) {
      return '';
    }
  }

  function decodeDatasetJson(value) {
    if (!value) return null;
    try {
      return JSON.parse(decodeURIComponent(String(value)));
    } catch (_err) {
      return null;
    }
  }

  async function submitAssistantFeedback(msgEl, button) {
    if (!msgEl || !button) return;
    var note = window.prompt('Add feedback for this assistant response:', '');
    if (note == null) {
      return;
    }
    note = String(note).trim();
    if (!note) {
      return;
    }

    button.disabled = true;
    setMessageActionButtonLabel(button, 'Saving');
    try {
      var resp = await fetch('/api/ai/helper/feedback', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          chat_id: String(msgEl.dataset.chatId || currentChatId || ''),
          turn_id: String(msgEl.dataset.turnId || ''),
          note: note,
          page: window.location.pathname || '/logs'
        })
      });
      var data = await resp.json();
      if (!resp.ok || !data.ok) {
        throw new Error(String(data.error || 'Feedback could not be saved'));
      }
      msgEl.dataset.feedbackSaved = '1';
      setMessageActionButtonLabel(button, 'Saved');
    } catch (err) {
      button.disabled = false;
      setMessageActionButtonLabel(button, 'Feedback');
      addMsg('error-msg', 'Feedback error: ' + String(err), new Date().toISOString());
    }
  }

  function addStreamingAssistantMsg() {
    var el = document.createElement('div');
    el.className = 'sobs-ai-msg assistant';
    el.textContent = '';
    messagesEl.appendChild(el);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return el;
  }

  function stripAssistantMeta(text) {
    var cleaned = String(text || '')
      .replace(/<assistant_meta\b[^>]*>[\s\S]*?<\/assistant_meta>/gi, '')
      .replace(/&lt;\s*assistant_meta\b(?:[\s\S]*?)&gt;[\s\S]*?&lt;\s*\/assistant_meta\s*&gt;/gi, '');
    var rawOpenIndex = cleaned.search(/<assistant_meta\b[^>]*>/i);
    var escapedOpenIndex = cleaned.search(/&lt;\s*assistant_meta\b(?:[\s\S]*?)&gt;/i);
    var cutIndex = -1;
    if (rawOpenIndex >= 0) {
      cutIndex = rawOpenIndex;
    }
    if (escapedOpenIndex >= 0 && (cutIndex === -1 || escapedOpenIndex < cutIndex)) {
      cutIndex = escapedOpenIndex;
    }
    if (cutIndex >= 0) {
      cleaned = cleaned.slice(0, cutIndex);
    }
    return cleaned.trim();
  }

  function stripAssistantMetaPreview(text) {
    return stripAssistantMeta(text).trimEnd();
  }

  function setStreamingText(el, text, finalize) {
    if (!el) return;
    var cleaned = stripAssistantMeta(text);
    if (finalize) {
      el.innerHTML = renderAssistantMarkdown(cleaned);
    } else {
      el.textContent = cleaned;
    }
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function detectCompleteBlocks(text) {
    var blocks = [];
    var idx = 0;
    var buffer = String(text || '');

    // Render complete code fences as blocks as soon as the closing fence arrives.
    while (true) {
      var startFence = buffer.indexOf('```', idx);
      if (startFence === -1) {
        break;
      }
      var endFence = buffer.indexOf('```', startFence + 3);
      if (endFence === -1) {
        break;
      }
      var afterFence = endFence + 3;
      if (startFence > idx) {
        blocks.push(buffer.slice(idx, startFence));
      }
      blocks.push(buffer.slice(startFence, afterFence));
      idx = afterFence;
      if (buffer.charAt(idx) === '\n') {
        idx += 1;
      }
    }

    var remainder = buffer.slice(idx);
    var paraCut = remainder.lastIndexOf('\n\n');
    if (paraCut !== -1) {
      blocks.push(remainder.slice(0, paraCut + 2));
      remainder = remainder.slice(paraCut + 2);
    }

    return { blocks: blocks, tail: remainder };
  }

  function appendRenderedMarkdownBlock(el, text) {
    if (!el || !text || !text.trim()) return;
    var html = renderAssistantMarkdown(text);
    if (!html) return;
    var blockEl = document.createElement('div');
    blockEl.className = 'sobs-markdown-block';
    blockEl.innerHTML = html;
    el.appendChild(blockEl);
  }

  function isMarkdownTableTail(text) {
    var s = String(text || '');
    if (!s || s.indexOf('|') === -1) {
      return false;
    }
    var lines = s.split('\n').filter(function (line) {
      return line.trim() !== '';
    });
    if (lines.length < 2) {
      return false;
    }
    var header = lines[0].trim();
    var sep = lines[1].trim();
    var sepPattern = /^\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)+\|?$/;
    if (header.indexOf('|') === -1 || !sepPattern.test(sep)) {
      return false;
    }
    return true;
  }

  function setTailText(el, text) {
    if (!el) return;
    var tailEl = el.querySelector('.sobs-markdown-tail');
    var tailText = stripAssistantMetaPreview(String(text || ''));
    if (!tailText) {
      if (tailEl) {
        removeNode(tailEl);
      }
      return;
    }
    if (!tailEl) {
      tailEl = document.createElement('div');
      tailEl.className = 'sobs-markdown-tail';
      el.appendChild(tailEl);
    }
    if (isMarkdownTableTail(tailText)) {
      tailEl.innerHTML = renderAssistantMarkdown(tailText);
    } else {
      tailEl.textContent = tailText;
    }
  }

  function parseSseChunk(block) {
    var lines = block.split('\n');
    var eventName = 'message';
    var dataLines = [];
    lines.forEach(function (line) {
      if (line.startsWith('event:')) {
        eventName = line.slice(6).trim();
      } else if (line.startsWith('data:')) {
        var dataPart = line.slice(5);
        if (dataPart.startsWith(' ')) {
          dataPart = dataPart.slice(1);
        }
        dataLines.push(dataPart);
      }
    });
    var payload = {};
    if (dataLines.length) {
      try {
        payload = JSON.parse(dataLines.join('\n'));
      } catch (_err) {
        payload = {error: dataLines.join('\n')};
      }
    }
    return {event: eventName, payload: payload};
  }

  async function consumeAiStream(response, thinking, questionText) {
    var reader = response.body && response.body.getReader ? response.body.getReader() : null;
    if (!reader) {
      throw new Error('Streaming not supported by this browser');
    }
    var decoder = new TextDecoder();
    var buffer = '';
    var fullAnswer = '';
    var pendingAnswer = '';
    var answerEl = null;
    var guardStats = null;
    var modelStats = null;
    var queuedAutoTools = [];
    var finalDonePayload = null;

    try {
      while (true) {
        var result = await reader.read();
        if (result.done) {
          break;
        }
        buffer += decoder.decode(result.value, {stream: true});
        var parts = buffer.split('\n\n');
        buffer = parts.pop() || '';
        for (var i = 0; i < parts.length; i += 1) {
          var parsed = parseSseChunk(parts[i]);
          if (parsed.event === 'meta') {
            if (parsed.payload.chat_id) {
              currentChatId = String(parsed.payload.chat_id);
              syncActiveChatLabelFromHistory();
            }
            if (parsed.payload.supports_thinking !== undefined) {
              supportsThinking = !!parsed.payload.supports_thinking;
              if (thinkingWrapEl) {
                thinkingWrapEl.classList.toggle('active', supportsThinking);
              }
            }
            if (supportsThinking && thinkingLevelEl && parsed.payload.thinking_level) {
              thinkingLevelEl.value = String(parsed.payload.thinking_level);
            }
          } else if (parsed.event === 'guard') {
            guardStats = parsed.payload.guard_stats || null;
            updateStatus(guardStats, modelStats);
          } else if (parsed.event === 'token') {
            if (!answerEl) {
              removeNode(thinking);
              answerEl = addStreamingAssistantMsg();
            }
            var piece = String(parsed.payload.text || '');
            fullAnswer += piece;
            pendingAnswer += piece;
            var batches = detectCompleteBlocks(pendingAnswer);
            batches.blocks.forEach(function (block) {
              appendRenderedMarkdownBlock(answerEl, block);
            });
            pendingAnswer = batches.tail;
            setTailText(answerEl, pendingAnswer);
          } else if (parsed.event === 'tool') {
            var toolPayload = parsed.payload || {};
            var toolUi = addToolCard(toolPayload);
            if (!toolPayload.requires_confirmation) {
              queuedAutoTools.push({tool: toolPayload, ui: toolUi});
              toolUi.status.textContent = 'Will apply after response';
            }
          } else if (parsed.event === 'done') {
            removeNode(thinking);
            if (!answerEl) {
              answerEl = addStreamingAssistantMsg();
            }
            finalDonePayload = parsed.payload || {};
            fullAnswer = String(parsed.payload.answer || fullAnswer);
            modelStats = parsed.payload.model_stats || null;
            if (parsed.payload.chat_id) {
              currentChatId = String(parsed.payload.chat_id);
              syncActiveChatLabelFromHistory();
            }
            updateStatus(parsed.payload.guard_stats || guardStats, modelStats);
            setStreamingText(answerEl, fullAnswer, true);
            syncMessageMeta(answerEl, new Date().toISOString(), {
              role: 'assistant',
              turnId: String(parsed.payload.turn_id || ''),
              chatId: currentChatId,
              retryQuestion: questionText,
              copyText: stripAssistantMeta(fullAnswer)
            });
            addThinkingTraceLink(answerEl, parsed.payload);
            queuedAutoTools.forEach(function (item) {
              executeToolAction(item.tool, item.ui.status, false);
            });
            queuedAutoTools = [];
            loadChatHistory();
          } else if (parsed.event === 'error') {
            removeNode(thinking);
            addMsg('error-msg', 'Error: ' + (parsed.payload.error || 'unknown'));
            return;
          }
        }
      }

      removeNode(thinking);
      if (answerEl && fullAnswer) {
        setStreamingText(answerEl, fullAnswer, true);
        syncMessageMeta(answerEl, new Date().toISOString(), {
          role: 'assistant',
          turnId: String((finalDonePayload && finalDonePayload.turn_id) || ''),
          chatId: currentChatId,
          retryQuestion: questionText,
          copyText: stripAssistantMeta(fullAnswer)
        });
        addThinkingTraceLink(answerEl, finalDonePayload);
      } else if (answerEl && pendingAnswer) {
        setStreamingText(answerEl, pendingAnswer, true);
        syncMessageMeta(answerEl, new Date().toISOString(), {
          role: 'assistant',
          turnId: String((finalDonePayload && finalDonePayload.turn_id) || ''),
          chatId: currentChatId,
          retryQuestion: questionText,
          copyText: stripAssistantMeta(pendingAnswer)
        });
        addThinkingTraceLink(answerEl, finalDonePayload);
      }
    } catch (err) {
      if (err.name === 'AbortError') {
        removeNode(thinking);
        addMsg('info-msg', 'Request cancelled');
      } else {
        throw err;
      }
    } finally {
      reader.cancel();
      currentAbortController = null;
    }
  }

  async function sendQuestionText(questionText) {
    var q = String(questionText || '').trim();
    if (!q) return;
    
    if (currentAbortController) {
      currentAbortController.abort();
      currentAbortController = null;
    }
    
    addMsg('user', q, new Date().toISOString(), {chatId: currentChatId});
    inputEl.value = '';
    inputEl.style.height = '';

    var thinking = addThinkingMsg();

    try {
      currentAbortController = new AbortController();
      var response = await fetch('/api/ai/helper', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'text/event-stream'
        },
        signal: currentAbortController.signal,
        body: JSON.stringify({
          question: q,
          page: window.location.pathname,
          context: gatherContext(),
          chat_id: currentChatId,
          thinking_level: (thinkingLevelEl && supportsThinking) ? thinkingLevelEl.value : 'off',
          stream: true
        })
      });

      var contentType = response.headers.get('content-type') || '';
      if (contentType.indexOf('text/event-stream') !== -1) {
        await consumeAiStream(response, thinking, q);
        return;
      }

      var data = await response.json();
      removeNode(thinking);
      if (data.ok) {
        if (data.chat_id) {
          currentChatId = String(data.chat_id);
          syncActiveChatLabelFromHistory();
        }
        var msgEl = addMsg('assistant', data.answer, new Date().toISOString(), {
          turnId: String(data.turn_id || ''),
          chatId: currentChatId,
          retryQuestion: q,
          copyText: String(data.answer || '')
        });
        addThinkingTraceLink(msgEl, data);
        updateStatus(data.guard_stats || null, data.model_stats || null);
        loadChatHistory();
      } else {
        addMsg('error-msg', 'Error: ' + (data.error || 'unknown'), new Date().toISOString());
      }
    } catch (err) {
      removeNode(thinking);
      addMsg('error-msg', 'Network error: ' + err, new Date().toISOString());
    }
  }

  async function sendQuestion() {
    await sendQuestionText(inputEl.value.trim());
  }

  sendBtn.addEventListener('click', sendQuestion);
  inputEl.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendQuestion();
    }
  });

  // Auto-resize textarea
  inputEl.addEventListener('input', function () {
    this.style.height = '';
    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
  });
}());
</script>
</body>
</html>