          <option value="120">2m</option>
          <option value="300">5m</option>
        </select>
      </div>
    </div>
    <button id="dashboardRefreshModalBtn" type="button" class="btn btn-outline-secondary btn-sm d-none" title="Auto-refresh" aria-label="Auto-refresh" data-bs-toggle="modal" data-bs-target="#dashboardRefreshModal">
      <i class="bi bi-arrow-repeat me-1"></i><span class="custom-dashboard-btn-label">Refresh</span>
    </button>
    <button class="btn btn-primary btn-sm js-add-chart-btn" data-bs-toggle="modal" data-bs-target="#addChartModal"
            title="Add Chart"
            data-ai-action-id="dashboard.chart.modal.open"
            data-ai-action-type="open_modal"
            data-ai-handler="openModal"
            data-ai-args='{"modal_id":"addChartModal"}'
            data-ai-label="Open add chart modal"
            data-ai-risk="low"
            data-ai-confirm="false">
      <i class="bi bi-plus-lg me-1"></i><span class="custom-dashboard-btn-label">Add Chart</span>
    </button>
    <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#importChartModal" title="Import Chart from JSON template">
      <i class="bi bi-upload me-1"></i><span class="custom-dashboard-btn-label">Import Chart</span>
    </button>
        <form method="post" action="/dashboards/d0000000-0000-4000-8000-00000000d001/delete"
          data-confirm-title="Delete Dashboard"
          data-confirm-message="Delete this dashboard and all its charts?"
