<!-- Import Chart Modal -->
<div class="modal fade" id="importChartModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-upload me-2"></i>Import Chart Template</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="small text-secondary mb-3">Select a previously exported <code>.json</code> chart template to add it to this dashboard.</p>
        <div class="mb-3">
          <label class="form-label small fw-semibold">Chart Template File</label>
          <input type="file" id="importChartFileInput" class="form-control form-control-sm" accept=".json,application/json">
        </div>
        <div class="mb-3">
          <label class="form-label small fw-semibold">Title (optional override)</label>
          <input type="text" id="importChartTitleInput" class="form-control form-control-sm" placeholder="Leave blank to use template title">
        </div>
        <div id="importChartStatus" class="small"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" id="importChartSubmitBtn">
          <i class="bi bi-upload me-1"></i>Import
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Add Chart Modal -->
<div class="modal fade" id="addChartModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable" style="max-width:min(96vw, 1480px);">
    <div class="modal-content">
      <form method="post" action="/dashboards/d0000000-0000-4000-8000-00000000d001/charts" id="chartEditorForm">
        <div class="modal-header">
          <h5 class="modal-title" id="chartEditorModalTitle">Add Chart</h5>
          <div class="d-flex gap-2 align-items-center ms-auto">
              <a href="/table-explorer" class="btn btn-sm btn-outline-secondary" title="Browse available tables, columns, and sample data">
                <i class="bi bi-grid-3x3 me-1"></i>Table Explorer
              </a>
            <a href="/dashboards/help/chart-editor" target="_blank" class="link-secondary text-decoration-none" title="Chart Help" aria-label="Chart Help" style="opacity:.75; font-size:1.1rem; line-height:1;"><i class="bi bi-question-circle"></i></a>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
        </div>
        <div class="modal-body">
          <input type="hidden" id="chartSpecJson" name="chart_spec_json" value="">
          <div class="mb-3">
            <label class="form-label">Title <span class="text-danger">*</span></label>
            <input type="text" id="chartTitleInput" name="title" class="form-control" placeholder="e.g. Request Latency" required>
          </div>
          <!-- AI Chart Builder panel -->
          <div class="card border-primary border-opacity-50 mb-3" id="aiBuilderPanel">
            <div class="card-header py-2 d-flex justify-content-between align-items-center" style="cursor:pointer;" id="aiBuilderHeader" data-bs-toggle="collapse" data-bs-target="#aiBuilderBody">
              <span class="small fw-semibold"><i class="bi bi-stars me-1 text-primary"></i>AI Chart Builder <span class="badge bg-primary ms-1" style="font-size:0.65rem;">Beta</span></span>
              <i class="bi bi-chevron-down small text-secondary" id="aiBuilderChevron"></i>
            </div>
            <div class="collapse" id="aiBuilderBody">
              <div class="card-body p-2">
                <p class="small text-secondary mb-2">Describe the chart you want in plain English. The AI will generate SQL and an eCharts config for you. You can refine the result manually after.</p>
                <div class="mb-2">
                  <label class="form-label small fw-semibold">Chart description</label>
                  <textarea id="aiBuilderQuestion" class="form-control form-control-sm" rows="3" placeholder="e.g. Show me a bar chart of the top 10 services by error count in the last 24 hours"></textarea>
                </div>
                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <label class="form-label small">Preferred chart type (optional)</label>
                    <select id="aiBuilderChartType" class="form-select form-select-sm">
                      <option value="">Auto (let AI choose)</option>
                      <option value="line">Line</option>
                      <option value="bar">Bar</option>
                      <option value="pie">Pie</option>
                      <option value="scatter">Scatter</option>
                      <option value="heatmap">Heatmap</option>
                      <option value="sankey">Sankey</option>
                      <option value="graph">Graph</option>
                      <option value="gauge">Gauge</option>
                    </select>
                  </div>
                  <div class="col-6">
                    <label class="form-label small">Chart instruction (optional)</label>
                    <input type="text" id="aiBuilderInstruction" class="form-control form-control-sm" placeholder="e.g. use blue colors">
                  </div>
                </div>
                <div class="d-flex gap-2 align-items-center mb-2">
                  <button type="button" class="btn btn-primary btn-sm" id="aiBuilderBuildBtn">
                    <i class="bi bi-stars me-1"></i>Build with AI
                  </button>
                  <span id="aiBuilderSpinner" class="d-none"><span class="spinner-border spinner-border-sm me-1" role="status"></span>Generating…</span>
                </div>
                <div id="aiBuilderStatus" class="small text-secondary"></div>
              </div>
            </div>
          </div>
          <div class="row g-3">
            <div class="col-lg-6">
              <div class="card border-secondary h-100">
                <div class="card-header py-2 small text-secondary">SQL Builder</div>
                <div class="card-body p-2">
                  <div class="mb-2">
                    <label class="form-label small">SQL Mode</label>
                    <select id="sqlModeSelect" class="form-select form-select-sm">
                      <option value="builder" selected>Builder</option>
                      <option value="raw">Raw SQL</option>
                    </select>
                  </div>
                  <div id="builderFieldsWrap">
                  <div class="mb-2">
                    <label class="form-label small">Source (View or Base Table)</label>
                    <select id="sourceViewInput" class="form-select form-select-sm">
                      <option value="v_derived_signals_anomaly" selected>v_derived_signals_anomaly</option>
                      <option value="v_otel_metrics_anomaly">v_otel_metrics_anomaly</option>
                      <option value="otel_metrics_gauge">otel_metrics_gauge</option>
                      <option value="otel_metrics_sum">otel_metrics_sum</option>
                      <option value="otel_metrics_histogram">otel_metrics_histogram</option>
                      <option value="otel_traces">otel_traces</option>
                      <option value="otel_logs">otel_logs</option>
                      <option value="sobs_error_resolutions">sobs_error_resolutions</option>
                    </select>
                  </div>
                  <div class="row g-2 mb-2">
                    <div class="col-6">
                      <label class="form-label small">Service</label>
                      <input id="serviceInput" list="serviceOptionsList" class="form-control form-control-sm" placeholder="optional">
                      <datalist id="serviceOptionsList"></datalist>
                    </div>
                    <div class="col-6">
                      <label class="form-label small">Attr FP</label>
                      <input id="attrFpInput" class="form-control form-control-sm font-monospace" placeholder="optional">
                    </div>
                  </div>
                  <div class="row g-2 mb-2" id="derivedSignalBuilderFields">
                    <div class="col-6">
                      <label class="form-label small">Signal Source</label>
                      <select id="signalSourceInput" class="form-select form-select-sm">
                        <option value="traces" selected>traces</option>
                        <option value="logs">logs</option>
                        <option value="errors">errors</option>
                      </select>
                    </div>
                    <div class="col-6">
                      <label class="form-label small">Signal Name</label>
                      <input id="signalNameInput" list="signalOptionsList" class="form-control form-control-sm" value="trace_volume">
                      <datalist id="signalOptionsList"></datalist>
                    </div>
                  </div>
                  <div class="row g-2 mb-2 d-none" id="metricBuilderFields">
                    <div class="col-12">
                      <label class="form-label small">Metric Name</label>
                      <input id="metricNameInput" list="metricOptionsList" class="form-control form-control-sm" placeholder="http.server.duration">
                      <datalist id="metricOptionsList"></datalist>
                    </div>
                  </div>
                  <div class="row g-2 mb-2">
                    <div class="col-6">
                      <label class="form-label small">Window (hours)</label>
                      <input id="windowHoursInput" type="number" min="1" max="168" value="6" class="form-control form-control-sm">
                    </div>
                    <div class="col-6">
                      <label class="form-label small">Limit</label>
                      <input id="limitInput" type="number" min="1" max="2000" value="1000" class="form-control form-control-sm">
                    </div>
                  </div>
                  </div>
                  <div class="small text-secondary mb-2 d-none" id="rawSqlModeHint">Builder filters are hidden in Raw SQL mode. Your query text is used as-is.</div>
                  <div class="mb-2">
                    <label class="form-label small">Raw SQL Override</label>
                    <textarea id="queryInput" name="query" class="form-control font-monospace" rows="5" placeholder="SELECT ..."></textarea>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-lg-6">
              <div class="card border-secondary h-100">
                <div class="card-header py-2 small text-secondary">Visual Builder</div>
                <div class="card-body p-2">
                  <div class="mb-2">
                    <label class="form-label small">Chart Template</label>
                    <select name="template_id" class="form-select form-select-sm" id="templateSelect">
                      
                      <option value="anomaly_overlay" title="Metric with baseline band and per-point anomaly state markers (normal/warning/outlier)">Anomaly Overlay</option>
                      
                      <option value="box_plot" title="Show distribution, quartiles, and outliers">Distribution Box Plot</option>
                      
                      <option value="custom_echarts" title="Bring your own SQL, mapping JSON, and raw ECharts option JSON.">Custom ECharts</option>
                      
                      <option value="derived_signal_overlay" title="At-a-glance signal health view with recent focus, anomaly windows, and status summary">Derived Signal Overlay</option>
                      
                      <option value="dual_axis_anomaly" title="Compare metric vs anomaly detection signal on dual axes">Metric + Anomaly Score</option>
                      
                      <option value="gauge_kpi" title="Single-value gauge for KPI monitoring (SLA %, uptime %)">KPI Gauge</option>
                      
                      <option value="heatmap" title="2D heatmap for correlating errors across dimensions">Heatmap</option>
                      
                      <option value="time_series_percentiles" title="Show metric with percentile bands for anomaly detection">Time Series with Normal Range</option>
                      
                    </select>
                  </div>
