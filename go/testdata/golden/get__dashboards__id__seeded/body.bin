  </div>
  <div class="d-flex gap-2 align-items-center">
    <div id="dashboardRefreshInlineGroup" class="d-flex align-items-center gap-2" title="Auto-refresh interval">
      <span id="refreshCountdown" class="text-secondary" style="font-size:0.75rem; min-width:2rem; display:none;"></span>
      <div class="input-group input-group-sm" style="width:auto;">
        <span class="input-group-text px-2"><i class="bi bi-arrow-repeat" style="font-size:0.85rem;"></i></span>
        <select id="refreshIntervalSelect" class="form-select form-select-sm" style="width:auto;">
          <option value="0">Off</option>
          <option value="10">10s</option>
