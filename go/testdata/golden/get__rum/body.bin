  }
  
  function updateLabel() {
    const checked = getSelectedValues();
    const checkedLabels = getSelectedLabels();
    
    if (checked.length === 0) {
      label.textContent = `All error source`;
      label.title = `All error source`;
    } else if (checked.length === 1) {
      label.textContent = checkedLabels[0] || checked[0];
      label.title = checkedLabels[0] || checked[0];
    } else {
      label.textContent = `${checked.length} selected`;
      label.title = checkedLabels.join(', ');
    }

    if (clearBtn) {
      clearBtn.hidden = singleSelect || checked.length <= 1;
    }

    syncOptionVisuals();
    
    // Update hidden fields for form submission
    hiddenFieldsContainer.innerHTML = '';
    checked.forEach(value => {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = inputName;
      input.value = value;
      hiddenFieldsContainer.appendChild(input);
    });
  }

  function updateMenuWidth() {
    if (!dropdownMenu || !btn) {
      return;
    }

    // Clear any previous explicit size before measuring.
    dropdownMenu.style.width = '';

    const triggerWidth = Math.ceil(btn.getBoundingClientRect().width);
    let contentWidth = 0;

    const computed = window.getComputedStyle(btn);
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    if (ctx) {
      ctx.font = `${computed.fontStyle} ${computed.fontVariant} ${computed.fontWeight} ${computed.fontSize} / ${computed.lineHeight} ${computed.fontFamily}`;
    }

    options.forEach((option) => {
      const text = String(option.dataset.optionValue || '').trim();
      if (!text) {
        return;
      }
      if (ctx) {
        contentWidth = Math.max(contentWidth, Math.ceil(ctx.measureText(text).width));
      } else {
        const textNode = option.querySelector('.sobs-multi-select-option-text');
        if (textNode) {
          contentWidth = Math.max(contentWidth, Math.ceil(textNode.scrollWidth));
        }
      }
    });

    // Extra room for menu padding and the right-side checkmark.
    const horizontalChrome = 72;
    const desired = Math.max(triggerWidth, contentWidth + horizontalChrome);
    const viewportCap = Math.floor(window.innerWidth * 0.9);
    const absoluteCap = 900;
    const finalWidth = Math.min(desired, viewportCap, absoluteCap);

    dropdownMenu.style.width = `${finalWidth}px`;
  }
  
  // Wait for DOM to be ready if needed
  function initialize() {
    // Initialize
    updateLabel();
    updateMenuWidth();
    
    // Toggle selection state on option click
    options.forEach(option => {
      option.addEventListener('click', () => {
        if (singleSelect) {
          options.forEach((item) => item.classList.remove('is-selected'));
          option.classList.add('is-selected');
        } else {
          option.classList.toggle('is-selected');
        }
        updateLabel();
        const event = new CustomEvent('sobs:filters:changed', { bubbles: true });
        option.dispatchEvent(event);
        // Auto-submit form when filter changes
        const form = option.closest('form');
        if (autoSubmit && form) {
          form.submit();
        }
      });
    });
    
    // Prevent dropdown from closing when clicking inside
    if (dropdownMenu) {
      dropdownMenu.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      // Recalculate width right before showing in case option content changed.
      dropdown.addEventListener('show.bs.dropdown', updateMenuWidth);
      dropdown.addEventListener('shown.bs.dropdown', updateMenuWidth);
      btn.addEventListener('click', updateMenuWidth);
      window.addEventListener('resize', updateMenuWidth);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        options.forEach((option) => option.classList.remove('is-selected'));
        updateLabel();
        const event = new CustomEvent('sobs:filters:changed', { bubbles: true });
        clearBtn.dispatchEvent(event);
        const form = clearBtn.closest('form');
        if (autoSubmit && form) {
          form.submit();
        }
      });
    }
  }
  
  // Run immediately if DOM is ready, otherwise wait
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize);
  } else {
    initialize();
  }
})();

(function () {
  if (window.__sobsFilterFormEnhancementsInit) {
    return;
  }
  window.__sobsFilterFormEnhancementsInit = true;

  function findSubmitButton(form) {
    return form.querySelector('[data-ai-action-role="filter-submit"], button[type="submit"]');
  }

  function flashSubmitButton(form) {
    const submitButton = findSubmitButton(form);
    if (!submitButton) {
      return;
    }
    submitButton.classList.remove('sobs-filter-submit-dirty');
    // Force reflow so repeated flashes retrigger animation.
    void submitButton.offsetWidth;
    submitButton.classList.add('sobs-filter-submit-dirty');
  }

  function shouldAutoSubmitOnChange(target) {
    if (!target) {
      return false;
    }
    if (target.tagName === 'SELECT') {
      return true;
    }
    if (target.tagName === 'INPUT') {
      const inputType = (target.type || '').toLowerCase();
      return ['checkbox', 'radio', 'number', 'range', 'date', 'datetime-local', 'time', 'month', 'week'].includes(inputType);
    }
    return false;
  }

  document.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }
    const form = target.closest('form.sobs-filter-form');
    if (!form) {
      return;
    }
    flashSubmitButton(form);
    if (shouldAutoSubmitOnChange(target)) {
      form.submit();
    }
  });

  document.addEventListener('input', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }
    const form = target.closest('form.sobs-filter-form');
    if (!form) {
      return;
    }
    flashSubmitButton(form);
  });

  document.addEventListener('sobs:filters:changed', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }
    const form = target.closest('form.sobs-filter-form');
    if (!form) {
      return;
    }
    flashSubmitButton(form);
  });
})();
</script>

<style>
  .sobs-multi-select-toggle {
    text-align: left;
    padding-right: 3.5rem;
    background-position: right 0.75rem center;
    cursor: pointer;
  }

  .sobs-multi-select-wrap {
    position: relative;
  }

  .sobs-multi-select-clear-btn {
    position: absolute;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    border: 0;
    background: transparent;
    color: var(--bs-secondary-color);
    width: 1rem;
    height: 1rem;
    padding: 0;
    line-height: 1;
    opacity: 0.75;
  }

  .sobs-multi-select-clear-btn:hover {
    opacity: 1;
    color: var(--bs-body-color);
  }

  .sobs-multi-select-label {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 400;
  }

  .sobs-multi-select-menu {
    min-width: 100%;
    width: 100%;
    max-width: min(700px, 90vw);
    margin-left: -0.45rem;
    max-height: min(360px, 60vh);
    overflow-x: auto;
    overflow-y: auto;
  }

  .sobs-multi-select-option {
    transition: background-color 0.15s ease-in-out;
    cursor: pointer;
    font-size: 0.875rem;
    line-height: 1.5;
    font-weight: 400;
    white-space: nowrap;
    gap: 0.24rem;
  }

  .sobs-multi-select-option-text {
    flex: 1 1 auto;
    min-width: max-content;
    padding-right: 0.25rem;
  }

  .sobs-multi-select-option:hover {
    background-color: rgba(13, 110, 253, 0.08);
  }

  .sobs-multi-select-option.is-selected,
  .sobs-multi-select-option.is-selected:focus,
  .sobs-multi-select-option.is-selected:active {
    color: inherit;
    background-color: rgba(13, 110, 253, 0.08);
  }

  .sobs-multi-select-checkmark {
    width: 0.84rem;
    min-width: 0.84rem;
    opacity: 0;
    color: var(--bs-secondary-color);
  }

  .sobs-multi-select-checkmark.visible {
    opacity: 1;
    color: var(--bs-body-color);
  }

  .sobs-filter-submit-dirty {
    animation: sobsFilterSubmitFlash 850ms ease-out;
  }

  @keyframes sobsFilterSubmitFlash {
    0% {
      box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.55);
    }
    100% {
      box-shadow: 0 0 0 7px rgba(13, 110, 253, 0);
    }
  }
</style>


