  const clearBtn = document.getElementById(clearBtnId);
  const label = document.getElementById(labelId);
  const hiddenFieldsContainer = document.getElementById(hiddenFieldsId);
  const dropdown = document.getElementById(`dropdown-${filterName}`);
  const dropdownMenu = dropdown ? dropdown.querySelector('.dropdown-menu') : null;
  
  // Find all selectable options for this filter
  const options = document.querySelectorAll(`button[data-filter-option="${filterName}"]`);
  
  function getSelectedValues() {
    return Array.from(options)
      .filter(option => option.classList.contains('is-selected'))
      .map(option => option.dataset.optionValue || '');
  }

  function getSelectedLabels() {
    return Array.from(options)
      .filter(option => option.classList.contains('is-selected'))
      .map(option => {
        const textNode = option.querySelector('.sobs-multi-select-option-text');
        return textNode ? textNode.textContent.trim() : (option.dataset.optionValue || '');
