<style>
  .rum-detail-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: .75rem;
  }
  .rum-detail-pre {
    white-space: pre-wrap;
    word-break: break-word;
    overflow-wrap: anywhere;
    max-height: 14rem;
    overflow-y: auto;
  }
  .rum-viewer-image {
    max-width: 100%;
    max-height: 60vh;
    border-radius: .5rem;
    border: 1px solid var(--bs-border-color);
    background: var(--bs-body-bg);
  }
  .rum-viewer-json {
    max-height: 50vh;
    overflow-y: auto;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-wrap: anywhere;
  }
  .rum-viewer-player {
    min-height: min(64vh, 760px);
    height: auto;
    border: 1px solid var(--bs-border-color);
    border-radius: .5rem;
    overflow: visible;
    background: var(--bs-body-bg);
    padding: .5rem;
  }
  .rum-viewer-player .rr-player {
    width: 100% !important;
    max-width: 100% !important;
  }
  .rum-viewer-player .rr-controller,
  .rum-viewer-player .rr-player__controller,
  .rum-viewer-player .controller {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    background: var(--bs-body-bg) !important;
    color: var(--bs-body-color) !important;
    border: 1px solid var(--bs-border-color) !important;
    border-radius: .5rem !important;
    box-shadow: none !important;
  }
  .rum-viewer-player .rr-controller *,
  .rum-viewer-player .rr-player__controller *,
  .rum-viewer-player .controller * {
    color: var(--bs-body-color) !important;
    fill: currentColor !important;
    stroke: currentColor !important;
  }
  .rum-viewer-player .rr-controller button,
  .rum-viewer-player .rr-player__controller button,
  .rum-viewer-player .controller button {
    background: color-mix(in srgb, var(--bs-secondary-bg) 65%, transparent) !important;
    border-color: var(--bs-border-color) !important;
  }
  .rum-viewer-player .rr-controller input[type="range"],
  .rum-viewer-player .rr-player__controller input[type="range"],
  .rum-viewer-player .controller input[type="range"] {
    accent-color: var(--bs-primary) !important;
  }
  [data-bs-theme='dark'] .rum-viewer-player .rr-controller,
  [data-bs-theme='dark'] .rum-viewer-player .rr-player__controller,
  [data-bs-theme='dark'] .rum-viewer-player .controller {
    background: color-mix(in srgb, var(--bs-dark) 82%, #000) !important;
    border-color: color-mix(in srgb, var(--bs-border-color) 70%, #9aa4b2) !important;
  }
  .rum-replay-timeline {
    position: relative;
    margin-bottom: .75rem;
    height: 1.25rem;
  }
  .rum-replay-timeline-track {
    position: absolute;
    left: 0;
    right: 0;
    top: .5rem;
    height: 3px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bs-secondary-color) 36%, transparent);
  }
  .rum-replay-timeline-marker {
    position: absolute;
    top: .2rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bs-danger);
    border: 2px solid var(--bs-body-bg);
    transform: translateX(-50%);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--bs-danger) 35%, transparent);
  }
  .rum-replay-timeline-label {
    position: absolute;
    top: .85rem;
    left: 0;
  }
  .rum-replay-raw summary {
    cursor: pointer;
    user-select: none;
  }
  .rum-replay-raw[open] summary {
    margin-bottom: .5rem;
  }
  .rum-row-accordion-btn {
    width: 1.85rem;
    height: 1.55rem;
    padding: 0;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: .4rem;
  }
  .rum-row-accordion-btn .rum-row-chevron {
    display: inline-block;
    transform: rotate(0deg);
    transition: transform .16s ease;
  }
  .rum-row-accordion-btn[aria-expanded='true'] .rum-row-chevron {
    transform: rotate(180deg);
  }
  .rum-row-action-slot {
    width: 4.6rem;
    min-width: 4.6rem;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    justify-content: flex-end;
  }
  .rum-row-action-slot .btn {
    flex: 0 0 auto;
  }
  .rum-row-action-slot.placeholder,
  .rum-row-action-placeholder {
    visibility: hidden;
  }
  .rum-row-trace-btn {
    width: 1.85rem;
    height: 1.55rem;
    padding: 0;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: .4rem;
  }
  .rum-detail-links {
    display: flex;
    gap: .5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .rum-detail-links .btn {
    flex: 0 0 auto;
  }
  @media (max-width: 575.98px) {
    .rum-events-table td::before {
      display: none !important;
    }
    .rum-events-table td[data-label='Timestamp'],
    .rum-events-table td[data-label='Session'],
    .rum-events-table td[data-label='Type'],
    .rum-events-table td[data-label='URL'] {
      display: none !important;
    }
    .rum-events-table td[data-label='Details'] {
      display: block !important;
      width: 100% !important;
      padding: 0 !important;
    }
    .rum-mobile-event-meta {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      min-width: 0;
      margin-bottom: 0.35rem;
    }
    .rum-mobile-event-meta .rum-mobile-event-ts {
      font-size: 0.76rem;
      color: var(--bs-secondary-color);
      font-family: var(--bs-font-monospace);
      white-space: nowrap;
    }
    .rum-mobile-event-meta .badge {
      flex: 0 0 auto;
    }
    .rum-mobile-event-body {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.5rem;
      min-width: 0;
    }
    .rum-mobile-event-primary {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 1.02rem;
      line-height: 1.25;
      max-width: none !important;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .rum-mobile-event-url {
      margin-top: 0.3rem;
      font-size: 0.78rem;
      color: var(--bs-secondary-color);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .rum-row-action-slot {
      width: auto;
      min-width: 0;
      gap: 0.3rem;
      justify-content: flex-end;
    }
    .rum-row-action-placeholder {
      display: none !important;
    }
  }
  .vitals-health-chip {
    border: 1px solid var(--bs-border-color);
    border-radius: 999px;
    padding: .15rem .55rem;
    font-size: .75rem;
    line-height: 1.1;
    background: color-mix(in srgb, var(--bs-secondary-bg) 60%, transparent);
  }
  .vitals-meta-line {
    font-size: .68rem;
    color: var(--bs-secondary-color);
    line-height: 1.2;
  }
  .vitals-sparkline {
    display: block;
    width: 100% !important;
    min-width: 0;
  }
  #vitalsCards > [class*='col-'] {
    flex: 1 1 200px;
    max-width: none;
  }
  #vitalsCards .stat-card {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  #vitalsExpandedChart {
    background: transparent;
  }
  .rum-error-expand-btn {
    position: absolute;
    top: .45rem;
    right: .45rem;
    width: 1.35rem;
    height: 1.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-color: color-mix(in srgb, var(--bs-border-color) 80%, transparent);
    color: var(--bs-secondary-color);
    opacity: .75;
  }
  .rum-error-expand-btn:hover,
  .rum-error-expand-btn:focus-visible {
    opacity: 1;
    color: var(--bs-body-color);
  }
  .rum-session-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    align-items: center;
  }
  .rum-session-row td:first-child {
    border-left: 4px solid transparent;
  }
  .rum-session-row-critical td:first-child {
    border-left-color: var(--bs-danger);
  }
  .rum-session-row-warning td:first-child {
    border-left-color: #d39e00;
  }
  .rum-session-row-healthy td:first-child {
    border-left-color: var(--bs-success);
  }
  .rum-session-status {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .2rem .55rem;
    border-radius: 999px;
    font-size: .72rem;
    line-height: 1.1;
    border: 1px solid var(--bs-border-color);
    background: color-mix(in srgb, var(--bs-secondary-bg) 68%, transparent);
  }
  .rum-session-status-critical {
    color: var(--bs-danger);
    border-color: color-mix(in srgb, var(--bs-danger) 45%, var(--bs-border-color));
    background: color-mix(in srgb, var(--bs-danger) 10%, transparent);
  }
  .rum-session-status-warning {
    color: color-mix(in srgb, #d39e00 78%, var(--bs-body-color));
    border-color: color-mix(in srgb, #d39e00 42%, var(--bs-border-color));
    background: color-mix(in srgb, #ffc107 12%, transparent);
  }
  .rum-session-status-healthy {
    color: var(--bs-success);
    border-color: color-mix(in srgb, var(--bs-success) 38%, var(--bs-border-color));
    background: color-mix(in srgb, var(--bs-success) 10%, transparent);
  }
  button.rum-session-status,
  button.rum-session-count-chip,
  button.rum-session-cap-chip {
    appearance: none;
    -webkit-appearance: none;
    margin: 0;
    cursor: pointer;
  }
  button.rum-session-status:focus-visible,
  button.rum-session-count-chip:focus-visible,
  button.rum-session-cap-chip:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .rum-session-row {
    transition: background-color .14s ease, box-shadow .14s ease;
  }
  .rum-session-row:hover td {
    background: color-mix(in srgb, var(--bs-secondary-bg) 48%, transparent);
  }
  .rum-session-row-critical:hover td {
    background: color-mix(in srgb, var(--bs-danger) 6%, var(--bs-secondary-bg));
  }
  .rum-session-row-warning:hover td {
    background: color-mix(in srgb, #ffc107 7%, var(--bs-secondary-bg));
  }
  .rum-session-overview {
    display: flex;
    flex-direction: column;
    gap: .4rem;
  }
  .rum-session-primary-row,
  .rum-session-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .35rem;
  }
  .rum-session-primary-row {
    gap: .45rem;
  }
  .rum-session-count-chip {
    display: inline-flex;
    align-items: center;
    padding: .18rem .52rem;
    border-radius: 999px;
    font-size: .72rem;
    line-height: 1.1;
    font-weight: 600;
    color: var(--bs-body-color);
    background: color-mix(in srgb, var(--bs-secondary-bg) 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--bs-border-color) 80%, transparent);
  }
  .rum-session-count-chip-critical {
    color: #fff;
    background: color-mix(in srgb, var(--bs-danger) 82%, #111);
    border-color: color-mix(in srgb, var(--bs-danger) 56%, var(--bs-border-color));
  }
  .rum-session-count-chip-warning {
    color: color-mix(in srgb, #d39e00 82%, var(--bs-body-color));
    background: color-mix(in srgb, #ffc107 18%, transparent);
    border-color: color-mix(in srgb, #ffc107 36%, var(--bs-border-color));
  }
  .rum-session-cap-chip {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    padding: .16rem .46rem;
    border-radius: 999px;
    font-size: .68rem;
    line-height: 1.05;
    font-weight: 600;
    color: var(--bs-secondary-color);
    background: color-mix(in srgb, var(--bs-secondary-bg) 58%, transparent);
    border: 1px solid color-mix(in srgb, var(--bs-border-color) 72%, transparent);
  }
  .rum-session-cap-chip-trace {
    color: color-mix(in srgb, #0dcaf0 70%, var(--bs-body-color));
  }
  .rum-session-cap-chip-replay {
    color: color-mix(in srgb, #ffc107 78%, var(--bs-body-color));
  }
  .rum-session-cap-chip-artifact {
    color: color-mix(in srgb, #5b9dff 78%, var(--bs-body-color));
  }
  .rum-session-last-event {
    font-size: .75rem;
    color: var(--bs-secondary-color);
  }
  .rum-session-last-event strong {
    font-weight: 600;
    color: color-mix(in srgb, var(--bs-body-color) 82%, var(--bs-secondary-color));
  }
  .rum-session-ts {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    gap: .2rem;
    font-family: var(--bs-font-monospace);
  }
  .rum-session-ts-date {
    font-size: .84rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--bs-body-color) 76%, var(--bs-secondary-color));
  }
  .rum-session-ts-time {
    font-size: .74rem;
    color: var(--bs-secondary-color);
  }
  .rum-session-id {
    font-size: .78rem;
    font-family: var(--bs-font-monospace);
    color: color-mix(in srgb, var(--bs-body-color) 70%, var(--bs-secondary-color));
    letter-spacing: .01em;
  }
  .rum-filters-form {
    gap: .85rem 1rem !important;
  }
  .rum-filter-field {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .rum-filter-search {
    flex: 2 1 200px;
  }
  .rum-filter-search .position-relative {
    flex: 1 1 auto;
  }
  .rum-filter-actions {
    flex: 0 0 auto;
    display: flex;
    align-items: flex-end;
    gap: .35rem;
    padding-left: .5rem;
    margin-left: .15rem;
    border-left: 1px solid color-mix(in srgb, var(--bs-border-color) 72%, transparent);
  }
  .rum-view-toggle .btn {
    min-width: 5.5rem;
  }
  .rum-filters-panel .form-label {
    margin-bottom: .35rem;
    font-weight: 600;
    letter-spacing: .01em;
  }
  .rum-row-accordion-btn,
  .rum-row-trace-btn {
    border-color: color-mix(in srgb, var(--bs-border-color) 76%, transparent);
  }
  .rum-row-accordion-btn:hover,
  .rum-row-accordion-btn:focus-visible,
  .rum-row-trace-btn:hover,
  .rum-row-trace-btn:focus-visible {
    color: var(--bs-body-color);
    background: color-mix(in srgb, var(--bs-secondary-bg) 70%, transparent);
  }
  button.rum-chip-btn {
    border: none;
    cursor: pointer;
    line-height: 1;
    vertical-align: middle;
  }
  button.rum-chip-btn:hover {
    filter: brightness(1.12);
  }
  button.rum-chip-btn:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .rum-session-timeline-item {
    border: 1px solid var(--bs-border-color);
    border-radius: .6rem;
    padding: .65rem .8rem;
    background: color-mix(in srgb, var(--bs-body-bg) 88%, var(--bs-secondary-bg));
  }
  .rum-session-timeline-url {
    max-width: min(100%, 44rem);
  }
  .rum-view-toggle .btn {
    min-width: 5.5rem;
  }
  #rumAssetViewerModal {
    z-index: 1080;
  }
  #rumAssetViewerModal .modal-dialog {
    width: min(98vw, 1680px);
    max-width: min(98vw, 1680px);
    height: calc(100vh - 1rem);
    max-height: calc(100vh - 1rem);
    margin: .5rem auto;
  }
  #rumAssetViewerModal .modal-content {
    height: 100%;
    max-height: 100%;
    overflow: hidden;
  }
  #rumAssetViewerModal .modal-header-actions {
    display: flex;
    align-items: center;
    gap: .35rem;
    margin-left: auto;
  }
  #rumAssetViewerModal .rum-asset-open-raw-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
  }
  #rumAssetViewerModal .modal-body {
    max-height: calc(100vh - 7rem);
    overflow: auto;
  }
  body.rum-replay-modal-open #sobsAiBtn,
  body.rum-replay-modal-open #sobsAiPanel {
    opacity: 0 !important;
    pointer-events: none !important;
  }
</style>


