{"checklist":[{"id":"sdk","label":"Install & initialise the SDK"},{"id":"collector","label":"Run the OpenTelemetry Collector"},{"id":"verify","label":"Verify data in SOBS"},{"id":"anomaly","label":"Configure anomaly detection"}],"deployment":"cloud","env":"prod","language":"ruby","ok":true,"steps":[{"commands":["gem 'opentelemetry-sdk'","gem 'opentelemetry-exporter-otlp'","gem 'opentelemetry-instrumentation-all'","","# then run:","bundle install"],"description":"Add the SDK and OTLP exporter to your Gemfile.","id":"sdk_install","language":"ruby","title":"Add OpenTelemetry Ruby gems"},{"commands":["require 'opentelemetry/sdk'","require 'opentelemetry/exporter/otlp'","require 'opentelemetry/instrumentation/all'","","OpenTelemetry::SDK.configure do |c|","  c.service_name = 'my-service'","  c.use_all","end"],"description":"Initialise OTEL before your app boots.","id":"sdk_init","language":"ruby","title":"Configure the SDK"},{"commands":["# For AWS Distro for OpenTelemetry (ADOT):","# Set the exporter endpoint in your ADOT config to:","#   endpoint: http://sobs:44317","","# For GCP OpenTelemetry Collector:","# Override the exporter.endpoint in your otel-config.yaml to:","#   endpoint: http://sobs:44317"],"description":"Point your cloud provider's OTLP endpoint to forward to SOBS.","id":"collector_cloud","language":"yaml","title":"Configure a managed OTLP pipeline"},{"commands":["# Open your browser and navigate to http://sobs:44317/","# The Summary card should show span, log, and metric counts within ~30 s."],"description":"Check the Summary page for incoming telemetry.","id":"sobs_verify","language":"bash","title":"Verify data arrives in SOBS"},{"commands":["# Navigate to: http://sobs:44317/settings/anomaly-rules","# Click 'Add Rule' and choose a metric from your stack."],"description":"Head to Settings \u2192 Anomaly Rules and add your first threshold rule.","id":"sobs_anomaly","language":"bash","title":"Enable anomaly detection rules"}],"version":"1"}
