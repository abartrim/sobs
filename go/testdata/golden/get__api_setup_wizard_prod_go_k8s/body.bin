{"checklist":[{"id":"sdk","label":"Install & initialise the SDK"},{"id":"collector","label":"Run the OpenTelemetry Collector"},{"id":"verify","label":"Verify data in SOBS"},{"id":"anomaly","label":"Configure anomaly detection"}],"deployment":"kubernetes","env":"prod","language":"go","ok":true,"steps":[{"commands":["go get go.opentelemetry.io/otel","go get go.opentelemetry.io/otel/sdk/trace","go get go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc"],"description":"Fetch the SDK and OTLP gRPC exporter modules.","id":"sdk_install","language":"bash","title":"Add OpenTelemetry Go dependencies"},{"commands":["exp, _ := otlptracegrpc.New(ctx, otlptracegrpc.WithInsecure(), otlptracegrpc.WithEndpoint(\"localhost:4317\"))","tp := sdktrace.NewTracerProvider(sdktrace.WithBatcher(exp))","otel.SetTracerProvider(tp)","defer tp.Shutdown(ctx)"],"description":"Wire the OTLP exporter into your main function.","id":"sdk_init","language":"go","title":"Initialise tracer provider"},{"commands":["# otel-collector-k8s.yaml","apiVersion: v1","kind: ConfigMap","metadata:","  name: otel-collector-config","data:","  config.yaml: |","    receivers:","      otlp:","        protocols:","          grpc:","            endpoint: 0.0.0.0:4317","    exporters:","      otlphttp:","        endpoint: http://sobs:44317","    service:","      pipelines:","        traces:","          receivers: [otlp]","          exporters: [otlphttp]","        metrics:","          receivers: [otlp]","          exporters: [otlphttp]","        logs:","          receivers: [otlp]","          exporters: [otlphttp]","---","apiVersion: apps/v1","kind: Deployment","metadata:","  name: otel-collector","spec:","  replicas: 1","  selector:","    matchLabels:","      app: otel-collector","  template:","    metadata:","      labels:","        app: otel-collector","    spec:","      containers:","      - name: otel-collector","        image: otel/opentelemetry-collector-contrib:latest","        args: ['--config=/etc/otelcol-contrib/config.yaml']","        volumeMounts:","        - name: config","          mountPath: /etc/otelcol-contrib","      volumes:","      - name: config","        configMap:","          name: otel-collector-config"],"description":"Apply a ConfigMap and Deployment that routes to SOBS.","id":"collector_k8s","language":"yaml","title":"Deploy the OpenTelemetry Collector on Kubernetes"},{"commands":["kubectl apply -f otel-collector-k8s.yaml"],"description":"Deploy the collector to your cluster.","id":"collector_k8s_apply","language":"bash","title":"Apply the manifest"},{"commands":["# Open your browser and navigate to http://sobs:44317/","# The Summary card should show span, log, and metric counts within ~30 s."],"description":"Check the Summary page for incoming telemetry.","id":"sobs_verify","language":"bash","title":"Verify data arrives in SOBS"},{"commands":["# Navigate to: http://sobs:44317/settings/anomaly-rules","# Click 'Add Rule' and choose a metric from your stack."],"description":"Head to Settings \u2192 Anomaly Rules and add your first threshold rule.","id":"sobs_anomaly","language":"bash","title":"Enable anomaly detection rules"}],"version":"1"}
