{"query":"WITH series AS (\nSELECT\n  time,\n  value,\n  baseline_mean,\n  baseline_lower,\n  baseline_upper,\n  anomaly_state,\n  anomaly_score\nFROM v_derived_signals_anomaly\nWHERE time >= now() - INTERVAL 6 HOUR AND\n    ServiceName = 'api' AND\n    SignalSource = 'traces' AND\n    SignalName = 'trace_volume'\n)\nSELECT\n  'trace_volume' AS dimension,\n  min(value) AS min,\n  quantile(0.25)(value) AS q1,\n  quantile(0.5)(value) AS median,\n  quantile(0.75)(value) AS q3,\n  max(value) AS max\nFROM series","spec":{"data":{"attr_fp":"","limit":1000,"metric_name":"","service":"api","signal_name":"trace_volume","signal_source":"traces","source_view":"v_derived_signals_anomaly","window_hours":6},"named_queries":[],"sql":{"mode":"builder","override_sql":"None"},"template_id":"box_plot","visual":{"legend_show":true,"role_map":{},"smooth_line":true,"value_color":"","zoom_end_pct":100,"zoom_inside":true,"zoom_slider":false,"zoom_start_pct":0}},"template_id":"box_plot"}
