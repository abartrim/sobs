{"fields":[{"column":"ServiceName","name":"service","type":"string","values":[]},{"column":"SpanAttributes['gen_ai.request.model']","name":"model","type":"string","values":[]},{"column":"SpanAttributes['gen_ai.provider.name']","name":"provider","type":"string","values":[]},{"column":"SpanAttributes['gen_ai.operation.name']","name":"operation","type":"string","values":[]},{"column":"coalesce(SpanAttributes['sobs.gen_ai.prompt'], SpanAttributes['gen_ai.turn.summary.request'], SpanAttributes['gen_ai.input.question'], SpanAttributes['gen_ai.input.messages'])","name":"prompt","type":"string","values":[]},{"column":"coalesce(SpanAttributes['sobs.gen_ai.response'], SpanAttributes['gen_ai.output.messages'])","name":"response","type":"string","values":[]},{"column":"SpanName","name":"span_name","type":"string","values":[]},{"column":"if(SpanAttributes['gen_ai.request.model'] != '', 'llm', 'system')","name":"row_type","type":"string","values":["llm","system"]},{"column":"TraceId","name":"trace_id","type":"string","values":[]},{"column":"SpanId","name":"span_id","type":"string","values":[]},{"column":"Timestamp","name":"ts","type":"datetime","values":[]},{"column":"StatusCode","name":"status","type":"string","values":[]},{"column":"SpanAttributes['error.type']","name":"error_type","type":"string","values":[]},{"column":"toUInt64OrZero(SpanAttributes['gen_ai.usage.input_tokens'])","name":"tokens_in","type":"number","values":[]},{"column":"toUInt64OrZero(SpanAttributes['gen_ai.usage.output_tokens'])","name":"tokens_out","type":"number","values":[]},{"column":"toUInt64OrZero(SpanAttributes['gen_ai.usage.thinking_tokens'])","name":"thinking_tokens","type":"number","values":[]},{"column":"(Duration / 1000000.0)","name":"duration_ms","type":"number","values":[]}],"functions":[{"kind":"string","name":"match","signature":"match(model, 'gpt')"},{"kind":"string","name":"startsWith","signature":"startsWith(span_name, 'ai.tool')"},{"kind":"string","name":"endsWith","signature":"endsWith(provider, 'cloud')"},{"kind":"string","name":"lower","signature":"lower(model)"},{"kind":"string","name":"upper","signature":"upper(operation)"},{"kind":"datetime","name":"toDateTime","signature":"toDateTime('2026-03-30 12:00:00')"}],"keywords":["AND","OR","NOT","IS NULL","IS NOT NULL","TRUE","FALSE","NULL"],"operators":["=","!=","LIKE","NOT LIKE","ILIKE","NOT ILIKE","IN","NOT IN",">","<",">=","<="],"snippets":[{"insert":"row_type='llm'","kind":"predicate","label":"row_type='llm'"},{"insert":"row_type='system'","kind":"predicate","label":"row_type='system'"},{"insert":"span_name='ai.tool.executed'","kind":"predicate","label":"span_name='ai.tool.executed'"},{"insert":"prompt ILIKE '%graph%'","kind":"predicate","label":"prompt ILIKE '%graph%'"},{"insert":"response ILIKE '%chart%'","kind":"predicate","label":"response ILIKE '%chart%'"},{"insert":"tokens_out > 1000","kind":"predicate","label":"tokens_out > 1000"},{"insert":"error_type != ''","kind":"predicate","label":"error_type != ''"},{"insert":"ts >= toDateTime('2026-03-30 00:00:00')","kind":"predicate","label":"ts >= toDateTime('2026-03-30 00:00:00')"}]}
