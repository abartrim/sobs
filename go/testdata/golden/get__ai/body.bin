        text-transform: uppercase;
        letter-spacing: 0.02em;
        margin-bottom: 0.1rem;
      }
      .page-header-main {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: 0.75rem;
      }
      .page-header-meta {
        grid-column: 1 / -1;
        width: 100%;
        margin-left: 0;
        justify-content: flex-start;
      }
      .page-header-actions {
        grid-column: 2;
        justify-content: flex-end;
      }
      .btn-label,
      [class$='-btn-label'] {
        display: none;
      }
      .btn:has(> .btn-label) i,
      .btn:has(> [class$='-btn-label']) i {
        margin-right: 0 !important;
      }
    }
    .main-content { min-height: 100vh; transition: margin-left 0.22s ease; }
    .page-header {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .page-header-main {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
    }
    .page-header-title-wrap {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
      flex: 1 1 auto;
    }
    .page-header-title-wrap h4,
    .page-header-title {
      min-width: 0;
    }
    .page-header-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      min-width: 0;
      flex: 0 1 auto;
      margin-left: auto;
    }
    .page-header-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0.5rem;
      flex-wrap: wrap;
      min-width: 0;
      flex: 0 0 auto;
    }
    @media (max-width: 575.98px) {
      .page-header-main {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: 0.75rem;
      }
      .page-header-title-wrap {
        grid-column: 1;
        grid-row: 1;
      }
      .page-header-actions {
        grid-column: 2;
        grid-row: 1;
        justify-content: flex-end;
      }
      .page-header-meta {
        grid-column: 1 / -1;
        grid-row: 2;
        width: 100%;
        margin-left: 0;
        justify-content: flex-start;
      }
    }
    .page-header-subtext {
      color: var(--bs-secondary-color);
      font-size: 0.875rem;
    }
    .page-help-btn {
      color: var(--bs-secondary-color);
      border-color: var(--bs-border-color);
    }
    .page-help-btn:hover,
    .page-help-btn:focus-visible {
      color: var(--bs-body-color);
      background: var(--bs-tertiary-bg);
      border-color: var(--bs-border-color);
    }
    /* Avoid first-load animation jump before sidebar state is initialized. */
    .sb-state-pending .sidebar,
    .sb-state-pending .main-content {
      transition: none !important;
    }
    /* ===== Desktop: sidebar fixed to viewport ===== */
    @media (min-width: 576px) {
      .sidebar { position: fixed; top: 0; left: 0; height: 100vh; }
      .main-content { margin-left: var(--sb-full); }
      .sidebar.sidebar-compact + .main-content { margin-left: var(--sb-compact); }

      /* Prepaint compact rules, applied from html class before JS init runs. */
      .sb-state-compact #sbSidebar {
        width: var(--sb-compact);
        padding-left: 0;
        padding-right: 0;
      }
      .sb-state-compact #sbSidebar .sb-label {
        opacity: 0;
        max-width: 0;
        pointer-events: none;
      }
      .sb-state-compact #sbSidebar .sb-brand-text {
        display: none;
      }
      .sb-state-compact #sbSidebar .nav-link {
        margin: 1px auto;
        width: calc(var(--sb-compact) - 8px);
        padding: .5rem 0;
        justify-content: center;
        gap: 0;
        text-align: center;
      }
      .sb-state-compact #sbSidebar .nav-link i {
        width: auto;
        min-width: 1.4rem;
        display: inline-flex;
        justify-content: center;
      }
      .sb-state-compact #sbSidebar .sb-brand {
        padding: 0 .6rem;
        justify-content: center;
      }
      .sb-state-compact .main-content {
        margin-left: var(--sb-compact);
      }
    }
    .badge-level-ERROR, .badge-level-FATAL, .badge-level-CRITICAL { background-color: #dc3545 !important; }
    .badge-level-WARN, .badge-level-WARNING { background-color: #fd7e14 !important; }
    .badge-level-INFO { background-color: #0d6efd !important; }
    .badge-level-DEBUG { background-color: #6c757d !important; }
    .badge-level-METRIC { background-color: #0dcaf0 !important; color: #000 !important; }
    .log-body { font-family: "SFMono-Regular", Menlo, monospace; font-size: .78rem; word-break: break-all; }
    .stack-trace {
      font-family: monospace;
      font-size: .78rem;
      white-space: pre-wrap;
      max-height: 200px;
      overflow-y: auto;
      color: var(--bs-danger-text-emphasis);
      background: var(--bs-danger-bg-subtle);
      border: 1px solid var(--bs-danger-border-subtle);
    }
    .theme-panel {
      color: var(--bs-body-color);
      background: var(--bs-tertiary-bg);
      border: 1px solid var(--bs-border-color);
    }
    [data-bs-theme='light'] .table-dark {
      --bs-table-color: var(--bs-body-color);
      --bs-table-bg: var(--bs-body-bg);
      --bs-table-border-color: var(--bs-border-color);
      --bs-table-striped-bg: var(--bs-tertiary-bg);
      --bs-table-striped-color: var(--bs-body-color);
      --bs-table-active-bg: var(--bs-secondary-bg);
      --bs-table-active-color: var(--bs-body-color);
      --bs-table-hover-bg: var(--bs-secondary-bg);
      --bs-table-hover-color: var(--bs-body-color);
    }
    .stat-card { border: 1px solid var(--bs-border-color); border-radius: 10px; }
    .vitals-good  { color: #198754; }
    .vitals-needs { color: #ffc107; }
    .vitals-poor  { color: #dc3545; }
    .prompt-box { background: var(--bs-tertiary-bg); border-radius: 6px; padding: .5rem; font-size: .82rem; white-space: pre-wrap; max-height: 150px; overflow-y: auto; }
    a.trace-link { font-family: monospace; font-size: .78rem; }
    .drp-combo .drp-combo-input {
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
      border-right: 0;
    }
    .input-group-sm.drp-combo > .drp-combo-input,
    .input-group-sm.drp-combo > .drp-combo-trigger {
      height: calc(1.5em + .5rem + 2px);
      min-height: calc(1.5em + .5rem + 2px);
      box-sizing: border-box;
    }
    .drp-combo .drp-combo-trigger {
      min-width: 2.2rem;
      border-left: 0;
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
      padding: .25rem .5rem;
      font-size: .875rem;
      line-height: 1.5;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      user-select: none;
    }
    .drp-combo .drp-combo-trigger:hover { color: var(--bs-emphasis-color); }
    .drp-combo .drp-combo-trigger:focus {
      outline: 0;
      box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .25);
      z-index: 3;
    }
    .drp-combo .drp-combo-trigger .bi { font-size: .85rem; }
    .filter-date-group {
      flex: 2 1 300px;
      min-width: min(300px, 100%);
      max-width: 100%;
    }
    .filter-date-fields {
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
      align-items: end;
      max-width: 100%;
    }
    .filter-date-field {
      flex: 1 1 140px;
      min-width: 0;
    }
    .sobs-tz-header-badge {
      display: inline-flex;
      align-items: center;
      gap: .25rem;
      margin-left: .75rem;
      padding: .1rem .45rem;
      font-size: .7rem;
      font-weight: 500;
      color: var(--bs-secondary-color);
      background: color-mix(in srgb, var(--bs-secondary-bg) 45%, transparent);
      border: 1px solid var(--bs-border-color);
      border-radius: .3rem;
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
      user-select: none;
      transition: color .15s, background-color .15s;
    }
    .sobs-tz-header-badge:hover {
      color: var(--bs-body-color);
      background-color: color-mix(in srgb, var(--bs-secondary-bg) 75%, transparent);
    }
    .sobs-ansi-active {
      color: var(--bs-info);
    }
    .sobs-ansi-active:hover {
      color: var(--bs-info);
      background-color: color-mix(in srgb, var(--bs-info) 12%, transparent);
    }
  </style>
  <style>
  .ai-row-grid {
    display: grid;
    grid-template-columns: minmax(118px, 1.05fr) minmax(108px, .9fr) minmax(132px, 1.05fr) minmax(0, 2.7fr) minmax(105px, .8fr) minmax(84px, .65fr) minmax(148px, .95fr);
    gap: .55rem;
    align-items: center;
    width: 100%;
    min-width: 0;
  }
  .ai-row-cell {
    min-width: 0;
  }
  .ai-row-cell.tokens,
  .ai-row-cell.duration,
  .ai-row-cell.timestamp {
    text-align: right;
    white-space: nowrap;
  }
  .ai-row-cell.summary {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ai-row-cell.op {
    display: flex;
    align-items: center;
    gap: .3rem;
    flex-wrap: wrap;
  }
  .ai-chip {
    display: inline-block;
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: middle;
  }
  .ai-chip-tight {
    max-width: 132px;
  }
  .ai-chip-wide {
    max-width: 230px;
  }
  .ai-system-chip {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-size: .68rem;
    color: var(--bs-secondary-color);
  }
  .ai-event-row {
    display: grid;
    grid-template-columns: minmax(96px, 1.1fr) minmax(70px, .7fr) minmax(110px, 1fr) minmax(0, 2fr) minmax(72px, .6fr) minmax(132px, .9fr);
    gap: .55rem;
    align-items: center;
    padding: .42rem .55rem;
    border-bottom: 1px solid var(--bs-border-color);
    opacity: .68;
    font-size: .72rem;
  }
  .ai-turn-board {
    display: grid;
    gap: .75rem;
    margin-bottom: 1rem;
  }
  .ai-turn-card {
    border: 1px solid rgba(13, 110, 253, .28);
    background: linear-gradient(180deg, rgba(13, 110, 253, .08), rgba(13, 110, 253, .02));
  }
  .ai-turn-messages {
    display: grid;
    gap: .55rem;
  }
  .ai-turn-message {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: .6rem;
    align-items: start;
  }
  .ai-turn-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
  }
  .ai-turn-tool {
    border: 1px solid var(--bs-border-color);
    border-radius: .5rem;
    padding: .55rem .7rem;
    background: rgba(255, 193, 7, .06);
  }
  .ai-turn-note {
    border-left: 3px solid rgba(108, 117, 125, .8);
    padding-left: .65rem;
  }
  .ai-turn-jump-link {
    cursor: pointer;
    text-decoration: none;
  }
  .ai-turn-jump-link:hover {
    text-decoration: underline;
  }
  .ai-telemetry-hit {
    outline: 2px solid rgba(13, 110, 253, .55);
    outline-offset: 2px;
    background: rgba(13, 110, 253, .08);
    transition: background 160ms ease;
  }
  @media (max-width: 991.98px) {
    .ai-row-grid,
    .ai-event-row {
      grid-template-columns: 1fr;
      gap: .3rem;
    }
    .ai-turn-message {
      grid-template-columns: 1fr;
      gap: .35rem;
    }
    .ai-row-cell.tokens,
    .ai-row-cell.duration,
    .ai-row-cell.timestamp {
      text-align: left;
    }
  }
</style>
</head>
<body>
<!-- Overlay backdrop for hamburger sidebar -->
<div id="sbBackdrop" class="sb-backdrop"></div>
<!-- Topbar: visible only in hamburger/small-screen mode -->
<div id="sbTopbar" class="sb-topbar">
  <button id="sbHamburgerBtn" class="btn btn-sm btn-outline-secondary d-flex align-items-center" aria-label="Open menu" aria-expanded="false" aria-controls="sbSidebar">
    <i class="bi bi-list fs-5"></i>
  </button>
  <a href="/" class="text-decoration-none d-flex align-items-center gap-2">
    <span>🔭</span>
    <span class="fw-bold text-body-emphasis">SOBS</span>
  </a>
  <div class="ms-auto">
    <div class="btn-group btn-group-sm" role="group" aria-label="Theme">
      <button type="button" class="btn btn-outline-secondary" data-sobs-theme="light" title="Light theme" aria-pressed="false">
        <i class="bi bi-sun"></i>
      </button>
      <button type="button" class="btn btn-outline-secondary" data-sobs-theme="system" title="System theme" aria-pressed="false">
        <i class="bi bi-circle-half"></i>
      </button>
      <button type="button" class="btn btn-outline-secondary" data-sobs-theme="dark" title="Dark theme" aria-pressed="false">
        <i class="bi bi-moon-stars"></i>
