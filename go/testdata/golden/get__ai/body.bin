          Tip: keep one manual span wrapper around your top-level agent turn even when using auto instrumentation.
          Auto instrumentation captures provider/tool transport details, while the manual wrapper preserves your app-level turn context.
        </div>
      </div>
    </div>
  </div>
</div>

<script>
/* ===== Cost estimation lookup table (USD per 1M tokens) — loaded from AI Configuration settings ===== */
var AI_PRICING = {"claude-3-5-haiku": {"in": 0.8, "out": 4.0}, "claude-3-5-sonnet": {"in": 3.0, "out": 15.0}, "claude-3-5-sonnet-20241022": {"in": 3.0, "out": 15.0}, "claude-3-haiku": {"in": 0.25, "out": 1.25}, "claude-3-opus": {"in": 15.0, "out": 75.0}, "claude-3-sonnet": {"in": 3.0, "out": 15.0}, "gemini-1.5-flash": {"in": 0.075, "out": 0.3}, "gemini-1.5-pro": {"in": 1.25, "out": 5.0}, "gemini-2.0-flash": {"in": 0.1, "out": 0.4}, "gpt-3.5-turbo": {"in": 0.5, "out": 1.5}, "gpt-4": {"in": 30.0, "out": 60.0}, "gpt-4-turbo": {"in": 10.0, "out": 30.0}, "gpt-4o": {"in": 2.5, "out": 10.0}, "gpt-4o-mini": {"in": 0.15, "out": 0.6}, "llama-3.1-70b": {"in": 0.9, "out": 0.9}, "llama-3.1-8b": {"in": 0.2, "out": 0.2}, "mistral-large": {"in": 3.0, "out": 9.0}, "mistral-small": {"in": 0.2, "out": 0.6}, "o1": {"in": 15.0, "out": 60.0}, "o1-mini": {"in": 3.0, "out": 12.0}, "o3-mini": {"in": 1.1, "out": 4.4}};
var AI_PRICING_SOURCES = {"claude-3-5-haiku": "default", "claude-3-5-sonnet": "default", "claude-3-5-sonnet-20241022": "default", "claude-3-haiku": "default", "claude-3-opus": "default", "claude-3-sonnet": "default", "gemini-1.5-flash": "default", "gemini-1.5-pro": "default", "gemini-2.0-flash": "default", "gpt-3.5-turbo": "default", "gpt-4": "default", "gpt-4-turbo": "default", "gpt-4o": "default", "gpt-4o-mini": "default", "llama-3.1-70b": "default", "llama-3.1-8b": "default", "mistral-large": "default", "mistral-small": "default", "o1": "default", "o1-mini": "default", "o3-mini": "default"};

function formatAiUsd(cost) {
  if (!Number.isFinite(cost) || cost <= 0) {
    return '$0.00';
  }
  var roundedUp = Math.ceil((cost + Number.EPSILON) * 100) / 100;
  return '$' + roundedUp.toFixed(2);
}

function resolveAiPricing(model) {
  var modelLower = (model || '').toLowerCase();
  if (AI_PRICING[modelLower]) {
    return { key: modelLower, price: AI_PRICING[modelLower] };
  }
  for (var key in AI_PRICING) {
    if (modelLower.indexOf(key) !== -1 || key.indexOf(modelLower) !== -1) {
      return { key: key, price: AI_PRICING[key] };
    }
  }
  return null;
}

function aiCostEstimate(model, tokIn, tokOut) {
  var resolved = resolveAiPricing(model);
  if (!resolved || !resolved.price) {
    return '<span class="text-secondary">Unknown model — pricing not available</span>';
  }
  var price = resolved.price;
  var cost = (tokIn / 1e6) * price.in + (tokOut / 1e6) * price.out;
  var fmt = formatAiUsd(cost);
  return '<span class="text-success fw-semibold">' + fmt + '</span>'
       + '<span class="text-secondary ms-2 small">($' + price.in + '/1M in · $' + price.out + '/1M out)</span>';
}

var AI_ERROR_TIPS = {
  'RateLimitError': 'Rate limit exceeded. Add retry logic with exponential backoff. Consider batching requests or upgrading your API plan.',
  'AuthenticationError': 'Authentication failed. Verify your API key is valid and not expired. Check environment variable configuration.',
  'InvalidRequestError': 'Invalid request parameters. Check prompt length, message format, and model compatibility.',
  'ContextLengthExceeded': 'Context window exceeded. Reduce prompt length, summarize prior turns, or use a model with a larger context window.',
  'ServiceUnavailableError': 'API service temporarily unavailable. Implement retry logic with backoff. Check provider status page.',
  'ContentFilterError': 'Response blocked by content filters. Review prompt content and adjust to comply with usage policies.',
  'TimeoutError': 'Request timed out. Check network connectivity and consider increasing timeout values.',
  'InsufficientQuotaError': 'Quota exceeded. Check your usage limits and billing status with the provider.',
};

function initAiErrorTips(scope) {
  (scope || document).querySelectorAll('.ai-error-tip[data-error-type]').forEach(function(el) {
    if (el.getAttribute('data-tip-loaded') === '1') {
      return;
    }
    var errType = el.getAttribute('data-error-type') || '';
    var tip = AI_ERROR_TIPS[errType] || 'Check the provider documentation for details on this error type.';
    el.textContent = 'Tip: ' + tip;
    el.setAttribute('data-tip-loaded', '1');
  });
}

function renderAiCostEstimate(el) {
  if (!el || el.getAttribute('data-cost-loaded') === '1') {
    return;
  }
  var model = el.getAttribute('data-cost-model') || '';
  var tokIn = parseInt(el.getAttribute('data-cost-tokens-in') || '0', 10);
  var tokOut = parseInt(el.getAttribute('data-cost-tokens-out') || '0', 10);
  el.innerHTML = aiCostEstimate(model, tokIn, tokOut);
  el.setAttribute('data-cost-loaded', '1');
}

function ensureAiMetricsCosts(scope) {
  (scope || document).querySelectorAll('.ai-cost-estimate').forEach(renderAiCostEstimate);
}

initAiErrorTips(document);

var AI_PAGE_FROM_TS = "";
var AI_PAGE_TO_TS = "";
var AI_CONVERSATION_URL = "/api/ai/conversation";
var AI_SPAN_ATTRIBUTES_URL = "/api/ai/span-attributes";

document.addEventListener('show.bs.collapse', function(ev) {
  var target = ev.target;
  var lazy = target.querySelector('.ai-conv-lazy:not([data-conv-loaded])');
  if (!lazy) return;
  lazy.setAttribute('data-conv-loaded', '1');
  lazy.innerHTML = '<div class="text-secondary small py-3 text-center"><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Loading\u2026</div>';
  var ts = lazy.getAttribute('data-conv-ts') || '';
  var service = lazy.getAttribute('data-conv-service') || '';
  var traceId = lazy.getAttribute('data-conv-trace-id') || '';
  var spanName = lazy.getAttribute('data-conv-span-name') || '';
  var url = AI_CONVERSATION_URL + '?ts=' + encodeURIComponent(ts) + '&service=' + encodeURIComponent(service);
  if (traceId) url += '&trace_id=' + encodeURIComponent(traceId);
  if (spanName) url += '&span_name=' + encodeURIComponent(spanName);
  if (AI_PAGE_FROM_TS) url += '&from_ts=' + encodeURIComponent(AI_PAGE_FROM_TS);
  if (AI_PAGE_TO_TS) url += '&to_ts=' + encodeURIComponent(AI_PAGE_TO_TS);
  fetch(url)
    .then(function(r) { return r.text(); })
    .then(function(html) {
      lazy.innerHTML = html;
      initAiErrorTips(lazy);
      if (window.sobsTimezone && window.sobsTimezone.initPage) {
        window.sobsTimezone.initPage({ timestampSelector: '.sobs-tz-ts[data-utc-ts]' });
      }
    })
    .catch(function() {
      lazy.removeAttribute('data-conv-loaded');
      lazy.innerHTML = '<p class="text-danger small my-2">Failed to load conversation. <a href="#" onclick="this.closest(\'.ai-conv-lazy\').removeAttribute(\'data-conv-loaded\'); this.closest(\'.accordion-collapse\').dispatchEvent(new Event(\'show.bs.collapse\', { bubbles: true })); return false;">Retry</a></p>';
    });
});

document.addEventListener('shown.bs.tab', function(ev) {
  var target = ev.target;
  if (!target) {
    return;
  }
  var paneSelector = target.getAttribute('data-bs-target') || '';
  if (paneSelector.indexOf('#metrics-') !== 0) {
    return;
  }
  var pane = document.querySelector(paneSelector);
  if (pane) {
    ensureAiMetricsCosts(pane);
  }
});

/* ===== Compute total estimated cost for summary card ===== */
(function() {
  var items = document.querySelectorAll('[data-ai-call="1"][data-model]');
  var total = 0;
  var known = 0;
  var inferredCount = 0;
  var inferredModels = {};
  items.forEach(function(el) {
    var model = el.getAttribute('data-model') || '';
    var tokIn = parseInt(el.getAttribute('data-tokens-in') || '0', 10);
    var tokOut = parseInt(el.getAttribute('data-tokens-out') || '0', 10);
    var resolved = resolveAiPricing(model);
    if (resolved && resolved.price) {
      var price = resolved.price;
      total += (tokIn / 1e6) * price.in + (tokOut / 1e6) * price.out;
      known++;
      if (AI_PRICING_SOURCES[resolved.key] === 'inferred') {
        if (!inferredModels[resolved.key]) {
          inferredModels[resolved.key] = true;
          inferredCount++;
        }
      }
    }
  });
  var el = document.getElementById('estCostDisplay');
  var inferredHint = document.getElementById('estCostInferredHint');
  if (el) {
    if (known > 0) {
      el.innerHTML = formatAiUsd(total);
      el.title = 'Estimated cost for visible page only. ' + (items.length - known) + ' unknown model(s) excluded.';
      if (inferredHint) {
        if (inferredCount > 0) {
          inferredHint.classList.remove('d-none');
        } else {
          inferredHint.classList.add('d-none');
        }
      }
    } else {
      el.textContent = 'N/A';
      el.className = 'fs-4 fw-bold text-secondary';
      if (inferredHint) {
        inferredHint.classList.add('d-none');
      }
    }
  }
}());

/* ===== Simple Markdown renderer ===== */
function renderMarkdown(text) {
  if (!text) return '';
  var html = escHtml(text);
  /* code blocks */
  html = html.replace(/```([a-z]*)\n?([\s\S]*?)```/g, function(_, lang, code) {
    return '<pre class="p-1 rounded" style="background:var(--bs-tertiary-bg);font-size:.8em;overflow-x:auto;"><code>' + code + '</code></pre>';
  });
  /* inline code */
  html = html.replace(/`([^`\n]+)`/g, '<code class="px-1 rounded" style="background:var(--bs-tertiary-bg);">$1</code>');
  /* bold */
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  /* italic */
  html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
  /* headers */
  html = html.replace(/^### (.+)$/gm, '<h6 class="fw-semibold mt-2 mb-1">$1</h6>');
  html = html.replace(/^## (.+)$/gm, '<h5 class="fw-semibold mt-2 mb-1">$1</h5>');
  html = html.replace(/^# (.+)$/gm, '<h5 class="fw-bold mt-2 mb-1">$1</h5>');
  /* unordered lists */
  html = html.replace(/((?:^[-*] .+\n?)+)/gm, function(block) {
    var items = block.trim().split('\n').map(function(line) {
      return '<li>' + line.replace(/^[-*] /, '') + '</li>';
    }).join('');
    return '<ul class="mb-1 ps-3">' + items + '</ul>';
  });
  /* line breaks */
  html = html.replace(/\n\n/g, '</p><p class="mb-1">');
  html = html.replace(/\n/g, '<br>');
  return '<p class="mb-1">' + html + '</p>';
}

function toggleMarkdown(btn) {
  var enabled = btn.getAttribute('data-md-enabled') === 'true';
  var next = !enabled;
  btn.setAttribute('data-md-enabled', next ? 'true' : 'false');
  btn.classList.toggle('active', next);
  btn.title = next ? 'Disable markdown rendering' : 'Enable markdown rendering';
  var scope = btn.closest('.tab-pane') || document;
  scope.querySelectorAll('.ai-md-content').forEach(function(el) {
    var raw = el.getAttribute('data-raw');
    if (next) {
      if (raw === null) {
        // Save the original plain text before first render
        el.setAttribute('data-raw', el.textContent);
      }
      el.innerHTML = renderMarkdown(el.getAttribute('data-raw'));
      el.style.whiteSpace = 'normal';
    } else {
      if (raw !== null) {
        el.textContent = raw;
      }
      el.style.whiteSpace = '';
    }
  });
}

/* ===== Clipboard helper ===== */
function copyToClipboard(btn, text) {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(function() {
      var orig = btn.innerHTML;
      btn.innerHTML = '<i class="bi bi-check me-1"></i>Copied!';
      setTimeout(function() { btn.innerHTML = orig; }, 1500);
    });
  }
}

function copyAiRawAttrs(btn, preId) {
  var pre = document.getElementById(preId);
  if (!pre) {
    return;
  }
  copyToClipboard(btn, pre.textContent || '');
}

function loadAiRawAttrs(btn, preId, copyBtnId, ts, service, traceId, spanName) {
  var pre = document.getElementById(preId);
  var copyBtn = document.getElementById(copyBtnId);
  if (!pre) {
    return;
  }
  if (btn.getAttribute('data-loading') === '1') {
    return;
  }

  var params = new URLSearchParams({ ts: ts || '', service: service || '' });
  if (traceId) {
    params.set('trace_id', traceId);
  }
  if (spanName) {
    params.set('span_name', spanName);
  }

  btn.setAttribute('data-loading', '1');
  btn.disabled = true;
  var orig = btn.innerHTML;
  var label = btn.querySelector('.ai-btn-label');
  if (label) {
    label.textContent = 'Loading';
  } else {
    btn.innerHTML = '<i class="bi bi-download me-1"></i>Loading';
  }

  fetch(AI_SPAN_ATTRIBUTES_URL + '?' + params.toString(), { credentials: 'same-origin' })
    .then(function(resp) { return resp.json(); })
    .then(function(payload) {
      if (!payload || !payload.ok) {
        throw new Error((payload && payload.error) || 'Request failed');
      }
      pre.textContent = payload.raw_attrs || '{}';
      if (copyBtn) {
        copyBtn.disabled = false;
      }
    })
    .catch(function(err) {
      pre.textContent = 'Error loading span attributes: ' + (err && err.message ? err.message : 'unknown error');
      if (copyBtn) {
        copyBtn.disabled = true;
      }
    })
    .finally(function() {
      btn.removeAttribute('data-loading');
      btn.disabled = false;
      btn.innerHTML = orig;
    });
}

/* ===== Live Tail ===== */
var _liveTailEvt = null;

function toggleLiveTail() {
  var panel = document.getElementById('liveTailPanel');
  if (panel.style.display === 'none') {
    panel.style.display = '';
    startLiveTail();
  } else {
    stopLiveTail();
    panel.style.display = 'none';
  }
}

function startLiveTail() {
  stopLiveTail();
  var status = document.getElementById('liveTailStatus');
  status.className = 'badge bg-warning text-dark';
  status.textContent = 'Connecting…';
  _liveTailEvt = new EventSource('/tail?source=ai');
  _liveTailEvt.onopen = function() {
    status.className = 'badge bg-success';
    status.textContent = 'Live';
  };
  _liveTailEvt.onerror = function() {
    status.className = 'badge bg-danger';
    status.textContent = 'Error';
  };
  _liveTailEvt.onmessage = function(e) {
    try {
      var ev = JSON.parse(e.data);
      appendLiveTailEvent(ev);
    } catch(err) {}
  };
}

function stopLiveTail() {
  if (_liveTailEvt) {
    _liveTailEvt.close();
    _liveTailEvt = null;
    var status = document.getElementById('liveTailStatus');
    if (status) {
      status.className = 'badge bg-secondary';
      status.textContent = 'Stopped';
    }
  }
}

function appendLiveTailEvent(ev) {
  var feed = document.getElementById('liveTailFeed');
  // Remove placeholder
  var placeholder = feed.querySelector('.text-center');
  if (placeholder) placeholder.remove();

  var ts = ev.ts ? ev.ts.substring(0, 19) : '';
  var provider = ev.provider || '';
  var model = ev.model || '';
  var svc = ev.service || '';
  var dur = ev.duration_ms != null ? ev.duration_ms + 'ms' : '';
  var tin = ev.tokens_in != null ? ev.tokens_in + '↑' : '';
  var tout = ev.tokens_out != null ? ev.tokens_out + '↓' : '';

  var row = document.createElement('div');
  row.className = 'd-flex gap-2 align-items-center border-bottom border-secondary py-1 live-tail-row';
  row.innerHTML =
    '<span class="text-secondary">' + ts + '</span>' +
    (provider ? '<span class="badge bg-info text-dark">' + escHtml(provider) + '</span>' : '') +
    (model ? '<span class="badge bg-success">' + escHtml(model) + '</span>' : '') +
    (svc ? '<span class="text-secondary">' + escHtml(svc) + '</span>' : '') +
    (dur ? '<span class="text-secondary">' + escHtml(dur) + '</span>' : '') +
    ((tin || tout) ? '<span class="text-warning">' + tin + ' ' + tout + '</span>' : '');

  feed.insertBefore(row, feed.firstChild);
  // Keep last 50 rows
  var rows = feed.querySelectorAll('.live-tail-row');
  if (rows.length > 50) rows[rows.length - 1].remove();
}

function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function clearTelemetryHighlights(scope) {
  var root = scope || document;
  root.querySelectorAll('.ai-telemetry-hit').forEach(function(el) {
    el.classList.remove('ai-telemetry-hit');
  });
}

function jumpToRelatedTelemetry(groupId, turnId) {
  if (!groupId || !turnId) return;
  var selector = '[data-ai-telemetry-row="1"][data-ai-group="' + String(groupId) + '"][data-ai-turn-id="' + String(turnId).replace(/"/g, '\\"') + '"]';
  var matches = Array.prototype.slice.call(document.querySelectorAll(selector));
  if (!matches.length) {
    var fallback = document.getElementById('traceItems' + groupId);
    if (fallback) {
      fallback.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    return;
  }
  clearTelemetryHighlights(document);
  matches.forEach(function(el) {
    el.classList.add('ai-telemetry-hit');
  });
  matches[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
  setTimeout(function() {
    matches.forEach(function(el) {
      el.classList.remove('ai-telemetry-hit');
    });
  }, 1800);
}

document.addEventListener('click', function(evt) {
  var link = evt.target.closest('[data-ai-related-group][data-ai-related-turn-id]');
  if (!link) return;
  evt.preventDefault();
  jumpToRelatedTelemetry(link.getAttribute('data-ai-related-group'), link.getAttribute('data-ai-related-turn-id'));
});
</script>

<script>
// SQL Filter Autocomplete (AI traces)
(() => {
  function initAiTimezone() {
    if (!window.sobsTimezone || typeof window.sobsTimezone.initPage !== 'function') return false;
    window.sobsTimezone.initPage({
      fromInputId: 'ai-from-ts',
      toInputId: 'ai-to-ts',
      formSelector: '#aiFiltersPanel form[method="get"]',
      badgeButtonId: 'ai-tz-badge-btn',
      badgeLabelId: 'ai-tz-badge-label',
      timestampSelector: '.sobs-tz-ts[data-utc-ts]'
    });
    return true;
  }

  if (!initAiTimezone()) {
    window.addEventListener('load', initAiTimezone, { once: true });
  }

  const input = document.getElementById("sql-filter-input");
  const dropdown = document.getElementById("sql-ac-dropdown");
  if (!input || !dropdown) return;

  let hints = null;
  let activeIdx = -1;
  let lastItems = [];
  let validateTimer = null;
  let validateSeq = 0;
  let validateController = null;
  let statusState = null; // { level, message } — shown as pinned row in dropdown

  const fieldHintsUrl = "/api/ai/field-hints";
  const validateUrl = "/api/ai/validate-filter";
  const localOperators = ["=", "!=", "LIKE", "NOT LIKE", "ILIKE", "NOT ILIKE", "IN", "NOT IN", ">", "<", ">=", "<="];

  function compactSqlMessage(message) {
    const text = String(message || "").trim();
    if (!text) return "Invalid SQL filter.";
    const firstLine = text.split(/\r?\n/, 1)[0].trim();
    const simplified = firstLine
      .replace(/^SQL\s+error:\s*/i, "")
      .replace(/^DB::Exception:\s*/i, "")
      .replace(/\s*\(SYNTAX_ERROR\)\s*$/i, "")
      .replace(/\s+Expected one of:.*$/i, "")
      .trim();
    if (simplified.length <= 160) return simplified;
    return `${simplified.slice(0, 157).trim()}...`;
  }

  function renderStatusRow() {
    const existing = dropdown.querySelector("li[data-status]");
    if (existing) existing.remove();
    if (!statusState) return;
    const li = document.createElement("li");
    li.setAttribute("data-status", "true");
    li.setAttribute("role", "presentation");
    const colorClass = statusState.level === "error" ? "text-danger"
      : statusState.level === "success" ? "text-success"
      : "text-warning";
    li.className = `px-2 py-1 small border-bottom ${colorClass}`;
    li.style.cssText = "cursor:default;user-select:none;";
    const fullMessage = String(statusState.message || "");
    const compact = compactSqlMessage(fullMessage);
    li.textContent = compact;
    li.title = fullMessage;
    dropdown.insertBefore(li, dropdown.firstChild);
  }

  function setStatusRow(level, message) {
    statusState = message ? { level, message } : null;
    if (dropdown.style.display !== "none") renderStatusRow();
  }

  function localValidate(text) {
    const sql = String(text || "").trim();
    if (!sql) {
      return { ok: true, level: "info", message: "Use fields, SQL operators, or functions for AI traces." };
    }
    let quoteOpen = false;
    let parenDepth = 0;
    for (let i = 0; i < sql.length; i += 1) {
      const ch = sql[i];
      if (ch === "'") {
        if (i + 1 < sql.length && sql[i + 1] === "'") {
          i += 1;
          continue;
        }
        quoteOpen = !quoteOpen;
      } else if (!quoteOpen) {
        if (ch === "(") parenDepth += 1;
        if (ch === ")") {
          parenDepth -= 1;
          if (parenDepth < 0) {
            return { ok: false, level: "error", message: "Unexpected ')' in filter." };
          }
        }
      }
    }
    if (quoteOpen) return { ok: false, level: "error", message: "Unclosed single quote in filter." };
    if (parenDepth > 0) return { ok: false, level: "error", message: "Unclosed '(' in filter." };
    if (/(AND|OR|NOT|IN|LIKE|ILIKE)\s*$/i.test(sql)) {
      return { ok: false, level: "warning", message: "Filter ends with an operator or keyword." };
    }
    return { ok: true, level: "success", message: "Filter syntax looks good so far." };
  }

  async function validateServerSide() {
    const requestSeq = ++validateSeq;
    const sqlSnapshot = input.value;

    const local = localValidate(input.value);
    setStatusRow(local.level, local.message);
    if (!local.ok || !input.value.trim()) return;

    if (validateController) validateController.abort();
    validateController = new AbortController();

    try {
      const res = await fetch(validateUrl, {
        method: "POST",
        credentials: "same-origin",
        signal: validateController.signal,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ sql: sqlSnapshot }),
      });
      if (!res.ok) return;
      const data = await res.json();
      if (requestSeq !== validateSeq || input.value !== sqlSnapshot) return;
      if (!data.ok) {
        const first = (data.issues || [])[0];
        setStatusRow(first && first.level ? first.level : "error", first && first.message ? first.message : "Invalid SQL filter.");
        return;
      }
      const warn = (data.issues || []).find((i) => i.level === "warning");
      if (warn) setStatusRow("warning", warn.message);
      else setStatusRow("success", "Filter is valid.");
    } catch (_err) {
      if (_err && _err.name === "AbortError") return;
    } finally {
      if (requestSeq === validateSeq) validateController = null;
    }
  }

  async function loadHints() {
    if (hints) return hints;
    try {
      const r = await fetch(fieldHintsUrl, { credentials: "same-origin" });
      if (r.ok) hints = await r.json();
    } catch (_) {}
    return hints;
  }

  function closeDropdown() {
    dropdown.style.display = "none";
    dropdown.innerHTML = "";
    activeIdx = -1;
    lastItems = [];
  }

  function openDropdown(items) {
    lastItems = items;
    activeIdx = -1;
    dropdown.innerHTML = "";
    items.forEach((item) => {
      const li = document.createElement("li");
      li.setAttribute("role", "option");
      li.setAttribute("aria-selected", "false");
      li.className = "dropdown-item py-1 px-2";
      li.style.cursor = "pointer";
      li.innerHTML = `<span class="me-1 text-secondary small">${_esc(item.prefix || "")}</span><strong>${_esc(item.label)}</strong>` +
        (item.hint ? ` <small class="text-muted ms-1">${_esc(item.hint)}</small>` : "");
      li.addEventListener("mousedown", (e) => {
        e.preventDefault();
        applyItem(item);
      });
      dropdown.appendChild(li);
    });
    if (!items.length && !statusState) { dropdown.style.display = "none"; return; }
    dropdown.style.display = "block";
    renderStatusRow();
  }

  function setActive(idx) {
    const lis = dropdown.querySelectorAll("li[role='option']");
    lis.forEach((li, i) => {
      li.classList.toggle("active", i === idx);
      li.setAttribute("aria-selected", i === idx ? "true" : "false");
    });
    activeIdx = idx;
    if (idx >= 0 && lis[idx]) lis[idx].scrollIntoView({ block: "nearest" });
  }

  function _esc(s) {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function _sqlQuote(s) {
    return String(s).replace(/'/g, "''");
  }

  function fieldByName(name) {
    if (!hints || !hints.fields) return null;
    const needle = String(name || "").toLowerCase();
    return hints.fields.find((f) => f.name.toLowerCase() === needle || f.column.toLowerCase() === needle) || null;
  }

  function parseContext(val, cursor) {
    const text = val.slice(0, cursor);

    const inQuotedVal = text.match(/(\w+)\s*(IN|NOT\s+IN)\s*\(\s*'((?:[^']|'')*)$/i);
    if (inQuotedVal) {
      return { type: "field_value", field: inQuotedVal[1].toLowerCase(), prefix: inQuotedVal[3].replace(/''/g, "'") };
    }

    const fieldVal = text.match(/(\w+)\s*(=|!=|LIKE|NOT\s+LIKE|ILIKE|NOT\s+ILIKE|>|<|>=|<=)\s*'((?:[^']|'')*)$/i);
    if (fieldVal) {
      return { type: "field_value", field: fieldVal[1].toLowerCase(), prefix: fieldVal[3].replace(/''/g, "'") };
    }

    const afterFieldOpWord = text.match(/(\w+)\s+([A-Za-z]*)$/);
    if (afterFieldOpWord && fieldByName(afterFieldOpWord[1])) {
      return { type: "field_operator", field: afterFieldOpWord[1].toLowerCase(), prefix: afterFieldOpWord[2] || "" };
    }

    const afterFieldOpSymbol = text.match(/(\w+)\s*([<>!=]{1,2})$/);
    if (afterFieldOpSymbol && fieldByName(afterFieldOpSymbol[1])) {
      return { type: "field_operator", field: afterFieldOpSymbol[1].toLowerCase(), prefix: afterFieldOpSymbol[2] || "" };
    }

    const fieldName = text.match(/(?:^|[\s(](?:AND|OR)\s+|^\s*)(\w*)$/i);
    if (fieldName !== null) {
      return { type: "field_name", prefix: fieldName[1] };
    }
    return null;
  }

  function applyItem(item) {
    const val = input.value;
    const cursor = input.selectionStart;
    const before = val.slice(0, cursor);
    const after = val.slice(cursor);

    let newBefore;
    if (item.type === "field_name") {
      newBefore = before.replace(/(\w*)$/, item.insert);
    } else if (item.type === "field_operator") {
      newBefore = before.replace(/(\w+)\s+([A-Za-z<>!=]*)$/, `$1 ${item.insert}`);
    } else if (item.type === "keyword" || item.type === "function" || item.type === "snippet") {
      newBefore = before.replace(/(\w*)$/, item.insert);
    } else if (item.type === "field_value") {
      newBefore = before.replace(/([^']*)'((?:[^']|'')*)$/, `$1'${_sqlQuote(item.insert)}`);
    } else {
      newBefore = before;
    }
    input.value = newBefore + after;
    const newCursor = newBefore.length;
    input.setSelectionRange(newCursor, newCursor);
    closeDropdown();
    input.focus();
    suggest();
  }

  async function suggest() {
    const h = await loadHints();
    if (!h) return;
    const cursor = input.selectionStart;
    const ctx = parseContext(input.value, cursor);
    if (!ctx) {
      closeDropdown();
      return;
    }

    let items = [];
    const pfx = (ctx.prefix || "").toLowerCase();

    if (ctx.type === "field_name") {
      const fieldAliases = h.fields.map((f) => ({
        type: "field_name",
        label: f.name,
        hint: `(${f.type})`,
        insert: f.name,
        prefix: "",
      }));
      const keywords = (h.keywords || []).map((kw) => ({
        type: "keyword",
        label: kw,
        hint: "keyword",
        insert: kw,
        prefix: "",
      }));
      const functions = (h.functions || []).map((fn) => ({
        type: "function",
        label: fn.name,
        hint: fn.signature || "function",
        insert: `${fn.name}(`,
        prefix: "",
      }));
      const snippets = (h.snippets || []).map((sn) => ({
        type: "snippet",
        label: sn.label,
        hint: sn.kind || "snippet",
        insert: sn.insert,
        prefix: "",
      }));
      const matchesPrefix = (item) => {
        const label = String(item.label || "").toLowerCase();
        const insert = String(item.insert || "").toLowerCase();
        const hint = String(item.hint || "").toLowerCase();
        return !pfx || label.startsWith(pfx) || insert.startsWith(pfx) || hint.includes(pfx);
      };
      items = [...fieldAliases, ...functions, ...keywords, ...snippets].filter(matchesPrefix);
    } else if (ctx.type === "field_operator") {
      const operators = [...(h.operators || localOperators), "IS NULL", "IS NOT NULL"].map((op) => ({
        type: "field_operator",
        label: op,
        hint: "operator",
        insert: op,
        prefix: `${ctx.field} `,
      }));
      items = operators.filter((op) => op.label.toLowerCase().startsWith(pfx));
    } else if (ctx.type === "field_value") {
      const field = h.fields.find((f) => f.name.toLowerCase() === ctx.field || f.column.toLowerCase() === ctx.field);
      if (field && field.values.length) {
        items = field.values
          .filter((v) => v.toLowerCase().startsWith(pfx))
          .slice(0, 20)
          .map((v) => ({ type: "field_value", label: v, insert: v, prefix: "" }));
      } else {
        items = [{ type: "field_value", label: "example", hint: "quoted value", insert: "example", prefix: "" }]
          .filter((v) => v.label.startsWith(pfx));
      }
    }

    openDropdown(items.slice(0, 100));
  }

  input.addEventListener("input", () => {
    const local = localValidate(input.value);
    setStatusRow(local.level, local.message);
    suggest();
    if (validateTimer) window.clearTimeout(validateTimer);
    validateTimer = window.setTimeout(validateServerSide, 350);
  });
  input.addEventListener("focus", suggest);
  input.addEventListener("blur", () => {
    if (validateTimer) window.clearTimeout(validateTimer);
    validateTimer = window.setTimeout(validateServerSide, 50);
  });

  input.addEventListener("keydown", (e) => {
    if (dropdown.style.display === "none") return;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(Math.min(activeIdx + 1, lastItems.length - 1));
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(Math.max(activeIdx - 1, -1));
    } else if (e.key === "Enter" || e.key === "Tab") {
      if (activeIdx >= 0 && lastItems[activeIdx]) {
        e.preventDefault();
        applyItem(lastItems[activeIdx]);
      } else {
        closeDropdown();
      }
    } else if (e.key === "Escape") {
      closeDropdown();
    }
  });

  document.addEventListener("click", (e) => {
    if (!input.contains(e.target) && !dropdown.contains(e.target)) {
      closeDropdown();
    }
  });

  // Pre-populate statusState for pre-filled sql (shown on first focus, not on load).
  if (input.value.trim()) {
    const initial = localValidate(input.value);
    statusState = { level: initial.level, message: initial.message };
  }
})();

// ── Saved Reports: AI page ────────────────────────────────────────────────
(function () {
  const group = document.getElementById('ai-reports-group');
  const saveBtn = document.getElementById('ai-save-report-btn');
  if (!group || !saveBtn) return;
  const menu = group.querySelector('ul');
  const pageBaseUrl = "/ai";

  function escHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  group.addEventListener('show.bs.dropdown', function () {
    fetch("/api/reports" + '?page_type=ai')
      .then(r => r.json())
      .then(reports => {
        if (!reports.length) {
          menu.innerHTML = '<li><span class="dropdown-item text-secondary small">No saved reports</span></li>';
          return;
        }
        menu.innerHTML = reports.map(rep => {
          const params = new URLSearchParams(rep.filters);
          const url = pageBaseUrl + '?' + params.toString();
          return `<li><a class="dropdown-item small" href="${url}" title="${escHtml(rep.description)}">${escHtml(rep.name)}</a></li>`;
        }).join('') +
          '<li><hr class="dropdown-divider my-1"></li>' +
          `<li><a class="dropdown-item small text-secondary" href="/reports"><i class="bi bi-gear me-1"></i>Manage reports</a></li>`;
      })
      .catch(() => {
        menu.innerHTML = '<li><span class="dropdown-item text-danger small">Failed to load</span></li>';
      });
  });

  saveBtn.addEventListener('click', function () {
    const form = document.querySelector('form[method="get"]');
    const data = new FormData(form);
    const filters = {};
    for (const [k, v] of data.entries()) {
      // Exclude internal AI page params that are not meaningful filter state
      if (v && k !== 'live') filters[k] = v;
    }
    if (window.sobsReportSaveModal && typeof window.sobsReportSaveModal.open === 'function') {
      window.sobsReportSaveModal.open({ pageType: 'ai', filters });
    }
  });
})();
</script>

  </div>
</div>

