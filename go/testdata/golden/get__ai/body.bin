<div style="flex: 1 1 120px; min-width: 0;">
  <label class="form-label small text-secondary">Sort by</label>
  <div class="dropdown sobs-multi-select-wrap" id="dropdown-sort_by">
    <button 
      class="form-select form-select-sm sobs-multi-select-toggle"
      type="button"
      id="btn-sort_by"
      data-bs-toggle="dropdown"
      aria-expanded="false"
      style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
      <span id="label-sort_by" class="sobs-multi-select-label">Timestamp</span>
    </button>
    <button
      type="button"
      id="clear-sort_by"
      class="sobs-multi-select-clear-btn"
      aria-label="Clear selected sort by"
      title="Clear selected sort by"
      hidden>
      <i class="bi bi-x"></i>
    </button>
    <ul class="dropdown-menu sobs-multi-select-menu" aria-labelledby="btn-sort_by">
      
      
      
      
      
      <li>
        <button
          type="button"
          class="dropdown-item px-2 py-2 d-flex align-items-center sobs-multi-select-option is-selected"
          data-filter-option="sort_by"
          data-option-value="Timestamp"
          aria-pressed="true">
          <i class="bi bi-check2 sobs-multi-select-checkmark visible" aria-hidden="true"></i>
          <span class="sobs-multi-select-option-text">Timestamp</span>
        </button>
      </li>
      
      
      
      
      
      <li>
        <button
          type="button"
          class="dropdown-item px-2 py-2 d-flex align-items-center sobs-multi-select-option"
          data-filter-option="sort_by"
          data-option-value="Duration"
          aria-pressed="false">
          <i class="bi bi-check2 sobs-multi-select-checkmark" aria-hidden="true"></i>
          <span class="sobs-multi-select-option-text">Duration</span>
        </button>
      </li>
      
      
      
      
      
      <li>
        <button
          type="button"
          class="dropdown-item px-2 py-2 d-flex align-items-center sobs-multi-select-option"
          data-filter-option="sort_by"
          data-option-value="ServiceName"
          aria-pressed="false">
          <i class="bi bi-check2 sobs-multi-select-checkmark" aria-hidden="true"></i>
          <span class="sobs-multi-select-option-text">Service</span>
        </button>
      </li>
      
    </ul>
  </div>
  <!-- Hidden inputs for form submission (initial state) -->
  <div id="hidden-fields-sort_by">
    <input type="hidden" name="sort_by" value="Timestamp">
  </div>
</div>

<script>
(function() {
  const filterName = "sort_by";
  const inputName = "sort_by";
  const singleSelect = true;
  const autoSubmit = true;
  const btnId = `btn-${filterName}`;
  const clearBtnId = `clear-${filterName}`;
  const labelId = `label-${filterName}`;
  const hiddenFieldsId = `hidden-fields-${filterName}`;
  
  const btn = document.getElementById(btnId);
  const clearBtn = document.getElementById(clearBtnId);
  const label = document.getElementById(labelId);
  const hiddenFieldsContainer = document.getElementById(hiddenFieldsId);
  const dropdown = document.getElementById(`dropdown-${filterName}`);
  const dropdownMenu = dropdown ? dropdown.querySelector('.dropdown-menu') : null;
  
  // Find all selectable options for this filter
  const options = document.querySelectorAll(`button[data-filter-option="${filterName}"]`);
  
  function getSelectedValues() {
    return Array.from(options)
      .filter(option => option.classList.contains('is-selected'))
      .map(option => option.dataset.optionValue || '');
  }

  function getSelectedLabels() {
    return Array.from(options)
      .filter(option => option.classList.contains('is-selected'))
      .map(option => {
        const textNode = option.querySelector('.sobs-multi-select-option-text');
        return textNode ? textNode.textContent.trim() : (option.dataset.optionValue || '');
      });
  }

  function syncOptionVisuals() {
    options.forEach((option) => {
      const isActive = option.classList.contains('is-selected');
      option.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      const checkmark = option.querySelector('.sobs-multi-select-checkmark');
      if (checkmark) {
        checkmark.classList.toggle('visible', isActive);
      }
    });
  }
  
  function updateLabel() {
    const checked = getSelectedValues();
    const checkedLabels = getSelectedLabels();
    
    if (checked.length === 0) {
      label.textContent = `All sort by`;
      label.title = `All sort by`;
    } else if (checked.length === 1) {
      label.textContent = checkedLabels[0] || checked[0];
      label.title = checkedLabels[0] || checked[0];
    } else {
      label.textContent = `${checked.length} selected`;
      label.title = checkedLabels.join(', ');
    }

    if (clearBtn) {
      clearBtn.hidden = singleSelect || checked.length <= 1;
    }

    syncOptionVisuals();
    
    // Update hidden fields for form submission
    hiddenFieldsContainer.innerHTML = '';
    checked.forEach(value => {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = inputName;
      input.value = value;
      hiddenFieldsContainer.appendChild(input);
    });
  }

  function updateMenuWidth() {
    if (!dropdownMenu || !btn) {
      return;
    }

    // Clear any previous explicit size before measuring.
    dropdownMenu.style.width = '';

    const triggerWidth = Math.ceil(btn.getBoundingClientRect().width);
    let contentWidth = 0;

    const computed = window.getComputedStyle(btn);
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    if (ctx) {
      ctx.font = `${computed.fontStyle} ${computed.fontVariant} ${computed.fontWeight} ${computed.fontSize} / ${computed.lineHeight} ${computed.fontFamily}`;
    }

    options.forEach((option) => {
      const text = String(option.dataset.optionValue || '').trim();
      if (!text) {
        return;
      }
      if (ctx) {
        contentWidth = Math.max(contentWidth, Math.ceil(ctx.measureText(text).width));
      } else {
        const textNode = option.querySelector('.sobs-multi-select-option-text');
        if (textNode) {
          contentWidth = Math.max(contentWidth, Math.ceil(textNode.scrollWidth));
        }
      }
    });

    // Extra room for menu padding and the right-side checkmark.
    const horizontalChrome = 72;
    const desired = Math.max(triggerWidth, contentWidth + horizontalChrome);
    const viewportCap = Math.floor(window.innerWidth * 0.9);
    const absoluteCap = 900;
    const finalWidth = Math.min(desired, viewportCap, absoluteCap);

    dropdownMenu.style.width = `${finalWidth}px`;
  }
  
  // Wait for DOM to be ready if needed
  function initialize() {
    // Initialize
    updateLabel();
    updateMenuWidth();
    
    // Toggle selection state on option click
    options.forEach(option => {
      option.addEventListener('click', () => {
        if (singleSelect) {
          options.forEach((item) => item.classList.remove('is-selected'));
          option.classList.add('is-selected');
        } else {
          option.classList.toggle('is-selected');
        }
        updateLabel();
        const event = new CustomEvent('sobs:filters:changed', { bubbles: true });
        option.dispatchEvent(event);
        // Auto-submit form when filter changes
        const form = option.closest('form');
        if (autoSubmit && form) {
          form.submit();
        }
      });
    });
    
    // Prevent dropdown from closing when clicking inside
    if (dropdownMenu) {
      dropdownMenu.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      // Recalculate width right before showing in case option content changed.
      dropdown.addEventListener('show.bs.dropdown', updateMenuWidth);
      dropdown.addEventListener('shown.bs.dropdown', updateMenuWidth);
      btn.addEventListener('click', updateMenuWidth);
      window.addEventListener('resize', updateMenuWidth);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        options.forEach((option) => option.classList.remove('is-selected'));
        updateLabel();
        const event = new CustomEvent('sobs:filters:changed', { bubbles: true });
        clearBtn.dispatchEvent(event);
        const form = clearBtn.closest('form');
        if (autoSubmit && form) {
          form.submit();
        }
      });
    }
  }
  
  // Run immediately if DOM is ready, otherwise wait
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize);
  } else {
    initialize();
  }
})();

(function () {
  if (window.__sobsFilterFormEnhancementsInit) {
    return;
  }
  window.__sobsFilterFormEnhancementsInit = true;

  function findSubmitButton(form) {
    return form.querySelector('[data-ai-action-role="filter-submit"], button[type="submit"]');
  }

  function flashSubmitButton(form) {
    const submitButton = findSubmitButton(form);
    if (!submitButton) {
      return;
    }
    submitButton.classList.remove('sobs-filter-submit-dirty');
    // Force reflow so repeated flashes retrigger animation.
    void submitButton.offsetWidth;
    submitButton.classList.add('sobs-filter-submit-dirty');
  }

  function shouldAutoSubmitOnChange(target) {
    if (!target) {
      return false;
    }
    if (target.tagName === 'SELECT') {
      return true;
    }
    if (target.tagName === 'INPUT') {
      const inputType = (target.type || '').toLowerCase();
      return ['checkbox', 'radio', 'number', 'range', 'date', 'datetime-local', 'time', 'month', 'week'].includes(inputType);
    }
    return false;
  }

  document.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }
    const form = target.closest('form.sobs-filter-form');
    if (!form) {
      return;
    }
    flashSubmitButton(form);
    if (shouldAutoSubmitOnChange(target)) {
      form.submit();
    }
  });

  document.addEventListener('input', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }
    const form = target.closest('form.sobs-filter-form');
    if (!form) {
      return;
    }
    flashSubmitButton(form);
  });

  document.addEventListener('sobs:filters:changed', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }
    const form = target.closest('form.sobs-filter-form');
    if (!form) {
      return;
    }
    flashSubmitButton(form);
  });
})();
</script>

