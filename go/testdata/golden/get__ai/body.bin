        <button type="button" class="btn btn-outline-secondary" data-sobs-theme="dark" title="Dark theme" aria-pressed="false">
          <i class="bi bi-moon-stars"></i>
        </button>
      </div>
      <div class="dropup sb-theme-compact mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Theme">
          <i id="sbCompactThemeIcon" class="bi bi-circle-half"></i>
        </button>
        <ul class="dropdown-menu shadow-sm">
          <li><button type="button" class="dropdown-item" data-sobs-theme="light"><i class="bi bi-sun me-2"></i>Light</button></li>
          <li><button type="button" class="dropdown-item" data-sobs-theme="system"><i class="bi bi-circle-half me-2"></i>System</button></li>
          <li><button type="button" class="dropdown-item" data-sobs-theme="dark"><i class="bi bi-moon-stars me-2"></i>Dark</button></li>
        </ul>
      </div>
      <br>
      <small class="text-secondary">Simple Observability Stack</small><br>
      <small class="text-secondary">dev</small>
    </div>
  </nav>

  <!-- Main -->
  <div class="main-content flex-grow-1 p-4">
    
      
    
    

<div class="page-header mb-3">
        <div class="page-header-main">
            <div class="page-header-title-wrap">
                
                    <h4 class="fw-semibold mb-0">
                        
                            <i class="bi bi-cpu me-2 text-success"></i>
                        
                        AI Transparency
                    </h4>
                
            </div>
            
            <div class="page-header-actions">
    <div class="btn-group" role="group" aria-label="View mode">
      <a href="/ai?view=flat&amp;service=&amp;model=&amp;operation=&amp;span_name=&amp;row_type=&amp;sql=&amp;from_ts=&amp;to_ts=&amp;sort_by=Timestamp&amp;sort_dir=desc&amp;limit=50&amp;offset=0"
        class="btn btn-sm btn-primary"
        title="Flat view"
        data-ai-action-id="ai.view.flat"
        data-ai-action-type="navigate"
        data-ai-handler="navigate"
        data-ai-args='{"target_page":"/ai","query":{"view":"flat"}}'
        data-ai-label="Switch AI view to flat"
        data-ai-risk="low"
        data-ai-confirm="false">
        <i class="bi bi-view-stacked me-1"></i><span class="ai-btn-label">Flat</span>
      </a>
      <a href="/ai?view=trace&amp;service=&amp;model=&amp;operation=&amp;span_name=&amp;row_type=&amp;sql=&amp;from_ts=&amp;to_ts=&amp;sort_by=Timestamp&amp;sort_dir=desc&amp;limit=50&amp;offset=0"
        class="btn btn-sm btn-outline-secondary"
        title="Group by trace"
        data-ai-action-id="ai.view.trace"
        data-ai-action-type="navigate"
        data-ai-handler="navigate"
        data-ai-args='{"target_page":"/ai","query":{"view":"trace"}}'
        data-ai-label="Switch AI view to trace"
        data-ai-risk="low"
        data-ai-confirm="false">
        <i class="bi bi-diagram-3 me-1"></i><span class="ai-btn-label">Group by Trace</span>
      </a>
    </div>
    <a href="/api/ai/export?service=&amp;model=&amp;operation=&amp;from_ts=&amp;to_ts="
       class="btn btn-sm btn-outline-secondary" title="Export training data as JSONL">
      <i class="bi bi-download me-1"></i><span class="ai-btn-label">Export JSONL</span>
    </a>
    <button id="liveTailBtn" class="btn btn-sm btn-outline-success" onclick="toggleLiveTail()"
            data-ai-action-id="ai.live_tail.toggle"
            data-ai-action-type="invoke_click"
            data-ai-handler="invokeClick"
            data-ai-label="Toggle AI live tail"
            data-ai-risk="low"
            data-ai-confirm="false"
            data-ai-args='{"element_id":"liveTailBtn"}'>
      <i class="bi bi-broadcast me-1"></i><span class="ai-btn-label">Live Tail</span>
    </button>
    <a href="/ai/help" class="btn btn-sm btn-outline-secondary page-help-btn" title="Help" aria-label="AI Transparency Help"><i class="bi bi-question-circle me-1"></i><span class="ai-btn-label">Help</span></a>
</div>
        </div>
        
    </div>

<!-- Live Tail Panel -->
<div id="liveTailPanel" class="card border-success mb-3" style="display:none;">
  <div class="card-header d-flex align-items-center justify-content-between py-2">
    <span class="text-success small fw-semibold"><i class="bi bi-broadcast me-1"></i>Live AI Tail</span>
    <div class="d-flex align-items-center gap-2">
      <span id="liveTailStatus" class="badge bg-secondary">Connecting…</span>
      <button class="btn btn-sm btn-outline-danger" onclick="stopLiveTail()">Stop</button>
    </div>
  </div>
  <div id="liveTailFeed" class="card-body p-2" style="max-height:250px;overflow-y:auto;font-size:0.8rem;">
    <div class="text-secondary text-center py-2">Waiting for AI events…</div>
  </div>
</div>

<!-- Summary cards -->
<div class="row g-3 mb-3">
  <div class="col-6 col-md-2">
    <div class="stat-card p-3 text-center">
      <div class="fs-4 fw-bold text-success">0</div>
      <div class="text-secondary small">Total Calls</div>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="stat-card p-3 text-center">
      <div class="fs-4 fw-bold text-info">0</div>
      <div class="text-secondary small">Tokens In</div>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="stat-card p-3 text-center">
      <div class="fs-4 fw-bold text-warning">0</div>
      <div class="text-secondary small">Tokens Out</div>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="stat-card p-3 text-center">
      <div class="fs-4 fw-bold text-primary">0</div>
      <div class="text-secondary small">Total Tokens</div>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="stat-card p-3 text-center">
      <div class="fs-4 fw-bold text-danger" id="errorRateDisplay">0</div>
      <div class="text-secondary small">Errors</div>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="stat-card p-3 text-center">
      <div class="fs-4 fw-bold text-success" id="estCostDisplay">…</div>
      <div class="text-secondary small d-flex justify-content-center align-items-center gap-1">
        <span>Est. Cost (USD)</span>
        <a
          id="estCostInferredHint"
          class="d-none text-info"
          href="/settings/ai"
          title="Includes inferred pricing"
          aria-label="Includes inferred pricing"
        ><i class="bi bi-info-circle"></i></a>
      </div>
    </div>
  </div>
</div>

<!-- Filter bar -->
<div class="accordion mb-3" id="aiFiltersAccordion">
  <div class="accordion-item border-secondary">
    <h2 class="accordion-header" id="aiFiltersHeading">
      <button class="accordion-button py-2" type="button"
              data-bs-toggle="collapse" data-bs-target="#aiFiltersPanel"
              aria-expanded="true" aria-controls="aiFiltersPanel">
        <i class="bi bi-funnel me-2 text-secondary"></i>
        <span class="fw-semibold">Filters</span>
        
        <span id="ai-tz-badge-btn" class="sobs-tz-header-badge" role="button" tabindex="0" title="Display timezone - click to change">
          <i class="bi bi-clock"></i>
          <span id="ai-tz-badge-label">UTC</span>
        </span>
        
        
        
      </button>
    </h2>
    <div id="aiFiltersPanel" class="accordion-collapse collapse show" aria-labelledby="aiFiltersHeading" data-bs-parent="#aiFiltersAccordion">
      <div class="accordion-body py-3">
        
    <form method="get" class="d-flex flex-wrap gap-2 align-items-end sobs-filter-form">
      <input type="hidden" name="view" value="flat">
      

<div style="flex: 1 1 140px; min-width: 0;">
  <label class="form-label small text-secondary">Service</label>
  <div class="dropdown sobs-multi-select-wrap" id="dropdown-service">
    <button 
      class="form-select form-select-sm sobs-multi-select-toggle"
      type="button"
      id="btn-service"
      data-bs-toggle="dropdown"
      aria-expanded="false"
      style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
      <span id="label-service" class="sobs-multi-select-label">
          All service</span>
    </button>
    <button
      type="button"
      id="clear-service"
      class="sobs-multi-select-clear-btn"
      aria-label="Clear selected service"
      title="Clear selected service"
      hidden>
      <i class="bi bi-x"></i>
    </button>
    <ul class="dropdown-menu sobs-multi-select-menu" aria-labelledby="btn-service">
      
    </ul>
  </div>
  <!-- Hidden inputs for form submission (initial state) -->
  <div id="hidden-fields-service">
  </div>
</div>

<script>
(function() {
  const filterName = "service";
  const inputName = "service";
  const singleSelect = false;
  const autoSubmit = true;
  const btnId = `btn-${filterName}`;
  const clearBtnId = `clear-${filterName}`;
  const labelId = `label-${filterName}`;
  const hiddenFieldsId = `hidden-fields-${filterName}`;
  
  const btn = document.getElementById(btnId);
  const clearBtn = document.getElementById(clearBtnId);
  const label = document.getElementById(labelId);
  const hiddenFieldsContainer = document.getElementById(hiddenFieldsId);
  const dropdown = document.getElementById(`dropdown-${filterName}`);
  const dropdownMenu = dropdown ? dropdown.querySelector('.dropdown-menu') : null;
  
  // Find all selectable options for this filter
  const options = document.querySelectorAll(`button[data-filter-option="${filterName}"]`);
  
  function getSelectedValues() {
    return Array.from(options)
      .filter(option => option.classList.contains('is-selected'))
      .map(option => option.dataset.optionValue || '');
  }

  function getSelectedLabels() {
    return Array.from(options)
      .filter(option => option.classList.contains('is-selected'))
      .map(option => {
        const textNode = option.querySelector('.sobs-multi-select-option-text');
        return textNode ? textNode.textContent.trim() : (option.dataset.optionValue || '');
      });
  }

  function syncOptionVisuals() {
    options.forEach((option) => {
      const isActive = option.classList.contains('is-selected');
      option.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      const checkmark = option.querySelector('.sobs-multi-select-checkmark');
      if (checkmark) {
        checkmark.classList.toggle('visible', isActive);
      }
    });
  }
  
  function updateLabel() {
    const checked = getSelectedValues();
    const checkedLabels = getSelectedLabels();
    
    if (checked.length === 0) {
      label.textContent = `All service`;
      label.title = `All service`;
    } else if (checked.length === 1) {
      label.textContent = checkedLabels[0] || checked[0];
      label.title = checkedLabels[0] || checked[0];
    } else {
      label.textContent = `${checked.length} selected`;
      label.title = checkedLabels.join(', ');
    }

    if (clearBtn) {
      clearBtn.hidden = singleSelect || checked.length <= 1;
    }

    syncOptionVisuals();
    
    // Update hidden fields for form submission
    hiddenFieldsContainer.innerHTML = '';
    checked.forEach(value => {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = inputName;
      input.value = value;
      hiddenFieldsContainer.appendChild(input);
    });
  }

  function updateMenuWidth() {
    if (!dropdownMenu || !btn) {
      return;
    }

    // Clear any previous explicit size before measuring.
    dropdownMenu.style.width = '';

    const triggerWidth = Math.ceil(btn.getBoundingClientRect().width);
    let contentWidth = 0;

    const computed = window.getComputedStyle(btn);
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    if (ctx) {
      ctx.font = `${computed.fontStyle} ${computed.fontVariant} ${computed.fontWeight} ${computed.fontSize} / ${computed.lineHeight} ${computed.fontFamily}`;
    }

    options.forEach((option) => {
      const text = String(option.dataset.optionValue || '').trim();
      if (!text) {
        return;
      }
      if (ctx) {
        contentWidth = Math.max(contentWidth, Math.ceil(ctx.measureText(text).width));
      } else {
        const textNode = option.querySelector('.sobs-multi-select-option-text');
        if (textNode) {
          contentWidth = Math.max(contentWidth, Math.ceil(textNode.scrollWidth));
        }
      }
    });

    // Extra room for menu padding and the right-side checkmark.
    const horizontalChrome = 72;
    const desired = Math.max(triggerWidth, contentWidth + horizontalChrome);
    const viewportCap = Math.floor(window.innerWidth * 0.9);
    const absoluteCap = 900;
    const finalWidth = Math.min(desired, viewportCap, absoluteCap);

    dropdownMenu.style.width = `${finalWidth}px`;
  }
  
  // Wait for DOM to be ready if needed
  function initialize() {
    // Initialize
    updateLabel();
    updateMenuWidth();
    
    // Toggle selection state on option click
    options.forEach(option => {
      option.addEventListener('click', () => {
        if (singleSelect) {
          options.forEach((item) => item.classList.remove('is-selected'));
          option.classList.add('is-selected');
        } else {
          option.classList.toggle('is-selected');
        }
        updateLabel();
        const event = new CustomEvent('sobs:filters:changed', { bubbles: true });
        option.dispatchEvent(event);
        // Auto-submit form when filter changes
        const form = option.closest('form');
        if (autoSubmit && form) {
          form.submit();
        }
      });
    });
    
    // Prevent dropdown from closing when clicking inside
    if (dropdownMenu) {
      dropdownMenu.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      // Recalculate width right before showing in case option content changed.
      dropdown.addEventListener('show.bs.dropdown', updateMenuWidth);
      dropdown.addEventListener('shown.bs.dropdown', updateMenuWidth);
      btn.addEventListener('click', updateMenuWidth);
      window.addEventListener('resize', updateMenuWidth);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        options.forEach((option) => option.classList.remove('is-selected'));
        updateLabel();
        const event = new CustomEvent('sobs:filters:changed', { bubbles: true });
        clearBtn.dispatchEvent(event);
        const form = clearBtn.closest('form');
        if (autoSubmit && form) {
          form.submit();
        }
      });
    }
  }
  
  // Run immediately if DOM is ready, otherwise wait
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize);
  } else {
    initialize();
  }
})();

(function () {
  if (window.__sobsFilterFormEnhancementsInit) {
    return;
  }
  window.__sobsFilterFormEnhancementsInit = true;

  function findSubmitButton(form) {
    return form.querySelector('[data-ai-action-role="filter-submit"], button[type="submit"]');
  }

  function flashSubmitButton(form) {
    const submitButton = findSubmitButton(form);
    if (!submitButton) {
      return;
    }
    submitButton.classList.remove('sobs-filter-submit-dirty');
    // Force reflow so repeated flashes retrigger animation.
    void submitButton.offsetWidth;
    submitButton.classList.add('sobs-filter-submit-dirty');
  }

  function shouldAutoSubmitOnChange(target) {
    if (!target) {
      return false;
    }
    if (target.tagName === 'SELECT') {
      return true;
    }
    if (target.tagName === 'INPUT') {
      const inputType = (target.type || '').toLowerCase();
      return ['checkbox', 'radio', 'number', 'range', 'date', 'datetime-local', 'time', 'month', 'week'].includes(inputType);
    }
    return false;
  }

  document.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }
    const form = target.closest('form.sobs-filter-form');
    if (!form) {
      return;
    }
    flashSubmitButton(form);
    if (shouldAutoSubmitOnChange(target)) {
      form.submit();
    }
  });

  document.addEventListener('input', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }
    const form = target.closest('form.sobs-filter-form');
    if (!form) {
      return;
    }
    flashSubmitButton(form);
  });

  document.addEventListener('sobs:filters:changed', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }
    const form = target.closest('form.sobs-filter-form');
    if (!form) {
      return;
    }
    flashSubmitButton(form);
  });
})();
</script>

<style>
  .sobs-multi-select-toggle {
    text-align: left;
    padding-right: 3.5rem;
    background-position: right 0.75rem center;
    cursor: pointer;
  }

  .sobs-multi-select-wrap {
    position: relative;
  }

  .sobs-multi-select-clear-btn {
    position: absolute;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    border: 0;
    background: transparent;
    color: var(--bs-secondary-color);
    width: 1rem;
    height: 1rem;
    padding: 0;
    line-height: 1;
    opacity: 0.75;
  }

  .sobs-multi-select-clear-btn:hover {
    opacity: 1;
    color: var(--bs-body-color);
  }

  .sobs-multi-select-label {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 400;
  }

  .sobs-multi-select-menu {
    min-width: 100%;
    width: 100%;
    max-width: min(700px, 90vw);
    margin-left: -0.45rem;
    max-height: min(360px, 60vh);
    overflow-x: auto;
    overflow-y: auto;
  }

  .sobs-multi-select-option {
    transition: background-color 0.15s ease-in-out;
    cursor: pointer;
    font-size: 0.875rem;
    line-height: 1.5;
    font-weight: 400;
    white-space: nowrap;
    gap: 0.24rem;
  }

  .sobs-multi-select-option-text {
    flex: 1 1 auto;
    min-width: max-content;
    padding-right: 0.25rem;
  }

  .sobs-multi-select-option:hover {
    background-color: rgba(13, 110, 253, 0.08);
  }

  .sobs-multi-select-option.is-selected,
  .sobs-multi-select-option.is-selected:focus,
  .sobs-multi-select-option.is-selected:active {
    color: inherit;
    background-color: rgba(13, 110, 253, 0.08);
  }

  .sobs-multi-select-checkmark {
    width: 0.84rem;
    min-width: 0.84rem;
    opacity: 0;
    color: var(--bs-secondary-color);
  }

  .sobs-multi-select-checkmark.visible {
    opacity: 1;
    color: var(--bs-body-color);
  }

  .sobs-filter-submit-dirty {
    animation: sobsFilterSubmitFlash 850ms ease-out;
  }

  @keyframes sobsFilterSubmitFlash {
    0% {
      box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.55);
    }
    100% {
      box-shadow: 0 0 0 7px rgba(13, 110, 253, 0);
    }
  }
</style>

      

<div style="flex: 1 1 140px; min-width: 0;">
  <label class="form-label small text-secondary">Model</label>
  <div class="dropdown sobs-multi-select-wrap" id="dropdown-model">
    <button 
      class="form-select form-select-sm sobs-multi-select-toggle"
      type="button"
      id="btn-model"
      data-bs-toggle="dropdown"
      aria-expanded="false"
      style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
      <span id="label-model" class="sobs-multi-select-label">
          All model</span>
    </button>
    <button
      type="button"
      id="clear-model"
      class="sobs-multi-select-clear-btn"
      aria-label="Clear selected model"
      title="Clear selected model"
      hidden>
      <i class="bi bi-x"></i>
    </button>
    <ul class="dropdown-menu sobs-multi-select-menu" aria-labelledby="btn-model">
      
    </ul>
  </div>
  <!-- Hidden inputs for form submission (initial state) -->
  <div id="hidden-fields-model">
  </div>
</div>

<script>
(function() {
  const filterName = "model";
  const inputName = "model";
  const singleSelect = false;
  const autoSubmit = true;
  const btnId = `btn-${filterName}`;
  const clearBtnId = `clear-${filterName}`;
  const labelId = `label-${filterName}`;
  const hiddenFieldsId = `hidden-fields-${filterName}`;
  
  const btn = document.getElementById(btnId);
  const clearBtn = document.getElementById(clearBtnId);
  const label = document.getElementById(labelId);
  const hiddenFieldsContainer = document.getElementById(hiddenFieldsId);
  const dropdown = document.getElementById(`dropdown-${filterName}`);
  const dropdownMenu = dropdown ? dropdown.querySelector('.dropdown-menu') : null;
  
  // Find all selectable options for this filter
  const options = document.querySelectorAll(`button[data-filter-option="${filterName}"]`);
  
  function getSelectedValues() {
    return Array.from(options)
      .filter(option => option.classList.contains('is-selected'))
      .map(option => option.dataset.optionValue || '');
  }

  function getSelectedLabels() {
    return Array.from(options)
      .filter(option => option.classList.contains('is-selected'))
      .map(option => {
        const textNode = option.querySelector('.sobs-multi-select-option-text');
        return textNode ? textNode.textContent.trim() : (option.dataset.optionValue || '');
      });
  }

  function syncOptionVisuals() {
    options.forEach((option) => {
      const isActive = option.classList.contains('is-selected');
      option.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      const checkmark = option.querySelector('.sobs-multi-select-checkmark');
      if (checkmark) {
        checkmark.classList.toggle('visible', isActive);
      }
    });
  }
  
  function updateLabel() {
    const checked = getSelectedValues();
    const checkedLabels = getSelectedLabels();
    
    if (checked.length === 0) {
      label.textContent = `All model`;
      label.title = `All model`;
    } else if (checked.length === 1) {
      label.textContent = checkedLabels[0] || checked[0];
      label.title = checkedLabels[0] || checked[0];
    } else {
      label.textContent = `${checked.length} selected`;
      label.title = checkedLabels.join(', ');
    }

    if (clearBtn) {
      clearBtn.hidden = singleSelect || checked.length <= 1;
    }

    syncOptionVisuals();
    
    // Update hidden fields for form submission
    hiddenFieldsContainer.innerHTML = '';
    checked.forEach(value => {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = inputName;
      input.value = value;
      hiddenFieldsContainer.appendChild(input);
    });
  }

  function updateMenuWidth() {
    if (!dropdownMenu || !btn) {
      return;
    }

    // Clear any previous explicit size before measuring.
    dropdownMenu.style.width = '';

    const triggerWidth = Math.ceil(btn.getBoundingClientRect().width);
    let contentWidth = 0;

    const computed = window.getComputedStyle(btn);
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    if (ctx) {
      ctx.font = `${computed.fontStyle} ${computed.fontVariant} ${computed.fontWeight} ${computed.fontSize} / ${computed.lineHeight} ${computed.fontFamily}`;
    }

    options.forEach((option) => {
      const text = String(option.dataset.optionValue || '').trim();
      if (!text) {
        return;
      }
      if (ctx) {
        contentWidth = Math.max(contentWidth, Math.ceil(ctx.measureText(text).width));
      } else {
        const textNode = option.querySelector('.sobs-multi-select-option-text');
        if (textNode) {
          contentWidth = Math.max(contentWidth, Math.ceil(textNode.scrollWidth));
        }
      }
    });

    // Extra room for menu padding and the right-side checkmark.
    const horizontalChrome = 72;
    const desired = Math.max(triggerWidth, contentWidth + horizontalChrome);
    const viewportCap = Math.floor(window.innerWidth * 0.9);
    const absoluteCap = 900;
    const finalWidth = Math.min(desired, viewportCap, absoluteCap);

    dropdownMenu.style.width = `${finalWidth}px`;
  }
  
  // Wait for DOM to be ready if needed
  function initialize() {
    // Initialize
    updateLabel();
    updateMenuWidth();
    
    // Toggle selection state on option click
    options.forEach(option => {
      option.addEventListener('click', () => {
        if (singleSelect) {
          options.forEach((item) => item.classList.remove('is-selected'));
          option.classList.add('is-selected');
        } else {
          option.classList.toggle('is-selected');
        }
        updateLabel();
        const event = new CustomEvent('sobs:filters:changed', { bubbles: true });
        option.dispatchEvent(event);
        // Auto-submit form when filter changes
        const form = option.closest('form');
        if (autoSubmit && form) {
          form.submit();
        }
      });
    });
    
    // Prevent dropdown from closing when clicking inside
    if (dropdownMenu) {
      dropdownMenu.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      // Recalculate width right before showing in case option content changed.
      dropdown.addEventListener('show.bs.dropdown', updateMenuWidth);
      dropdown.addEventListener('shown.bs.dropdown', updateMenuWidth);
      btn.addEventListener('click', updateMenuWidth);
      window.addEventListener('resize', updateMenuWidth);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        options.forEach((option) => option.classList.remove('is-selected'));
        updateLabel();
        const event = new CustomEvent('sobs:filters:changed', { bubbles: true });
        clearBtn.dispatchEvent(event);
        const form = clearBtn.closest('form');
        if (autoSubmit && form) {
          form.submit();
        }
      });
    }
  }
  
  // Run immediately if DOM is ready, otherwise wait
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize);
  } else {
    initialize();
  }
})();

(function () {
  if (window.__sobsFilterFormEnhancementsInit) {
    return;
  }
  window.__sobsFilterFormEnhancementsInit = true;

  function findSubmitButton(form) {
    return form.querySelector('[data-ai-action-role="filter-submit"], button[type="submit"]');
  }

