          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button id="saveReportSubmit" type="submit" class="btn btn-primary">
            <i class="bi bi-bookmark-check me-1"></i>Save report
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

