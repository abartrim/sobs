  }

  .sobs-multi-select-checkmark.visible {
    opacity: 1;
    color: var(--bs-body-color);
  }

  .sobs-filter-submit-dirty {
    animation: sobsFilterSubmitFlash 850ms ease-out;
  }

  @keyframes sobsFilterSubmitFlash {
    0% {
      box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.55);
    }
    100% {
      box-shadow: 0 0 0 7px rgba(13, 110, 253, 0);
    }
  }
</style>


