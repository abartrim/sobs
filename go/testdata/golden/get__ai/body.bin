      dropdown.addEventListener('shown.bs.dropdown', updateMenuWidth);
      btn.addEventListener('click', updateMenuWidth);
      window.addEventListener('resize', updateMenuWidth);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        options.forEach((option) => option.classList.remove('is-selected'));
        updateLabel();
        const event = new CustomEvent('sobs:filters:changed', { bubbles: true });
        clearBtn.dispatchEvent(event);
        const form = clearBtn.closest('form');
        if (autoSubmit && form) {
          form.submit();
        }
      });
    }
  }
  
  // Run immediately if DOM is ready, otherwise wait
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize);
  } else {
    initialize();
  }
})();

(function () {
  if (window.__sobsFilterFormEnhancementsInit) {
    return;
  }
  window.__sobsFilterFormEnhancementsInit = true;

  function findSubmitButton(form) {
    return form.querySelector('[data-ai-action-role="filter-submit"], button[type="submit"]');
  }

  function flashSubmitButton(form) {
    const submitButton = findSubmitButton(form);
    if (!submitButton) {
      return;
    }
    submitButton.classList.remove('sobs-filter-submit-dirty');
    // Force reflow so repeated flashes retrigger animation.
    void submitButton.offsetWidth;
    submitButton.classList.add('sobs-filter-submit-dirty');
  }

  function shouldAutoSubmitOnChange(target) {
    if (!target) {
      return false;
    }
    if (target.tagName === 'SELECT') {
      return true;
    }
    if (target.tagName === 'INPUT') {
      const inputType = (target.type || '').toLowerCase();
      return ['checkbox', 'radio', 'number', 'range', 'date', 'datetime-local', 'time', 'month', 'week'].includes(inputType);
    }
    return false;
  }

  document.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }
    const form = target.closest('form.sobs-filter-form');
    if (!form) {
      return;
    }
    flashSubmitButton(form);
    if (shouldAutoSubmitOnChange(target)) {
      form.submit();
    }
  });

  document.addEventListener('input', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }
    const form = target.closest('form.sobs-filter-form');
    if (!form) {
      return;
    }
    flashSubmitButton(form);
  });

  document.addEventListener('sobs:filters:changed', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }
    const form = target.closest('form.sobs-filter-form');
    if (!form) {
      return;
    }
    flashSubmitButton(form);
  });
})();
</script>

<style>
  .sobs-multi-select-toggle {
