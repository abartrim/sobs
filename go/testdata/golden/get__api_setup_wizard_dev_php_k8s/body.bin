{"checklist":[{"id":"sdk","label":"Install & initialise the SDK"},{"id":"collector","label":"Run the OpenTelemetry Collector"},{"id":"verify","label":"Verify data in SOBS"}],"deployment":"kubernetes","env":"dev","language":"php","ok":true,"steps":[{"commands":["composer require open-telemetry/sdk open-telemetry/exporter-otlp"],"description":"Add the SDK and OTLP exporter via Composer.","id":"sdk_install","language":"bash","title":"Install OpenTelemetry PHP SDK"},{"commands":["use OpenTelemetry\\SDK\\Trace\\TracerProviderFactory;","use OpenTelemetry\\Contrib\\Otlp\\OtlpHttpTransportFactory;","","$tracerProvider = (new TracerProviderFactory())->create();","\\OpenTelemetry\\API\\Globals::registerInitializer(fn() => $tracerProvider);"],"description":"Configure a tracer provider before handling requests.","id":"sdk_init","language":"php","title":"Bootstrap the SDK"},{"commands":["# otel-collector-k8s.yaml","apiVersion: v1","kind: ConfigMap","metadata:","  name: otel-collector-config","data:","  config.yaml: |","    receivers:","      otlp:","        protocols:","          grpc:","            endpoint: 0.0.0.0:4317","    exporters:","      otlphttp:","        endpoint: http://localhost:44317","    service:","      pipelines:","        traces:","          receivers: [otlp]","          exporters: [otlphttp]","        metrics:","          receivers: [otlp]","          exporters: [otlphttp]","        logs:","          receivers: [otlp]","          exporters: [otlphttp]","---","apiVersion: apps/v1","kind: Deployment","metadata:","  name: otel-collector","spec:","  replicas: 1","  selector:","    matchLabels:","      app: otel-collector","  template:","    metadata:","      labels:","        app: otel-collector","    spec:","      containers:","      - name: otel-collector","        image: otel/opentelemetry-collector-contrib:latest","        args: ['--config=/etc/otelcol-contrib/config.yaml']","        volumeMounts:","        - name: config","          mountPath: /etc/otelcol-contrib","      volumes:","      - name: config","        configMap:","          name: otel-collector-config"],"description":"Apply a ConfigMap and Deployment that routes to SOBS.","id":"collector_k8s","language":"yaml","title":"Deploy the OpenTelemetry Collector on Kubernetes"},{"commands":["kubectl apply -f otel-collector-k8s.yaml"],"description":"Deploy the collector to your cluster.","id":"collector_k8s_apply","language":"bash","title":"Apply the manifest"},{"commands":["# Open your browser and navigate to http://localhost:44317/","# The Summary card should show span, log, and metric counts within ~30 s."],"description":"Check the Summary page for incoming telemetry.","id":"sobs_verify","language":"bash","title":"Verify data arrives in SOBS"}],"version":"1"}
