<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Traces — Simple Observe</title>
  <script>(function () {
    function normalizeTheme(value) {
      return (value === 'light' || value === 'dark' || value === 'system') ? value : 'system';
    }
    var t = normalizeTheme(localStorage.getItem('sobs-theme'));
    document.documentElement.setAttribute('data-bs-theme',
      t === 'system' ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : t);

    // Apply sidebar state before first paint to avoid full->compact layout jump.
    var root = document.documentElement;
    root.classList.add('sb-state-pending');
    try {
      var sidebarState = localStorage.getItem('sobs-sidebar-state') || 'full';
      var isHamburger = window.matchMedia('(max-width: 575.98px)').matches;
      if (sidebarState === 'compact' && !isHamburger) {
        root.classList.add('sb-state-compact');
      }
    } catch (_err) {
      // Ignore storage/matchMedia failures and continue with default layout.
    }
  }());</script>
  <link rel="stylesheet" href="/static/bootstrap.min.css">
  <link rel="stylesheet" href="/static/bootstrap-icons.min.css">
  <style>
    body { font-size: .9rem; }
    .nav-link.active { font-weight: 600; }
    /* Raw signal identifier shown below a human-friendly label */
    .signal-raw-id { font-size: 0.7em; display: block; }
    .signal-raw-id-inline { font-size: 0.75em; }
    /* ===== Sidebar Base ===== */
    :root { --sb-full: 220px; --sb-compact: 56px; }
    .sidebar { flex-shrink: 0; width: var(--sb-full); min-height: 100vh; padding: 1rem; background: var(--bs-tertiary-bg); border-right: 1px solid var(--bs-border-color); position: relative; overflow: visible; z-index: 1030; transition: width 0.22s ease; }
    .sidebar .nav-link { color: var(--bs-secondary-color); border-radius: 6px; margin: 1px 4px; padding: .4rem .8rem; display: flex; align-items: center; gap: .5rem; white-space: nowrap; }
    .sidebar .nav { flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; scrollbar-gutter: stable; flex-wrap: nowrap; }
    .sidebar .nav-link:hover, .sidebar .nav-link.active { background: var(--bs-secondary-bg); color: var(--bs-emphasis-color); }
    .sidebar .nav-link i { width: 1.4rem; flex-shrink: 0; }
    /* Sidebar label (text part) */
    .sb-label { overflow: hidden; transition: opacity 0.15s ease, max-width 0.22s ease; max-width: 200px; white-space: nowrap; }
    /* ===== State 2: Compact (icon-only) ===== */
    .sidebar.sidebar-compact { width: var(--sb-compact); padding-left: 0; padding-right: 0; }
    .sidebar.sidebar-compact .sb-label { opacity: 0; max-width: 0; pointer-events: none; }
    .sidebar.sidebar-compact .sb-brand-text { display: none; }
    .sidebar.sidebar-compact .nav-link {
      margin: 1px auto;
      width: calc(var(--sb-compact) - 8px);
      padding: .5rem 0;
      justify-content: center;
      gap: 0;
      text-align: center;
    }
    .sidebar.sidebar-compact .nav-link i {
      width: auto;
      min-width: 1.4rem;
      display: inline-flex;
      justify-content: center;
    }
    .sidebar.sidebar-compact .sb-brand { padding: 0 .6rem; justify-content: center; }
    .sb-theme-compact { display: none; }
    .sb-theme-slot-compact { display: none; }
    .sb-theme-slot-compact .dropdown-menu { min-width: 10rem; }
    .sb-theme-slot-compact .nav-link {
      border: 0;
      background: transparent;
      color: var(--bs-secondary-color);
      border-radius: 6px;
      margin: 1px auto;
      width: calc(var(--sb-compact) - 8px);
      padding: .5rem 0;
      justify-content: center;
      gap: 0;
      text-align: center;
    }
    .sb-theme-slot-compact .nav-link:hover,
    .sb-theme-slot-compact .nav-link.active {
      background: var(--bs-secondary-bg);
      color: var(--bs-emphasis-color);
    }
    .sidebar.sidebar-compact .sb-footer {
      display: none !important;
    }
    .sidebar.sidebar-compact .sb-theme-slot-compact {
      display: block;
      margin-top: auto;
      margin-bottom: 0;
      padding-bottom: .25rem;
    }
    .sidebar.sidebar-compact .sb-footer .sb-theme-full { display: none !important; }
    .sidebar.sidebar-compact .sb-footer .sb-theme-compact { display: none !important; }
    .sidebar.sidebar-compact .sb-footer small { display: none; }
    /* ===== Sidebar edge toggle button ===== */
    /* Draw border as a right-side half-ring so the menu-side edge stays clean and the icon remains unobstructed. */
    .sb-toggle-btn { position: absolute; right: -14px; top: 64px; z-index: 1031; width: 28px; height: 28px; border-radius: 50%; border: 0; background: var(--bs-tertiary-bg); color: var(--bs-secondary-color); display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; transition: background 0.15s, color 0.15s; }
    .sb-toggle-btn::after { content: ''; position: absolute; inset: 0; border: 1px solid var(--bs-border-color); border-radius: 50%; clip-path: inset(0 0 0 50%); pointer-events: none; }
    .sb-toggle-btn > i { position: relative; z-index: 1; }
    .sb-toggle-btn:hover { background: var(--bs-secondary-bg); color: var(--bs-emphasis-color); }
    /* Keep sidebar/menu controls inert under modal backdrops. */
    body.modal-open .sidebar,
    body.modal-open .sb-toggle-btn {
      pointer-events: none;
    }
    /* ===== State 3: Hamburger topbar ===== */
    .sb-topbar { display: none; background: var(--bs-tertiary-bg); border-bottom: 1px solid var(--bs-border-color); padding: .5rem 1rem; align-items: center; gap: .75rem; position: sticky; top: 0; z-index: 100; }
    /* Overlay backdrop */
    .sb-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 1040; }
    .sb-backdrop.show { display: block; }
    /* Hamburger mode (≤ 575px) */
    @media (max-width: 575.98px) {
      .sb-topbar { display: flex; }
      .sb-toggle-btn { display: none; }
      .sidebar { position: fixed; top: 0; left: 0; bottom: 0; width: var(--sb-full); z-index: 1045; overflow: visible; transform: translateX(-100%); transition: transform 0.25s ease; }
      .sidebar.sb-open { transform: translateX(0); }
      .sidebar.sidebar-compact { padding-left: 1rem; padding-right: 1rem; }
      .sidebar.sidebar-compact .sb-label { opacity: 1; max-width: 200px; pointer-events: auto; }
      .sidebar.sidebar-compact .sb-brand-text { display: inline; }
      .sidebar.sidebar-compact .nav-link { margin: 1px 4px; padding: .4rem .8rem; justify-content: flex-start; }
      .sidebar.sidebar-compact .sb-brand { padding: 0; justify-content: flex-start; }
      .sidebar.sidebar-compact .sb-footer {
        display: block;
        border-top: 1px solid var(--bs-border-color) !important;
        padding-top: 1rem !important;
      }
      .sidebar.sidebar-compact .sb-theme-slot-compact { display: none; }
      .sidebar.sidebar-compact .sb-footer .sb-theme-full { display: inline-flex !important; }
      .sidebar.sidebar-compact .sb-footer .sb-theme-compact { display: none !important; }
      .sidebar.sidebar-compact .sb-footer small { display: inline; }
      .main-content { padding: 1rem !important; overflow-x: hidden; }
      .sobs-filter-form > * {
        flex: 1 1 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
      }
