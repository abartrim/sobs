<style>
#traceErrAccordion {
    overflow-x: hidden;
    }
    #traceErrAccordion .accordion-item,
    #traceErrAccordion .accordion-header,
    #traceErrAccordion .accordion-button {
    max-width: 100%;
    min-width: 0;
    }
    #traceErrAccordion .accordion-button.error-panel-button {
    overflow: hidden;
    }
    .error-panel-summary {
    width: 100%;
    max-width: calc(100% - .25rem);
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-wrap: nowrap;
    gap: .5rem;
    align-items: center;
    }
    .error-panel-summary > * {
    min-width: 0;
    }
    .error-panel-type,
    .error-panel-service,
    .error-panel-span-id,
    .error-panel-timestamp {
    display: inline-block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    }
    .error-panel-type {
    max-width: 18ch;
    }
    .error-panel-service {
    max-width: 16ch;
    }
    .error-panel-span-id {
    max-width: 10ch;
    }
    @media (max-width: ) {
    .error-panel-type {
    max-width: 13ch;
    }
    .error-panel-service {
    max-width: 11ch;
    }
    }
    .error-panel-message-preview {
    display: block;
    flex: 1 1 auto;
    width: 0;
    min-width: 0;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    }
    @media (max-width: ) {
    #traceErrAccordion.error-accordion-compact-mobile .accordion-item {
    margin-bottom: 0.6rem;
    }
    #traceErrAccordion.error-accordion-compact-mobile .error-panel-summary {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    grid-template-areas:
    "state count type timestamp"
    "service service service timestamp";
    align-items: center;
    row-gap: 0.28rem;
    column-gap: 0.45rem;
    max-width: calc(100% - 1.25rem);
    }
    #traceErrAccordion.error-accordion-compact-mobile .error-panel-state {
    grid-area: state;
    }
    #traceErrAccordion.error-accordion-compact-mobile .error-panel-count {
    grid-area: count;
    }
    #traceErrAccordion.error-accordion-compact-mobile .error-panel-type {
    grid-area: type;
    max-width: 100%;
    font-size: 0.92rem;
    font-weight: 600;
    }
    #traceErrAccordion.error-accordion-compact-mobile .error-panel-service {
    grid-area: service;
    max-width: 100%;
    justify-self: start;
    }
    #traceErrAccordion.error-accordion-compact-mobile .error-panel-timestamp {
    grid-area: timestamp;
    justify-self: end;
    font-size: 0.75rem;
    }
    #traceErrAccordion.error-accordion-compact-mobile .error-panel-message-preview,
    #traceErrAccordion.error-accordion-compact-mobile .error-panel-span-id,
    #traceErrAccordion.error-accordion-compact-mobile .error-panel-parsed {
    display: none;
    }
    }

.rum-viewer-image {
  max-width: 100%;
  max-height: 60vh;
  border-radius: .5rem;
  border: 1px solid var(--bs-border-color);
  background: var(--bs-body-bg);
}
.rum-viewer-json {
  max-height: 50vh;
  overflow-y: auto;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.rum-viewer-player {
  min-height: min(64vh, 760px);
  height: auto;
  border: 1px solid var(--bs-border-color);
  border-radius: .5rem;
  overflow: visible;
  background: var(--bs-body-bg);
  padding: .5rem;
}
.rum-viewer-player .rr-player {
  width: 100% !important;
  max-width: 100% !important;
}
.rum-viewer-player .rr-controller,
.rum-viewer-player .rr-player__controller,
.rum-viewer-player .controller {
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
  background: var(--bs-body-bg) !important;
  color: var(--bs-body-color) !important;
  border: 1px solid var(--bs-border-color) !important;
  border-radius: .5rem !important;
  box-shadow: none !important;
}
.rum-viewer-player .rr-controller *,
.rum-viewer-player .rr-player__controller *,
.rum-viewer-player .controller * {
  color: var(--bs-body-color) !important;
  fill: currentColor !important;
  stroke: currentColor !important;
}
.rum-viewer-player .rr-controller button,
.rum-viewer-player .rr-player__controller button,
.rum-viewer-player .controller button {
  background: color-mix(in srgb, var(--bs-secondary-bg) 65%, transparent) !important;
  border-color: var(--bs-border-color) !important;
}
.rum-viewer-player .rr-controller input[type="range"],
.rum-viewer-player .rr-player__controller input[type="range"],
.rum-viewer-player .controller input[type="range"] {
  accent-color: var(--bs-primary) !important;
}
[data-bs-theme='dark'] .rum-viewer-player .rr-controller,
[data-bs-theme='dark'] .rum-viewer-player .rr-player__controller,
[data-bs-theme='dark'] .rum-viewer-player .controller {
  background: color-mix(in srgb, var(--bs-dark) 82%, #000) !important;
  border-color: color-mix(in srgb, var(--bs-border-color) 70%, #9aa4b2) !important;
}
.rum-replay-timeline {
  position: relative;
  margin-bottom: .75rem;
  height: 1.25rem;
}
.rum-replay-timeline-track {
  position: absolute;
  left: 0;
  right: 0;
  top: .5rem;
  height: 3px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--bs-secondary-color) 36%, transparent);
}
.rum-replay-timeline-marker {
  position: absolute;
  top: .2rem;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--bs-danger);
  border: 2px solid var(--bs-body-bg);
  transform: translateX(-50%);
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--bs-danger) 35%, transparent);
}
.rum-replay-timeline-label {
  position: absolute;
  top: .85rem;
  left: 0;
}
.rum-replay-raw summary {
  cursor: pointer;
  user-select: none;
}
.rum-replay-raw[open] summary {
  margin-bottom: .5rem;
}
#rumAssetViewerModal {
  z-index: 1080;
}
#rumAssetViewerModal .modal-dialog {
  width: min(98vw, 1680px);
  max-width: min(98vw, 1680px);
  height: calc(100vh - 1rem);
  max-height: calc(100vh - 1rem);
  margin: .5rem auto;
}
#rumAssetViewerModal .modal-content {
  height: 100%;
  max-height: 100%;
  overflow: hidden;
}
#rumAssetViewerModal .modal-header-actions {
  display: flex;
  align-items: center;
  gap: .35rem;
  margin-left: auto;
}
#rumAssetViewerModal .rum-asset-open-raw-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  padding: 0;
}
#rumAssetViewerModal .modal-body {
  max-height: calc(100vh - 7rem);
  overflow: auto;
}
body.rum-replay-modal-open #sobsAiBtn,
body.rum-replay-modal-open #sobsAiPanel {
  opacity: 0 !important;
  pointer-events: none !important;
}

.trace-coverage-strip {
  position: relative;
  height: 12px;
  border-radius: 999px;
  border: 1px solid var(--bs-border-color);
  background: color-mix(in srgb, var(--bs-secondary-color) 18%, transparent);
  overflow: hidden;
}

.trace-coverage-segment {
  position: absolute;
  top: 0;
  height: 100%;
}

.trace-coverage-segment.active {
  background: #0d6efd;
}

.trace-coverage-segment.gap {
  background: color-mix(in srgb, var(--bs-secondary-color) 35%, transparent);
}

.trace-coverage-segment.gap.potential {
  background: repeating-linear-gradient(
    -45deg,
    color-mix(in srgb, #ffc107 72%, transparent),
    color-mix(in srgb, #ffc107 72%, transparent) 6px,
    color-mix(in srgb, #fd7e14 72%, transparent) 6px,
    color-mix(in srgb, #fd7e14 72%, transparent) 12px
  );
}

.trace-coverage-legend-chip {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  color: var(--bs-secondary-color);
}

.trace-coverage-legend-dot {
  width: .7rem;
  height: .7rem;
  border-radius: 999px;
  border: 1px solid var(--bs-border-color);
}

.trace-coverage-legend-dot.active {
  background: #0d6efd;
}

.trace-coverage-legend-dot.gap {
  background: color-mix(in srgb, var(--bs-secondary-color) 35%, transparent);
}

.trace-coverage-legend-dot.potential {
  background: repeating-linear-gradient(
    -45deg,
    color-mix(in srgb, #ffc107 72%, transparent),
    color-mix(in srgb, #ffc107 72%, transparent) 6px,
    color-mix(in srgb, #fd7e14 72%, transparent) 6px,
    color-mix(in srgb, #fd7e14 72%, transparent) 12px
  );
}

.trace-window-overlay-strip {
  position: relative;
  height: 10px;
  border-radius: 999px;
  border: 1px solid var(--bs-border-color);
  background: color-mix(in srgb, var(--bs-secondary-color) 10%, transparent);
  overflow: hidden;
}

.trace-window-overlay-segment {
  position: absolute;
  top: 0;
  height: 100%;
}

.trace-window-overlay-segment.complete {
  background: color-mix(in srgb, #198754 78%, transparent);
}

.trace-window-overlay-segment.partial {
  background: repeating-linear-gradient(
    -45deg,
    color-mix(in srgb, #ffc107 72%, transparent),
    color-mix(in srgb, #ffc107 72%, transparent) 6px,
    color-mix(in srgb, #fd7e14 72%, transparent) 6px,
    color-mix(in srgb, #fd7e14 72%, transparent) 12px
  );
}

.trace-window-legend-dot {
  width: .7rem;
  height: .7rem;
  border-radius: 999px;
  border: 1px solid var(--bs-border-color);
}

.trace-window-legend-dot.complete {
  background: color-mix(in srgb, #198754 78%, transparent);
}

.trace-window-legend-dot.partial {
  background: repeating-linear-gradient(
    -45deg,
    color-mix(in srgb, #ffc107 72%, transparent),
    color-mix(in srgb, #ffc107 72%, transparent) 6px,
    color-mix(in srgb, #fd7e14 72%, transparent) 6px,
    color-mix(in srgb, #fd7e14 72%, transparent) 12px
  );
}

/* Health chips */
.metric-health-chip {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .2rem .55rem;
  border-radius: 999px;
  border: 1px solid;
  font-size: .73rem;
  font-weight: 500;
  white-space: nowrap;
}
.metric-health-chip.level-ok   { background: color-mix(in srgb,#198754 12%,transparent); border-color:color-mix(in srgb,#198754 40%,transparent); color:#198754; }
.metric-health-chip.level-warn { background: color-mix(in srgb,#ffc107 15%,transparent); border-color:color-mix(in srgb,#ffc107 55%,transparent); color:#997404; }
.metric-health-chip.level-crit { background: color-mix(in srgb,#dc3545 12%,transparent); border-color:color-mix(in srgb,#dc3545 40%,transparent); color:#dc3545; }

/* Per-dark-mode health chip text tweaks */
[data-bs-theme=dark] .metric-health-chip.level-ok   { color:#75b798; }
[data-bs-theme=dark] .metric-health-chip.level-warn { color:#ffda6a; }
[data-bs-theme=dark] .metric-health-chip.level-crit { color:#f1aeb5; }
</style>

