{"checklist":[{"id":"sdk","label":"Install & initialise the SDK"},{"id":"collector","label":"Run the OpenTelemetry Collector"},{"id":"verify","label":"Verify data in SOBS"}],"deployment":"docker","env":"dev","language":"dotnet","ok":true,"steps":[{"commands":["dotnet add package OpenTelemetry","dotnet add package OpenTelemetry.Exporter.OpenTelemetryProtocol","dotnet add package OpenTelemetry.Extensions.Hosting","dotnet add package OpenTelemetry.Instrumentation.AspNetCore"],"description":"Install the SDK and OTLP exporter via NuGet.","id":"sdk_install","language":"bash","title":"Add OpenTelemetry .NET packages"},{"commands":["builder.Services.AddOpenTelemetry()","  .WithTracing(b => b","    .AddAspNetCoreInstrumentation()","    .AddOtlpExporter(o => o.Endpoint = new Uri(\"http://localhost:4317\")));"],"description":"Configure tracing with OTLP export in your startup code.","id":"sdk_init","language":"csharp","title":"Register OpenTelemetry in Program.cs"},{"commands":["# otel-collector-config.yaml","receivers:","  otlp:","    protocols:","      grpc:","        endpoint: 0.0.0.0:4317","      http:","        endpoint: 0.0.0.0:4318","exporters:","  otlphttp:","    endpoint: http://localhost:44317","service:","  pipelines:","    traces:","      receivers: [otlp]","      exporters: [otlphttp]","    metrics:","      receivers: [otlp]","      exporters: [otlphttp]","    logs:","      receivers: [otlp]","      exporters: [otlphttp]"],"description":"Start the contrib collector with a minimal config wired to SOBS.","id":"collector_run","language":"yaml","title":"Run the OpenTelemetry Collector (Docker)"},{"commands":["docker run -d --name otel-collector \\","  -p 4317:4317 -p 4318:4318 \\","  -v $(pwd)/otel-collector-config.yaml:/etc/otelcol-contrib/config.yaml \\","  otel/opentelemetry-collector-contrib:latest"],"description":"Mount the config and expose OTLP ports.","id":"collector_docker_run","language":"bash","title":"Start the collector container"},{"commands":["# Open your browser and navigate to http://localhost:44317/","# The Summary card should show span, log, and metric counts within ~30 s."],"description":"Check the Summary page for incoming telemetry.","id":"sobs_verify","language":"bash","title":"Verify data arrives in SOBS"}],"version":"1"}
