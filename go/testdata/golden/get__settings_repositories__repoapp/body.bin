      }
      .page-header-main {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: 0.75rem;
      }
      .page-header-meta {
        grid-column: 1 / -1;
        width: 100%;
        margin-left: 0;
        justify-content: flex-start;
      }
      .page-header-actions {
        grid-column: 2;
        justify-content: flex-end;
      }
      .btn-label,
      [class$='-btn-label'] {
        display: none;
      }
      .btn:has(> .btn-label) i,
      .btn:has(> [class$='-btn-label']) i {
        margin-right: 0 !important;
      }
    }
    .main-content { min-height: 100vh; transition: margin-left 0.22s ease; }
    .page-header {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .page-header-main {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
    }
    .page-header-title-wrap {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
      flex: 1 1 auto;
    }
    .page-header-title-wrap h4,
    .page-header-title {
      min-width: 0;
    }
    .page-header-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      min-width: 0;
      flex: 0 1 auto;
      margin-left: auto;
    }
    .page-header-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0.5rem;
      flex-wrap: wrap;
      min-width: 0;
      flex: 0 0 auto;
    }
    @media (max-width: 575.98px) {
      .page-header-main {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: 0.75rem;
      }
      .page-header-title-wrap {
        grid-column: 1;
        grid-row: 1;
      }
      .page-header-actions {
        grid-column: 2;
        grid-row: 1;
        justify-content: flex-end;
      }
      .page-header-meta {
        grid-column: 1 / -1;
        grid-row: 2;
        width: 100%;
        margin-left: 0;
        justify-content: flex-start;
      }
    }
    .page-header-subtext {
      color: var(--bs-secondary-color);
      font-size: 0.875rem;
    }
    .page-help-btn {
      color: var(--bs-secondary-color);
      border-color: var(--bs-border-color);
    }
    .page-help-btn:hover,
    .page-help-btn:focus-visible {
      color: var(--bs-body-color);
      background: var(--bs-tertiary-bg);
      border-color: var(--bs-border-color);
    }
    /* Avoid first-load animation jump before sidebar state is initialized. */
    .sb-state-pending .sidebar,
    .sb-state-pending .main-content {
      transition: none !important;
    }
    /* ===== Desktop: sidebar fixed to viewport ===== */
    @media (min-width: 576px) {
      .sidebar { position: fixed; top: 0; left: 0; height: 100vh; }
      .main-content { margin-left: var(--sb-full); }
      .sidebar.sidebar-compact + .main-content { margin-left: var(--sb-compact); }

      /* Prepaint compact rules, applied from html class before JS init runs. */
      .sb-state-compact #sbSidebar {
        width: var(--sb-compact);
        padding-left: 0;
        padding-right: 0;
      }
      .sb-state-compact #sbSidebar .sb-label {
        opacity: 0;
        max-width: 0;
        pointer-events: none;
      }
      .sb-state-compact #sbSidebar .sb-brand-text {
        display: none;
      }
      .sb-state-compact #sbSidebar .nav-link {
        margin: 1px auto;
        width: calc(var(--sb-compact) - 8px);
        padding: .5rem 0;
        justify-content: center;
        gap: 0;
        text-align: center;
      }
      .sb-state-compact #sbSidebar .nav-link i {
        width: auto;
        min-width: 1.4rem;
        display: inline-flex;
        justify-content: center;
      }
      .sb-state-compact #sbSidebar .sb-brand {
        padding: 0 .6rem;
        justify-content: center;
      }
      .sb-state-compact .main-content {
        margin-left: var(--sb-compact);
      }
    }
    .badge-level-ERROR, .badge-level-FATAL, .badge-level-CRITICAL { background-color: #dc3545 !important; }
    .badge-level-WARN, .badge-level-WARNING { background-color: #fd7e14 !important; }
    .badge-level-INFO { background-color: #0d6efd !important; }
    .badge-level-DEBUG { background-color: #6c757d !important; }
    .badge-level-METRIC { background-color: #0dcaf0 !important; color: #000 !important; }
    .log-body { font-family: "SFMono-Regular", Menlo, monospace; font-size: .78rem; word-break: break-all; }
    .stack-trace {
      font-family: monospace;
      font-size: .78rem;
      white-space: pre-wrap;
      max-height: 200px;
      overflow-y: auto;
      color: var(--bs-danger-text-emphasis);
      background: var(--bs-danger-bg-subtle);
      border: 1px solid var(--bs-danger-border-subtle);
    }
    .theme-panel {
      color: var(--bs-body-color);
      background: var(--bs-tertiary-bg);
      border: 1px solid var(--bs-border-color);
    }
    [data-bs-theme='light'] .table-dark {
      --bs-table-color: var(--bs-body-color);
      --bs-table-bg: var(--bs-body-bg);
      --bs-table-border-color: var(--bs-border-color);
      --bs-table-striped-bg: var(--bs-tertiary-bg);
      --bs-table-striped-color: var(--bs-body-color);
      --bs-table-active-bg: var(--bs-secondary-bg);
      --bs-table-active-color: var(--bs-body-color);
      --bs-table-hover-bg: var(--bs-secondary-bg);
      --bs-table-hover-color: var(--bs-body-color);
    }
    .stat-card { border: 1px solid var(--bs-border-color); border-radius: 10px; }
    .vitals-good  { color: #198754; }
    .vitals-needs { color: #ffc107; }
    .vitals-poor  { color: #dc3545; }
    .prompt-box { background: var(--bs-tertiary-bg); border-radius: 6px; padding: .5rem; font-size: .82rem; white-space: pre-wrap; max-height: 150px; overflow-y: auto; }
    a.trace-link { font-family: monospace; font-size: .78rem; }
    .drp-combo .drp-combo-input {
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
      border-right: 0;
    }
    .input-group-sm.drp-combo > .drp-combo-input,
    .input-group-sm.drp-combo > .drp-combo-trigger {
      height: calc(1.5em + .5rem + 2px);
      min-height: calc(1.5em + .5rem + 2px);
      box-sizing: border-box;
    }
    .drp-combo .drp-combo-trigger {
      min-width: 2.2rem;
      border-left: 0;
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
      padding: .25rem .5rem;
      font-size: .875rem;
      line-height: 1.5;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      user-select: none;
    }
    .drp-combo .drp-combo-trigger:hover { color: var(--bs-emphasis-color); }
    .drp-combo .drp-combo-trigger:focus {
      outline: 0;
      box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .25);
      z-index: 3;
    }
    .drp-combo .drp-combo-trigger .bi { font-size: .85rem; }
    .filter-date-group {
      flex: 2 1 300px;
      min-width: min(300px, 100%);
      max-width: 100%;
    }
    .filter-date-fields {
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
      align-items: end;
      max-width: 100%;
    }
    .filter-date-field {
      flex: 1 1 140px;
      min-width: 0;
    }
    .sobs-tz-header-badge {
      display: inline-flex;
      align-items: center;
      gap: .25rem;
      margin-left: .75rem;
      padding: .1rem .45rem;
      font-size: .7rem;
      font-weight: 500;
      color: var(--bs-secondary-color);
      background: color-mix(in srgb, var(--bs-secondary-bg) 45%, transparent);
      border: 1px solid var(--bs-border-color);
      border-radius: .3rem;
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
      user-select: none;
      transition: color .15s, background-color .15s;
    }
    .sobs-tz-header-badge:hover {
      color: var(--bs-body-color);
      background-color: color-mix(in srgb, var(--bs-secondary-bg) 75%, transparent);
    }
    .sobs-ansi-active {
      color: var(--bs-info);
    }
    .sobs-ansi-active:hover {
      color: var(--bs-info);
      background-color: color-mix(in srgb, var(--bs-info) 12%, transparent);
    }
  </style>
  <style>
  #repo-settings-root input::-webkit-credentials-auto-fill-button,
  #repo-settings-root input::-webkit-contacts-auto-fill-button {
    visibility: hidden;
    display: none !important;
    pointer-events: none;
  }

  #repo-settings-root[data-color-mode='dark'] input:-webkit-autofill,
  #repo-settings-root[data-color-mode='dark'] textarea:-webkit-autofill,
  #repo-settings-root[data-color-mode='dark'] select:-webkit-autofill {
    -webkit-text-fill-color: var(--bs-body-color);
    -webkit-box-shadow: 0 0 0 1000px var(--bs-body-bg) inset;
    caret-color: var(--bs-body-color);
  }

  #repo-settings-root[data-color-mode='light'] input:-webkit-autofill,
  #repo-settings-root[data-color-mode='light'] textarea:-webkit-autofill,
  #repo-settings-root[data-color-mode='light'] select:-webkit-autofill {
    -webkit-text-fill-color: var(--bs-body-color);
    -webkit-box-shadow: 0 0 0 1000px var(--bs-body-bg) inset;
    caret-color: var(--bs-body-color);
  }

  @media (max-width: 575.98px) {
    .repositories-btn-label { display: none; }
    .btn:has(> .repositories-btn-label) i { margin-right: 0 !important; }

    .repositories-mobile-card-table thead { display: none; }
    .repositories-mobile-card-table,
    .repositories-mobile-card-table tbody,
    .repositories-mobile-card-table tr,
    .repositories-mobile-card-table td { display: block; width: 100%; }
    .repositories-mobile-card-table tr {
      border: 1px solid var(--bs-border-color);
      border-radius: 0.5rem;
      margin-bottom: 0.75rem;
      padding: 0.5rem 0.625rem;
    }
    .repositories-mobile-card-table td { border: 0; padding: 0.2rem 0; }
    .repositories-mobile-card-table td::before {
      content: attr(data-label);
      display: block;
      font-size: 0.72rem;
      color: var(--bs-secondary-color);
      text-transform: uppercase;
      letter-spacing: 0.02em;
      margin-bottom: 0.1rem;
    }
    .repositories-mobile-card-table tr.repo-manage-row {
      border: 0;
      border-radius: 0;
      margin-bottom: 0;
      padding: 0;
    }
    .repositories-mobile-card-table tr.repo-manage-row td {
      padding: 0;
    }
    .repo-action-form { margin-bottom: 0.4rem; }
    .repo-action-form:last-child { margin-bottom: 0; }
  }

  .repositories-table td { vertical-align: top; }
  .repo-actions-stack {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .repo-inline-manage {
    border: 1px solid var(--bs-border-color);
    border-radius: 0.5rem;
    margin: 0.15rem 0.35rem 0.6rem;
  }
  .repo-settings-panel {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 0.75rem;
  }
  .repo-setting-section {
    border: 1px solid var(--bs-border-color);
    border-radius: 0.45rem;
    padding: 0.5rem;
    background: color-mix(in srgb, var(--bs-body-bg) 88%, var(--bs-secondary-bg) 12%);
  }
  .repo-setting-title {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--bs-secondary-color);
    margin-bottom: 0.35rem;
  }
  .repo-manage-row td::before { display: none !important; }
  .repo-manage-button {
    min-width: 6.5rem;
    justify-content: center;
  }
  @media (max-width: 992px) {
    .repo-settings-panel {
      grid-template-columns: 1fr;
    }
  }
  .repo-action-form {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .repo-action-form .form-control {
    min-width: 0;
    flex: 1 1 9rem;
  }
  .repo-owner-input,
  .repo-name-input {
    max-width: 14rem;
  }
  .repo-url-preview {
    width: 100%;
    font-size: 0.72rem;
    color: var(--bs-secondary-color);
    word-break: break-all;
  }
  .repo-action-form .btn { white-space: nowrap; }
  .repo-token-toggle {
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
  }
  .ci-key-row {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .ci-key-row .btn { white-space: nowrap; }
  .repo-meta-note {
    font-size: 0.75rem;
    color: var(--bs-secondary-color);
  }

</style>
</head>
<body>
<!-- Overlay backdrop for hamburger sidebar -->
<div id="sbBackdrop" class="sb-backdrop"></div>
<!-- Topbar: visible only in hamburger/small-screen mode -->
<div id="sbTopbar" class="sb-topbar">
  <button id="sbHamburgerBtn" class="btn btn-sm btn-outline-secondary d-flex align-items-center" aria-label="Open menu" aria-expanded="false" aria-controls="sbSidebar">
    <i class="bi bi-list fs-5"></i>
  </button>
  <a href="/" class="text-decoration-none d-flex align-items-center gap-2">
    <span>🔭</span>
    <span class="fw-bold text-body-emphasis">SOBS</span>
  </a>
  <div class="ms-auto">
    <div class="btn-group btn-group-sm" role="group" aria-label="Theme">
      <button type="button" class="btn btn-outline-secondary" data-sobs-theme="light" title="Light theme" aria-pressed="false">
        <i class="bi bi-sun"></i>
      </button>
      <button type="button" class="btn btn-outline-secondary" data-sobs-theme="system" title="System theme" aria-pressed="false">
        <i class="bi bi-circle-half"></i>
      </button>
      <button type="button" class="btn btn-outline-secondary" data-sobs-theme="dark" title="Dark theme" aria-pressed="false">
        <i class="bi bi-moon-stars"></i>
      </button>
    </div>
  </div>
</div>
<div class="d-flex">
  <!-- Sidebar -->
  <nav id="sbSidebar" class="sidebar d-flex flex-column" aria-label="Main navigation">
    <!-- Sidebar edge toggle button (full ↔ compact) -->
    <button id="sbToggleBtn" class="sb-toggle-btn" aria-label="Toggle sidebar">
      <i id="sbToggleIcon" class="bi bi-chevron-left"></i>
    </button>
    <a href="/" class="text-decoration-none mb-4 d-flex align-items-center gap-2 sb-brand">
      <span style="font-size:1.4rem;">🔭</span>
      <span class="fw-bold fs-5 text-body-emphasis sb-brand-text">SObS</span>
    </a>
    <ul class="nav flex-column gap-1">
      <li class="nav-item">
        <a href="/" class="nav-link " title="Summary">
          <i class="bi bi-house"></i><span class="sb-label">Summary</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/dashboards" class="nav-link " title="Dashboards">
          <i class="bi bi-speedometer2"></i><span class="sb-label">Dashboards</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/logs" class="nav-link " title="Logs">
          <i class="bi bi-journal-text"></i><span class="sb-label">Logs</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/errors" class="nav-link " title="Errors">
          <i class="bi bi-bug"></i><span class="sb-label">Errors</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/traces" class="nav-link " title="Traces">
          <i class="bi bi-diagram-3"></i><span class="sb-label">Traces</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/metrics" class="nav-link " title="Metrics">
          <i class="bi bi-graph-up-arrow"></i><span class="sb-label">Metrics</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/rum" class="nav-link " title="RUM">
          <i class="bi bi-globe"></i><span class="sb-label">RUM</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/web-traffic" class="nav-link " title="Web Traffic">
          <i class="bi bi-map"></i><span class="sb-label">Web Traffic</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/enrichment/cve" class="nav-link " title="CVE Findings">
          <i class="bi bi-shield-exclamation"></i><span class="sb-label">CVE</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/work-items" class="nav-link " title="Work Items">
          <i class="bi bi-github"></i><span class="sb-label">Work Items</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/ai" class="nav-link " title="AI">
          <i class="bi bi-cpu"></i><span class="sb-label">AI</span>
        </a>
      </li>
      
      
      <li class="nav-item">
        <a href="/reports" class="nav-link " title="Reports">
          <i class="bi bi-bookmark-star"></i><span class="sb-label">Reports</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/settings" class="nav-link " title="Settings">
          <i class="bi bi-gear"></i><span class="sb-label">Settings</span>
        </a>
      </li>
      <li class="nav-item mt-2">
        <button
          type="button"
          class="nav-link btn btn-link text-start w-100"
          title="Getting Started"
          data-bs-toggle="modal"
          data-bs-target="#gettingStartedModal"
        >
          <i class="bi bi-stars"></i><span class="sb-label">Getting Started</span>
        </button>
      </li>
    </ul>
    <div class="sb-theme-slot-compact">
      <div class="dropup d-flex justify-content-center">
        <button type="button" class="nav-link btn btn-link" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Theme">
          <i id="sbCompactThemeIconNav" class="bi bi-circle-half"></i><span class="sb-label">Theme</span>
        </button>
        <ul class="dropdown-menu shadow-sm">
          <li><button type="button" class="dropdown-item" data-sobs-theme="light"><i class="bi bi-sun me-2"></i>Light</button></li>
          <li><button type="button" class="dropdown-item" data-sobs-theme="system"><i class="bi bi-circle-half me-2"></i>System</button></li>
          <li><button type="button" class="dropdown-item" data-sobs-theme="dark"><i class="bi bi-moon-stars me-2"></i>Dark</button></li>
        </ul>
      </div>
    </div>
    <div class="mt-auto pt-3 border-top border-secondary sb-footer">
      <div class="btn-group btn-group-sm mb-2 sb-theme-full" role="group" aria-label="Theme">
        <button type="button" class="btn btn-outline-secondary" data-sobs-theme="light" title="Light theme" aria-pressed="false">
          <i class="bi bi-sun"></i>
        </button>
        <button type="button" class="btn btn-outline-secondary" data-sobs-theme="system" title="System theme" aria-pressed="false">
          <i class="bi bi-circle-half"></i>
        </button>
        <button type="button" class="btn btn-outline-secondary" data-sobs-theme="dark" title="Dark theme" aria-pressed="false">
          <i class="bi bi-moon-stars"></i>
        </button>
      </div>
      <div class="dropup sb-theme-compact mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Theme">
          <i id="sbCompactThemeIcon" class="bi bi-circle-half"></i>
        </button>
        <ul class="dropdown-menu shadow-sm">
          <li><button type="button" class="dropdown-item" data-sobs-theme="light"><i class="bi bi-sun me-2"></i>Light</button></li>
          <li><button type="button" class="dropdown-item" data-sobs-theme="system"><i class="bi bi-circle-half me-2"></i>System</button></li>
          <li><button type="button" class="dropdown-item" data-sobs-theme="dark"><i class="bi bi-moon-stars me-2"></i>Dark</button></li>
        </ul>
      </div>
      <br>
      <small class="text-secondary">Simple Observability Stack</small><br>
      <small class="text-secondary">dev</small>
    </div>
  </nav>

  <!-- Main -->
  <div class="main-content flex-grow-1 p-4">
    
      
    
    
<div id="repo-settings-root" data-color-mode="light">

<div class="page-header mb-3">
        <div class="page-header-main">
            <div class="page-header-title-wrap">
                
                    <h4 class="fw-semibold mb-0">
                        
                            <i class="bi bi-github me-2 text-secondary"></i>
                        
                        GitHub Repositories
                    </h4>
                
            </div>
            
            <div class="page-header-actions">
  <button type="button" class="btn btn-sm btn-outline-success" title="Onboarding Wizard" onclick="window.__sobsOpenOnboardingWizard && window.__sobsOpenOnboardingWizard()">
    <i class="bi bi-rocket-takeoff me-1"></i><span class="repositories-btn-label settings-btn-label">Onboarding Wizard</span>
  </button>
  <a href="/settings" class="btn btn-sm btn-outline-secondary" title="Back to Settings">
    <i class="bi bi-arrow-left me-1"></i><span class="repositories-btn-label settings-btn-label">Back to Settings</span>
  </a>
  <a href="/settings/help/repositories" class="btn btn-sm btn-outline-secondary page-help-btn" title="Help">
    <i class="bi bi-question-circle me-1"></i><span class="repositories-btn-label settings-btn-label">Help</span>
  </a>
</div>
        </div>
        
    </div>

<div class="card border-secondary mb-3">
  <div class="card-header d-flex align-items-center gap-2">
    <i class="bi bi-info-circle text-primary"></i>
    <span class="fw-semibold">Single Source of Truth</span>
  </div>
  <div class="card-body small text-secondary">
    Configure repositories here once. CVE enrichment backfill and version-scoped GitHub repo health both use this list.
    AI Settings <code>github_repo</code> remains a default target for agent-created issues only.
    <div class="mt-2 d-flex flex-wrap gap-2 align-items-center">
      
      <span class="badge text-bg-success"><i class="bi bi-check-circle me-1"></i>GitHub token configured</span>
      
      <span class="badge text-bg-light text-dark">Default agent repo: not set</span>
      
        
        <span class="badge text-bg-secondary">Token expiry date not set</span>
        
        
      
    </div>
    
    <div class="mt-2 small text-secondary d-flex flex-wrap align-items-center gap-2">
      <span>Expiry alert threshold: 14 days</span>
      
      
      <form method="post" action="/settings/repositories/github-token/validate" class="d-inline">
        <button type="submit" class="btn btn-sm btn-outline-primary py-0 px-2">Validate Token</button>
      </form>
    </div>
    
  </div>
</div>

<div class="card border-secondary mb-3">
  <div class="card-header d-flex align-items-center gap-2">
    <i class="bi bi-magic text-success"></i>
    <span class="fw-semibold">Add Repository Wizard</span>
  </div>
  <div class="card-body">
    <p class="small text-secondary mb-2">
      Use the wizard to add repository details, optional GitHub token settings, inspect CI/OTEL readiness,
      and create onboarding issues in one guided flow.
    </p>
    <div class="d-flex flex-wrap gap-2">
      <button
        type="button"
        class="btn btn-sm btn-success"
        title="Add And Onboard Repository"
        onclick="window.__sobsOpenOnboardingWizard && window.__sobsOpenOnboardingWizard('new')"
      >
        <i class="bi bi-plus-circle me-1"></i><span class="repositories-btn-label settings-btn-label">Add And Onboard Repository</span>
      </button>
      <button
        type="button"
        class="btn btn-sm btn-outline-success"
        title="Onboard Existing Repository"
        
        onclick="window.__sobsOpenOnboardingWizard && window.__sobsOpenOnboardingWizard('existing')"
      >
        <i class="bi bi-rocket-takeoff me-1"></i><span class="repositories-btn-label settings-btn-label">Onboard Existing Repository</span>
      </button>
    </div>
  </div>
</div>

<div class="card border-secondary mb-3">
  <div class="card-header d-flex align-items-center gap-2">
    <i class="bi bi-lightning-charge text-warning"></i>
    <span class="fw-semibold">Realtime CI Push (Optional, Per Repository)</span>
  </div>
  <div class="card-body">
    <p class="small text-secondary mb-2">
      Default behavior uses GitHub polling with conditional requests.
      Realtime CI push keys are managed per repository from each row below so security teams can rotate/revoke independently.
    </p>
    <div class="small text-secondary">
      Open a repository <strong>Manage</strong> row to set realtime mode, rotate key, or revoke key for that repository only.
    </div>
  </div>
</div>

<div class="card border-secondary">
  <div class="card-header d-flex align-items-center gap-2">
    <i class="bi bi-list-ul text-info"></i>
    <span class="fw-semibold">Configured Repositories</span>
    <span class="badge text-bg-secondary ms-2">1</span>
  </div>
  <div class="card-body p-0">
    
    <div class="table-responsive">
      <table class="table table-sm table-hover mb-0 align-middle repositories-table repositories-mobile-card-table">
        <thead>
          <tr>
            <th>App</th>
            <th>Repo</th>
            <th>Releases</th>
            <th style="width:210px;">CI Push</th>
            <th style="width:130px;">Status</th>
            <th style="width:130px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          
          <tr>
            <td data-label="App">
              <div class="small fw-semibold">Widget Service</div>
              <div class="text-secondary" style="font-size:.75rem;">widget-service</div>
            </td>
            <td data-label="Repo">
              <a href="https://github.com/acme/widget" target="_blank" rel="noopener" class="small font-monospace text-decoration-none" style="word-break:break-all;">https://github.com/acme/widget</a>
            </td>
            <td data-label="Releases">
              <div class="small">1 total</div>
              <div class="text-secondary" style="font-size:.75rem;">1.0.0</div>
            </td>
            <td data-label="CI Push">
              <div class="d-flex flex-wrap gap-1 align-items-center">
                <span class="badge text-bg-secondary">
                  disabled
                </span>
                <span class="badge text-bg-secondary">
                  no key
                </span>
              </div>
              <div class="text-secondary mt-1" style="font-size:.75rem;">CI push API key not configured</div>
            </td>
            <td data-label="Status">
              
              <span class="badge text-bg-success">enabled</span>
              
            </td>
            <td data-label="Actions">
              <button
                class="btn btn-sm btn-outline-secondary repo-manage-button"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#repoManageRow-f1000000000000000000000000000001"
                aria-expanded="false"
                aria-controls="repoManageRow-f1000000000000000000000000000001"
                title="Manage Repository Settings">
                <i class="bi bi-sliders2 me-1"></i><span class="repositories-btn-label">Manage</span>
              </button>
            </td>
          </tr>
          <tr class="repo-manage-row">
            <td colspan="6" class="pt-0 border-0">
              <div id="repoManageRow-f1000000000000000000000000000001" class="collapse repo-inline-manage">
                <div class="repo-settings-panel">
                  <div class="repo-setting-section">
                    <div class="repo-setting-title">Repository URL</div>
                    <form method="post" action="/settings/repositories/f1000000000000000000000000000001" class="repo-action-form" data-role="repo-url-builder">
                      <input type="hidden" name="repo_url" value="https://github.com/acme/widget" data-role="repo-url-hidden">
                      <input type="text" name="repo_owner" class="form-control form-control-sm font-monospace repo-owner-input" value="acme" placeholder="owner" autocomplete="username" spellcheck="false" data-role="repo-owner" required>
                      <input type="text" name="repo_name" class="form-control form-control-sm font-monospace repo-name-input" value="widget" placeholder="repository" autocomplete="off" spellcheck="false" data-role="repo-name" required>
                      <button type="submit" class="btn btn-sm btn-outline-primary" title="Save Repository URL">
                        <i class="bi bi-save me-1"></i><span class="repositories-btn-label">Save</span>
                      </button>
                    </form>
                    <div class="repo-url-preview" data-role="repo-url-preview">https://github.com/acme/widget</div>
                  </div>

                  <div class="repo-setting-section">
                    <div class="repo-setting-title">Repository Token</div>
                    <form method="post" action="/settings/repositories/f1000000000000000000000000000001" class="repo-action-form">
                      <input type="hidden" name="repo_url" value="https://github.com/acme/widget">
                      <input type="password" name="repo_token" class="form-control form-control-sm font-monospace" placeholder="repo PAT (optional)" autocomplete="new-password" autocorrect="off" autocapitalize="none" spellcheck="false">
                      <label class="repo-token-toggle">
                        <input type="checkbox" name="set_repo_token" value="1" checked>
                        save
                      </label>
                      <button type="submit" class="btn btn-sm btn-outline-secondary" title="Save Repo Token">
                        <i class="bi bi-key me-1"></i><span class="repositories-btn-label">Token</span>
                      </button>
                    </form>
                    <div class="repo-meta-note mt-1">
                      PAT status: not set
                    </div>
                  </div>

                  <div class="repo-setting-section">
                    <div class="repo-setting-title">Add Release</div>
                    <form method="post" action="/settings/repositories/f1000000000000000000000000000001/releases" class="repo-action-form">
                      <input type="text" name="version" class="form-control form-control-sm" placeholder="release version" autocomplete="off" spellcheck="false" required>
                      <input type="text" name="environment" class="form-control form-control-sm" placeholder="env" autocomplete="off" autocapitalize="none" spellcheck="false">
                      <button type="submit" class="btn btn-sm btn-outline-secondary" title="Add Release">
                        <i class="bi bi-plus-circle me-1"></i><span class="repositories-btn-label">Add release</span>
                      </button>
                    </form>
                  </div>

                  <div class="repo-setting-section">
                    <div class="repo-setting-title">Realtime CI Key</div>

                    <div class="d-flex flex-wrap gap-1 align-items-center mb-2">
                      <span class="badge text-bg-secondary">
                        disabled
                      </span>
                      <span class="badge text-bg-secondary">
                        API key not configured
                      </span>
                      <span class="badge text-bg-secondary">CI push API key not configured</span>
                    </div>

                    

                    <div class="d-flex flex-column gap-2">
                      <form method="post" action="/settings/repositories/f1000000000000000000000000000001/realtime-mode" class="ci-key-row">
                        <label class="repo-token-toggle mb-0 flex-grow-1">
                          <input type="checkbox" name="realtime_enabled" value="1" >
                          Enable realtime mode
                        </label>
                        <button type="submit" class="btn btn-sm btn-outline-secondary ms-2 flex-shrink-0" title="Save Realtime Mode">
                          <i class="bi bi-save me-1"></i><span class="repositories-btn-label">Save mode</span>
                        </button>
                      </form>

                      <form method="post" action="/settings/repositories/f1000000000000000000000000000001/ci-ingest-key/rotate" class="ci-key-row">
                        <label class="small text-secondary flex-shrink-0 mb-0 align-self-center" for="ttl_f1000000000000000000000000000001">Expiry (days)</label>
                        <input type="number" id="ttl_f1000000000000000000000000000001" name="ttl_days" min="1" max="365" value="30" class="form-control form-control-sm ms-2" style="width:5.5rem;" title="Expiry in days" required>
                        <button type="submit" class="btn btn-sm btn-outline-primary ms-2 flex-shrink-0" title="Rotate CI Ingest Key">
                          <i class="bi bi-arrow-repeat me-1"></i><span class="repositories-btn-label">Rotate key</span>
                        </button>
                      </form>

                      <form
                        method="post"
                        action="/settings/repositories/f1000000000000000000000000000001/ci-ingest-key/revoke"
                        class="ci-key-row"
                        data-confirm-title="Revoke CI Ingest Key"
                        data-confirm-message="Revoke realtime CI ingest key for 'Widget Service'? Existing CI pushes for this repo will fail until rotated."
                        data-confirm-ok-label="Revoke"
                        data-confirm-ok-class="btn-danger">
                        <span class="small text-secondary flex-grow-1 align-self-center">Remove key and disable CI push access.</span>
                        <button type="submit" class="btn btn-sm btn-outline-danger ms-2 flex-shrink-0" title="Revoke CI Ingest Key">
                          <i class="bi bi-trash me-1"></i><span class="repositories-btn-label">Revoke key</span>
                        </button>
                      </form>
                    </div>
                  </div>

                  <div class="repo-setting-section">
                    <div class="repo-setting-title text-danger">Danger Zone</div>
                    <form
                      method="post"
                      action="/settings/repositories/f1000000000000000000000000000001/delete"
                      class="repo-action-form"
                      data-confirm-title="Delete Repository"
                      data-confirm-message="Delete repository 'Widget Service' (widget-service)?"
                      data-confirm-ok-label="Delete"
                      data-confirm-ok-class="btn-danger">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Repository">
                        <i class="bi bi-trash me-1"></i><span class="repositories-btn-label">Delete</span>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </td>
          </tr>
          
        </tbody>
      </table>
    </div>
    
  </div>
</div>
</div>

<!-- Onboarding wizard repo data -->
<script id="obReposData" type="application/json">
[{"ci_push_plain": "", "ci_push_status": {"app_id": "f1000000000000000000000000000001", "configured": false, "expires_at": "", "expiry": {"days_remaining": null, "expires_at": "", "message": "CI push API key not configured", "state": "missing"}, "hash": "", "realtime_enabled": false, "rotated_at": ""}, "enabled": true, "id": "f1000000000000000000000000000001", "latest_versions": ["1.0.0"], "name": "Widget Service", "release_count": 1, "repo_name": "widget", "repo_owner": "acme", "repo_token_configured": false, "repo_url": "https://github.com/acme/widget", "slug": "widget-service"}]
</script>

<script id="obRealtimeData" type="application/json">
{"api_key": "", "api_key_show_once": false, "configured": false, "enabled": false, "expires_at": "", "expiry_message": "Per-repository CI ingest keys are managed from each repository row."}
</script>

<style>
  #onboardingWizardModal .modal-body { min-height: 430px; }

  .ob-step { display: none; }
  .ob-step.active { display: block; }

  .ob-mode-card,
  .ob-repo-card {
    display: block;
    width: 100%;
    text-align: left;
    border: 1px solid var(--bs-border-color);
    border-radius: 8px;
    padding: .6rem .75rem;
    margin-bottom: .5rem;
    cursor: pointer;
    background: var(--bs-tertiary-bg);
    transition: border-color .15s, background .15s;
  }
  .ob-mode-card:hover,
  .ob-repo-card:hover { border-color: var(--bs-info); }
  .ob-mode-card.selected,
  .ob-repo-card.selected {
    border-color: var(--bs-info);
    background: rgba(var(--bs-info-rgb), .1);
  }
  .ob-mode-title,
  .ob-repo-card .repo-name { font-weight: 600; font-size: .88rem; }
  .ob-mode-sub,
  .ob-repo-card .repo-url { font-size: .76rem; color: var(--bs-secondary-color); word-break: break-all; }

  .ob-inspect-row {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .4rem 0;
    font-size: .85rem;
    border-bottom: 1px solid var(--bs-border-color);
  }
  .ob-inspect-row:last-child { border-bottom: 0; }
  .ob-inspect-icon { font-size: 1.1rem; min-width: 1.4rem; text-align: center; }

  .ob-result-card {
    border: 1px solid var(--bs-border-color);
    border-radius: 8px;
    padding: .6rem .8rem;
    margin-bottom: .6rem;
    font-size: .85rem;
  }
  .ob-result-card .issue-title { font-weight: 600; margin-bottom: .2rem; }
  .ob-result-card .issue-url a { word-break: break-all; }

  #onboardingWizardModal .ob-progress { height: 3px; }

  .ob-repo-autocomplete-wrap { position: relative; }
  .ob-repo-autocomplete-dropdown {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 2px);
    z-index: 20;
    border: 1px solid var(--bs-border-color);
    border-radius: 0.45rem;
    background: var(--bs-body-bg);
    box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.15);
    max-height: 14rem;
    overflow: auto;
  }
  .ob-repo-autocomplete-header {
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .02em;
    color: var(--bs-secondary-color);
    padding: .35rem .5rem;
    border-bottom: 1px solid var(--bs-border-color);
    background: var(--bs-tertiary-bg);
  }
  .ob-repo-autocomplete-header.warning {
    color: var(--bs-warning-text-emphasis);
    background: rgba(var(--bs-warning-rgb), .14);
  }
  .ob-repo-suggestion-item {
    width: 100%;
    text-align: left;
    border: 0;
    background: transparent;
    color: var(--bs-body-color);
    font-size: .82rem;
    padding: .35rem .5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
  }
  .ob-repo-suggestion-item:hover {
    background: rgba(var(--bs-info-rgb), .12);
  }
  .ob-repo-suggestion-empty {
    padding: .45rem .5rem;
    font-size: .8rem;
    color: var(--bs-secondary-color);
  }
</style>

<div class="modal fade" id="onboardingWizardModal" tabindex="-1" aria-labelledby="obWizardTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
    <div class="modal-content border-secondary">
      <div class="modal-header pb-1">
        <h5 class="modal-title" id="obWizardTitle">
          <i class="bi bi-rocket-takeoff me-2 text-success"></i>Repository Onboarding Wizard
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="progress rounded-0 border-0 ob-progress">
        <div id="obProgressBar" class="progress-bar bg-success" role="progressbar" style="width:0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
      </div>

      <div class="modal-body pt-3">

        <div class="ob-step active" id="obStep0">
          <h6 class="fw-semibold mb-1">Step 1 of 5 &mdash; Start Mode</h6>
          <p class="text-secondary small mb-3">Choose whether to onboard an existing configured repository or add a new one first.</p>
          <div id="obModeList">
            <button type="button" class="ob-mode-card" data-mode="new" aria-pressed="false">
              <div class="ob-mode-title"><i class="bi bi-plus-circle me-1 text-success"></i>Add New Repository And Onboard</div>
              <div class="ob-mode-sub">Enter repository details, optional token settings, then continue directly into inspect and issue creation.</div>
            </button>
            <button type="button" class="ob-mode-card" data-mode="existing" aria-pressed="false">
              <div class="ob-mode-title"><i class="bi bi-list-check me-1 text-info"></i>Onboard Existing Repository</div>
              <div class="ob-mode-sub">Select from configured repositories and run inspect + issue onboarding.</div>
            </button>
          </div>
        </div>

        <div class="ob-step" id="obStep1">
          <h6 class="fw-semibold mb-1" id="obRepoStepTitle">Step 2 of 5 &mdash; Repository</h6>
          <p class="text-secondary small mb-3" id="obRepoStepSub">Provide repository details or select an existing repository.</p>

          <div id="obExistingRepoBlock" style="display:none">
            <div id="obRepoList">
              <div class="text-secondary small">Loading repositories&hellip;</div>
            </div>
            <div class="mt-2 small text-secondary">
              No repositories listed? Switch to <strong>Add New Repository And Onboard</strong> in the previous step.
            </div>
          </div>

          <div id="obNewRepoBlock" style="display:none">
            <div class="row g-2">
              <div class="col-md-4">
                <label class="form-label small fw-semibold">App Name</label>
                <input type="text" class="form-control form-control-sm" id="obNewName" placeholder="checkout-api" autocomplete="organization">
              </div>
              <div class="col-md-3">
                <label class="form-label small fw-semibold">Slug (optional)</label>
                <input type="text" class="form-control form-control-sm" id="obNewSlug" placeholder="checkout-api" autocomplete="off" spellcheck="false">
              </div>
              <div class="col-md-3">
                <label class="form-label small fw-semibold">GitHub Owner</label>
                <input type="text" class="form-control form-control-sm font-monospace" id="obNewRepoOwner" placeholder="org-or-user" autocomplete="username" spellcheck="false">
              </div>
              <div class="col-md-2">
                <label class="form-label small fw-semibold">Repository</label>
                <div class="ob-repo-autocomplete-wrap">
                  <input type="text" class="form-control form-control-sm font-monospace" id="obNewRepoName" placeholder="repo-name" autocomplete="off" spellcheck="false">
                  <div id="obRepoNameAutocomplete" class="ob-repo-autocomplete-dropdown" style="display:none">
                    <div id="obRepoNameAutocompleteHeader" class="ob-repo-autocomplete-header"></div>
                    <div id="obRepoNameAutocompleteList"></div>
                  </div>
                </div>
              </div>
              <div class="col-md-12">
                <label class="form-label small fw-semibold">Repository URL (auto)</label>
                <input type="text" class="form-control form-control-sm font-monospace" id="obNewRepoUrlPreview" placeholder="https://github.com/org-or-user/repo-name" readonly>
                <div class="form-text">Only owner and repository are required. For private repositories, provide a PAT below.</div>
              </div>
              <div class="col-12 d-flex flex-wrap align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" id="obImportRepoBtn" title="Import From GitHub">
                  <i class="bi bi-cloud-download me-1"></i>Import From GitHub
                </button>
                <span id="obImportRepoStatus" class="small text-secondary"></span>
              </div>
              <div class="col-md-4">
                <label class="form-label small fw-semibold">Default Environment</label>
                <input type="text" class="form-control form-control-sm" id="obNewDefaultEnv" placeholder="prod" autocomplete="off" autocapitalize="none" spellcheck="false" list="obEnvOptions">
                <datalist id="obEnvOptions">
                  <option value="prod"></option>
                  <option value="staging"></option>
                  <option value="dev"></option>
                  <option value="qa"></option>
                </datalist>
              </div>
              <div class="col-md-8">
                <label class="form-label small fw-semibold">GitHub Token (optional)</label>
                <input type="password" class="form-control form-control-sm font-monospace" id="obNewGithubToken" placeholder="github_pat_..." autocomplete="new-password" autocorrect="off" autocapitalize="none" spellcheck="false">
              </div>
              <div class="col-md-4">
                <label class="form-label small fw-semibold">Token Expiry Date</label>
                <input type="date" class="form-control form-control-sm" id="obNewGithubTokenExpiry" value="">
              </div>
              <div class="col-md-4">
                <div class="form-check mt-1">
                  <input class="form-check-input" type="checkbox" id="obNewSetGithubToken">
                  <label class="form-check-label small" for="obNewSetGithubToken">Save token as global fallback</label>
                </div>
              </div>
              <div class="col-md-4">
                <div class="form-check mt-1">
                  <input class="form-check-input" type="checkbox" id="obNewSetRepoToken" checked>
                  <label class="form-check-label small" for="obNewSetRepoToken">Save token for this repo</label>
                </div>
              </div>
              <div class="col-md-4">
                <div class="form-check mt-1">
                  <input class="form-check-input" type="checkbox" id="obNewSetAgentRepo" checked>
                  <label class="form-check-label small" for="obNewSetAgentRepo">Set as default agent repo</label>
                </div>
              </div>
            </div>
            <div class="alert alert-secondary small mt-2 mb-0 py-2">
              <div class="fw-semibold mb-1">Need a GitHub PAT?</div>
              <div>Create a fine-grained PAT at
                <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">GitHub token settings</a>.
              </div>
              <div class="mt-1">Public repositories can usually be imported without a PAT. Private repositories require a PAT with access.</div>
              <div class="mt-1">Recommended repository permissions:</div>
              <div>Contents: Read (import and inspect), Issues: Read and Write (create/update onboarding issues).</div>
            </div>
          </div>
        </div>

        <div class="ob-step" id="obStep2">
          <h6 class="fw-semibold mb-1">Step 3 of 5 &mdash; Inspecting Repository</h6>
          <p class="text-secondary small mb-3">Checking CI configuration, Sobs metadata scripts, and Copilot availability.</p>
          <div id="obInspectResults">
            <div class="text-center py-4">
              <div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>
              <span class="text-secondary small">Inspecting&hellip;</span>
            </div>
          </div>
        </div>

        <div class="ob-step" id="obStep3">
          <h6 class="fw-semibold mb-1">Step 4 of 5 &mdash; Create GitHub Issues</h6>
          <p class="text-secondary small mb-3">Select issue types, then optionally enable manual realtime CI setup guidance.</p>

          <div class="mb-3">
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" id="obCreateCi" checked>
              <label class="form-check-label fw-semibold" for="obCreateCi">
                <i class="bi bi-gear me-1 text-info"></i>CI Metadata Setup
              </label>
              <div class="form-text ms-4">Creates a GitHub issue with steps to register releases, upload dependency lockfiles, source maps, and trigger CVE scans.</div>
            </div>
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" id="obCreateOtel" checked>
              <label class="form-check-label fw-semibold" for="obCreateOtel">
                <i class="bi bi-reception-4 me-1 text-warning"></i>OTEL And RUM Telemetry Audit
              </label>
              <div class="form-text ms-4">Creates a GitHub issue auditing the codebase for OTEL SDK setup, RUM, AI gen_ai keys, and infrastructure logging gaps.</div>
            </div>
          </div>

          <div class="mt-3 pt-2 border-top">
            <div class="form-check mb-1">
              <input class="form-check-input" type="checkbox" id="obEnableRealtimeSupport">
              <label class="form-check-label fw-semibold" for="obEnableRealtimeSupport">
                <i class="bi bi-lightning-charge me-1 text-warning"></i>Enable realtime CI support guidance
              </label>
            </div>
            <div class="form-text ms-4">
              When enabled, Sobs will provide manual setup instructions for CI push mode, include required secrets,
              and show the managed ingest API key lifecycle state.
            </div>
          </div>

          <div id="obCopilotSection" style="display:none">
            <hr class="my-2">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="obAssignCopilot">
              <label class="form-check-label fw-semibold" for="obAssignCopilot">
                <i class="bi bi-robot me-1 text-success"></i>Assign issues to Copilot
              </label>
              <div class="form-text ms-4">GitHub Copilot cloud agent is available for this repository. Sobs can formally assign each created issue.</div>
            </div>
          </div>

          <div id="obNoCopilotNote" class="small text-secondary mt-2" style="display:none">
            <i class="bi bi-info-circle me-1"></i>Copilot cloud agent is not available for this repository.
          </div>
        </div>

        <div class="ob-step" id="obStep4">
          <h6 class="fw-semibold mb-1">Step 5 of 5 &mdash; Done</h6>
          <p class="text-secondary small mb-3">Here are the results:</p>
          <div id="obResultsContainer">
            <div class="text-center py-4">
              <div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>
              <span class="text-secondary small">Creating issues&hellip;</span>
            </div>
          </div>
        </div>

      </div>

      <div class="modal-footer d-flex justify-content-between align-items-center">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="obSkipBtn">Close</button>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-outline-secondary" id="obPrevBtn" style="display:none">Back</button>
          <button type="button" class="btn btn-outline-success" id="obNextBtn" disabled>Next</button>
          <button type="button" class="btn btn-success" id="obCreateBtn" style="display:none">
            <i class="bi bi-github me-1"></i>Create Issues
          </button>
          <button type="button" class="btn btn-outline-secondary" id="obDoneBtn" style="display:none" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var modalEl = document.getElementById('onboardingWizardModal');
  if (!modalEl) return;

  var modal = null;
  var skipBtn = document.getElementById('obSkipBtn');
  var prevBtn = document.getElementById('obPrevBtn');
  var nextBtn = document.getElementById('obNextBtn');
  var createBtn = document.getElementById('obCreateBtn');
  var doneBtn = document.getElementById('obDoneBtn');
  var progressBar = document.getElementById('obProgressBar');
  var totalSteps = 5;

  function getModal() {
    if (!window.bootstrap || !window.bootstrap.Modal) return null;
    if (!modal) modal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
    return modal;
  }

  function getRepos() {
    var reposJson = document.getElementById('obReposData');
    if (!reposJson) return [];
    try {
      var parsed = JSON.parse(reposJson.textContent || '[]');
      return Array.isArray(parsed) ? parsed : [];
    } catch (e) {
      return [];
    }
  }

  function getRealtimeSeed() {
    var seed = document.getElementById('obRealtimeData');
    if (!seed) return {};
    try {
      var parsed = JSON.parse(seed.textContent || '{}');
      return (parsed && typeof parsed === 'object') ? parsed : {};
    } catch (e) {
      return {};
    }
  }

  var state = {
    step: 0,
    mode: '',
    appId: '',
    repoName: '',
    repoUrl: '',
    copilotAvailable: false,
    hasGithubActions: false,
    inspected: false,
    inspectError: '',
    repoCreated: false,
  };

  var ownerRepoFetchTimer = null;
  var ownerRepoSuggestions = [];
  var ownerRepoTokenUsed = false;
  var ownerRepoVisibilityNote = '';

  var slugUserEdited = false;

  function suggestSlug(input) {
    return String(input || '')
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 80);
  }

  function inferRepoNameFromUrl(repoUrl) {
    var m = String(repoUrl || '').trim().match(/github\.com[/:]([^/]+)\/([^/#?]+)(?:\.git)?/i);
    return m ? m[2] : '';
  }

  function inferOwnerFromUrl(repoUrl) {
    var m = String(repoUrl || '').trim().match(/github\.com[/:]([^/]+)\/([^/#?]+)(?:\.git)?/i);
    return m ? m[1] : '';
  }

  function composeGithubRepoUrl(owner, repo) {
    var ownerClean = String(owner || '').trim().replace(/^\/+|\/+$/g, '');
    var repoClean = String(repo || '').trim().replace(/^\/+|\/+$/g, '').replace(/\.git$/i, '');
    if (!ownerClean || !repoClean) return '';
    return 'https://github.com/' + ownerClean + '/' + repoClean;
  }

  function syncNewRepoUrlPreview() {
    var previewEl = document.getElementById('obNewRepoUrlPreview');
    if (!previewEl) return '';
    var built = composeGithubRepoUrl(val('obNewRepoOwner'), val('obNewRepoName'));
    previewEl.value = built;
    return built;
  }

  function hideRepoAutocomplete() {
    var dd = document.getElementById('obRepoNameAutocomplete');
    if (dd) dd.style.display = 'none';
  }

  function renderRepoAutocomplete() {
    var dd = document.getElementById('obRepoNameAutocomplete');
    var header = document.getElementById('obRepoNameAutocompleteHeader');
    var list = document.getElementById('obRepoNameAutocompleteList');
    if (!dd || !header || !list) return;

    var owner = val('obNewRepoOwner');
    if (!owner) {
      hideRepoAutocomplete();
      return;
    }

    var query = val('obNewRepoName').toLowerCase();
    var filtered = ownerRepoSuggestions.filter(function (r) {
      var name = String((r && r.name) || '').toLowerCase();
      return !query || name.indexOf(query) !== -1;
    });

    var headerText = ownerRepoTokenUsed
      ? ('Repositories for ' + owner)
      : (ownerRepoVisibilityNote || 'Need PAT to see private repositories.');
    header.textContent = headerText;
    header.classList.toggle('warning', !ownerRepoTokenUsed);

    if (!ownerRepoSuggestions.length) {
      list.innerHTML = '<div class="ob-repo-suggestion-empty">No repositories found for this owner.</div>';
      dd.style.display = '';
      return;
    }
    if (!filtered.length) {
      list.innerHTML = '<div class="ob-repo-suggestion-empty">No matching repositories.</div>';
      dd.style.display = '';
      return;
    }

    var html = '';
    filtered.slice(0, 30).forEach(function (r) {
      var privateBadge = r.private ? '<span class="badge text-bg-secondary">private</span>' : '';
      html += '<button type="button" class="ob-repo-suggestion-item" '
        + 'data-repo-name="' + escAttr(r.name || '') + '">'
        + '<span>' + escHtml(r.name || '') + '</span>'
        + privateBadge
        + '</button>';
    });
    list.innerHTML = html;
    dd.style.display = '';

    list.querySelectorAll('.ob-repo-suggestion-item').forEach(function (btn) {
      btn.addEventListener('mousedown', function (e) { e.preventDefault(); });
      btn.addEventListener('click', function () {
        var repoEl = document.getElementById('obNewRepoName');
        if (repoEl) repoEl.value = btn.getAttribute('data-repo-name') || '';
        syncNewRepoUrlPreview();
        hideRepoAutocomplete();
        updateNav();
      });
    });
  }

  function fetchOwnerRepositories() {
    var owner = val('obNewRepoOwner');
    if (!owner) {
      ownerRepoSuggestions = [];
      ownerRepoTokenUsed = false;
      ownerRepoVisibilityNote = '';
      hideRepoAutocomplete();
      return;
    }

    ownerRepoSuggestions = [];
    ownerRepoTokenUsed = false;
    ownerRepoVisibilityNote = '';
    var list = document.getElementById('obRepoNameAutocompleteList');
    if (list) {
      list.innerHTML = '<div class="ob-repo-suggestion-empty">Loading repositories...</div>';
    }
    renderRepoAutocomplete();

    fetch("/api/onboarding/list-repos", {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        owner: owner,
        github_token: val('obNewGithubToken')
      }),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) {
          ownerRepoSuggestions = [];
          ownerRepoTokenUsed = false;
          ownerRepoVisibilityNote = data.error || 'Could not load repositories.';
          renderRepoAutocomplete();
          return;
        }
        ownerRepoSuggestions = Array.isArray(data.repos) ? data.repos : [];
        ownerRepoTokenUsed = !!data.token_used;
        ownerRepoVisibilityNote = String(data.visibility_note || '');
        renderRepoAutocomplete();
      })
      .catch(function () {
        ownerRepoSuggestions = [];
        ownerRepoTokenUsed = false;
        ownerRepoVisibilityNote = 'Could not load repositories.';
        renderRepoAutocomplete();
      });
  }

  function scheduleOwnerRepoFetch() {
    if (ownerRepoFetchTimer) {
      clearTimeout(ownerRepoFetchTimer);
    }
    ownerRepoFetchTimer = setTimeout(fetchOwnerRepositories, 250);
  }

  function setMode(mode) {
    state.mode = mode;
    modalEl.querySelectorAll('.ob-mode-card').forEach(function (card) {
      var selected = card.getAttribute('data-mode') === mode;
      card.classList.toggle('selected', selected);
      card.setAttribute('aria-pressed', selected ? 'true' : 'false');
    });
    updateNav();
  }

  function applyRepoStepMode() {
    var existing = document.getElementById('obExistingRepoBlock');
    var newer = document.getElementById('obNewRepoBlock');
    var title = document.getElementById('obRepoStepTitle');
    var sub = document.getElementById('obRepoStepSub');
    if (state.mode === 'new') {
      if (existing) existing.style.display = 'none';
      if (newer) newer.style.display = '';
      if (title) title.innerHTML = 'Step 2 of 5 &mdash; Add Repository Details';
      if (sub) sub.textContent = 'Enter repository details and optional token settings.';
    } else {
      if (existing) existing.style.display = '';
      if (newer) newer.style.display = 'none';
      if (title) title.innerHTML = 'Step 2 of 5 &mdash; Select Existing Repository';
      if (sub) sub.textContent = 'Choose a configured repository to onboard.';
    }
  }

  function newRepoFormBody() {
    var owner = val('obNewRepoOwner');
    var repoName = val('obNewRepoName');
    var repoUrl = composeGithubRepoUrl(owner, repoName);
    return {
      name: val('obNewName'),
      slug: val('obNewSlug'),
      repo_owner: owner,
      repo_name: repoName,
      repo_url: repoUrl,
      default_environment: val('obNewDefaultEnv'),
      github_token: val('obNewGithubToken'),
      github_token_expires_at: val('obNewGithubTokenExpiry'),
      set_github_token: checked('obNewSetGithubToken'),
      set_repo_token: checked('obNewSetRepoToken'),
      set_agent_repo: checked('obNewSetAgentRepo'),
    };
  }

  function setImportStatus(message, isError) {
    var status = document.getElementById('obImportRepoStatus');
    if (!status) return;
    status.className = isError ? 'small text-danger' : 'small text-secondary';
    status.textContent = message || '';
  }

  function importRepoFromGithub() {
    var owner = val('obNewRepoOwner');
    var repoName = val('obNewRepoName');
    var repoUrl = composeGithubRepoUrl(owner, repoName);
    if (!repoUrl) {
      setImportStatus('Enter GitHub owner and repository first.', true);
      return;
    }

    var btn = document.getElementById('obImportRepoBtn');
    if (btn) btn.disabled = true;
    setImportStatus('Importing metadata from GitHub...', false);

    fetch("/api/onboarding/import-repo", {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        repo_owner: owner,
        repo_name: repoName,
        repo_url: repoUrl,
        github_token: val('obNewGithubToken')
      }),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) {
          setImportStatus(data.error || 'Import failed.', true);
          return;
        }
        var nameEl = document.getElementById('obNewName');
        var slugEl = document.getElementById('obNewSlug');
        var ownerEl = document.getElementById('obNewRepoOwner');
        var repoNameEl = document.getElementById('obNewRepoName');
        var envEl = document.getElementById('obNewDefaultEnv');
        if (nameEl && !nameEl.value.trim()) nameEl.value = String(data.name || '');
        if (slugEl && !slugUserEdited && !slugEl.value.trim()) slugEl.value = String(data.slug || suggestSlug(data.name || ''));
        if (ownerEl && !ownerEl.value.trim()) ownerEl.value = String(data.owner || owner || '');
        if (repoNameEl && !repoNameEl.value.trim()) repoNameEl.value = String(data.repo || repoName || '');
        syncNewRepoUrlPreview();
        if (envEl && !envEl.value.trim()) envEl.value = 'prod';
        setImportStatus('Imported ' + String(data.full_name || '') + ' metadata.', false);
        updateNav();
      })
      .catch(function () {
        setImportStatus('Import failed. Check token or repository access.', true);
      })
      .finally(function () {
        if (btn) btn.disabled = false;
      });
  }

  function val(id) {
    var el = document.getElementById(id);
    return (el && typeof el.value === 'string') ? el.value.trim() : '';
  }

  function checked(id) {
    var el = document.getElementById(id);
    return !!(el && el.checked);
  }

  function showStep(idx) {
    modalEl.querySelectorAll('.ob-step').forEach(function (s) { s.classList.remove('active'); });
    var el = document.getElementById('obStep' + idx);
    if (el) el.classList.add('active');
    state.step = idx;
    updateNav();

    var pct = Math.round((idx / (totalSteps - 1)) * 100);
    progressBar.style.width = pct + '%';
    progressBar.setAttribute('aria-valuenow', pct);

    if (idx === 1) {
      applyRepoStepMode();
      loadRepos();
    }
    if (idx === 2 && !state.inspected) runInspect();
    if (idx === 4) runCreateIssues();
  }

  function updateNav() {
    if (skipBtn) {
      skipBtn.style.display = state.step === 4 ? 'none' : '';
    }
    prevBtn.style.display = state.step > 0 && state.step < totalSteps - 1 ? '' : 'none';
    nextBtn.style.display = state.step < 3 ? '' : 'none';
    createBtn.style.display = state.step === 3 ? '' : 'none';
    doneBtn.style.display = state.step === 4 ? '' : 'none';

    if (state.step === 0) {
      nextBtn.disabled = !state.mode;
      return;
    }
    if (state.step === 1) {
      if (state.mode === 'new') {
        var body = newRepoFormBody();
        nextBtn.disabled = !body.name || !body.repo_url;
      } else {
        nextBtn.disabled = !state.appId;
      }
      return;
    }
    if (state.step === 2) {
      nextBtn.disabled = !state.inspected || !!state.inspectError;
      return;
    }
    if (state.step === 3) {
      var ci = document.getElementById('obCreateCi');
      var otel = document.getElementById('obCreateOtel');
      var realtime = document.getElementById('obEnableRealtimeSupport');
      createBtn.disabled = !(ci && ci.checked) && !(otel && otel.checked) && !(realtime && realtime.checked);
    }
  }

  function loadRepos() {
    var list = document.getElementById('obRepoList');
    if (!list) return;

    var repos = getRepos();
    if (!repos.length) {
      list.innerHTML = '<div class="text-secondary small">No configured repositories found.</div>';
      return;
    }

    var html = '';
    repos.forEach(function (r) {
      var sel = r.id === state.appId ? ' selected' : '';
      html += '<button type="button" class="ob-repo-card' + sel + '" data-app-id="' + escAttr(r.id) + '" data-repo-url="' + escAttr(r.repo_url) + '" data-repo-name="' + escAttr(r.name) + '" aria-pressed="' + (sel ? 'true' : 'false') + '">'
        + '<div class="repo-name">' + escHtml(r.name) + '</div>'
        + '<div class="repo-url">' + escHtml(r.repo_url) + '</div>'
        + '</button>';
    });
    list.innerHTML = html;

    list.querySelectorAll('.ob-repo-card').forEach(function (card) {
      card.addEventListener('click', function () {
        list.querySelectorAll('.ob-repo-card').forEach(function (c) { c.classList.remove('selected'); });
        list.querySelectorAll('.ob-repo-card').forEach(function (c) { c.setAttribute('aria-pressed', 'false'); });
        card.classList.add('selected');
        card.setAttribute('aria-pressed', 'true');
        state.appId = card.dataset.appId || '';
        state.repoUrl = card.dataset.repoUrl || '';
        state.repoName = card.dataset.repoName || '';
        state.inspected = false;
        state.inspectError = '';
        updateNav();
      });
    });
  }

  function setInspectError(message) {
    state.inspected = false;
    state.inspectError = message || 'Inspect failed.';
    state.copilotAvailable = false;
    state.hasGithubActions = false;
    var container = document.getElementById('obInspectResults');
    if (container) {
      container.innerHTML = '<div class="alert alert-danger small">' + escHtml(state.inspectError) + '</div>';
    }
    var copSection = document.getElementById('obCopilotSection');
    var noCopNote = document.getElementById('obNoCopilotNote');
    if (copSection) copSection.style.display = 'none';
    if (noCopNote) noCopNote.style.display = '';
  }

  function ensureRepoForInspect(done) {
    if (state.mode === 'existing') {
      if (!state.appId) {
        setInspectError('Select a configured repository before inspection.');
        updateNav();
        return;
      }
      done();
      return;
    }

    if (state.appId) {
      done();
      return;
    }

    var createUrl = "/api/onboarding/create-repo";
    var body = newRepoFormBody();
    var container = document.getElementById('obInspectResults');
    if (container) {
      container.innerHTML = '<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-success me-2" role="status"></div><span class="text-secondary small">Creating repository entry&hellip;</span></div>';
    }

    fetch(createUrl, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) {
          setInspectError(data.error || 'Could not create repository entry.');
          updateNav();
          return;
        }
        state.appId = String(data.app_id || '');
        state.repoName = String(data.name || body.name || '');
        state.repoUrl = String(data.repo_url || body.repo_url || '');
        state.repoCreated = true;
        done();
      })
      .catch(function () {
        setInspectError('Failed to create repository entry.');
        updateNav();
      });
  }

  function runInspect() {
    var container = document.getElementById('obInspectResults');
    if (!container) return;
    state.inspectError = '';

    ensureRepoForInspect(function () {
      container.innerHTML = '<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-success me-2" role="status"></div><span class="text-secondary small">Inspecting&hellip;</span></div>';
      nextBtn.disabled = true;

      var url = "/api/onboarding/inspect-repo";
      if (state.appId) {
        url += '?app_id=' + encodeURIComponent(state.appId);
      } else if (state.repoUrl) {
        url += '?repo=' + encodeURIComponent(state.repoUrl);
      }

      fetch(url, { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          state.inspected = true;
          state.inspectError = data.error ? String(data.error) : '';
          state.copilotAvailable = !!data.copilot_available;
          state.hasGithubActions = !!data.has_github_actions;

          var rows = [
            {
              ok: data.has_github_actions,
              label: 'GitHub Actions',
              yes: 'Detected. Workflow files found.',
              no: 'No .github/workflows directory found. CI guidance will be provider-agnostic.',
            },
            {
              ok: data.sobs_ci_found,
              label: 'Sobs CI metadata',
              yes: 'Already present in at least one workflow.',
              no: 'Not detected. CI issue will guide setup.',
            },
            {
              ok: data.sobs_otel_found,
              label: 'OTEL instrumentation',
              yes: 'OTEL references found in workflows or manifests.',
              no: 'Not detected. OTEL issue will guide setup.',
            },
            {
              ok: data.copilot_available,
              label: 'Copilot cloud agent',
              yes: 'Available. Issues can be auto-assigned.',
              no: 'Not available for this repository.',
            },
          ];

          var html = '';
          rows.forEach(function (row) {
            var icon = row.ok
              ? '<i class="bi bi-check-circle-fill text-success ob-inspect-icon"></i>'
              : '<i class="bi bi-x-circle-fill text-danger ob-inspect-icon"></i>';
            html += '<div class="ob-inspect-row">'
              + icon
              + '<span><strong>' + row.label + '</strong> - ' + (row.ok ? row.yes : row.no) + '</span>'
              + '</div>';
          });

          if (data.error) {
            html += '<div class="alert alert-warning small mt-2">' + escHtml(data.error) + '</div>';
          }

          container.innerHTML = html;
          var copSection = document.getElementById('obCopilotSection');
          var noCopNote = document.getElementById('obNoCopilotNote');
          if (copSection) copSection.style.display = data.copilot_available ? '' : 'none';
          if (noCopNote) noCopNote.style.display = data.copilot_available ? 'none' : '';
          updateNav();
        })
        .catch(function () {
          setInspectError('Failed to inspect repository. Check GitHub token configuration.');
          updateNav();
        });
    });
  }

  function runCreateIssues() {
    var container = document.getElementById('obResultsContainer');
    if (!container) return;
    container.innerHTML = '<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-success me-2" role="status"></div><span class="text-secondary small">Creating issues&hellip;</span></div>';
    doneBtn.disabled = true;

    var payload = {
      app_id: state.appId,
      create_ci: checked('obCreateCi'),
      create_otel: checked('obCreateOtel'),
      assign_copilot: checked('obAssignCopilot'),
      enable_realtime_support: checked('obEnableRealtimeSupport'),
      has_github_actions: state.hasGithubActions,
    };

    fetch("/api/onboarding/create-issues", {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) {
          container.innerHTML = '<div class="alert alert-danger small">' + escHtml(data.error || 'An error occurred.') + '</div>';
          doneBtn.disabled = false;
          return;
        }

        function renderIssueResult(issue, label) {
          if (!issue) return '';
          if (issue.error) {
            return '<div class="ob-result-card border-danger">'
              + '<div class="issue-title">' + label + '</div>'
              + '<div class="text-danger small">Failed: ' + escHtml(issue.error) + '</div>'
              + '</div>';
          }
          var modeBadge = '';
          if (issue.status === 'created') modeBadge = ' <span class="badge text-bg-success ms-1">Created</span>';
          if (issue.status === 'updated') modeBadge = ' <span class="badge text-bg-info ms-1">Updated</span>';
          if (issue.status === 'reused') modeBadge = ' <span class="badge text-bg-secondary ms-1">Reused existing</span>';
          var noteHtml = issue.note ? '<div class="small text-secondary mt-1">' + escHtml(issue.note) + '</div>' : '';
          var copilotBadge = '';
          var assignmentStatus = String(issue.copilot_assignment_status || issue.copilot_status || 'not_requested');
          var assignmentReason = String(issue.copilot_assignment_reason || '');
          if (assignmentStatus && assignmentStatus !== 'not_requested') {
            var badgeClass = assignmentStatus === 'requested' ? 'text-bg-success' : 'text-bg-warning';
            var badgeLabel = assignmentStatus === 'requested' ? 'Copilot assigned' : ('Copilot: ' + escHtml(assignmentStatus));
            copilotBadge = ' <span class="badge ' + badgeClass + ' ms-1">'
              + badgeLabel
              + '</span>';
          }
          var copilotReasonHtml = assignmentReason ? '<div class="small text-secondary mt-1">' + escHtml(assignmentReason) + '</div>' : '';
          return '<div class="ob-result-card border-success">'
            + '<div class="issue-title"><i class="bi bi-check-circle-fill text-success me-1"></i>' + label + modeBadge + copilotBadge + '</div>'
            + '<div class="issue-url"><a href="' + escAttr(issue.url) + '" target="_blank" rel="noopener">' + escHtml(issue.url) + '</a></div>'
            + noteHtml
            + copilotReasonHtml
            + '</div>';
        }

        var html = '';
        html += renderIssueResult(data.ci_issue, 'CI Metadata Setup');
        html += renderIssueResult(data.otel_issue, 'OTEL And RUM Telemetry Audit');
        if (data.realtime && data.realtime.enabled) {
          var rt = data.realtime;
          var keyBlock = '';
          if (rt.api_key_show_once && rt.api_key) {
            keyBlock = '<div class="small fw-semibold mt-1">Copy this ingest key now (shown once):</div>'
              + '<code class="d-block" style="word-break:break-all;">' + escHtml(rt.api_key) + '</code>';
          } else {
            keyBlock = '<div class="small text-secondary mt-1">Ingest key already configured. Rotate in Repositories settings if needed.</div>';
          }
          var curlExample = '';
          if (rt.instructions && rt.instructions.curl_example) {
            curlExample = '<pre class="small mb-1 mt-2"><code>' + escHtml(rt.instructions.curl_example) + '</code></pre>';
          }
          var expiryMsg = rt.expiry_message ? ('<div class="small text-secondary mt-1">' + escHtml(rt.expiry_message) + '</div>') : '';
          html += '<div class="ob-result-card border-warning">'
            + '<div class="issue-title"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Realtime CI Setup (Optional)</div>'
            + '<div class="small">Required secrets: <code>SOBS_URL</code>, <code>SOBS_INGEST_API_KEY</code>, <code>SOBS_APP_ID</code></div>'
            + keyBlock
            + curlExample
            + '<div class="small text-secondary">Optional: add a GitHub webhook for push/workflow events; keep polling mode as fallback.</div>'
            + expiryMsg
            + '</div>';
        }
        html += '<div class="small text-secondary mt-2"><i class="bi bi-info-circle me-1"></i>Review each issue and complete the manual steps listed.</div>';
        container.innerHTML = html;
        doneBtn.disabled = false;
      })
      .catch(function () {
        container.innerHTML = '<div class="alert alert-danger small">Failed to create issues. Check GitHub token configuration.</div>';
        doneBtn.disabled = false;
      });
  }

  function escHtml(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function escAttr(s) {
    return String(s || '').replace(/"/g, '&quot;');
  }

  function resetWizard() {
    state.step = 0;
    state.mode = '';
    state.appId = '';
    state.repoName = '';
    state.repoUrl = '';
    state.copilotAvailable = false;
    state.hasGithubActions = false;
    state.inspected = false;
    state.inspectError = '';
    state.repoCreated = false;
    modalEl.querySelectorAll('.ob-mode-card').forEach(function (card) { card.classList.remove('selected'); });
  }

  modalEl.addEventListener('hidden.bs.modal', function () {
    if (state.repoCreated) {
      window.location.reload();
    }
  });

  modalEl.querySelectorAll('.ob-mode-card').forEach(function (card) {
    card.addEventListener('click', function () {
      setMode(card.getAttribute('data-mode') || '');
    });
  });

  ['obCreateCi', 'obCreateOtel'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('change', updateNav);
  });
  var realtimeToggle = document.getElementById('obEnableRealtimeSupport');
  if (realtimeToggle) {
    realtimeToggle.addEventListener('change', updateNav);
  }

  var realtimeSeed = getRealtimeSeed();
  var realtimeCheckbox = document.getElementById('obEnableRealtimeSupport');
  if (realtimeCheckbox) {
    realtimeCheckbox.checked = !!realtimeSeed.enabled;
  }

  ['obNewName', 'obNewSlug', 'obNewRepoOwner', 'obNewRepoName', 'obNewDefaultEnv', 'obNewGithubToken', 'obNewGithubTokenExpiry'].forEach(function (id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('input', function () {
      if (id === 'obNewSlug') {
        slugUserEdited = !!el.value.trim();
      }
      if (id === 'obNewName') {
        var slugEl = document.getElementById('obNewSlug');
        if (slugEl && !slugUserEdited) {
          slugEl.value = suggestSlug(el.value);
        }
      }
      if (id === 'obNewRepoOwner' || id === 'obNewRepoName') {
        syncNewRepoUrlPreview();
        var nameEl = document.getElementById('obNewName');
        var envEl = document.getElementById('obNewDefaultEnv');
        var repoInput = val('obNewRepoName');
        if (nameEl && !nameEl.value.trim() && repoInput) {
          nameEl.value = repoInput;
          var slugField = document.getElementById('obNewSlug');
          if (slugField && !slugUserEdited) {
            slugField.value = suggestSlug(repoInput);
          }
        }
        if (envEl && !envEl.value.trim() && repoInput) {
          envEl.value = 'prod';
        }
      }
      if (id === 'obNewRepoOwner') {
        scheduleOwnerRepoFetch();
      }
      if (id === 'obNewRepoName') {
        renderRepoAutocomplete();
      }
      if (state.mode === 'new') {
        state.appId = '';
        state.inspected = false;
        state.inspectError = '';
      }
      updateNav();
    });
  });

  var importBtn = document.getElementById('obImportRepoBtn');
  if (importBtn) {
    importBtn.addEventListener('click', importRepoFromGithub);
  }

  var repoNameEl = document.getElementById('obNewRepoName');
  if (repoNameEl) {
    repoNameEl.addEventListener('focus', function () {
      renderRepoAutocomplete();
    });
    repoNameEl.addEventListener('blur', function () {
      setTimeout(hideRepoAutocomplete, 140);
    });
  }

  var repoOwnerEl = document.getElementById('obNewRepoOwner');
  if (repoOwnerEl) {
    repoOwnerEl.addEventListener('blur', function () {
      scheduleOwnerRepoFetch();
    });
  }

  var repoTokenEl = document.getElementById('obNewGithubToken');
  if (repoTokenEl) {
    repoTokenEl.addEventListener('blur', function () {
      scheduleOwnerRepoFetch();
    });
  }

  prevBtn.addEventListener('click', function () { showStep(state.step - 1); });
  nextBtn.addEventListener('click', function () { showStep(state.step + 1); });
  createBtn.addEventListener('click', function () { showStep(4); });

  window.__sobsOpenOnboardingWizard = function (modePreference) {
    resetWizard();
    var repos = getRepos();
    var preferred = (modePreference === 'new' || modePreference === 'existing') ? modePreference : '';
    if (!preferred) preferred = repos.length ? 'existing' : 'new';
    setMode(preferred);
    showStep(preferred ? 1 : 0);
    var activeModal = getModal();
    if (!activeModal) return;
    activeModal.show();
  };

  showStep(0);
  syncNewRepoUrlPreview();
})();
</script>

  </div>
</div>

<div class="modal fade" id="gettingStartedModal" tabindex="-1" aria-labelledby="gettingStartedModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-secondary">
      <div class="modal-header">
        <h5 class="modal-title" id="gettingStartedModalTitle"><i class="bi bi-stars me-2 text-info"></i>Getting Started</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body py-2">
        <div class="list-group list-group-flush">
          <button id="reopenWelcomeTourBtn" type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-2" data-bs-dismiss="modal">
            <i class="bi bi-stars"></i><span>Quick Tour</span>
          </button>
          <button id="reopenSetupWizardBtn" type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-2" data-bs-dismiss="modal">
            <i class="bi bi-tools"></i><span>Setup Wizard</span>
          </button>
          <a href="/setup/help/playbooks" class="list-group-item list-group-item-action d-flex align-items-center gap-2 ">
            <i class="bi bi-journal-code"></i><span>Setup Playbooks</span>
          </a>
        </div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="saveReportModal" tabindex="-1" aria-labelledby="saveReportModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-secondary">
      <form id="saveReportForm" novalidate>
        <div class="modal-header">
          <h5 class="modal-title" id="saveReportModalTitle">
            <i class="bi bi-bookmark-plus me-2"></i>Save Report
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div id="saveReportFeedback" class="alert py-2 d-none" role="alert"></div>
          <div class="mb-3">
            <label for="saveReportName" class="form-label">Name</label>
            <input id="saveReportName" name="name" type="text" class="form-control" maxlength="120" required>
            <div class="invalid-feedback">Please provide a report name.</div>
          </div>
          <div class="mb-1">
            <label for="saveReportDescription" class="form-label">Description (optional)</label>
            <textarea id="saveReportDescription" name="description" class="form-control" rows="2" maxlength="500"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button id="saveReportSubmit" type="submit" class="btn btn-primary">
            <i class="bi bi-bookmark-check me-1"></i>Save report
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="sobsTzModal" tabindex="-1" aria-labelledby="sobsTzModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-secondary">
      <div class="modal-header">
        <h5 class="modal-title fs-6" id="sobsTzModalTitle">
          <i class="bi bi-clock me-2 text-primary"></i>Display Timezone
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body py-2">
        <div class="small text-secondary mb-2">
          Timestamps are stored in UTC and displayed in your selected timezone.
        </div>
        <label class="form-label small fw-semibold mb-1" for="sobs-tz-modal-input">Select Timezone</label>
        <input id="sobs-tz-modal-input" type="text" class="form-control form-control-sm" list="sobs-tz-list" autocomplete="off" placeholder="UTC or e.g. America/New_York">
        <datalist id="sobs-tz-list"></datalist>
        <div class="mt-2 small" id="sobs-tz-modal-note"></div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-sm btn-primary" id="sobs-tz-apply-btn">Apply</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="sobsConfirmModal" tabindex="-1" aria-labelledby="sobsConfirmModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-secondary">
      <div class="modal-header">
        <h5 class="modal-title" id="sobsConfirmModalTitle">Confirm Action</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p id="sobsConfirmModalMessage" class="mb-0">Are you sure?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="sobsConfirmModalOkBtn">Confirm</button>
      </div>
    </div>
  </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" id="sobsNotifyToastContainer" style="z-index:1200;"></div>

<script src="/static/bootstrap.bundle.min.js"></script>
<script src="/static/date-range-picker.js"></script>
<script src="/static/sobs-timezone.js"></script>
<script src="/static/sobs-ansi.js"></script>


<script>
(function () {
  var modalEl = document.getElementById('saveReportModal');
  var formEl = document.getElementById('saveReportForm');
  var nameEl = document.getElementById('saveReportName');
  var descriptionEl = document.getElementById('saveReportDescription');
  var submitEl = document.getElementById('saveReportSubmit');
  var feedbackEl = document.getElementById('saveReportFeedback');

  if (!modalEl || !formEl || !nameEl || !descriptionEl || !submitEl || !feedbackEl || !window.bootstrap) {
    return;
  }

  var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
  var state = {
    pageType: '',
    filters: {}
  };

  function setFeedback(level, message) {
    feedbackEl.className = 'alert py-2';
    if (level === 'success') {
      feedbackEl.classList.add('alert-success');
    } else {
      feedbackEl.classList.add('alert-danger');
    }
    feedbackEl.textContent = String(message || '');
  }

  function clearFeedback() {
    feedbackEl.className = 'alert py-2 d-none';
    feedbackEl.textContent = '';
  }

  function setBusy(busy) {
    submitEl.disabled = !!busy;
    submitEl.innerHTML = busy
      ? '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Saving...'
      : '<i class="bi bi-bookmark-check me-1"></i>Save report';
  }

  function resetForm() {
    formEl.classList.remove('was-validated');
    nameEl.value = '';
    descriptionEl.value = '';
    nameEl.classList.remove('is-invalid');
    clearFeedback();
    setBusy(false);
  }

  window.sobsReportSaveModal = {
    open: function (opts) {
      opts = opts || {};
      state.pageType = String(opts.pageType || '').trim();
      state.filters = opts.filters && typeof opts.filters === 'object' ? opts.filters : {};
      resetForm();
      modal.show();
    }
  };

  modalEl.addEventListener('shown.bs.modal', function () {
    nameEl.focus();
  });

  modalEl.addEventListener('hidden.bs.modal', function () {
    resetForm();
  });

  formEl.addEventListener('submit', async function (event) {
    event.preventDefault();
    event.stopPropagation();

    var name = String(nameEl.value || '').trim();
    var description = String(descriptionEl.value || '').trim();
    if (!name) {
      nameEl.classList.add('is-invalid');
      formEl.classList.add('was-validated');
      return;
    }
    nameEl.classList.remove('is-invalid');
    clearFeedback();
    setBusy(true);

    try {
      var response = await fetch("/api/reports", {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: name,
          description: description,
          page_type: state.pageType,
          filters: state.filters
        })
      });
      var payload = await response.json();
      if (!response.ok || payload.error) {
        setFeedback('error', payload.error || 'Failed to save report.');
        return;
      }

      setFeedback('success', "Report '" + payload.name + "' saved.");
      document.dispatchEvent(new CustomEvent('sobs:report-saved', { detail: payload }));
      window.setTimeout(function () {
        modal.hide();
      }, 550);
    } catch (_err) {
      setFeedback('error', 'Failed to save report.');
    } finally {
      setBusy(false);
    }
  });
})();
</script>
<script>
(function () {
  window.SOBS = window.SOBS || {};

  window.SOBS.initSavedReportsDropdown = function initSavedReportsDropdown(options) {
    var cfg = options || {};
    var groupId = String(cfg.groupId || '').trim();
    var saveButtonId = String(cfg.saveButtonId || '').trim();
    var pageType = String(cfg.pageType || '').trim();
    var pageBaseUrl = String(cfg.pageBaseUrl || '').trim();
    var listReportsUrl = String(cfg.listReportsUrl || '').trim();
    var manageReportsUrl = String(cfg.manageReportsUrl || '').trim();
    var formSelector = String(cfg.formSelector || 'form[method="get"]');
    if (!groupId || !saveButtonId || !pageType || !pageBaseUrl || !listReportsUrl || !manageReportsUrl) return;

    var group = document.getElementById(groupId);
    var saveBtn = document.getElementById(saveButtonId);
    if (!group || !saveBtn) return;
    var menu = group.querySelector('ul');
    if (!menu) return;

    var escHtml = function (value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    };

    group.addEventListener('show.bs.dropdown', function () {
      fetch(listReportsUrl + '?page_type=' + encodeURIComponent(pageType))
        .then(function (r) { return r.json(); })
        .then(function (reports) {
          if (!reports.length) {
            menu.innerHTML = '<li><span class="dropdown-item text-secondary small">No saved reports</span></li>';
            return;
          }
          menu.innerHTML = reports.map(function (rep) {
            var params = new URLSearchParams(rep.filters);
            var url = pageBaseUrl + '?' + params.toString();
            return '<li><a class="dropdown-item small" href="' + url + '" title="' + escHtml(rep.description) + '">' + escHtml(rep.name) + '</a></li>';
          }).join('') +
            '<li><hr class="dropdown-divider my-1"></li>' +
            '<li><a class="dropdown-item small text-secondary" href="' + manageReportsUrl + '"><i class="bi bi-gear me-1"></i>Manage reports</a></li>';
        })
        .catch(function () {
          menu.innerHTML = '<li><span class="dropdown-item text-danger small">Failed to load</span></li>';
        });
    });

    saveBtn.addEventListener('click', function () {
      var form = document.querySelector(formSelector);
      if (!form) return;
      var data = new FormData(form);
      var filters = {};
      for (var pair of data.entries()) {
        if (pair[1]) filters[pair[0]] = pair[1];
      }
      if (window.sobsReportSaveModal && typeof window.sobsReportSaveModal.open === 'function') {
        window.sobsReportSaveModal.open({ pageType: pageType, filters: filters });
      }
    });
  };

  window.SOBS.resolveUrl = function (value) {
    var raw = String(value == null ? '' : value).trim();
    if (!raw) return String(document.baseURI || window.location.href || '');
    try {
      return new URL(raw, document.baseURI || window.location.href).toString();
    } catch (_err) {
      return raw;
    }
  };

  var modalEl = document.getElementById('sobsConfirmModal');
  var titleEl = document.getElementById('sobsConfirmModalTitle');
  var messageEl = document.getElementById('sobsConfirmModalMessage');
  var okBtn = document.getElementById('sobsConfirmModalOkBtn');
  var notifyContainerEl = document.getElementById('sobsNotifyToastContainer');
  var modal = (modalEl && window.bootstrap && window.bootstrap.Modal)
    ? window.bootstrap.Modal.getOrCreateInstance(modalEl)
    : null;
  var pendingRequest = null;
  var confirmQueue = [];
  var skipNextHiddenCancel = false;

  function processNextConfirm() {
    if (pendingRequest || !confirmQueue.length) return;
    pendingRequest = confirmQueue.shift();
    titleEl.textContent = pendingRequest.title;
    messageEl.textContent = pendingRequest.message;
    okBtn.textContent = pendingRequest.okLabel;
    okBtn.className = 'btn ' + pendingRequest.okClass;
    modal.show();
  }

  function finish(result, opts) {
    opts = opts || {};
    if (pendingRequest) {
      var request = pendingRequest;
      pendingRequest = null;
      request.resolve(!!result);
    }
    if (!opts.deferNext) {
      processNextConfirm();
    }
  }

  if (modalEl) {
    modalEl.addEventListener('hidden.bs.modal', function () {
      if (skipNextHiddenCancel) {
        skipNextHiddenCancel = false;
        processNextConfirm();
        return;
      }
      finish(false);
    });
  }
  if (okBtn) {
    okBtn.addEventListener('click', function () {
      skipNextHiddenCancel = true;
      finish(true, { deferNext: true });
      if (modal) {
        modal.hide();
      } else {
        processNextConfirm();
      }
    });
  }

  function showConfirm(opts) {
    opts = opts || {};
    var title = String(opts.title || 'Confirm Action');
    var message = String(opts.message || opts.text || 'Are you sure?');
    var okLabel = String(opts.okLabel || 'Confirm');
    var okClass = String(opts.okClass || 'btn-danger');

    if (!modal || !titleEl || !messageEl || !okBtn) {
      var nativeConfirm = (typeof globalThis !== 'undefined' && typeof globalThis.confirm === 'function')
        ? globalThis.confirm.bind(globalThis)
        : null;
      return Promise.resolve(nativeConfirm ? nativeConfirm(message) : false);
    }

    return new Promise(function (resolve) {
      confirmQueue.push({
        title: title,
        message: message,
        okLabel: okLabel,
        okClass: okClass,
        resolve: resolve
      });
      processNextConfirm();
    });
  }

  window.SOBS.confirm = showConfirm;
  window.sobsConfirm = showConfirm;

  function normalizeNotifyLevel(level) {
    var raw = String(level || '').toLowerCase();
    if (raw === 'error') return 'danger';
    if (raw === 'warn') return 'warning';
    if (raw === 'success' || raw === 'info' || raw === 'warning' || raw === 'danger' || raw === 'secondary' || raw === 'primary') {
      return raw;
    }
    return 'info';
  }

  function showNotify(message, opts) {
    opts = opts || {};
    var text = String(message || '').trim();
    if (!text) return;

    var level = normalizeNotifyLevel(opts.level || opts.type || 'info');
    var title = String(opts.title || 'Notice');
    var delay = Number(opts.delayMs || opts.delay || 3800);

    if (!notifyContainerEl || !window.bootstrap || !window.bootstrap.Toast) {
      var nativeAlert = (typeof globalThis !== 'undefined' && typeof globalThis.alert === 'function')
        ? globalThis.alert.bind(globalThis)
        : null;
      if (nativeAlert) {
        nativeAlert(text);
      }
      return;
    }

    var toastEl = document.createElement('div');
    toastEl.className = 'toast border-0 text-bg-' + level;
    toastEl.setAttribute('role', 'status');
    toastEl.setAttribute('aria-live', 'polite');
    toastEl.setAttribute('aria-atomic', 'true');

    var headerEl = document.createElement('div');
    headerEl.className = 'toast-header';

    var titleEl = document.createElement('strong');
    titleEl.className = 'me-auto';
    titleEl.textContent = title;

    var nowEl = document.createElement('small');
    nowEl.className = 'text-body-secondary';
    nowEl.textContent = 'now';

    var closeBtn = document.createElement('button');
    closeBtn.type = 'button';
    closeBtn.className = 'btn-close';
    closeBtn.setAttribute('data-bs-dismiss', 'toast');
    closeBtn.setAttribute('aria-label', 'Close');

    headerEl.appendChild(titleEl);
    headerEl.appendChild(nowEl);
    headerEl.appendChild(closeBtn);

    var bodyEl = document.createElement('div');
    bodyEl.className = 'toast-body';
    bodyEl.textContent = text;

    toastEl.appendChild(headerEl);
    toastEl.appendChild(bodyEl);

    notifyContainerEl.appendChild(toastEl);
    var toast = window.bootstrap.Toast.getOrCreateInstance(toastEl, {
      autohide: opts.autohide !== false,
      delay: Number.isFinite(delay) ? delay : 3800
    });
    toastEl.addEventListener('hidden.bs.toast', function () {
      toastEl.remove();
    });
    toast.show();
  }

  window.SOBS.notify = showNotify;
  window.sobsNotify = showNotify;

  document.addEventListener('submit', function (event) {
    var form = event.target;
    if (!(form instanceof HTMLFormElement)) return;
    var msg = form.getAttribute('data-confirm-message');
    if (!msg) return;
    if (form.dataset.confirming === '1') {
      form.dataset.confirming = '0';
      return;
    }
    event.preventDefault();
    var submitter = event.submitter;
    showConfirm({
      title: form.getAttribute('data-confirm-title') || 'Confirm Action',
      message: msg,
      okLabel: form.getAttribute('data-confirm-ok-label') || 'Confirm',
      okClass: form.getAttribute('data-confirm-ok-class') || 'btn-danger'
    }).then(function (confirmed) {
      if (!confirmed) {
        return;
      }
      form.dataset.confirming = '1';
      if (typeof form.requestSubmit === 'function') {
        form.requestSubmit(submitter || undefined);
      } else {
        form.querySelectorAll('input[data-sobs-temp-submitter="1"]').forEach(function (node) {
          node.remove();
        });
        if (submitter && submitter.name) {
          var hiddenSubmitter = document.createElement('input');
          hiddenSubmitter.type = 'hidden';
          hiddenSubmitter.name = submitter.name;
          hiddenSubmitter.value = submitter.value || '';
          hiddenSubmitter.setAttribute('data-sobs-temp-submitter', '1');
          form.appendChild(hiddenSubmitter);
        }
        form.submit();
      }
    });
  }, true);
})();
</script>

<script>
(function () {
  if (window.sobsTimezone && typeof window.sobsTimezone.initPage === 'function') {
    window.sobsTimezone.initPage({ timestampSelector: '.sobs-tz-ts[data-utc-ts]' });
  }
})();
</script>
<script>
  (function () {
    var root = document.getElementById('repo-settings-root');
    if (!root) {
      return;
    }

    function composeGithubRepoUrl(owner, repo) {
      var ownerClean = String(owner || '').trim().replace(/^\/+|\/+$/g, '');
      var repoClean = String(repo || '').trim().replace(/^\/+|\/+$/g, '').replace(/\.git$/i, '');
      if (!ownerClean || !repoClean) {
        return '';
      }
      return 'https://github.com/' + ownerClean + '/' + repoClean;
    }

    function syncRepoBuilderForm(form) {
      if (!form) {
        return;
      }
      var ownerEl = form.querySelector('[data-role="repo-owner"]');
      var repoEl = form.querySelector('[data-role="repo-name"]');
      var hiddenEl = form.querySelector('[data-role="repo-url-hidden"]');
      var previewEl = form.closest('.repo-setting-section')
        ? form.closest('.repo-setting-section').querySelector('[data-role="repo-url-preview"]')
        : null;
      if (!ownerEl || !repoEl || !hiddenEl) {
        return;
      }
      var builtUrl = composeGithubRepoUrl(ownerEl.value, repoEl.value);
      hiddenEl.value = builtUrl;
      if (previewEl) {
        previewEl.textContent = builtUrl || 'https://github.com/owner/repository';
      }
    }

    root.querySelectorAll('form[data-role="repo-url-builder"]').forEach(function (form) {
      syncRepoBuilderForm(form);
      var ownerEl = form.querySelector('[data-role="repo-owner"]');
      var repoEl = form.querySelector('[data-role="repo-name"]');
      if (ownerEl) {
        ownerEl.addEventListener('input', function () { syncRepoBuilderForm(form); });
      }
      if (repoEl) {
        repoEl.addEventListener('input', function () { syncRepoBuilderForm(form); });
      }
      form.addEventListener('submit', function () {
        syncRepoBuilderForm(form);
      });
    });

    function syncColorMode() {
      var mode = document.documentElement.getAttribute('data-bs-theme') || 'light';
      root.setAttribute('data-color-mode', mode);
      document.dispatchEvent(new CustomEvent('sobs:color-mode', {
        detail: { page: 'settings-repositories', mode: mode }
      }));
    }

    syncColorMode();
    var observer = new MutationObserver(function (mutations) {
      for (var i = 0; i < mutations.length; i += 1) {
        if (mutations[i].attributeName === 'data-bs-theme') {
          syncColorMode();
          break;
        }
      }
    });
    observer.observe(document.documentElement, { attributes: true });
  })();
</script>

<script>
(function () {
  /* ===== Theme management ===== */
  var THEME_KEY = 'sobs-theme';
  var VALID_THEMES = { light: true, dark: true, system: true };

  function normalizeTheme(value) {
    return VALID_THEMES[value] ? value : 'system';
  }

  function getStoredTheme() {
    return normalizeTheme(localStorage.getItem(THEME_KEY));
  }

  function applyTheme(stored) {
    stored = normalizeTheme(stored);
    var effective = stored === 'system'
      ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      : stored;
    document.documentElement.setAttribute('data-bs-theme', effective);
  }

  function updateThemeUI(stored) {
    document.querySelectorAll('[data-sobs-theme]').forEach(function (btn) {
      var active = btn.getAttribute('data-sobs-theme') === stored;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    ['sbCompactThemeIcon', 'sbCompactThemeIconNav'].forEach(function (iconId) {
      var compactIcon = document.getElementById(iconId);
      if (compactIcon) {
        compactIcon.className = stored === 'light'
          ? 'bi bi-sun'
          : (stored === 'dark' ? 'bi bi-moon-stars' : 'bi bi-circle-half');
      }
    });
  }

  var currentTheme = getStoredTheme();
  localStorage.setItem(THEME_KEY, currentTheme);
  updateThemeUI(currentTheme);

  document.querySelectorAll('[data-sobs-theme]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var t = this.getAttribute('data-sobs-theme');
      localStorage.setItem(THEME_KEY, t);
      applyTheme(t);
      updateThemeUI(t);
    });
  });

  // Follow OS preference changes when in system mode
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
    if (getStoredTheme() === 'system') {
      applyTheme('system');
    }
  });

  // Expose a small helper for chart code: returns 'dark' or null matching current BS theme
  window.SOBS = window.SOBS || {};
  window.SOBS.echartsTheme = function () {
    return document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'dark' : null;
  };
  window.SOBS.cssVar = function (name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  };
  // Copy text (or a Promise resolving to text) to the clipboard.
  // When a Promise is supplied, ClipboardItem is used so the user-activation
  // token is captured at call-time rather than after the async resolution,
  // which matters for browsers that enforce user-activation on clipboard writes.
  window.SOBS.copyToClipboard = async function (textOrPromise) {
    if (typeof textOrPromise !== 'string' &&
        typeof ClipboardItem !== 'undefined' &&
        navigator.clipboard && navigator.clipboard.write) {
      var blobPromise = Promise.resolve(textOrPromise).then(function (t) {
        return new Blob([t], { type: 'text/plain' });
      });
      await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blobPromise })]);
    } else {
      var text = typeof textOrPromise === 'string' ? textOrPromise : await textOrPromise;
      await navigator.clipboard.writeText(text);
    }
  };
}());

/* ===== Sidebar ===== */
(function () {
  var rootEl = document.documentElement;
  var sidebar = document.getElementById('sbSidebar');
  var toggleBtn = document.getElementById('sbToggleBtn');
  var toggleIcon = document.getElementById('sbToggleIcon');
  var hamburgerBtn = document.getElementById('sbHamburgerBtn');
  var backdrop = document.getElementById('sbBackdrop');
  var mq = window.matchMedia('(max-width: 575.98px)');
  var lastFocusedElement = null;

  function isHamburgerMode() { return mq.matches; }

  // Restore saved state (compact or full) on medium+ screens
  var saved = localStorage.getItem('sobs-sidebar-state') || 'full';
  var shouldCompact = saved === 'compact' && !isHamburgerMode();
  sidebar.classList.toggle('sidebar-compact', shouldCompact);
  toggleIcon.className = shouldCompact ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
  rootEl.classList.toggle('sb-state-compact', shouldCompact);
  rootEl.classList.remove('sb-state-pending');

  // Toggle button: switch between full (State 1) and compact (State 2)
  toggleBtn.addEventListener('click', function () {
    var isCompact = sidebar.classList.toggle('sidebar-compact');
    toggleIcon.className = isCompact ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
    localStorage.setItem('sobs-sidebar-state', isCompact ? 'compact' : 'full');
    rootEl.classList.toggle('sb-state-compact', isCompact);
  });

  // Hamburger button: open sidebar as overlay (State 3)
  hamburgerBtn.addEventListener('click', function () {
    lastFocusedElement = document.activeElement;
    sidebar.classList.add('sb-open');
    backdrop.classList.add('show');
    document.body.style.overflow = 'hidden';
    hamburgerBtn.setAttribute('aria-expanded', 'true');
    var firstFocusable = sidebar.querySelector('a.nav-link, button.nav-link, button, a');
    if (firstFocusable) {
      firstFocusable.focus();
    }
  });

  function closeSidebar() {
    sidebar.classList.remove('sb-open');
    backdrop.classList.remove('show');
    document.body.style.overflow = '';
    hamburgerBtn.setAttribute('aria-expanded', 'false');
    if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
      lastFocusedElement.focus();
      lastFocusedElement = null;
    } else {
      hamburgerBtn.focus();
    }
  }

  // Close on backdrop click
  backdrop.addEventListener('click', closeSidebar);

  // Close on nav-link click in hamburger mode (navigate away)
  sidebar.querySelectorAll('a.nav-link, button.nav-link').forEach(function (link) {
    link.addEventListener('click', function () {
      if (isHamburgerMode()) closeSidebar();
    });
  });

  // Escape closes overlay menu in hamburger mode
  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && isHamburgerMode() && sidebar.classList.contains('sb-open')) {
      closeSidebar();
    }
  });

  // Handle transition between hamburger and normal modes on resize
  mq.addEventListener('change', function (e) {
    if (!e.matches) {
      // Back to normal/desktop mode
      closeSidebar();
      var restoredState = localStorage.getItem('sobs-sidebar-state') || 'full';
      if (restoredState === 'compact') {
        sidebar.classList.add('sidebar-compact');
        toggleIcon.className = 'bi bi-chevron-right';
        rootEl.classList.add('sb-state-compact');
      } else {
        sidebar.classList.remove('sidebar-compact');
        toggleIcon.className = 'bi bi-chevron-left';
        rootEl.classList.remove('sb-state-compact');
      }
    } else {
      // In hamburger mode we don't force compact desktop rules.
      rootEl.classList.remove('sb-state-compact');
    }
  });
}());
</script>

<!-- ===== AI Assistant Widget ===== -->
<style>
  :root {
    --sobs-ai-btn-bg: rgba(13, 110, 253, 0.12);
    --sobs-ai-btn-hover-bg: rgba(13, 110, 253, 0.18);
    --sobs-ai-btn-border: rgba(13, 110, 253, 0.2);
    --sobs-ai-btn-color: #0d6efd;
    --sobs-ai-btn-shadow: 0 4px 12px rgba(0, 0, 0, 0.18);
  }
  [data-bs-theme='dark'] {
    --sobs-ai-btn-bg: rgba(110, 168, 254, 0.18);
    --sobs-ai-btn-hover-bg: rgba(110, 168, 254, 0.26);
    --sobs-ai-btn-border: rgba(110, 168, 254, 0.28);
    --sobs-ai-btn-color: #9ec5fe;
    --sobs-ai-btn-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
  }
  #sobsAiBtn {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 1080;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--sobs-ai-btn-border);
    background: var(--sobs-ai-btn-bg);
    color: var(--sobs-ai-btn-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: var(--sobs-ai-btn-shadow);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background 0.15s, border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  #sobsAiBtn:hover {
    background: var(--sobs-ai-btn-hover-bg);
    border-color: var(--sobs-ai-btn-color);
    transform: scale(1.08);
  }
  #sobsAiPanel {
    position: fixed;
    bottom: 4.5rem;
    right: 1.5rem;
    z-index: 1075;
    width: min(420px, calc(100vw - 2rem));
    min-height: 320px;
    min-width: 320px;
    max-height: 70vh;
    max-width: calc(100vw - 1rem);
    display: none;
    flex-direction: column;
    background: var(--bs-body-bg);
    border: 1px solid var(--bs-border-color);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,.4);
    resize: both;
    overflow: hidden;
    transition: width 0.2s ease, height 0.2s ease, max-height 0.2s ease, right 0.2s ease, bottom 0.2s ease;
  }
  #sobsAiPanel.behind-modal {
    z-index: 1040;
  }
  #sobsAiBtn.behind-modal {
    z-index: 1040;
    opacity: .7;
  }
  #sobsAiPanel.open { display: flex; }
  #sobsAiPanel.expanded {
    max-height: none;
  }
  #sobsAiPanelHeader {
    padding: .6rem 1rem;
    background: var(--bs-tertiary-bg);
    border-bottom: 1px solid var(--bs-border-color);
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-shrink: 0;
    cursor: move;
    user-select: none;
    overflow: hidden;
  }
  #sobsAiPanelHeader > .fw-semibold {
    min-width: 0;
  }
  #sobsAiPanel.dragging {
    transition: none;
  }
  #sobsAiToggleHistory {
    border: 0;
    background: transparent;
    color: var(--bs-secondary-color);
    padding: .15rem .28rem;
    opacity: .72;
  }
  #sobsAiToggleHistory:hover {
    opacity: 1;
    color: var(--bs-body-color);
    background: color-mix(in srgb, var(--bs-secondary-bg) 72%, transparent);
  }
  #sobsAiPanel:not(.history-collapsed) #sobsAiToggleHistory {
    color: var(--bs-primary);
    opacity: .92;
  }
  #sobsAiActiveChat {
    display: none;
    align-items: center;
    gap: .25rem;
    max-width: 180px;
    min-width: 0;
    flex-shrink: 1;
    font-size: .64rem;
    color: var(--bs-secondary-color);
    border: 1px solid var(--bs-border-color);
    border-radius: 999px;
    padding: .08rem .4rem;
    background: color-mix(in srgb, var(--bs-tertiary-bg) 65%, transparent);
  }
  #sobsAiActiveChat.visible {
    display: inline-flex;
  }
  #sobsAiActiveChatLabel {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 132px;
  }
  #sobsAiThinkingWrap {
    display: none;
    align-items: center;
    gap: .35rem;
    font-size: .72rem;
    color: var(--bs-secondary-color);
    flex-shrink: 0;
  }
  #sobsAiThinkingWrap.active {
    display: inline-flex;
  }
  #sobsAiPanel.header-tight .sobs-ai-thinking-text {
    display: none;
  }
  #sobsAiPanel.header-tight #sobsAiActiveChat {
    max-width: 120px;
  }
  #sobsAiPanel.header-very-tight #sobsAiActiveChat {
    display: none;
  }
  #sobsAiThinkingLevel {
    width: 84px;
    padding: .12rem .3rem;
    font-size: .72rem;
  }
  #sobsAiMessages {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: .75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    font-size: .85rem;
  }
  #sobsAiBody {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
  }
  #sobsAiHistoryPanel {
    width: 210px;
    min-width: 160px;
    border-right: 1px solid var(--bs-border-color);
    background: color-mix(in srgb, var(--bs-secondary-bg) 52%, transparent);
    display: flex;
    flex-direction: column;
    transition: width .18s ease;
  }
  #sobsAiPanel.history-collapsed #sobsAiHistoryPanel {
    width: 0;
    min-width: 0;
    border-right: 0;
    overflow: hidden;
  }
  #sobsAiHistoryHeader {
    padding: .5rem .55rem;
    border-bottom: 1px solid var(--bs-border-color);
    color: var(--bs-secondary-color);
    font-size: .7rem;
    font-weight: 600;
  }
  #sobsAiHistoryList {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: .3rem;
    display: flex;
    flex-direction: column;
    gap: .28rem;
  }
  #sobsAiHistorySentinel {
    height: 1px;
    flex-shrink: 0;
  }
  #sobsAiHistorySearch {
    flex-shrink: 0;
    padding: .3rem .35rem;
    border-top: 1px solid var(--bs-border-color);
  }
  #sobsAiHistorySearchInput {
    width: 100%;
    font-size: .7rem;
    padding: .22rem .4rem;
    border: 1px solid var(--bs-border-color);
    border-radius: 5px;
    background: var(--bs-body-bg);
    color: var(--bs-body-color);
    outline: none;
  }
  #sobsAiHistorySearchInput:focus {
    border-color: color-mix(in srgb, var(--bs-primary) 55%, var(--bs-border-color));
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--bs-primary) 15%, transparent);
  }
  .sobs-ai-history-loading {
    text-align: center;
    font-size: .68rem;
    color: var(--bs-secondary-color);
    padding: .3rem 0;
  }
  .sobs-ai-history-item {
    border: 1px solid var(--bs-border-color);
    border-radius: 8px;
    background: var(--bs-body-bg);
    padding: .35rem .4rem;
    cursor: pointer;
  }
  .sobs-ai-history-item.active {
    border-color: color-mix(in srgb, var(--bs-primary) 65%, var(--bs-border-color));
    background: color-mix(in srgb, var(--bs-primary-bg-subtle) 58%, var(--bs-body-bg));
  }
  .sobs-ai-history-title {
    font-size: .72rem;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sobs-ai-history-meta {
    margin-top: .16rem;
    font-size: .62rem;
    color: var(--bs-secondary-color);
  }
  #sobsAiConversation {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1 1 auto;
  }
  .sobs-ai-msg {
    padding: .45rem .75rem;
    border-radius: 10px;
    max-width: 90%;
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.5;
  }
  .sobs-ai-msg.user {
    background: var(--bs-primary);
    color: #fff;
    align-self: flex-end;
    border-bottom-right-radius: 3px;
  }
  .sobs-ai-msg.assistant {
    background: var(--bs-secondary-bg);
    color: var(--bs-body-color);
    align-self: flex-start;
    border-bottom-left-radius: 3px;
    white-space: normal;
  }
  .sobs-ai-msg-time {
    font-size: .6rem;
    line-height: 1;
    opacity: .7;
    white-space: nowrap;
  }
  .sobs-ai-msg-meta {
    margin-top: .28rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .45rem;
    flex-wrap: wrap;
  }
  .sobs-ai-msg-actions {
    display: inline-flex;
    align-items: center;
    gap: .15rem;
    flex-wrap: wrap;
  }
  .sobs-ai-msg-action {
    --bs-btn-padding-y: .08rem;
    --bs-btn-padding-x: .28rem;
    --bs-btn-font-size: .68rem;
    display: inline-flex;
    align-items: center;
    gap: .2rem;
    color: var(--bs-secondary-color);
    text-decoration: none;
  }
  .sobs-ai-msg-action:hover,
  .sobs-ai-msg-action:focus {
    color: var(--bs-body-color);
  }
  .sobs-ai-msg-action[disabled] {
    opacity: .72;
    pointer-events: none;
  }
  .sobs-ai-msg.assistant p { margin: 0 0 .45rem 0; }
  .sobs-ai-msg.assistant p:last-child { margin-bottom: 0; }
  .sobs-ai-msg.assistant ul,
  .sobs-ai-msg.assistant ol {
    margin: 0 0 .45rem 1.15rem;
    padding-left: .6rem;
  }
  .sobs-ai-msg.assistant li { margin: .15rem 0; }
  .sobs-ai-msg.assistant pre {
    margin: .35rem 0;
    padding: .45rem .55rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--bs-body-color) 8%, transparent);
    overflow-x: auto;
  }
  .sobs-ai-msg.assistant code {
    font-size: .82em;
    border-radius: 4px;
    padding: .05rem .3rem;
    background: color-mix(in srgb, var(--bs-body-color) 10%, transparent);
  }
  .sobs-ai-msg.assistant pre code {
    padding: 0;
    background: transparent;
  }
  .sobs-ai-msg.assistant a {
    color: var(--bs-link-color);
    text-decoration: underline;
    word-break: break-all;
  }
  .sobs-markdown-block {
    display: block;
  }
  .sobs-markdown-tail {
    display: block;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--bs-body-color);
    line-height: 1.5;
  }
  .sobs-ai-msg.assistant .ai-md-table-wrap {
    width: 100%;
    overflow-x: auto;
    margin: .35rem 0;
  }
  .sobs-ai-msg.assistant table {
    width: 100%;
    border-collapse: collapse;
    font-size: .82rem;
  }
  .sobs-ai-msg.assistant th,
  .sobs-ai-msg.assistant td {
    border: 1px solid var(--bs-border-color);
    padding: .35rem .45rem;
    text-align: left;
    vertical-align: top;
  }
  .sobs-ai-msg.assistant th {
    background: var(--bs-tertiary-bg);
    font-weight: 600;
  }
  .sobs-ai-msg.assistant tr:nth-child(even) td {
    background: color-mix(in srgb, var(--bs-body-color) 3%, transparent);
  }
  .sobs-ai-msg.error-msg { background: #dc354522; color: #dc3545; }
  .sobs-ai-msg.info-msg { background: #0d6efd22; color: #0d6efd; }
  .sobs-ai-tool-card {
    align-self: flex-start;
    max-width: 90%;
    border: 1px solid var(--bs-border-color);
    background: var(--bs-tertiary-bg);
    border-radius: 10px;
    padding: .5rem .6rem;
    display: flex;
    flex-direction: column;
    gap: .35rem;
    font-size: .78rem;
  }
  .sobs-ai-tool-title {
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: .35rem;
  }
  .sobs-ai-tool-code {
    font-family: var(--bs-font-monospace);
    font-size: .74rem;
    background: color-mix(in srgb, var(--bs-body-color) 7%, transparent);
    border-radius: 6px;
    padding: .35rem .45rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .sobs-ai-tool-actions {
    display: flex;
    gap: .4rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .sobs-ai-tool-status {
    color: var(--bs-secondary-color);
    font-size: .72rem;
  }
  .sobs-ai-tool-card.historical {
    background: color-mix(in srgb, var(--bs-tertiary-bg) 78%, transparent);
  }
  .sobs-ai-thinking-trace {
    margin-top: .35rem;
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    font-size: .72rem;
    color: var(--bs-secondary-color);
    text-decoration: none;
    opacity: .9;
  }
  .sobs-ai-thinking-trace:hover {
    color: var(--bs-info-text-emphasis, var(--bs-info));
    opacity: 1;
  }
  .sobs-ai-msg.thinking-msg {
    background: color-mix(in srgb, var(--bs-secondary-bg) 78%, transparent);
    color: var(--bs-secondary-color);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 92px;
    padding: .5rem .7rem;
  }
  .sobs-ai-thinking-wrap {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    align-self: flex-start;
    gap: .25rem;
    max-width: 90%;
  }
  .sobs-ai-thinking {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sobs-ai-thinking-dots {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    min-height: 14px;
  }
  .sobs-ai-thinking-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: .35;
    animation: sobsAiThinkingPulse 1.1s ease-in-out infinite;
  }
  .sobs-ai-thinking-dot:nth-child(2) { animation-delay: .16s; }
  .sobs-ai-thinking-dot:nth-child(3) { animation-delay: .32s; }
  .sobs-ai-thinking-label {
    font-size: .64rem;
    line-height: 1;
    letter-spacing: .04em;
    color: var(--bs-secondary-color);
  }
  @keyframes sobsAiThinkingPulse {
    0%, 80%, 100% {
      transform: translateY(0) scale(.85);
      opacity: .3;
    }
    40% {
      transform: translateY(-1px) scale(1);
      opacity: .85;
    }
  }
  #sobsAiInputRow {
    display: flex;
    gap: .4rem;
    padding: .6rem;
    border-top: 1px solid var(--bs-border-color);
    flex-shrink: 0;
  }
  #sobsAiStatus {
    display: none;
    font-size: .7rem;
    color: var(--bs-secondary-color);
    padding: .25rem .6rem;
    border-top: 1px solid var(--bs-border-color);
    gap: .75rem;
    flex-wrap: wrap;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
  }
  #sobsAiStatus.visible { display: flex; }
  #sobsAiStatus .stat-group { display: flex; gap: .3rem; align-items: center; }
  #sobsAiStatus .stat-label { font-weight: 600; opacity: .75; }
  #sobsAiStatus .stat-sep { opacity: .35; }
  #sobsAiInput {
    flex: 1;
    font-size: .85rem;
    resize: none;
    border-radius: 8px;
    padding: .4rem .6rem;
    border: 1px solid var(--bs-border-color);
    background: var(--bs-body-bg);
    color: var(--bs-body-color);
    min-height: 38px;
    max-height: 120px;
  }
  #sobsAiSendBtn {
    flex-shrink: 0;
    height: 38px;
    padding: 0 .75rem;
    font-size: .85rem;
  }
  @media (max-width: 768px) {
    #sobsAiPanel {
      right: 1rem;
      bottom: 4.25rem;
      width: calc(100vw - 2rem);
    }
    #sobsAiPanel.expanded {
      right: .5rem;
      bottom: .5rem;
      width: calc(100vw - 1rem);
      height: calc(100vh - 1rem);
      max-height: calc(100vh - 1rem);
    }
    #sobsAiHistoryPanel {
      width: 150px;
      min-width: 130px;
    }
  }
</style>

<button id="sobsAiBtn" title="AI Assistant (beta)" aria-label="Open AI assistant (beta)">
  <i class="bi bi-robot fs-5"></i>
</button>

<div id="sobsAiPanel" class="history-collapsed" role="dialog" aria-label="AI Assistant (beta)" aria-modal="false">
  <div id="sobsAiPanelHeader">
    <i class="bi bi-robot text-primary"></i>
    <span class="fw-semibold small flex-grow-1">AI Assistant (beta)</span>
    <span id="sobsAiActiveChat" aria-label="Active chat">
      <i class="bi bi-pin-angle"></i>
      <span id="sobsAiActiveChatLabel"></span>
    </span>
    <button type="button" id="sobsAiToggleHistory" aria-label="Toggle chat history" title="Toggle history">
      <i class="bi bi-layout-sidebar"></i>
    </button>
    <div id="sobsAiThinkingWrap" aria-label="Thinking level">
      <span class="sobs-ai-thinking-text">Thinking</span>
      <select id="sobsAiThinkingLevel" class="form-select form-select-sm" title="Model thinking level">
        <option value="off">Off</option>
        <option value="low">Low</option>
        <option value="medium">Medium</option>
        <option value="high">High</option>
      </select>
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="sobsAiNewChat" aria-label="New chat" title="New chat">
      <i class="bi bi-plus-lg"></i>
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="sobsAiExpand" aria-label="Expand AI helper" aria-expanded="false" title="Expand">
      <i class="bi bi-arrows-angle-expand"></i>
    </button>
    <button type="button" class="btn-close btn-close-sm" id="sobsAiClose" aria-label="Close"></button>
  </div>
  <div id="sobsAiBody">
    <aside id="sobsAiHistoryPanel" aria-label="Chat history">
      <div id="sobsAiHistoryHeader">Chats</div>
      <div id="sobsAiHistoryList">
        <div id="sobsAiHistorySentinel"></div>
      </div>
      <div id="sobsAiHistorySearch">
        <input type="search" id="sobsAiHistorySearchInput" placeholder="Filter chats…" autocomplete="off" aria-label="Filter chat history">
      </div>
    </aside>
    <div id="sobsAiConversation">
      <div id="sobsAiMessages" aria-live="polite" aria-relevant="additions"></div>
      <div id="sobsAiStatus" role="status" aria-label="Token usage"></div>
      <div id="sobsAiInputRow">
        <textarea id="sobsAiInput" rows="1" placeholder="Ask a question about this page…" aria-label="Your question"></textarea>
        <button id="sobsAiSendBtn" class="btn btn-primary btn-sm" type="button">
          <i class="bi bi-send"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/markdown-it@14.1.0/dist/markdown-it.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js"></script>
<script>
(function () {
  var btn = document.getElementById('sobsAiBtn');
  var panel = document.getElementById('sobsAiPanel');
  var closeBtn = document.getElementById('sobsAiClose');
  var expandBtn = document.getElementById('sobsAiExpand');
  var newChatBtn = document.getElementById('sobsAiNewChat');
  var toggleHistoryBtn = document.getElementById('sobsAiToggleHistory');
  var historyListEl = document.getElementById('sobsAiHistoryList');
  var activeChatEl = document.getElementById('sobsAiActiveChat');
  var activeChatLabelEl = document.getElementById('sobsAiActiveChatLabel');
  var messagesEl = document.getElementById('sobsAiMessages');
  var statusEl = document.getElementById('sobsAiStatus');
  var inputEl = document.getElementById('sobsAiInput');
  var sendBtn = document.getElementById('sobsAiSendBtn');
  var thinkingWrapEl = document.getElementById('sobsAiThinkingWrap');
  var thinkingLevelEl = document.getElementById('sobsAiThinkingLevel');
  var currentAbortController = null;
  var currentChatId = '';
  var supportsThinking = false;
  var historyLoaded = false;
  var chatStateKey = 'sobs-ai-chat-state-v1';
  var headerResizeObserver = null;
  var mdRenderer = (window.markdownit && window.DOMPurify)
    ? window.markdownit({
      html: false,
      linkify: true,
      breaks: true,
      typographer: true
    })
    : null;

  if (mdRenderer) {
    mdRenderer.renderer.rules.table_open = function () {
      return '<div class="ai-md-table-wrap"><table>';
    };
    mdRenderer.renderer.rules.table_close = function () {
      return '</table></div>';
    };
  }

  function formatRelativeTime(ts) {
    if (!ts) return '';
    var d = new Date(String(ts).replace(' ', 'T') + 'Z');
    if (isNaN(d.getTime())) {
      d = new Date(ts);
    }
    if (isNaN(d.getTime())) return '';
    var diffSec = Math.max(1, Math.floor((Date.now() - d.getTime()) / 1000));
    if (diffSec < 60) return diffSec + 's ago';
    var diffMin = Math.floor(diffSec / 60);
    if (diffMin < 60) return diffMin + 'm ago';
    var diffHr = Math.floor(diffMin / 60);
    if (diffHr < 24) return diffHr + 'h ago';
    var diffDay = Math.floor(diffHr / 24);
    if (diffDay < 365) return diffDay + 'd ago';
    return Math.floor(diffDay / 365) + 'y ago';
  }

  function setActiveChatLabel(label) {
    var text = String(label || '').trim();
    if (!activeChatEl || !activeChatLabelEl) return;
    if (!text) {
      activeChatLabelEl.textContent = '';
      activeChatEl.classList.remove('visible');
      return;
    }
    activeChatLabelEl.textContent = text;
    activeChatEl.classList.add('visible');
  }

  function syncPanelHeaderDensity() {
    if (!panel) return;
    var width = panel.offsetWidth || panel.getBoundingClientRect().width || 0;
    panel.classList.toggle('header-tight', width > 0 && width < 560);
    panel.classList.toggle('header-very-tight', width > 0 && width < 470);
  }

  if (window.ResizeObserver && panel) {
    headerResizeObserver = new window.ResizeObserver(function () {
      syncPanelHeaderDensity();
    });
    headerResizeObserver.observe(panel);
  }

  function snapshotPanelGeometryForRestore() {
    var rect = panel.getBoundingClientRect();
    var computed = window.getComputedStyle(panel);
    panel.dataset.sobsPrevWidth = Math.max(320, Math.round(rect.width)) + 'px';
    panel.dataset.sobsPrevHeight = Math.max(280, Math.round(rect.height)) + 'px';

    if (panel.style.left && panel.style.top) {
      panel.dataset.sobsPrevMode = 'floating';
      panel.dataset.sobsPrevLeft = Math.round(rect.left) + 'px';
      panel.dataset.sobsPrevTop = Math.round(rect.top) + 'px';
      panel.dataset.sobsPrevRight = 'auto';
      panel.dataset.sobsPrevBottom = 'auto';
    } else {
      panel.dataset.sobsPrevMode = 'anchored';
      panel.dataset.sobsPrevLeft = '';
      panel.dataset.sobsPrevTop = '';
      panel.dataset.sobsPrevRight = panel.style.right || computed.right || '';
      panel.dataset.sobsPrevBottom = panel.style.bottom || computed.bottom || '';
    }
  }

  function setExpandedState(expanded) {
    var wasExpanded = panel.classList.contains('expanded');
    if (expanded === wasExpanded) {
      return;
    }

    panel.classList.toggle('expanded', expanded);

    if (expanded) {
      snapshotPanelGeometryForRestore();
      applyExpandedBounds();
    } else {
      panel.style.width = panel.dataset.sobsPrevWidth || '';
      panel.style.height = panel.dataset.sobsPrevHeight || '';
      var mode = String(panel.dataset.sobsPrevMode || 'anchored');
      if (mode === 'floating') {
        panel.style.left = panel.dataset.sobsPrevLeft || '';
        panel.style.top = panel.dataset.sobsPrevTop || '';
        panel.style.right = 'auto';
        panel.style.bottom = 'auto';
      } else {
        panel.style.left = '';
        panel.style.top = '';
        panel.style.right = panel.dataset.sobsPrevRight || '';
        panel.style.bottom = panel.dataset.sobsPrevBottom || '';
      }
      clampPanelSize(true);
      if (mode === 'floating' && panel.style.left && panel.style.top) {
        clampPanelPosition(true);
      }
    }
    if (!expandBtn) {
      return;
    }
    expandBtn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    expandBtn.setAttribute('aria-label', expanded ? 'Collapse AI helper' : 'Expand AI helper');
    expandBtn.setAttribute('title', expanded ? 'Collapse' : 'Expand');
    var icon = expandBtn.querySelector('i');
    if (icon) {
      icon.className = expanded ? 'bi bi-arrows-angle-contract' : 'bi bi-arrows-angle-expand';
    }
    if (expanded) {
      applyExpandedBounds();
    }
  }

  function toggleExpanded() {
    setExpandedState(!panel.classList.contains('expanded'));
  }

  function toggleHistory() {
    panel.classList.toggle('history-collapsed');
    syncPanelHeaderDensity();
  }

  function togglePanel() {
    panel.classList.toggle('open');
    if (panel.classList.contains('open')) {
      if (panel.style.left && panel.style.top) {
        clampPanelPosition();
      }
      syncPanelHeaderDensity();
      inputEl.focus();
      if (!messagesEl.hasChildNodes()) {
        addMsg('assistant', 'Hi! I\'m your SOBS observability assistant. I can help you understand logs, traces, metrics, errors, and more on this page. What would you like to know?', null);
      }
      if (!historyLoaded) {
        loadChatHistory();
      }
      syncActiveChatLabelFromHistory();
    }
  }

  // ===== Paged history state =====
  var historySearchEl = document.getElementById('sobsAiHistorySearchInput');
  var historySentinelEl = document.getElementById('sobsAiHistorySentinel');
  var historyState = { offset: 0, q: '', loading: false, hasMore: true };
  var historyIntersectionObserver = null;
  var historySearchTimer = null;

  function _historyPageSize() {
    // Estimate how many items fit in the visible list height.
    // Each item is ~54px (2-line title+meta + padding + gap).
    var listH = historyListEl ? historyListEl.clientHeight : 0;
    var itemH = 54;
    // Try to measure an existing item for accuracy.
    var existing = historyListEl && historyListEl.querySelector('.sobs-ai-history-item');
    if (existing && existing.offsetHeight > 0) {
      itemH = existing.offsetHeight + 4; // +4 for gap
    }
    var visible = listH > 0 ? Math.floor(listH / itemH) : 10;
    // Fetch 1.5x what's visible so the list fills without an immediate second request, min 5 max 100.
    return Math.max(5, Math.min(Math.ceil(visible * 1.5), 100));
  }

  function _buildHistoryItem(chat) {
    var item = document.createElement('button');
    item.type = 'button';
    item.dataset.chatId = String(chat.chat_id || '');
    item.className = 'sobs-ai-history-item' + (String(chat.chat_id || '') === currentChatId ? ' active' : '');
    var title = document.createElement('div');
    title.className = 'sobs-ai-history-title';
    title.textContent = String(chat.label || 'Chat');
    var meta = document.createElement('div');
    meta.className = 'sobs-ai-history-meta';
    meta.textContent = formatRelativeTime(chat.last_ts) + ' • ' + String(chat.turn_count || 0) + ' turns';
    item.appendChild(title);
    item.appendChild(meta);
    item.addEventListener('click', function () {
      loadChatConversation(String(chat.chat_id || ''));
    });
    return item;
  }

  function _appendHistoryItems(chats) {
    if (!historyListEl || !historySentinelEl) return;
    (chats || []).forEach(function (chat) {
      // insert before sentinel so new items appear above it
      historyListEl.insertBefore(_buildHistoryItem(chat), historySentinelEl);
      // accumulate into cache for label sync
      if (!historyListEl._cachedChats) historyListEl._cachedChats = [];
      historyListEl._cachedChats.push(chat);
    });
  }

  function refreshHistoryActiveState() {
    if (!historyListEl) return;
    historyListEl.querySelectorAll('.sobs-ai-history-item').forEach(function (el) {
      el.classList.toggle('active', el.dataset.chatId === currentChatId);
    });
  }

  async function _fetchHistoryPage() {
    if (historyState.loading || !historyState.hasMore) return;
    historyState.loading = true;
    // show a loading indicator inside sentinel
    var loadingEl = document.createElement('div');
    loadingEl.className = 'sobs-ai-history-loading';
    loadingEl.textContent = '…';
    if (historySentinelEl) historySentinelEl.appendChild(loadingEl);
    try {
      var url = new URL('/api/ai/helper/chats', window.location.origin);
      url.searchParams.set('page', window.location.pathname || '/');
      url.searchParams.set('offset', String(historyState.offset));
      url.searchParams.set('limit', String(_historyPageSize()));
      if (historyState.q) url.searchParams.set('q', historyState.q);
      var resp = await fetch(url.toString());
      var data = await resp.json();
      if (!resp.ok || !data.ok) return;
      historyLoaded = true;
      _appendHistoryItems(data.chats || []);
      historyState.offset += (data.chats || []).length;
      historyState.hasMore = !!data.has_more;
      syncActiveChatLabelFromHistory();
    } catch (_err) {
      // ignore
    } finally {
      if (loadingEl.parentNode) loadingEl.parentNode.removeChild(loadingEl);
      historyState.loading = false;
    }
  }

  function _resetAndLoadHistory() {
    if (!historyListEl || !historySentinelEl) return;
    // remove all history items (keep sentinel)
    Array.from(historyListEl.querySelectorAll('.sobs-ai-history-item')).forEach(function (el) {
      el.parentNode.removeChild(el);
    });
    historyListEl._cachedChats = [];
    historyState.offset = 0;
    historyState.hasMore = true;
    historyState.loading = false;
    _fetchHistoryPage();
  }

  function loadChatHistory() {
    _resetAndLoadHistory();
  }

  // IntersectionObserver: load next page when sentinel scrolls into view
  if (window.IntersectionObserver && historySentinelEl && historyListEl) {
    historyIntersectionObserver = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting && historyState.hasMore && !historyState.loading) {
        _fetchHistoryPage();
      }
    }, { root: historyListEl, threshold: 0.1 });
    historyIntersectionObserver.observe(historySentinelEl);
  }

  // Debounced search
  if (historySearchEl) {
    historySearchEl.addEventListener('input', function () {
      clearTimeout(historySearchTimer);
      historySearchTimer = setTimeout(function () {
        historyState.q = (historySearchEl.value || '').trim().toLowerCase();
        _resetAndLoadHistory();
      }, 300);
    });
  }

  function syncActiveChatLabelFromHistory() {
    var chats = (historyListEl && historyListEl._cachedChats) || [];
    var found = null;
    for (var i = 0; i < chats.length; i += 1) {
      if (String(chats[i].chat_id || '') === currentChatId) {
        found = chats[i];
        break;
      }
    }
    if (found) {
      setActiveChatLabel(String(found.label || 'Chat'));
    } else if (currentChatId) {
      setActiveChatLabel('Chat');
    } else {
      setActiveChatLabel('');
    }
  }

  async function loadChatConversation(chatId) {
    if (!chatId) return;
    try {
      var url = new URL('/api/ai/helper/chats' + '/' + encodeURIComponent(chatId), window.location.origin);
      var resp = await fetch(url.toString());
      var data = await resp.json();
      if (!resp.ok || !data.ok) return;
      while (messagesEl.firstChild) { messagesEl.removeChild(messagesEl.firstChild); }
      (data.messages || []).forEach(function (msg) {
        if (String(msg.kind || 'message') === 'tool') {
          addToolCard(msg, {historical: true});
          return;
        }
        addMsg(String(msg.role || 'assistant'), String(msg.text || ''), String(msg.ts || ''), {
          turnId: String(msg.turn_id || ''),
          chatId: String(data.chat_id || chatId),
          retryQuestion: String(msg.question || ''),
          copyText: String(msg.role || '') === 'assistant' ? String(msg.text || '') : ''
        });
      });
      currentChatId = String(data.chat_id || chatId);
      refreshHistoryActiveState();
      syncActiveChatLabelFromHistory();
      messagesEl.scrollTop = messagesEl.scrollHeight;
      syncPanelHeaderDensity();
      inputEl.focus();
    } catch (_err) {
      // ignore load failures
    }
  }

  async function loadCapabilities() {
    try {
      var capUrl = new URL('/api/ai/helper/capabilities', window.location.origin);
      capUrl.searchParams.set('page', window.location.pathname || '/logs');
      var r = await fetch(capUrl.toString());
      var data = await r.json();
      if (!data || !data.ok) {
        return;
      }
      supportsThinking = !!data.supports_thinking;
      if (thinkingWrapEl) {
        thinkingWrapEl.classList.toggle('active', supportsThinking);
      }
      if (supportsThinking && thinkingLevelEl) {
        thinkingLevelEl.value = String(data.default_thinking_level || 'off');
      }
    } catch (_err) {
      if (thinkingWrapEl) {
        thinkingWrapEl.classList.remove('active');
      }
    }
  }

  function saveChatState() {
    try {
      var hasCustomPosition = !!(panel.style.left && panel.style.top);
      var hasCustomSize = !!(panel.style.width || panel.style.height);
      var state = {
        path: window.location.pathname,
        query: window.location.search,
        isOpen: panel.classList.contains('open'),
        isExpanded: panel.classList.contains('expanded'),
        messagesHtml: stripAssistantMeta(messagesEl.innerHTML),
        statusHtml: statusEl ? statusEl.innerHTML : '',
        statusVisible: statusEl ? statusEl.classList.contains('visible') : false,
        isHistoryCollapsed: panel.classList.contains('history-collapsed'),
        chatId: currentChatId,
        thinkingLevel: thinkingLevelEl ? thinkingLevelEl.value : 'off',
        hasCustomPosition: hasCustomPosition,
        panelLeft: hasCustomPosition ? panel.style.left : '',
        panelTop: hasCustomPosition ? panel.style.top : '',
        hasCustomSize: hasCustomSize,
        panelWidth: hasCustomSize ? panel.style.width : '',
        panelHeight: hasCustomSize ? panel.style.height : '',
        savedAt: Date.now()
      };
      window.sessionStorage.setItem(chatStateKey, JSON.stringify(state));
    } catch (_err) {
      // Ignore storage errors in constrained browser modes.
    }
  }

  function setAiLayerBehindModal(behind) {
    panel.classList.toggle('behind-modal', !!behind);
    btn.classList.toggle('behind-modal', !!behind);
  }

  function syncAiLayerWithModals() {
    setAiLayerBehindModal(!!document.querySelector('.modal.show'));
  }

  function shouldPersistAiState() {
    return panel.classList.contains('open');
  }

  function saveAiStateForNavigation() {
    if (!shouldPersistAiState()) {
      return;
    }
    saveChatState();
  }

  function restoreChatState() {
    try {
      var raw = window.sessionStorage.getItem(chatStateKey);
      if (!raw) return;
      var state = JSON.parse(raw);
      window.sessionStorage.removeItem(chatStateKey);
      if (!state || !state.messagesHtml) return;
      if (Date.now() - Number(state.savedAt || 0) > 5 * 60 * 1000) return;

      messagesEl.innerHTML = stripAssistantMeta(String(state.messagesHtml || ''));
      if (statusEl) {
        statusEl.innerHTML = String(state.statusHtml || '');
        statusEl.classList.toggle('visible', !!state.statusVisible && !!state.statusHtml);
      }
      panel.classList.toggle('open', !!state.isOpen);
      setExpandedState(!!state.isExpanded);
      panel.classList.toggle('history-collapsed', !!state.isHistoryCollapsed);
      if (state.hasCustomSize) {
        if (state.panelWidth) {
          panel.style.width = String(state.panelWidth);
        }
        if (state.panelHeight) {
          panel.style.height = String(state.panelHeight);
        }
        clampPanelSize();
      }
      if (state.hasCustomPosition && state.panelLeft && state.panelTop) {
        panel.style.left = String(state.panelLeft);
        panel.style.top = String(state.panelTop);
        panel.style.right = 'auto';
        panel.style.bottom = 'auto';
        clampPanelPosition();
      }
      currentChatId = String(state.chatId || '');
      syncActiveChatLabelFromHistory();
      if (thinkingLevelEl && state.thinkingLevel) {
        thinkingLevelEl.value = String(state.thinkingLevel);
      }
      messagesEl.scrollTop = messagesEl.scrollHeight;
      syncPanelHeaderDensity();
    } catch (_err) {
      // Ignore malformed state.
    }
  }

  function clearChat() {
    if (currentAbortController) {
      currentAbortController.abort();
      currentAbortController = null;
    }
    while (messagesEl.firstChild) { messagesEl.removeChild(messagesEl.firstChild); }
    if (statusEl) { statusEl.textContent = ''; statusEl.classList.remove('visible'); }
    currentChatId = '';
    setActiveChatLabel('');
    inputEl.value = '';
    inputEl.style.height = '';
    addMsg('assistant', 'Hi! I\'m your SOBS observability assistant. I can help you understand logs, traces, metrics, errors, and more on this page. What would you like to know?', null);
    loadChatHistory();
    inputEl.focus();
  }

  function clamp(value, min, max) {
    return Math.min(Math.max(value, min), max);
  }

  function clampPanelSize(preferInlineSize) {
    if (panel.classList.contains('expanded')) {
      applyExpandedBounds();
      return;
    }
    var minW = 320;
    var minH = 280;
    var maxW = Math.max(minW, window.innerWidth - 8);
    var maxH = Math.max(minH, window.innerHeight - 8);

    var width = panel.offsetWidth;
    var height = panel.offsetHeight;
    if (preferInlineSize) {
      var inlineW = Number.parseFloat(panel.style.width || '');
      var inlineH = Number.parseFloat(panel.style.height || '');
      if (!Number.isNaN(inlineW) && inlineW > 0) {
        width = inlineW;
      }
      if (!Number.isNaN(inlineH) && inlineH > 0) {
        height = inlineH;
      }
    }

    var nextW = clamp(width, minW, maxW);
    var nextH = clamp(height, minH, maxH);
    panel.style.width = nextW + 'px';
    panel.style.height = nextH + 'px';
    syncPanelHeaderDensity();
  }

  function applyExpandedBounds() {
    var margin = 10;
    var left = margin;
    var top = margin;
    var rightEdge = window.innerWidth - margin;
    var bottomEdge = window.innerHeight - margin;
    var sidebar = document.getElementById('sbSidebar');

    if (sidebar) {
      var sbRect = sidebar.getBoundingClientRect();
      var sidebarVisible = sbRect.width > 1 && sbRect.right > 0 && sbRect.left < window.innerWidth;
      if (sidebarVisible) {
        left = Math.max(left, Math.floor(sbRect.right + margin));
      }
    }

    var width = Math.max(320, rightEdge - left);
    var height = Math.max(280, bottomEdge - top);

    panel.style.left = left + 'px';
    panel.style.top = top + 'px';
    panel.style.right = 'auto';
    panel.style.bottom = 'auto';
    panel.style.width = width + 'px';
    panel.style.height = height + 'px';
    syncPanelHeaderDensity();
  }

  function clampPanelPosition(preferInlineSize) {
    if (!(panel.style.left && panel.style.top)) {
      return;
    }
    var rect = panel.getBoundingClientRect();
    var width = rect.width;
    var height = rect.height;
    if (preferInlineSize) {
      var inlineW = Number.parseFloat(panel.style.width || '');
      var inlineH = Number.parseFloat(panel.style.height || '');
      if (!Number.isNaN(inlineW) && inlineW > 0) {
        width = inlineW;
      }
      if (!Number.isNaN(inlineH) && inlineH > 0) {
        height = inlineH;
      }
    }
    var margin = 8;
    var maxLeft = Math.max(margin, window.innerWidth - width - margin);
    var maxTop = Math.max(margin, window.innerHeight - height - margin);
    var currentLeft = Number.parseFloat(panel.style.left) || margin;
    var currentTop = Number.parseFloat(panel.style.top) || margin;
    panel.style.left = clamp(currentLeft, margin, maxLeft) + 'px';
    panel.style.top = clamp(currentTop, margin, maxTop) + 'px';
    panel.style.right = 'auto';
    panel.style.bottom = 'auto';
    syncPanelHeaderDensity();
  }

  function initPanelDrag() {
    var header = document.getElementById('sobsAiPanelHeader');
    if (!header) {
      return;
    }
    var dragState = {
      active: false,
      pointerId: null,
      offsetX: 0,
      offsetY: 0,
    };

    function endDrag() {
      dragState.active = false;
      dragState.pointerId = null;
      panel.classList.remove('dragging');
    }

    header.addEventListener('pointerdown', function (event) {
      if (!panel.classList.contains('open')) {
        return;
      }
      if (event.button !== 0) {
        return;
      }
      var target = event.target;
      if (target && target.closest('button,select,input,textarea,a,label')) {
        return;
      }
      var rect = panel.getBoundingClientRect();
      dragState.active = true;
      dragState.pointerId = event.pointerId;
      dragState.offsetX = event.clientX - rect.left;
      dragState.offsetY = event.clientY - rect.top;
      panel.classList.add('dragging');
      if (typeof header.setPointerCapture === 'function') {
        header.setPointerCapture(event.pointerId);
      }
      event.preventDefault();
    });

    header.addEventListener('pointermove', function (event) {
      if (!dragState.active || event.pointerId !== dragState.pointerId) {
        return;
      }
      var rect = panel.getBoundingClientRect();
      var margin = 8;
      var maxLeft = Math.max(margin, window.innerWidth - rect.width - margin);
      var maxTop = Math.max(margin, window.innerHeight - rect.height - margin);
      var left = clamp(event.clientX - dragState.offsetX, margin, maxLeft);
      var top = clamp(event.clientY - dragState.offsetY, margin, maxTop);
      panel.style.left = left + 'px';
      panel.style.top = top + 'px';
      panel.style.right = 'auto';
      panel.style.bottom = 'auto';
    });

    header.addEventListener('pointerup', function (event) {
      if (dragState.active && event.pointerId === dragState.pointerId) {
        endDrag();
      }
    });

    header.addEventListener('pointercancel', endDrag);
  }

  function applyClientAction(clientAction, statusElRef) {
    if (!clientAction || !clientAction.type) {
      if (statusElRef) {
        statusElRef.textContent = 'No executable action returned';
      }
      return;
    }

    if (clientAction.type === 'navigate') {
      var navTarget = String(clientAction.target_page || window.location.pathname || '/logs');
      var navQuery = clientAction.query && typeof clientAction.query === 'object' ? clientAction.query : {};
      var navUrl = new URL(navTarget, window.location.origin);
      Object.keys(navQuery).forEach(function (key) {
        var value = String(navQuery[key] == null ? '' : navQuery[key]).trim();
        if (value) {
          navUrl.searchParams.set(String(key), value);
        } else {
          navUrl.searchParams.delete(String(key));
        }
      });
      if (statusElRef) {
        statusElRef.textContent = 'Navigating to ' + navTarget + '...';
      }
      saveChatState();
      window.location.href = navUrl.toString();
      return;
    }

    if (clientAction.type === 'open_modal') {
      var modalTarget = String(clientAction.target_page || window.location.pathname || '');
      if (modalTarget && modalTarget !== window.location.pathname) {
        if (statusElRef) {
          statusElRef.textContent = 'Navigating to ' + modalTarget + '...';
        }
        saveChatState();
        window.location.href = new URL(modalTarget, window.location.origin).toString();
        return;
      }
      var modalId = String(clientAction.modal_id || clientAction.modalId || '').replace(/^#/, '');
      var modalEl = modalId ? document.getElementById(modalId) : null;
      if (!modalEl || !window.bootstrap || !window.bootstrap.Modal) {
        if (statusElRef) {
          statusElRef.textContent = 'Modal not found: ' + (modalId || 'unknown');
        }
        return;
      }
      var modal = window.bootstrap.Modal.getOrCreateInstance(modalEl);
      setAiLayerBehindModal(true);
      modal.show();
      if (statusElRef) {
        statusElRef.textContent = 'Opened modal';
      }
      return;
    }

    if (clientAction.type === 'invoke_click') {
      var clickTarget = String(clientAction.target_page || window.location.pathname || '');
      if (clickTarget && clickTarget !== window.location.pathname) {
        if (statusElRef) {
          statusElRef.textContent = 'Navigating to ' + clickTarget + '...';
        }
        saveChatState();
        window.location.href = new URL(clickTarget, window.location.origin).toString();
        return;
      }
      var selector = String(clientAction.selector || '').trim();
      var elementId = String(clientAction.element_id || '').trim();
      var clickEl = null;
      if (selector) {
        clickEl = document.querySelector(selector);
      }
      if (!clickEl && elementId) {
        clickEl = document.getElementById(elementId);
      }
      if (!clickEl || typeof clickEl.click !== 'function') {
        if (statusElRef) {
          statusElRef.textContent = 'Clickable element not found';
        }
        return;
      }
      clickEl.click();
      if (statusElRef) {
        statusElRef.textContent = 'Action clicked';
      }
      return;
    }

    if (clientAction.type === 'submit_form') {
      var submitTarget = String(clientAction.target_page || window.location.pathname || '');
      if (submitTarget && submitTarget !== window.location.pathname) {
        if (statusElRef) {
          statusElRef.textContent = 'Navigating to ' + submitTarget + '...';
        }
        saveChatState();
        window.location.href = new URL(submitTarget, window.location.origin).toString();
        return;
      }
      var actionId = String(clientAction.action_id || '');
      var actionButton = actionId ? document.querySelector('[data-ai-action-id="' + actionId.replace(/"/g, '\\"') + '"]') : null;
      var formSelector = String(clientAction.form_selector || '').trim();
      var formId = String(clientAction.form_id || '').trim();
      var form = null;
      if (actionButton) {
        form = actionButton.closest('form');
      }
      if (!form && formSelector) {
        form = document.querySelector(formSelector);
      }
      if (!form && formId) {
        form = document.getElementById(formId);
      }
      if (!form && actionButton) {
        var actionModal = actionButton.closest('.modal');
        form = actionModal ? actionModal.querySelector('form') : null;
      }
      if (!form) {
        var openModal = document.querySelector('.modal.show');
        form = openModal ? openModal.querySelector('form') : null;
      }
      if (!form && actionId.indexOf('dashboard.chart.create') !== -1) {
        form = document.getElementById('chartEditorForm');
      }
      if (!form) {
        if (statusElRef) {
          statusElRef.textContent = 'Form not found for submit action';
        }
        return;
      }
      var fields = clientAction.fields && typeof clientAction.fields === 'object' ? clientAction.fields : {};
      Object.keys(fields).forEach(function (name) {
        var value = String(fields[name] == null ? '' : fields[name]);
        var field = form.querySelector('[name="' + String(name).replace(/"/g, '\\"') + '"]');
        if (!field) {
          return;
        }
        field.value = value;
        field.dispatchEvent(new Event('input', {bubbles: true}));
        field.dispatchEvent(new Event('change', {bubbles: true}));
      });
      if (statusElRef) {
        statusElRef.textContent = 'Submitting form...';
      }
      saveChatState();
      if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
      } else {
        form.submit();
      }
      return;
    }

    if (clientAction.type === 'apply_sql_filter') {
      var sqlWhere = String(clientAction.sql_where || '').trim();
      if (!sqlWhere) {
        var altSql = [
          clientAction.sql,
          clientAction.where,
          clientAction.filter,
          clientAction.expression,
          clientAction.query
        ];
        for (var si = 0; si < altSql.length; si += 1) {
          var candidate = altSql[si];
          if (typeof candidate === 'string' && candidate.trim()) {
            sqlWhere = candidate.trim();
            break;
          }
          if (candidate && typeof candidate === 'object') {
            var nested = String(candidate.sql_where || candidate.sql || candidate.where || '').trim();
            if (nested) {
              sqlWhere = nested;
              break;
            }
          }
        }
      }
      var targetPage = String(clientAction.target_page || window.location.pathname || '/logs');
      if (!sqlWhere) {
        if (statusElRef) {
          statusElRef.textContent = 'Skipped: empty SQL filter';
        }
        return;
      }

      if (targetPage === window.location.pathname) {
        var sqlInput = document.getElementById('sql-filter-input') || document.querySelector('input[name="sql"]');
        if (!sqlInput) {
          if (statusElRef) {
            statusElRef.textContent = 'No SQL filter input found on this page';
          }
          return;
        }
        sqlInput.value = sqlWhere;
        sqlInput.dispatchEvent(new Event('input', {bubbles: true}));
        sqlInput.dispatchEvent(new Event('change', {bubbles: true}));
        if (clientAction.submit) {
          var filterForm = sqlInput.form || document.querySelector('form[method="get"]');
          if (filterForm) {
            if (statusElRef) {
              statusElRef.textContent = 'Applying filter...';
            }
            saveChatState();
            if (typeof filterForm.requestSubmit === 'function') {
              filterForm.requestSubmit();
            } else {
              filterForm.submit();
            }
            return;
          }
        }
        if (statusElRef) {
          statusElRef.textContent = 'Filter updated in SQL input';
        }
        return;
      }

      var next = new URL(targetPage, window.location.origin);
      next.searchParams.set('sql', sqlWhere);
      if (statusElRef) {
        statusElRef.textContent = 'Navigating to ' + targetPage + ' with filter...';
      }
      saveChatState();
      window.location.href = next.toString();
      return;
    }

    if (clientAction.type === 'start_live_mode') {
      var liveTarget = String(clientAction.target_page || '/logs');
      if (liveTarget === window.location.pathname) {
        var liveBtn = document.querySelector('[data-ai-action-id="logs.live_mode.start"]');
        if (liveBtn && typeof liveBtn.click === 'function') {
          if (statusElRef) {
            statusElRef.textContent = 'Starting live mode...';
          }
          liveBtn.click();
          return;
        }
      }
      var liveUrl = new URL(liveTarget, window.location.origin);
      liveUrl.searchParams.set('live', '1');
      if (statusElRef) {
        statusElRef.textContent = 'Navigating to live mode...';
      }
      saveChatState();
      window.location.href = liveUrl.toString();
      return;
    }

    if (clientAction.type === 'apply_form_filters') {
      var filterTarget = String(clientAction.target_page || '');
      var filters = clientAction.filters && typeof clientAction.filters === 'object' ? clientAction.filters : {};
      var submit = !!clientAction.submit;

      if (!filterTarget) {
        if (statusElRef) {
          statusElRef.textContent = 'Missing target page for filter action';
        }
        return;
      }

      if (filterTarget === window.location.pathname) {
        var actionId = String(clientAction.action_id || '');
        var actionButton = actionId ? document.querySelector('[data-ai-action-id="' + actionId.replace(/"/g, '\\"') + '"]') : null;
        var filterForm = actionButton ? actionButton.closest('form') : document.querySelector('form[method="get"]');
        var appliedCount = 0;
        Object.keys(filters).forEach(function (name) {
          var value = String(filters[name] == null ? '' : filters[name]);
          var selector = '[name="' + String(name).replace(/"/g, '\\"') + '"]';
          var field = filterForm ? filterForm.querySelector(selector) : null;
          if (!field) {
            field = document.querySelector(selector);
          }
          if (!field) {
            return;
          }
          field.value = value;
          field.dispatchEvent(new Event('input', {bubbles: true}));
          field.dispatchEvent(new Event('change', {bubbles: true}));
          appliedCount += 1;
        });

        if (appliedCount === 0) {
          if (statusElRef) {
            statusElRef.textContent = 'No matching filter inputs found on this page';
          }
          return;
        }

        if (submit && filterForm) {
          if (statusElRef) {
            statusElRef.textContent = 'Applying filters...';
          }
          saveChatState();
          if (typeof filterForm.requestSubmit === 'function') {
            filterForm.requestSubmit();
          } else {
            filterForm.submit();
          }
          return;
        }

        if (statusElRef) {
          statusElRef.textContent = 'Updated filter inputs';
        }
        return;
      }

      var filterUrl = new URL(filterTarget, window.location.origin);
      Object.keys(filters).forEach(function (name) {
        var value = String(filters[name] == null ? '' : filters[name]).trim();
        if (value) {
          filterUrl.searchParams.set(String(name), value);
        } else {
          filterUrl.searchParams.delete(String(name));
        }
      });
      if (statusElRef) {
        statusElRef.textContent = 'Navigating to ' + filterTarget + ' with filters...';
      }
      saveChatState();
      window.location.href = filterUrl.toString();
      return;
    }

    if (statusElRef) {
      statusElRef.textContent = 'Unsupported action type: ' + String(clientAction.type);
    }
  }

  async function executeToolAction(tool, statusElRef, confirmed) {
    if (!tool || !tool.action_token) {
      if (statusElRef) {
        statusElRef.textContent = 'Action token unavailable';
      }
      return;
    }
    if (statusElRef) {
      statusElRef.textContent = 'Authorizing action...';
    }

    try {
      var execResp = await fetch('/api/ai/helper/actions/execute', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          action_token: String(tool.action_token || ''),
          confirm: !!confirmed
        })
      });
      var execData = await execResp.json();
      if (!execResp.ok || !execData.ok) {
        if (statusElRef) {
          statusElRef.textContent = String(execData.error || 'Action execution failed');
        }
        return;
      }
      applyClientAction(execData.client_action || null, statusElRef);
    } catch (err) {
      if (statusElRef) {
        statusElRef.textContent = 'Action execution failed: ' + String(err);
      }
    }
  }

  function addToolCard(tool, options) {
    var opts = options || {};
    var card = document.createElement('div');
    card.className = 'sobs-ai-tool-card' + (opts.historical ? ' historical' : '');
    card.dataset.toolPayload = encodeDatasetJson(tool);

    var title = document.createElement('div');
    title.className = 'sobs-ai-tool-title';
    title.innerHTML = '<i class="bi bi-sliders"></i><span>AI Action</span>';
    card.appendChild(title);

    var summary = document.createElement('div');
    summary.textContent = String(tool.summary || 'Proposed action');
    card.appendChild(summary);

    if (tool.action && tool.action.type === 'apply_sql_filter') {
      var code = document.createElement('div');
      code.className = 'sobs-ai-tool-code';
      code.textContent = String(tool.action.sql_where || '');
      card.appendChild(code);
    }

    var status = document.createElement('div');
    status.className = 'sobs-ai-tool-status';
    status.textContent = String(tool.status_label || (tool.unsupported
      ? 'Not available in this page action manifest'
      : (tool.requires_confirmation ? 'Awaiting confirmation' : 'Queued')));

    var actions = document.createElement('div');
    actions.className = 'sobs-ai-tool-actions';

    if (!opts.historical && !tool.unsupported && tool.requires_confirmation) {
      var confirmBtn = document.createElement('button');
      confirmBtn.className = 'btn btn-sm btn-primary';
      confirmBtn.type = 'button';
      confirmBtn.textContent = 'Confirm';
      confirmBtn.setAttribute('data-sobs-ai-tool-action', 'confirm');

      var cancelBtn = document.createElement('button');
      cancelBtn.className = 'btn btn-sm btn-outline-secondary';
      cancelBtn.type = 'button';
      cancelBtn.textContent = 'Dismiss';
      cancelBtn.setAttribute('data-sobs-ai-tool-action', 'dismiss');

      actions.appendChild(confirmBtn);
      actions.appendChild(cancelBtn);
    }

    actions.appendChild(status);
    card.appendChild(actions);
    messagesEl.appendChild(card);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return {card: card, status: status};
  }

  btn.addEventListener('click', togglePanel);
  closeBtn.addEventListener('click', function () { panel.classList.remove('open'); });
  if (newChatBtn) {
    newChatBtn.addEventListener('click', clearChat);
  }
  if (toggleHistoryBtn) {
    toggleHistoryBtn.addEventListener('click', toggleHistory);
  }
  if (expandBtn) {
    expandBtn.addEventListener('click', toggleExpanded);
  }
  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!(target instanceof Element)) {
      return;
    }
    var link = target.closest('a[href]');
    if (!link) {
      return;
    }
    if (link.hasAttribute('download')) {
      return;
    }
    var rel = String(link.getAttribute('rel') || '').toLowerCase();
    if (rel.indexOf('external') !== -1) {
      return;
    }
    var href = String(link.getAttribute('href') || '').trim();
    if (!href || href.charAt(0) === '#') {
      return;
    }
    if (href.toLowerCase().indexOf('javascript:') === 0) {
      return;
    }
    var targetAttr = String(link.getAttribute('target') || '').trim().toLowerCase();
    if (targetAttr && targetAttr !== '_self') {
      return;
    }
    saveAiStateForNavigation();
  }, true);
  document.addEventListener('submit', function (_event) {
    saveAiStateForNavigation();
  }, true);
  window.addEventListener('pagehide', function () {
    saveAiStateForNavigation();
  });
  document.addEventListener('show.bs.modal', function (_evt) {
    setAiLayerBehindModal(true);
  });
  document.addEventListener('hidden.bs.modal', function (_evt) {
    syncAiLayerWithModals();
  });
  messagesEl.addEventListener('click', async function (event) {
    var target = event.target;
    if (!(target instanceof Element)) {
      return;
    }

    var msgButton = target.closest('[data-sobs-ai-msg-action]');
    if (msgButton) {
      var msgEl = msgButton.closest('.sobs-ai-msg');
      if (!msgEl) {
        return;
      }
      var msgAction = String(msgButton.getAttribute('data-sobs-ai-msg-action') || '');
      if (msgAction === 'retry') {
        await sendQuestionText(String(msgEl.dataset.retryQuestion || ''));
      } else if (msgAction === 'copy') {
        var copyText = String(msgEl.dataset.copyText || '').trim();
        if (!copyText) {
          return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(copyText);
          flashMessageActionButton(msgButton, 'Copied');
        } else {
          window.prompt('Copy response:', copyText);
        }
      } else if (msgAction === 'feedback') {
        await submitAssistantFeedback(msgEl, msgButton);
      }
      return;
    }

    var toolButton = target.closest('[data-sobs-ai-tool-action]');
    if (!toolButton) {
      return;
    }
    var card = toolButton.closest('.sobs-ai-tool-card');
    if (!card) {
      return;
    }
    var toolPayload = decodeDatasetJson(card.dataset.toolPayload || '');
    var statusNode = card.querySelector('.sobs-ai-tool-status');
    if (!toolPayload) {
      if (statusNode) {
        statusNode.textContent = 'Action details unavailable';
      }
      return;
    }
    var toolAction = String(toolButton.getAttribute('data-sobs-ai-tool-action') || '');
    if (toolAction === 'dismiss') {
      removeNode(card);
      return;
    }
    if (toolAction === 'confirm') {
      executeToolAction(toolPayload, statusNode, true);
    }
  });
  initPanelDrag();
  window.addEventListener('resize', function () {
    clampPanelSize();
    clampPanelPosition();
    syncPanelHeaderDensity();
  });
  restoreChatState();
  loadCapabilities();
  loadChatHistory();
  syncPanelHeaderDensity();

  function addMsg(role, text, ts, options) {
    var el = document.createElement('div');
    el.className = 'sobs-ai-msg ' + role;
    if (role === 'assistant') {
      el.innerHTML = renderAssistantMarkdown(text);
    } else {
      el.textContent = text;
    }
    syncMessageMeta(el, ts, Object.assign({
      role: role,
      copyText: role === 'assistant' ? stripAssistantMeta(text) : ''
    }, options || {}));
    messagesEl.appendChild(el);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return el;
  }

  function addThinkingMsg() {
    var wrap = document.createElement('div');
    wrap.className = 'sobs-ai-thinking-wrap';
    wrap.setAttribute('aria-label', 'Assistant is thinking');
    wrap.innerHTML = ''
      + '<div class="sobs-ai-msg assistant thinking-msg" aria-hidden="true">'
      + '<div class="sobs-ai-thinking">'
      + '<div class="sobs-ai-thinking-dots">'
      + '<span class="sobs-ai-thinking-dot"></span>'
      + '<span class="sobs-ai-thinking-dot"></span>'
      + '<span class="sobs-ai-thinking-dot"></span>'
      + '</div>'
      + '</div>'
      + '</div>'
      + '<div class="sobs-ai-thinking-label">Thinking</div>';
    messagesEl.appendChild(wrap);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return wrap;
  }

  function sanitizeAssistantHtml(html) {
    if (!window.DOMPurify) {
      return '';
    }
    return window.DOMPurify.sanitize(html, {
      ALLOWED_URI_REGEXP: /^(?:(?:https?):|[^a-z]|[a-z+.-]+(?:[^a-z+.-:]|$))/i,
      FORBID_TAGS: [
        'style',
        'script',
        'iframe',
        'object',
        'embed',
        'form',
        'input',
        'button',
        'select',
        'textarea',
        'label'
      ]
    });
  }

  function hardenRenderedLinks(container) {
    var links = container.querySelectorAll('a[href]');
    links.forEach(function (link) {
      var href = (link.getAttribute('href') || '').trim();
      if (!/^https?:\/\//i.test(href)) {
        link.removeAttribute('href');
        return;
      }
      link.setAttribute('target', '_blank');
      link.setAttribute('rel', 'noopener noreferrer');
    });
  }

  function renderAssistantMarkdown(text) {
    var source = stripAssistantMeta(String(text || ''));
    if (!mdRenderer || !window.DOMPurify) {
      var fallback = document.createElement('div');
      fallback.textContent = source;
      return fallback.innerHTML;
    }
    var rawHtml = mdRenderer.render(source);
    var sanitized = sanitizeAssistantHtml(rawHtml);
    var probe = document.createElement('div');
    probe.innerHTML = sanitized;
    hardenRenderedLinks(probe);
    return probe.innerHTML;
  }

  function addThinkingTraceLink(msgEl, donePayload) {
    if (!msgEl || !donePayload) return;
    var modelStats = donePayload.model_stats || {};
    var thinkingTokens = Number(modelStats.thinking_tokens || 0);
    var logsUrl = String(donePayload.turn_logs_url || '');
    if (!(thinkingTokens > 0) || !logsUrl) {
      return;
    }
    var existing = msgEl.querySelector('.sobs-ai-thinking-trace');
    if (existing) {
      return;
    }
    var link = document.createElement('a');
    link.className = 'sobs-ai-thinking-trace';
    link.href = logsUrl;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.title = 'View model thinking telemetry for this turn';
    link.innerHTML = '<i class="bi bi-lightbulb"></i><span>Thinking trace</span>';
    msgEl.appendChild(link);
  }

  function appendMsgTimestamp(msgEl, ts) {
    if (!msgEl || !ts) return;
    syncMessageMeta(msgEl, ts, {
      role: getMessageRole(msgEl),
      turnId: msgEl.dataset.turnId,
      chatId: msgEl.dataset.chatId,
      retryQuestion: msgEl.dataset.retryQuestion,
      copyText: msgEl.dataset.copyText,
      feedbackSaved: msgEl.dataset.feedbackSaved === '1'
    });
  }

  function tps(stats) {
    if (!stats || !stats.elapsed_ms || stats.elapsed_ms <= 0) return '—';
    var t = (stats.completion_tokens / (stats.elapsed_ms / 1000)).toFixed(1);
    return t + ' t/s';
  }

  function updateStatus(guardStats, modelStats) {
    if (!statusEl) return;
    var parts = [];
    if (guardStats && (guardStats.prompt_tokens || guardStats.completion_tokens || guardStats.elapsed_ms)) {
      parts.push(
        '<span class="stat-group">'
        + '<span class="stat-label">Guard</span>'
        + '<span title="tokens in">' + (guardStats.prompt_tokens || 0) + '↑</span>'
        + '<span title="tokens out">' + (guardStats.completion_tokens || 0) + '↓</span>'
        + '<span title="tokens per second">' + tps(guardStats) + '</span>'
        + '</span>'
      );
    }
    if (modelStats && (modelStats.prompt_tokens || modelStats.completion_tokens || modelStats.elapsed_ms)) {
      if (parts.length) parts.push('<span class="stat-sep">·</span>');
      parts.push(
        '<span class="stat-group">'
        + '<span class="stat-label">Model</span>'
        + '<span title="tokens in">' + (modelStats.prompt_tokens || 0) + '↑</span>'
        + '<span title="tokens out">' + (modelStats.completion_tokens || 0) + '↓</span>'
        + '<span title="tokens per second">' + tps(modelStats) + '</span>'
        + '</span>'
      );
    }
    if (parts.length) {
      statusEl.innerHTML = parts.join('');
      statusEl.classList.add('visible');
    }
  }

  function gatherContext() {
    var ctx = {};
    var params = new URLSearchParams(window.location.search);
    params.forEach(function(v, k) { if (v) ctx[k] = v; });
    return ctx;
  }

  function removeNode(node) {
    if (node && node.parentNode) {
      node.parentNode.removeChild(node);
    }
  }

  function getMessageRole(msgEl) {
    if (!msgEl || !msgEl.classList) {
      return 'assistant';
    }
    if (msgEl.classList.contains('user')) {
      return 'user';
    }
    if (msgEl.classList.contains('assistant')) {
      return 'assistant';
    }
    return 'assistant';
  }

  function buildMessageActionButton(label, iconClass, actionName) {
    var button = document.createElement('button');
    button.type = 'button';
    button.className = 'btn btn-sm btn-link sobs-ai-msg-action';
    button.setAttribute('data-sobs-ai-msg-action', actionName);
    button.setAttribute('aria-label', label);
    button.setAttribute('title', label);
    button.innerHTML = '<i class="' + iconClass + '"></i><span>' + label + '</span>';
    return button;
  }

  function setMessageActionButtonLabel(button, label) {
    if (!button) return;
    var labelEl = button.querySelector('span');
    if (labelEl) {
      labelEl.textContent = label;
    }
  }

  function flashMessageActionButton(button, label) {
    if (!button) return;
    var original = button.dataset.originalLabel;
    if (!original) {
      var labelEl = button.querySelector('span');
      original = labelEl ? labelEl.textContent : '';
      button.dataset.originalLabel = original;
    }
    setMessageActionButtonLabel(button, label);
    window.setTimeout(function () {
      setMessageActionButtonLabel(button, button.dataset.originalLabel || original || '');
    }, 1200);
  }

  function syncMessageMeta(msgEl, ts, options) {
    if (!msgEl) return;
    var opts = options || {};
    var role = String(opts.role || getMessageRole(msgEl));
    if (opts.turnId !== undefined) {
      msgEl.dataset.turnId = String(opts.turnId || '');
    }
    if (opts.chatId !== undefined) {
      msgEl.dataset.chatId = String(opts.chatId || '');
    }
    if (opts.retryQuestion !== undefined) {
      msgEl.dataset.retryQuestion = String(opts.retryQuestion || '');
    }
    if (opts.copyText !== undefined) {
      msgEl.dataset.copyText = String(opts.copyText || '');
    }
    if (opts.feedbackSaved) {
      msgEl.dataset.feedbackSaved = '1';
    }

    var metaEl = msgEl.querySelector('.sobs-ai-msg-meta');
    if (!metaEl) {
      metaEl = document.createElement('div');
      metaEl.className = 'sobs-ai-msg-meta';
      msgEl.appendChild(metaEl);
    }
    metaEl.innerHTML = '';

    if (role === 'assistant') {
      var actionsEl = document.createElement('div');
      actionsEl.className = 'sobs-ai-msg-actions';
      if (msgEl.dataset.retryQuestion) {
        actionsEl.appendChild(buildMessageActionButton('Retry', 'bi bi-arrow-clockwise', 'retry'));
      }
      if (msgEl.dataset.copyText || String(msgEl.textContent || '').trim()) {
        actionsEl.appendChild(buildMessageActionButton('Copy', 'bi bi-clipboard', 'copy'));
      }
      if (msgEl.dataset.turnId) {
        var feedbackBtn = buildMessageActionButton('Feedback', 'bi bi-chat-left-text', 'feedback');
        if (msgEl.dataset.feedbackSaved === '1') {
          feedbackBtn.disabled = true;
          setMessageActionButtonLabel(feedbackBtn, 'Saved');
        }
        actionsEl.appendChild(feedbackBtn);
      }
      if (actionsEl.childNodes.length) {
        metaEl.appendChild(actionsEl);
      }
    }

    var rel = formatRelativeTime(ts);
    if (rel) {
      var timeEl = document.createElement('span');
      timeEl.className = 'sobs-ai-msg-time';
      timeEl.textContent = rel;
      metaEl.appendChild(timeEl);
    }
  }

  function encodeDatasetJson(value) {
    try {
      return encodeURIComponent(JSON.stringify(value || {}));
    } catch (_err) {
      return '';
    }
  }

  function decodeDatasetJson(value) {
    if (!value) return null;
    try {
      return JSON.parse(decodeURIComponent(String(value)));
    } catch (_err) {
      return null;
    }
  }

  async function submitAssistantFeedback(msgEl, button) {
    if (!msgEl || !button) return;
    var note = window.prompt('Add feedback for this assistant response:', '');
    if (note == null) {
      return;
    }
    note = String(note).trim();
    if (!note) {
      return;
    }

    button.disabled = true;
    setMessageActionButtonLabel(button, 'Saving');
    try {
      var resp = await fetch('/api/ai/helper/feedback', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          chat_id: String(msgEl.dataset.chatId || currentChatId || ''),
          turn_id: String(msgEl.dataset.turnId || ''),
          note: note,
          page: window.location.pathname || '/logs'
        })
      });
      var data = await resp.json();
      if (!resp.ok || !data.ok) {
        throw new Error(String(data.error || 'Feedback could not be saved'));
      }
      msgEl.dataset.feedbackSaved = '1';
      setMessageActionButtonLabel(button, 'Saved');
    } catch (err) {
      button.disabled = false;
      setMessageActionButtonLabel(button, 'Feedback');
      addMsg('error-msg', 'Feedback error: ' + String(err), new Date().toISOString());
    }
  }

  function addStreamingAssistantMsg() {
    var el = document.createElement('div');
    el.className = 'sobs-ai-msg assistant';
    el.textContent = '';
    messagesEl.appendChild(el);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return el;
  }

  function stripAssistantMeta(text) {
    var cleaned = String(text || '')
      .replace(/<assistant_meta\b[^>]*>[\s\S]*?<\/assistant_meta>/gi, '')
      .replace(/&lt;\s*assistant_meta\b(?:[\s\S]*?)&gt;[\s\S]*?&lt;\s*\/assistant_meta\s*&gt;/gi, '');
    var rawOpenIndex = cleaned.search(/<assistant_meta\b[^>]*>/i);
    var escapedOpenIndex = cleaned.search(/&lt;\s*assistant_meta\b(?:[\s\S]*?)&gt;/i);
    var cutIndex = -1;
    if (rawOpenIndex >= 0) {
      cutIndex = rawOpenIndex;
    }
    if (escapedOpenIndex >= 0 && (cutIndex === -1 || escapedOpenIndex < cutIndex)) {
      cutIndex = escapedOpenIndex;
    }
    if (cutIndex >= 0) {
      cleaned = cleaned.slice(0, cutIndex);
    }
    return cleaned.trim();
  }

  function stripAssistantMetaPreview(text) {
    return stripAssistantMeta(text).trimEnd();
  }

  function setStreamingText(el, text, finalize) {
    if (!el) return;
    var cleaned = stripAssistantMeta(text);
    if (finalize) {
      el.innerHTML = renderAssistantMarkdown(cleaned);
    } else {
      el.textContent = cleaned;
    }
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function detectCompleteBlocks(text) {
    var blocks = [];
    var idx = 0;
    var buffer = String(text || '');

    // Render complete code fences as blocks as soon as the closing fence arrives.
    while (true) {
      var startFence = buffer.indexOf('```', idx);
      if (startFence === -1) {
        break;
      }
      var endFence = buffer.indexOf('```', startFence + 3);
      if (endFence === -1) {
        break;
      }
      var afterFence = endFence + 3;
      if (startFence > idx) {
        blocks.push(buffer.slice(idx, startFence));
      }
      blocks.push(buffer.slice(startFence, afterFence));
      idx = afterFence;
      if (buffer.charAt(idx) === '\n') {
        idx += 1;
      }
    }

    var remainder = buffer.slice(idx);
    var paraCut = remainder.lastIndexOf('\n\n');
    if (paraCut !== -1) {
      blocks.push(remainder.slice(0, paraCut + 2));
      remainder = remainder.slice(paraCut + 2);
    }

    return { blocks: blocks, tail: remainder };
  }

  function appendRenderedMarkdownBlock(el, text) {
    if (!el || !text || !text.trim()) return;
    var html = renderAssistantMarkdown(text);
    if (!html) return;
    var blockEl = document.createElement('div');
    blockEl.className = 'sobs-markdown-block';
    blockEl.innerHTML = html;
    el.appendChild(blockEl);
  }

  function isMarkdownTableTail(text) {
    var s = String(text || '');
    if (!s || s.indexOf('|') === -1) {
      return false;
    }
    var lines = s.split('\n').filter(function (line) {
      return line.trim() !== '';
    });
    if (lines.length < 2) {
      return false;
    }
    var header = lines[0].trim();
    var sep = lines[1].trim();
    var sepPattern = /^\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)+\|?$/;
    if (header.indexOf('|') === -1 || !sepPattern.test(sep)) {
      return false;
    }
    return true;
  }

  function setTailText(el, text) {
    if (!el) return;
    var tailEl = el.querySelector('.sobs-markdown-tail');
    var tailText = stripAssistantMetaPreview(String(text || ''));
    if (!tailText) {
      if (tailEl) {
        removeNode(tailEl);
      }
      return;
    }
    if (!tailEl) {
      tailEl = document.createElement('div');
      tailEl.className = 'sobs-markdown-tail';
      el.appendChild(tailEl);
    }
    if (isMarkdownTableTail(tailText)) {
      tailEl.innerHTML = renderAssistantMarkdown(tailText);
    } else {
      tailEl.textContent = tailText;
    }
  }

  function parseSseChunk(block) {
    var lines = block.split('\n');
    var eventName = 'message';
    var dataLines = [];
    lines.forEach(function (line) {
      if (line.startsWith('event:')) {
        eventName = line.slice(6).trim();
      } else if (line.startsWith('data:')) {
        var dataPart = line.slice(5);
        if (dataPart.startsWith(' ')) {
          dataPart = dataPart.slice(1);
        }
        dataLines.push(dataPart);
      }
    });
    var payload = {};
    if (dataLines.length) {
      try {
        payload = JSON.parse(dataLines.join('\n'));
      } catch (_err) {
        payload = {error: dataLines.join('\n')};
      }
    }
    return {event: eventName, payload: payload};
  }

  async function consumeAiStream(response, thinking, questionText) {
    var reader = response.body && response.body.getReader ? response.body.getReader() : null;
    if (!reader) {
      throw new Error('Streaming not supported by this browser');
    }
    var decoder = new TextDecoder();
    var buffer = '';
    var fullAnswer = '';
    var pendingAnswer = '';
    var answerEl = null;
    var guardStats = null;
    var modelStats = null;
    var queuedAutoTools = [];
    var finalDonePayload = null;

    try {
      while (true) {
        var result = await reader.read();
        if (result.done) {
          break;
        }
        buffer += decoder.decode(result.value, {stream: true});
        var parts = buffer.split('\n\n');
        buffer = parts.pop() || '';
        for (var i = 0; i < parts.length; i += 1) {
          var parsed = parseSseChunk(parts[i]);
          if (parsed.event === 'meta') {
            if (parsed.payload.chat_id) {
              currentChatId = String(parsed.payload.chat_id);
              syncActiveChatLabelFromHistory();
            }
            if (parsed.payload.supports_thinking !== undefined) {
              supportsThinking = !!parsed.payload.supports_thinking;
              if (thinkingWrapEl) {
                thinkingWrapEl.classList.toggle('active', supportsThinking);
              }
            }
            if (supportsThinking && thinkingLevelEl && parsed.payload.thinking_level) {
              thinkingLevelEl.value = String(parsed.payload.thinking_level);
            }
          } else if (parsed.event === 'guard') {
            guardStats = parsed.payload.guard_stats || null;
            updateStatus(guardStats, modelStats);
          } else if (parsed.event === 'token') {
            if (!answerEl) {
              removeNode(thinking);
              answerEl = addStreamingAssistantMsg();
            }
            var piece = String(parsed.payload.text || '');
            fullAnswer += piece;
            pendingAnswer += piece;
            var batches = detectCompleteBlocks(pendingAnswer);
            batches.blocks.forEach(function (block) {
              appendRenderedMarkdownBlock(answerEl, block);
            });
            pendingAnswer = batches.tail;
            setTailText(answerEl, pendingAnswer);
          } else if (parsed.event === 'tool') {
            var toolPayload = parsed.payload || {};
            var toolUi = addToolCard(toolPayload);
            if (!toolPayload.requires_confirmation) {
              queuedAutoTools.push({tool: toolPayload, ui: toolUi});
              toolUi.status.textContent = 'Will apply after response';
            }
          } else if (parsed.event === 'done') {
            removeNode(thinking);
            if (!answerEl) {
              answerEl = addStreamingAssistantMsg();
            }
            finalDonePayload = parsed.payload || {};
            fullAnswer = String(parsed.payload.answer || fullAnswer);
            modelStats = parsed.payload.model_stats || null;
            if (parsed.payload.chat_id) {
              currentChatId = String(parsed.payload.chat_id);
              syncActiveChatLabelFromHistory();
            }
            updateStatus(parsed.payload.guard_stats || guardStats, modelStats);
            setStreamingText(answerEl, fullAnswer, true);
            syncMessageMeta(answerEl, new Date().toISOString(), {
              role: 'assistant',
              turnId: String(parsed.payload.turn_id || ''),
              chatId: currentChatId,
              retryQuestion: questionText,
              copyText: stripAssistantMeta(fullAnswer)
            });
            addThinkingTraceLink(answerEl, parsed.payload);
            queuedAutoTools.forEach(function (item) {
              executeToolAction(item.tool, item.ui.status, false);
            });
            queuedAutoTools = [];
            loadChatHistory();
          } else if (parsed.event === 'error') {
            removeNode(thinking);
            addMsg('error-msg', 'Error: ' + (parsed.payload.error || 'unknown'));
            return;
          }
        }
      }

      removeNode(thinking);
      if (answerEl && fullAnswer) {
        setStreamingText(answerEl, fullAnswer, true);
        syncMessageMeta(answerEl, new Date().toISOString(), {
          role: 'assistant',
          turnId: String((finalDonePayload && finalDonePayload.turn_id) || ''),
          chatId: currentChatId,
          retryQuestion: questionText,
          copyText: stripAssistantMeta(fullAnswer)
        });
        addThinkingTraceLink(answerEl, finalDonePayload);
      } else if (answerEl && pendingAnswer) {
        setStreamingText(answerEl, pendingAnswer, true);
        syncMessageMeta(answerEl, new Date().toISOString(), {
          role: 'assistant',
          turnId: String((finalDonePayload && finalDonePayload.turn_id) || ''),
          chatId: currentChatId,
          retryQuestion: questionText,
          copyText: stripAssistantMeta(pendingAnswer)
        });
        addThinkingTraceLink(answerEl, finalDonePayload);
      }
    } catch (err) {
      if (err.name === 'AbortError') {
        removeNode(thinking);
        addMsg('info-msg', 'Request cancelled');
      } else {
        throw err;
      }
    } finally {
      reader.cancel();
      currentAbortController = null;
    }
  }

  async function sendQuestionText(questionText) {
    var q = String(questionText || '').trim();
    if (!q) return;
    
    if (currentAbortController) {
      currentAbortController.abort();
      currentAbortController = null;
    }
    
    addMsg('user', q, new Date().toISOString(), {chatId: currentChatId});
    inputEl.value = '';
    inputEl.style.height = '';

    var thinking = addThinkingMsg();

    try {
      currentAbortController = new AbortController();
      var response = await fetch('/api/ai/helper', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'text/event-stream'
        },
        signal: currentAbortController.signal,
        body: JSON.stringify({
          question: q,
          page: window.location.pathname,
          context: gatherContext(),
          chat_id: currentChatId,
          thinking_level: (thinkingLevelEl && supportsThinking) ? thinkingLevelEl.value : 'off',
          stream: true
        })
      });

      var contentType = response.headers.get('content-type') || '';
      if (contentType.indexOf('text/event-stream') !== -1) {
        await consumeAiStream(response, thinking, q);
        return;
      }

      var data = await response.json();
      removeNode(thinking);
      if (data.ok) {
        if (data.chat_id) {
          currentChatId = String(data.chat_id);
          syncActiveChatLabelFromHistory();
        }
        var msgEl = addMsg('assistant', data.answer, new Date().toISOString(), {
          turnId: String(data.turn_id || ''),
          chatId: currentChatId,
          retryQuestion: q,
          copyText: String(data.answer || '')
        });
        addThinkingTraceLink(msgEl, data);
        updateStatus(data.guard_stats || null, data.model_stats || null);
        loadChatHistory();
      } else {
        addMsg('error-msg', 'Error: ' + (data.error || 'unknown'), new Date().toISOString());
      }
    } catch (err) {
      removeNode(thinking);
      addMsg('error-msg', 'Network error: ' + err, new Date().toISOString());
    }
  }

  async function sendQuestion() {
    await sendQuestionText(inputEl.value.trim());
  }

  sendBtn.addEventListener('click', sendQuestion);
  inputEl.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendQuestion();
    }
  });

  // Auto-resize textarea
  inputEl.addEventListener('input', function () {
    this.style.height = '';
    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
  });
}());
</script>
</body>
</html>