{"query":"WITH series AS (\nSELECT\n  time,\n  value,\n  baseline_mean,\n  baseline_lower,\n  baseline_upper,\n  anomaly_state,\n  anomaly_score\nFROM v_otel_metrics_anomaly\nWHERE time >= now() - INTERVAL 12 HOUR AND\n    ServiceName = 'api' AND\n    MetricName = 'http.server.duration' AND\n    AttrFingerprint = 'fp123'\n)\nSELECT\n  time,\n  'api' AS service,\n  'metrics' AS source,\n  'http.server.duration' AS signal,\n  'fp123' AS attr_fp,\n  value,\n  toUInt32(1) AS sample_count,\n  baseline_mean,\n  baseline_lower,\n  baseline_upper,\n  anomaly_state,\n  anomaly_score\nFROM series\nORDER BY time\nLIMIT 500","spec":{"data":{"attr_fp":"fp123","limit":500,"metric_name":"http.server.duration","service":"api","signal_name":"","signal_source":"","source_view":"v_otel_metrics_anomaly","window_hours":12},"named_queries":[],"sql":{"mode":"builder","override_sql":"None"},"template_id":"derived_signal_overlay","visual":{"legend_show":true,"role_map":{},"smooth_line":true,"value_color":"","zoom_end_pct":100,"zoom_inside":true,"zoom_slider":false,"zoom_start_pct":0}},"template_id":"derived_signal_overlay"}
