{"query":"WITH series AS (\nWITH per_minute AS (\n  SELECT\n    toStartOfMinute(TimeUnixMs) AS time,\n    avg(toFloat64(Value)) AS value\n  FROM otel_metrics_gauge\n  WHERE TimeUnixMs >= now() - INTERVAL 6 HOUR AND\n    ServiceName = 'api' AND\n    MetricName = 'cpu.utilization'\n  GROUP BY time\n), scored AS (\n  SELECT\n    time,\n    value,\n    avg(value) OVER (\n      ORDER BY time\n      ROWS BETWEEN 59 PRECEDING AND CURRENT ROW\n    ) AS baseline_mean,\n    stddevPop(value) OVER (\n      ORDER BY time\n      ROWS BETWEEN 59 PRECEDING AND CURRENT ROW\n    ) AS baseline_stddev\n  FROM per_minute\n)\nSELECT\n  time,\n  value,\n  baseline_mean,\n  greatest(0.0, baseline_mean - (3.0 * ifNull(baseline_stddev, 0.0))) AS baseline_lower,\n  baseline_mean + (3.0 * ifNull(baseline_stddev, 0.0)) AS baseline_upper,\n  if(\n    abs(value - baseline_mean) / greatest(ifNull(baseline_stddev, 0.0), 1.0) >= 3.0,\n    'outlier',\n    'normal'\n  ) AS anomaly_state,\n  abs(value - baseline_mean) / greatest(ifNull(baseline_stddev, 0.0), 1.0) AS anomaly_score\nFROM scored\n)\nSELECT\n  time,\n  'api' AS service,\n  'metrics' AS source,\n  'cpu.utilization' AS signal,\n  '' AS attr_fp,\n  value,\n  toUInt32(1) AS sample_count,\n  baseline_mean,\n  baseline_lower,\n  baseline_upper,\n  anomaly_state,\n  anomaly_score\nFROM series\nORDER BY time\nLIMIT 1000","spec":{"data":{"attr_fp":"","limit":1000,"metric_name":"cpu.utilization","service":"api","signal_name":"","signal_source":"","source_view":"otel_metrics_gauge","window_hours":6},"named_queries":[],"sql":{"mode":"builder","override_sql":"None"},"template_id":"derived_signal_overlay","visual":{"legend_show":true,"role_map":{},"smooth_line":true,"value_color":"","zoom_end_pct":100,"zoom_inside":true,"zoom_slider":false,"zoom_start_pct":0}},"template_id":"derived_signal_overlay"}
