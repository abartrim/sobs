{"checklist":[{"id":"sdk","label":"Install & initialise the SDK"},{"id":"collector","label":"Run the OpenTelemetry Collector"},{"id":"verify","label":"Verify data in SOBS"},{"id":"anomaly","label":"Configure anomaly detection"}],"deployment":"baremetal","env":"prod","language":"java","ok":true,"steps":[{"commands":["<dependency>","  <groupId>io.opentelemetry</groupId>","  <artifactId>opentelemetry-sdk</artifactId>","  <version>1.36.0</version>","</dependency>","<dependency>","  <groupId>io.opentelemetry</groupId>","  <artifactId>opentelemetry-exporter-otlp</artifactId>","  <version>1.36.0</version>","</dependency>"],"description":"Add the OTLP exporter and SDK to your pom.xml.","id":"sdk_install","language":"xml","title":"Add OpenTelemetry Java dependencies (Maven)"},{"commands":["# Download the agent","curl -Lo opentelemetry-javaagent.jar https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/latest/download/opentelemetry-javaagent.jar","","# Run your app with the agent","java -javaagent:opentelemetry-javaagent.jar -Dotel.exporter.otlp.endpoint=http://localhost:4317 -jar your-app.jar"],"description":"Attach the agent JAR to your JVM startup for automatic instrumentation.","id":"sdk_init","language":"bash","title":"Alternatively use the Java agent (zero-code)"},{"commands":["# Download (Linux amd64):","curl -LO https://github.com/open-telemetry/opentelemetry-collector-releases/releases/latest/download/otelcol-contrib_linux_amd64.tar.gz","tar xzf otelcol-contrib_linux_amd64.tar.gz","","# Write config.yaml (same format as Docker example above)","","# Start:","./otelcol-contrib --config=config.yaml"],"description":"Download and run the contrib collector directly.","id":"collector_binary","language":"bash","title":"Run the OpenTelemetry Collector (binary)"},{"commands":["# Open your browser and navigate to http://sobs:44317/","# The Summary card should show span, log, and metric counts within ~30 s."],"description":"Check the Summary page for incoming telemetry.","id":"sobs_verify","language":"bash","title":"Verify data arrives in SOBS"},{"commands":["# Navigate to: http://sobs:44317/settings/anomaly-rules","# Click 'Add Rule' and choose a metric from your stack."],"description":"Head to Settings \u2192 Anomaly Rules and add your first threshold rule.","id":"sobs_anomaly","language":"bash","title":"Enable anomaly detection rules"}],"version":"1"}
