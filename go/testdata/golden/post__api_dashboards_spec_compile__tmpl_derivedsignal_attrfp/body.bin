{"query":"WITH series AS (\nSELECT\n  time,\n  value,\n  baseline_mean,\n  baseline_lower,\n  baseline_upper,\n  anomaly_state,\n  anomaly_score\nFROM v_derived_signals_anomaly\nWHERE time >= now() - INTERVAL 6 HOUR AND\n    ServiceName = 'api' AND\n    AttrFingerprint = 'fp999'\n)\nSELECT\n  time,\n  'api' AS service,\n  'derived' AS source,\n  'value' AS signal,\n  'fp999' AS attr_fp,\n  value,\n  toUInt32(1) AS sample_count,\n  baseline_mean,\n  baseline_lower,\n  baseline_upper,\n  anomaly_state,\n  anomaly_score\nFROM series\nORDER BY time\nLIMIT 1000","spec":{"data":{"attr_fp":"fp999","limit":1000,"metric_name":"","service":"api","signal_name":"","signal_source":"","source_view":"v_derived_signals_anomaly","window_hours":6},"named_queries":[],"sql":{"mode":"builder","override_sql":"None"},"template_id":"derived_signal_overlay","visual":{"legend_show":true,"role_map":{},"smooth_line":true,"value_color":"","zoom_end_pct":100,"zoom_inside":true,"zoom_slider":false,"zoom_start_pct":0}},"template_id":"derived_signal_overlay"}
