{"checklist":[{"id":"sdk","label":"Install & initialise the SDK"},{"id":"collector","label":"Run the OpenTelemetry Collector"},{"id":"verify","label":"Verify data in SOBS"}],"deployment":"cloud","env":"dev","language":"node","ok":true,"steps":[{"commands":["npm install @opentelemetry/sdk-node @opentelemetry/auto-instrumentations-node @opentelemetry/exporter-trace-otlp-grpc"],"description":"Add the SDK and OTLP exporter packages.","id":"sdk_install","language":"bash","title":"Install OpenTelemetry Node.js SDK"},{"commands":["// tracing.js","const { NodeSDK } = require('@opentelemetry/sdk-node');","const { getNodeAutoInstrumentations } = require('@opentelemetry/auto-instrumentations-node');","const { OTLPTraceExporter } = require('@opentelemetry/exporter-trace-otlp-grpc');","","const sdk = new NodeSDK({","  traceExporter: new OTLPTraceExporter({ url: 'http://localhost:4317' }),","  instrumentations: [getNodeAutoInstrumentations()],","});","sdk.start();"],"description":"Create tracing.js and require it before your app entry.","id":"sdk_init","language":"javascript","title":"Initialise SDK (tracing.js)"},{"commands":["# For AWS Distro for OpenTelemetry (ADOT):","# Set the exporter endpoint in your ADOT config to:","#   endpoint: http://localhost:44317","","# For GCP OpenTelemetry Collector:","# Override the exporter.endpoint in your otel-config.yaml to:","#   endpoint: http://localhost:44317"],"description":"Point your cloud provider's OTLP endpoint to forward to SOBS.","id":"collector_cloud","language":"yaml","title":"Configure a managed OTLP pipeline"},{"commands":["# Open your browser and navigate to http://localhost:44317/","# The Summary card should show span, log, and metric counts within ~30 s."],"description":"Check the Summary page for incoming telemetry.","id":"sobs_verify","language":"bash","title":"Verify data arrives in SOBS"}],"version":"1"}
