# syntax=docker/dockerfile:1
#
# Hot-reload DEV image for the Go server: the golang toolchain + pinned libchdb + air. The repo is
# bind-mounted at /src by docker-compose.dev.yml; air rebuilds ./cmd/sobs and restarts on every
# save (a few-second Go compile — the dev-loop replacement for Quart's reloader). Not a production
# artifact (use Dockerfile.go for that).

FROM golang:1.26-bookworm
ARG TARGETARCH

# air live-reload tool (pinned).
RUN go install github.com/air-verse/air@v1.61.7

# Pre-cache module deps so the first in-container build is fast (source is mounted over /src/go at
# runtime, but the module cache in /go/pkg/mod persists from this layer).
WORKDIR /src/go
COPY go/go.mod go/go.sum ./
RUN go mod download

# Pinned chdb-core v26.5.0 native lib (arch-matched), same as the prod image.
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) asset=linux-x86_64-libchdb.tar.gz ;; \
      arm64) asset=linux-aarch64-libchdb.tar.gz ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/libchdb.tar.gz \
      "https://github.com/chdb-io/chdb-core/releases/download/v26.5.0/${asset}"; \
    mkdir -p /opt/libchdb; tar -xzf /tmp/libchdb.tar.gz -C /opt/libchdb; test -f /opt/libchdb/libchdb.so

ENV CHDB_LIB_PATH=/opt/libchdb/libchdb.so \
    SOBS_HOST=0.0.0.0 \
    SOBS_PORT=4317 \
    SOBS_DATA_DIR=/data \
    SOBS_STATIC_DIR=/src/static \
    SOBS_TEMPLATE_DIR=/src/templates

WORKDIR /src/go
EXPOSE 4317
# Reads /src/go/.air.toml from the mounted source.
CMD ["air"]
